<attribute name="Sentiment" >-0.5210526429</attribute>
<attribute name="Sentiments" >-0.6;-0.6;-0.4;-0.4;0.2;0.4;-0.2;-0.6;-0.4;-0.8;-0.8;-0.8;-0.6;-0.2;-0.4;-0.4;-0.8;-0.6;-0.8;-0.8;-0.8;0;0;-0.8;-0.8;-0.8;-0.8;-0.2;-0.8;-0.6;-0.6;-0.8;-0.8;0;-0.4;-0.8;-0.6;-0.6</attribute>
