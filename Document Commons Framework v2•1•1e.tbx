<item ID="1744596459" Creator="Charles Wade" >
<attribute name="Badge" >sf-list.bullet.clipboard.fill</attribute>
<attribute name="BadgeMonochrome" >true</attribute>
<attribute name="Created" >2025-01-17T13:12:20+09:00</attribute>
<attribute name="DisplayedAttributes" >Subtitle;Creator;Modified;ID;MyBoolean;MyNumber;MyString;RuleDisabled</attribute>
<attribute name="DominantLanguage" >en</attribute>
<attribute name="Height" >1.86</attribute>
<attribute name="MapScrollX" >10.88309003</attribute>
<attribute name="MapScrollY" >10.7779394</attribute>
<attribute name="Modified" >2025-04-09T17:15:39+09:00</attribute>
<attribute name="MySet" >Created;Creator;Modified;MyBoolean;MyList;MyNumber;MySet;MyString;Prototype;ReadOnly;SmartQuotes</attribute>
<attribute name="NLNames" >Link Type;Link Types;Log Entry;User</attribute>
<attribute name="Name" >Manifest</attribute>
<attribute name="Rule" >action($Text(&quot;./Installer&quot;));</attribute>
