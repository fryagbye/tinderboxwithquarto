<item ID="1744657432" Creator="Charles Wade" proto="Function" >
<attribute name="Created" >2022-02-22T16:03:44+09:00</attribute>
<attribute name="Height" >1.86</attribute>
<attribute name="Modified" >2025-01-15T22:45:52+09:00</attribute>
<attribute name="Name" >Convert IPv4 Octets List to Integer</attribute>
<attribute name="SafePath" >/Hints/Library/Convert IPv4 Octets List to Integer</attribute>
<attribute name="SelectionCount" >40</attribute>
<attribute name="Sentiment" >-0.3125000065</attribute>
<attribute name="Sentiments" >-0.6;0;-1;-0.8;-0.4;-0.4;-0.8;-0.6;-0.6;0.2;0.8;-0.6;-0.4;-0.2;0.6;-0.2</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >52.5</attribute>
<attribute name="Ypos" >0</attribute>
<text >// Function to convert a List of four decimal octets into
// an integer. This requires a recent version of Tinderbox
// where numbers have full precision. The octet List is supplied
// as the input argument. The resulting integer is returned.
// Note that if the supplied list includes a fifth entry for
// the CIDR value, then this will be ignored.

function ip_octets2integer(ip_octets)
{ // Declare numeric variable to hold resulting integer
  var:number ip_int;
  var:list ip_octets=ip_octets;
  ip_int=(ip_octets[0]*16777216)
    +(ip_octets[1]*65536)
    +(ip_octets[2]*256)
    +ip_octets[3];
  return(ip_int);
};
</text>
<rtfd >cnRmZAAAAAADAAAAAgAAAAcAAABUWFQucnRmAQAAAC6mBQAAKwAAAAEAAACeBQAAe1xydGYxXGFuc2lcYW5zaWNwZzEyNTJcY29jb2FydGYyNzA5Clxjb2NvYXRleHRzY2FsaW5nMFxjb2NvYXBsYXRmb3JtMHtcZm9udHRibFxmMFxmbmlsXGZjaGFyc2V0MCBBbmRhbGVNb25vO30Ke1xjb2xvcnRibDtccmVkMjU1XGdyZWVuMjU1XGJsdWUyNTU7XHJlZDEyM1xncmVlbjEyM1xibHVlMTI5O1xyZWQyNTVcZ3JlZW4yNTVcYmx1ZTI1NTtccmVkMFxncmVlbjBcYmx1ZTA7ClxyZWQxMFxncmVlbjk2XGJsdWUyNTU7XHJlZDQxXGdyZWVuMTk5XGJsdWU1MDt9CntcKlxleHBhbmRlZGNvbG9ydGJsOztcY3NzcmdiXGM1NTY4NlxjNTU2ODZcYzU3NjQ3XGNuYW1lIHN5c3RlbUdyYXlDb2xvcjtcY3NzcmdiXGMxMDAwMDBcYzEwMDAwMFxjMTAwMDAwXGNuYW1lIHRleHRCYWNrZ3JvdW5kQ29sb3I7XGNzc3JnYlxjMFxjMFxjMFxjODQ3MDZcY25hbWUgY29udHJvbFRleHRDb2xvcjsKXGNzc3JnYlxjMFxjNDc4NDNcYzEwMDAwMFxjbmFtZSBzeXN0ZW1CbHVlQ29sb3I7XGNzc3JnYlxjMTU2ODZcYzgwMzkyXGMyNTQ5MFxjbmFtZSBzeXN0ZW1HcmVlbkNvbG9yO30KXHBhcmRcdHg1NjBcdHgxMTIwXHR4MTY4MFx0eDIyNDBcdHgyODAwXHR4MzM2MFx0eDM5MjBcdHg0NDgwXHR4NTA0MFx0eDU2MDBcdHg2MTYwXHR4NjcyMFxwYXJkaXJuYXR1cmFsXHBhcnRpZ2h0ZW5mYWN0b3IwCgpcZjBcZnMzMiBcY2YyIFxjYjMgLy8gRnVuY3Rpb24gdG8gY29udmVydCBhIExpc3Qgb2YgZm91ciBkZWNpbWFsIG9jdGV0cyBpbnRvXGNmNCBcClxjZjIgLy8gYW4gaW50ZWdlci4gVGhpcyByZXF1aXJlcyBhIHJlY2VudCB2ZXJzaW9uIG9mIFRpbmRlcmJveFxjZjQgXApcY2YyIC8vIHdoZXJlIG51bWJlcnMgaGF2ZSBmdWxsIHByZWNpc2lvbi4gVGhlIG9jdGV0IExpc3QgaXMgc3VwcGxpZWRcY2Y0IFwKXGNmMiAvLyBhcyB0aGUgaW5wdXQgYXJndW1lbnQuIFRoZSByZXN1bHRpbmcgaW50ZWdlciBpcyByZXR1cm5lZC5cY2Y0IFwKXGNmMiAvLyBOb3RlIHRoYXQgaWYgdGhlIHN1cHBsaWVkIGxpc3QgaW5jbHVkZXMgYSBmaWZ0aCBlbnRyeSBmb3JcY2Y0IFwKXGNmMiAvLyB0aGUgQ0lEUiB2YWx1ZSwgdGhlbiB0aGlzIHdpbGwgYmUgaWdub3JlZC5cY2Y0IFwKXApcY2Y1IGZ1bmN0aW9uXGNmNCAgaXBfb2N0ZXRzMmludGVnZXIoaXBfb2N0ZXRzKVwKXHsgXGNmMiAvLyBEZWNsYXJlIG51bWVyaWMgdmFyaWFibGUgdG8gaG9sZCByZXN1bHRpbmcgaW50ZWdlclxjZjQgXAogIFxjZjYgdmFyOm51bWJlclxjZjQgIGlwX2ludDtcCiAgXGNmNiB2YXI6XGNmNSBsaXN0XGNmNCAgaXBfb2N0ZXRzPWlwX29jdGV0cztcCiAgaXBfaW50PShpcF9vY3RldHNbMF0qMTY3NzcyMTYpXAogICAgKyhpcF9vY3RldHNbMV0qNjU1MzYpXAogICAgKyhpcF9vY3RldHNbMl0qMjU2KVwKICAgICtpcF9vY3RldHNbM107XAogIFxjZjUgcmV0dXJuXGNmNCAoaXBfaW50