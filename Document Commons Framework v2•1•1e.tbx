<text >
pattern: pattern|color|size|background|bold|italic|strike|underline|case-sensitive|wildcards|line-spacing|indent|first-indent
    color: bright blue
    
pattern: :.+
    color: black

pattern: yes|no
    case-sensitive: NO
    color: bright red
    bold:yes
    italic: yes

</text>
