<attribute name="Xpos" >81</attribute>
<attribute name="Ypos" >0</attribute>
<text >// Construct the $SafePath for current Note/Container where the
// Path string has all forward and backward slashes escaped.

$SafePath=ConstructSafePath2Note($ID);</text>
