<text >// This stamp will create a unique note for each User Attribute in 
// the current document. The resulting &quot;Attribute Notes&quot; can be
// used for the following purposes:
// (1) Documenting the defined User Attributes and allowing other
//     documentation to reference these notes to better clarify
//     role and usage of Attributes.
// (2) Provide an easier way to edit User Attribute descriptions
//     by utilizing $Text with associated code to update the
//     actual description based on the contents of $Text.
//     Similarly, default values, suggested values, and number
//     of displayed lines can be updated via the Attribute Note
//     as an alternative to using the Inspector.
// (3) As a method for easily copying User Attributes from one
//     Tinderbox document to another. By design, Attribute Notes
//     do not depend on any User Attributes or Prototypes. This
//     is so that when copied into a new document, minimal effort
//     and preparation is required.

// The System Attributes used in the resulting User Attribute Notes
// are mapped in this table:
//
// MyDictionary : Retrieval of complete attribute dictionary
//      Caption : Potentially used to provide warnings or errors
//     Subtitle : &quot;type&quot;
//    MyBoolean : &quot;sequential&quot;
//     MyString : &quot;default&quot;
//        MySet : &quot;suggested&quot;
//     MyNumber : &quot;lines&quot;
//         Text : &quot;description&quot;
//        Edict : action($Text(&quot;/Hints/Edict «Attribute Note»&quot;));

// When each Attribute Note is created, an Edict is defined that will 
// create or update the associated User Attribute with the details
// maintained in the Attribute Note. However, $EdictDisabled can be 
// set to true so that the Edict will not run or the &quot;Enabled&quot; 
// checkbox in the Inspector&apos;s Edict pane can be ticked off.

if($Checked)
{ // Then proceed to construct Attribute Notes for each User 
  // Attribute in the Tinderbox document overwriting any 
  // settings currently stored in Attribute Notes.
  var:string attr_path;
  $MyList=document[&quot;user-attributes&quot;];

  // Main loop to capture information about each User Attribute and
  // then create a unique &quot;Attribute Note&quot; based on this information.
  $MyList.each(attr_name)
  { // First, create a new &quot;Attribute Note&quot; if it does not already exist
    attr_path=create($Path+&quot;/&quot;+attr_name);
    $Badge(attr_path)=&quot;information&quot;;
    // Establish the System Attributes that will be displayed
    $DisplayedAttributes(attr_path)=
    &quot;Subtitle;Caption;MyString;MyBoolean;MyNumber;MySet;MyDictionary;MyDate;Creator;Created;Modified;Checked;EdictDisabled;RuleDisabled&quot;;
    // Capture dictionary of User Attribute specifications &amp; values
    $MyDictionary(attr_path)=attribute(attr_name);
    // Establish Edict &amp; Rule for new Note to handle subsequent creation 
    // and updates of the actual corresponding User Attribute
    $Edict(attr_path)=&apos;action($Text(&quot;/Hints/Edict «Attribute Note»&quot;));&apos;;
    $Rule(attr_path)=&apos;action($Text(&quot;/Hints/Edict «Attribute Note»&quot;));$Checked=false;$RuleDisabled=true;&apos;;
    $RuleDisabled(attr_path)=true; // Execute Rule only once for each enablement
    $Checked(attr_path)=true; // Allow reverse updating of all User Attribute settings
    // Extract User Attribute specs into Note&apos;s System Attributes
    $Subtitle(attr_path)=attribute(attr_name)[&quot;type&quot;];
    if(attribute(attr_name)[&quot;sequential&quot;]==&quot;YES&quot;){$MyBoolean(attr_path)=true;};
    $MyString(attr_path)=attribute(attr_name)[&quot;default&quot;];
    $MySet(attr_path)=attribute(attr_name)[&quot;suggested&quot;];
    $MyNumber(attr_path)=attribute(attr_name)[&quot;lines&quot;];
    $Text(attr_path)=attribute(attr_name)[&quot;description&quot;]+&quot;\n&quot;;
  };// End main loop
}; // EndIf 
</text>
