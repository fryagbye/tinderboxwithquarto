<item ID="1744596570" Creator="Chuck Wade" >
<attribute name="Color" >#ff2600</attribute>
<attribute name="Created" >2025-02-22T15:01:37+09:00</attribute>
<attribute name="DisplayedAttributes" >Subtitle;Modified;Checked;EdictDisabled;RuleDisabled;MyDictionary;ID;Path;OnPaste</attribute>
<attribute name="DominantLanguage" >en</attribute>
<attribute name="Edict" >// To rebuild dictionary, turn $Checked on
if($Checked) { $MyDictionary={};   $Checked=false; }; // Build a lookup dictionary for child notes found in ‘this’ container.
// The resulting dictionary maps $Name values to the corresponding $ID value. 
// In addition, if there are any child Notes in this container named 
// “Code Archive” or “Packages,” then their children will also be included.
// The resulting dictionary is placed into the $MyDictionary attribute
// of this container.

var:string  newLookup; // New Lookup entry for “Document Commons” Dictionary

$ID(children).each(global_note)
{ 
  newLookup=$Name(global_note)+&quot;:&quot;+$ID(global_note);
  $MyDictionary=$MyDictionary.add({newLookup});
  if($Name(global_note)==&quot;Packages&quot;)
  { 
    $ID(children(global_note)).each(package)
    { 
      newLookup=&quot;Package_&quot;+$Name(package)+&quot;:&quot;+$ID(package);
      $MyDictionary=$MyDictionary.add({newLookup});
    }; // End each “Package” loop
  }; // EndIf “Packages” container processing
  if($Name(global_note)==&quot;Code Archive&quot;)
  {
    $ID(children(global_note)).each(code_archive)
    { 
      newLookup=&quot;CodeArchive_&quot;+$Name(code_archive)+&quot;:&quot;+$ID(code_archive);
      $MyDictionary=$MyDictionary.add({newLookup});
    }; // End each “Code Archive” loop
  }; // EndIf “Code Archive” container processing
}; //End of children-of-commons loop
 
// Notes:
// (1) The intended use of the resulting dictionary is to allow other 
// code to easily look up the $IDs of the notes maintained in the 
// common section of the document, which should be the last top-level
// note in the document. Consequently, this dictionary can always be
// accessed as “$MyDictionary(lastSibling(cover))” </attribute>
<attribute name="EdictDisabled" >true</attribute>
<attribute name="IsSeparator" >true</attribute>
<attribute name="Modified" >2025-05-10T14:45:01+09:00</attribute>
<attribute name="NLNames" >User</attribute>
<attribute name="NLPlaces" >Edict</attribute>
<attribute name="Name" >Copy of “Document Commons”</attribute>
<attribute name="OnPaste" >if(!$Checked)
{ // Skip execution if Checked
  require(&quot;Hints&quot;); require(&quot;Prototypes&quot;); require(&quot;Templates&quot;);
  if($Subtitle(lastSibling(cover))!=&quot;Document Commons&quot;)
  { // “Document Commons” container does not exist
    $MyBoolean(&quot;./Essentials&quot;)=false;
    $MyNumber(&quot;./Essentials&quot;)=$ID;
    $Checked(&quot;./Document Attributes&quot;)=true;
    $Name=$Subtitle;
    $RuleDisabled=false;
    $Checked=true;
    $EdictDisabled=false;
    $Color=&quot;bright blue&quot;;
  } else 
  { // There is already a “Document Commons” container
    $MyBoolean(&quot;./Essentials&quot;)=true;
    $MyNumber(&quot;./Essentials&quot;)=$ID(lastSibling(cover));
    $Name+=&quot; copy&quot;;
  };
  // Invoke Essentials Installer to complete installation
  $RuleDisabled(&quot;./Essentials&quot;)=false;
}; //Endif not Checked
</attribute>
<attribute name="Rule" >// Force this Note to always be the last Top-Level Note // in the Document. if($OutlineOrder!=$OutlineOrder(lastSibling(cover)))
{ // Then this is not the last top-level Note/Container
  // Check that there is not already a lastSibling(cover)
  // with the same name as this note
  if($Name!=$Name(lastSibling(cover)))
  { // Then move this note to its correct position
  create(&quot;/Temp_Gw7WvqP5b_&quot;); // Just a random name, since it willl be tossed
  $Container=&quot;/Temp_Gw7WvqP5b_&quot;;   $Container=&quot;/&quot;;   $Prototype=;   delete(&quot;/Temp_Gw7WvqP5b_&quot;);
  } else
  {
  show(&quot;There is a duplicate &quot;+$Name+&quot; Container—Correct!&quot;,&quot;poppy&quot;,&quot;bright blue&quot;);
  $RuleDisabled=true;
  };
};</attribute>
<attribute name="RuleDisabled" >true</attribute>
