<item ID="1744596540" Creator="Charles Wade" proto="Function" >
<attribute name="Created" >2022-02-20T14:45:09+09:00</attribute>
<attribute name="DisplayedAttributes" >ReadOnly</attribute>
<attribute name="Height" >1.86</attribute>
<attribute name="Modified" >2022-02-21T19:21:24+09:00</attribute>
<attribute name="NLOrganizations" >IP</attribute>
<attribute name="Name" >Network:IP quad to integer</attribute>
<attribute name="ReadOnly" >true</attribute>
<attribute name="SafePath" >/Hints/Stamps/Network:IP quad to integer</attribute>
<attribute name="SelectionCount" >23</attribute>
<attribute name="Sentiment" >-0.654545467</attribute>
<attribute name="Sentiments" >-0.6;-0.6;-1;-0.4;-0.8;-0.8;-1;0;-0.2;-0.8;-0.8;-0.8;-1;-0.6;-0.8;-0.6;-0.6;-0.2;-0.6;-0.8;-0.6;-0.8</attribute>
<attribute name="Telephone" >2147483648</attribute>
<attribute name="TextWindowHeight" >443</attribute>
<attribute name="TextWindowWidth" >785</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >113</attribute>
<attribute name="Ypos" >0</attribute>
<text >// Convert IP dotted quad address to integer and CIDR to size/range.
// This Stamp is applied to the current Note and uses the “IP_Quad” 
// attribute as the sources of the IP address with the integer placed 
// in “IP_Integer”. The “IP_CIDR” attribute is used to compute the 
// subnet size or range that is placed in “IP_Range,” but only if 
// “IP_Range” is currently zero (default). This allows a range to be set
// manually, and not overwritten with the subnet size.
// Aside: Since Tinderbox numbers are currently signed 32 bit values,
// this code converts the dotted quad to a signed 32 bit result 
// noting that 2^31 is 2147483648 and 128.0.0.0 = zero (0).

if($IP_Quad[0]&gt;127)
{ $IP_Integer=(($IP_Quad[0]-128)*16777216)
  +($IP_Quad[1]*65536)
  +($IP_Quad[2]*256)
  +$IP_Quad[3];
}else
{ $IP_Integer=((($IP_Quad[0])*16777216)-2147483648)
  +($IP_Quad[1]*65536)
  +($IP_Quad[2]*256)
  +$IP_Quad[3];
};

if(!$IP_Range){$IP_Range=-1+pow(2,(32-$IP_CIDR));};
</text>
</item>
<item ID="1744596541" Creator="Charles Wade" proto="Function" >
<attribute name="Created" >2022-02-22T15:40:13+09:00</attribute>
<attribute name="DisplayedAttributes" >ReadOnly</attribute>
<attribute name="Height" >1.86</attribute>
<attribute name="Modified" >2025-01-15T22:41:48+09:00</attribute>
<attribute name="NLOrganizations" >IP</attribute>
<attribute name="Name" >Network:Extract IP-MAC info</attribute>
<attribute name="ReadOnly" >true</attribute>
<attribute name="SafePath" >/Hints/Stamps/Network:Extract IP-MAC info</attribute>
<attribute name="SelectionCount" >19</attribute>
<attribute name="Sentiment" >-0.3148148225</attribute>
<attribute name="Sentiments" >-0.6;-0.2;-0.6;-0.2;-0.6;-0.4;-0.4;-0.4;0;0;-0.2;0.8;-0.8;0.8;0.2;-0.6;0.4;-0.4;-0.4;-0.6;-0.4;-0.4;-0.4;0.8;-0.4;-0.6;-1;-0.6;-0.4;0;0;0.2;-0.6;0.8;-0.6;-0.6;-0.6;-0.2;-0.2;-0.4;-0.2;-0.2;-0.6;-0.8;-0.8;-0.8;0;0.2;-0.8;-0.8;-0.4;-0.8;-0.8;-0.4</attribute>
<attribute name="TextWindowHeight" >671</attribute>
<attribute name="TextWindowWidth" >901</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >116.5</attribute>
<attribute name="Ypos" >0</attribute>
<text >//
var:boolean debug=true; // If debug is true, issue log statements
var:string  log_books=&quot;/Core/LogBooks/&quot;;
var:string  netObjStore=&quot;Extract&quot;; // Log Book name for debugging records
var:string  log_dest=log_books+logbook;
var:string  current_line;
var:string  ip_dotQuad;
var:list    ip_octets;
var:number  ip_int;
var:number  ip_CIDR;
var:number  ip_range;
var:number  ip_netBase
var:string  mac_addr;
//
$MySet=&quot;&quot;;
0...($Text.paragraphCount-1).each(line_no)
{ // Main loop to process each line/row in $Text
  current_line=$Text.paragraph(line_no).trim;
  if(debug){LogRec(logbook,current_line);};
  // Initialize variables
  ip_dotQuad =&quot;&quot;;
  ip_int=0;
  ip_CIDR=0;
  ip_range=0;
  ip_netBase=0;
  mac_addr=&quot;&quot;;
  // Capture IP address from current line 
  ip_octets=ip_quad2octets(current_line);
  if(!ip_octets.empty)
  { // IP address found, so capture details
    ip_int=ip_octets2integer(ip_octets);
    ip_dotQuad=ip_octets[0]+&quot;.&quot;+ip_octets[1]+&quot;.&quot;+ip_octets[2]+&quot;.&quot;+ip_octets[3];
    if(ip_octets.count=5)
      { //CIDR value found with IP address
        ip_CIDR=ip_octets[4];
        ip_range=-1+pow(2,(32-ip_CIDR));
        ip_netBase=ip_int-mod(ip_int,pow(2,32-ip_CIDR));
        ip_dotQuad=ip_dotQuad+&quot;/&quot;+ip_octets[4];
      }; // Endif CIDR found
    // Create new IP Address note
    
    // Capture MAC Address from current line
    mac_addr=captureMAC(current_line);

  } else 
  {
  }; // Endif for IP address found

  if(debug){LogRec(logbook,&quot;ip_addr=&quot;+ip_addr+&quot;/&quot;);};
  if(!ip_addr.empty)
  { 
    ip_octets=ip_addr.extractAll(&quot;([0-9]+)&quot;);
    ip_int=ip_octets2integer(ip_octets);
    $MySet=$MySet+ip_int;
    if(debug){LogRec(logbook,ip_addr+&quot; | &quot;+ip_octets+&quot; | &quot;+ip_int);}; 
  };
};

// This stamp calls the following functions:
//   logRec
//   ip_quad2octets
//   ip_octets2integer
//   captureMAC
</text>
