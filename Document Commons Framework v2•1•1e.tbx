<attribute name="NLOrganizations" >Canonical;Cisco</attribute>
<attribute name="Name" >Capture Canonical MAC Address</attribute>
<attribute name="ReadOnly" >true</attribute>
<attribute name="SafePath" >/Hints/Library/Capture Canonical MAC Address</attribute>
<attribute name="SelectionCount" >41</attribute>
<attribute name="Sentiment" >-0.5437500104</attribute>
<attribute name="Sentiments" >-0.8;-0.8;-0.8;-0.2;0.2;-1;-0.6;-0.6;-0.6;-0.4;-0.8;-0.8;-0.8;0;-0.6;-0.8;-0.8;-0.8;0;-0.8;-0.8;-0.8;-0.8;0;-0.2;-0.6;-0.6;-0.8;0;-0.4;-0.4;-0.2</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >112</attribute>
<attribute name="Ypos" >0</attribute>
<text >// Capture MAC Address from input string argument and return in 
// canonical form as 12 hex digits with only uppercase A-F digits.
// 
// Since MAC addresses are formatted in various ways by different
// systems and vendors, this function tries multiple formats
// until one is found, otherwise it returns an empty string.
//

function captureMAC(input_string)
{ //
  var:string mac_string=&quot;&quot;;
  // Try MAC address with colon separators
  mac_string=input_string.extract(&quot;([a-fA-F0-9]{2}(:[a-fA-F0-9]{2}){5})&quot;);
  if(mac_string.size==17)
  {
    mac_string=mac_string.uppercase.replace(&quot;:&quot;,&quot;&quot;);
    return(mac_string);
  };
  // Try MAC address with hyphen separators
  mac_string=input_string.extract(&quot;([a-fA-F0-9]{2}(\-[a-fA-F0-9]{2}){5})&quot;);
  if(mac_string.size==17)
  {
    mac_string=mac_string.uppercase.replace(&quot;-&quot;,&quot;&quot;);
    return(mac_string);
  };
  // Try MAC address as dotted triads (Cisco style)
  mac_string=input_string.extract(&quot;([a-fA-F0-9]{4}(\.[a-fA-F0-9]{4}){2})&quot;);
  if(mac_string.size==14)
  {
    mac_string=mac_string.uppercase.replace(&quot;\.&quot;,&quot;&quot;);
    return(mac_string);
  };
  // Try MAC address split into 6-digit halves separated by hyphen
  mac_string=input_string.extract(&quot;([a-fA-F0-9]{6}(\-[a-fA-F0-9]{6}))&quot;);
  if(mac_string.size==13)
  {
    mac_string=mac_string.uppercase.replace(&quot;-&quot;,&quot;&quot;);
    return(mac_string);
  };
  // No MAC address found, so return empty string
  mac_string=&quot;&quot;;
  return(mac_string);
};</text>
