<item ID="1744596349" Creator="Charles Wade" proto="Function" >
<attribute name="Created" >2022-02-09T13:31:25+09:00</attribute>
<attribute name="DisplayedAttributes" >ReadOnly</attribute>
<attribute name="Height" >1.86</attribute>
<attribute name="Modified" >2025-02-21T22:29:33+09:00</attribute>
<attribute name="NLOrganizations" >LogRec</attribute>
<attribute name="Name" >Safe Paths:Update $SafePath for Branch</attribute>
<attribute name="ReadOnly" >true</attribute>
<attribute name="SafePath" >/Hints/Stamps/Safe Paths:Update $SafePath for Branch</attribute>
<attribute name="SelectionCount" >134</attribute>
<attribute name="Sentiment" >-0.4750000102</attribute>
<attribute name="Sentiments" >-0.8;-0.8;-1;-0.4;-0.8;-0.6;-0.4;-0.4;-0.4;-0.6;0.2;-0.4;-0.6;-1;-0.6;0.2;0;-0.4;-0.6;-0.8;-0.6;0;-0.6;0</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >84.5</attribute>
<attribute name="Ypos" >0</attribute>
<text >// This Stamp will invoke the UpdateSafePaths() function for the
// currently selected note. This will update the $SafePath 
// attribute for all descendants of the current note.
// The ConstructSafePath2Note() function is called to guarantee that
// the path string supplied to the UpdateSafePaths function is 
// properly escaped.

// Define debug &amp; logbook variables
var:boolean debug=false;
var:string logbook=&quot;UpdateSafePaths&quot;;
var:date start_time;
var:date end_time;
var:string abs_path_string;
abs_path_string=ConstructSafePath2Note($ID);

if(debug)
{ LogRec(logbook,&quot;&lt;&lt;blank&gt;&gt;&quot;);
  start_time=LogRec(logbook,
    &quot;&lt;&lt;start&gt;&gt;Begin UpdateSafePaths @ Branch=&quot;
      +abs_path_string);
};

UpdateSafePaths(abs_path_string);

if(debug)
{
  LogRec(logbook,&quot;&lt;&lt;blank&gt;&gt;&quot;);
  end_time=LogRec(logbook,&quot;&lt;&lt;end&gt;&gt;&quot;+start_time);
  $MyDate=end_time;
};

</text>
<rtfd >cnRmZAAAAAADAAAAAgAAAAcAAABUWFQucnRmAQAAAC6fBwAAKwAAAAEAAACXBwAAe1xydGYxXGFuc2lcYW5zaWNwZzEyNTJcY29jb2FydGYyNzA5Clxjb2NvYXRleHRzY2FsaW5nMFxjb2NvYXBsYXRmb3JtMHtcZm9udHRibFxmMFxmbmlsXGZjaGFyc2V0MCBBbmRhbGVNb25vO30Ke1xjb2xvcnRibDtccmVkMjU1XGdyZWVuMjU1XGJsdWUyNTU7XHJlZDEyM1xncmVlbjEyM1xibHVlMTI5O1xyZWQyNTVcZ3JlZW4yNTVcYmx1ZTI1NTtccmVkMFxncmVlbjBcYmx1ZTA7ClxyZWQ0MVxncmVlbjE5OVxibHVlNTA7XHJlZDI1MlxncmVlbjMzXGJsdWUzNztccmVkMTBcZ3JlZW45NlxibHVlMjU1O1xyZWQxNTdcZ3JlZW41MVxibHVlMjE0O30Ke1wqXGV4cGFuZGVkY29sb3J0Ymw7O1xjc3NyZ2JcYzU1Njg2XGM1NTY4NlxjNTc2NDdcY25hbWUgc3lzdGVtR3JheUNvbG9yO1xjc3NyZ2JcYzEwMDAwMFxjMTAwMDAwXGMxMDAwMDBcY25hbWUgdGV4dEJhY2tncm91bmRDb2xvcjtcY3NzcmdiXGMwXGMwXGMwXGM4NDcwNlxjbmFtZSBjb250cm9sVGV4dENvbG9yOwpcY3NzcmdiXGMxNTY4NlxjODAzOTJcYzI1NDkwXGNuYW1lIHN5c3RlbUdyZWVuQ29sb3I7XGNzc3JnYlxjMTAwMDAwXGMyMzEzN1xjMTg4MjRcY25hbWUgc3lzdGVtUmVkQ29sb3I7XGNzc3JnYlxjMFxjNDc4NDNcYzEwMDAwMFxjbmFtZSBzeXN0ZW1CbHVlQ29sb3I7XGNzc3JnYlxjNjg2MjdcYzMyMTU3XGM4NzA1OVxjbmFtZSBzeXN0ZW1QdXJwbGVDb2xvcjt9ClxwYXJkXHR4NTYwXHR4MTEyMFx0eDE2ODBcdHgyMjQwXHR4MjgwMFx0eDMzNjBcdHgzOTIwXHR4NDQ4MFx0eDUwNDBcdHg1NjAwXHR4NjE2MFx0eDY3MjBccGFyZGlybmF0dXJhbFxwYXJ0aWdodGVuZmFjdG9yMAoKXGYwXGZzMzIgXGNmMiBcY2IzIC8vIFRoaXMgU3RhbXAgd2lsbCBpbnZva2UgdGhlIFVwZGF0ZVNhZmVQYXRocygpIGZ1bmN0aW9uIGZvciB0aGVcY2Y0IFwKXGNmMiAvLyBjdXJyZW50bHkgc2VsZWN0ZWQgbm90ZS4gVGhpcyB3aWxsIHVwZGF0ZSB0aGUgJFNhZmVQYXRoIFxjZjQgXApcY2YyIC8vIGF0dHJpYnV0ZSBmb3IgYWxsIGRlc2NlbmRhbnRzIG9mIHRoZSBjdXJyZW50IG5vdGUuXGNmNCBcClxjZjIgLy8gVGhlIENvbnN0cnVjdFNhZmVQYXRoMk5vdGUoKSBmdW5jdGlvbiBpcyBjYWxsZWQgdG8gZ3VhcmFudGVlIHRoYXRcY2Y0IFwKXGNmMiAvLyB0aGUgcGF0aCBzdHJpbmcgc3VwcGxpZWQgdG8gdGhlIFVwZGF0ZVNhZmVQYXRocyBmdW5jdGlvbiBpcyBcY2Y0IFwKXGNmMiAvLyBwcm9wZXJseSBlc2NhcGVkLlxjZjQgXApcClxjZjIgLy8gRGVmaW5lIGRlYnVnICYgbG9nYm9vayB2YXJpYWJsZXNcY2Y0IFwKXGNmNSB2YXI6Ym9vbGVhblxjZjQgIGRlYnVnPVxjZjUgZmFsc2VcY2Y0IDtcClxjZjUgdmFyOnN0cmluZ1xjZjQgIGxvZ2Jvb2s9XGNmNiAiVXBkYXRlU2FmZVBhdGhzIlxjZjQgO1wKXGNmNSB2YXI6XGNmNyBkYXRlXGNmNCAgc3RhcnRfdGltZTtcClxjZjUg