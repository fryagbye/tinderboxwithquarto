<item ID="1744596615" Creator="Chuck Wade" proto="Stamp" >
<attribute name="Created" >2025-04-01T16:07:31+09:00</attribute>
<attribute name="DisplayedAttributes" >Creator;Created;Modified;MyBoolean;MyList;MyNumber;MySet;MyString;Prototype;ReadOnly;SmartQuotes</attribute>
<attribute name="Height" >1.86</attribute>
<attribute name="Modified" >2025-04-16T22:04:08+09:00</attribute>
<attribute name="Name" >Logging:Delete Log Books</attribute>
<attribute name="SelectionCount" >23</attribute>
<attribute name="Sentiment" >-0.1176470606</attribute>
<attribute name="Sentiments" >0.2;-0.8;0.6;-0.4;-0.4;-0.4;-0.4;-0.6;0.4;-0.2;0.2;0.6;0.2;0.2;-0.2;-0.6;-0.4</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >42</attribute>
<attribute name="Ypos" >0</attribute>
<text >// Remove all non-permanent log books contained in the 
// common log book repository, normally found at:
// “/Document Commons/LogBooks/”

var:number log_repository; // Obtain $ID for “LogBooks” container
log_repository=$MyDictionary(lastSibling(cover))[&quot;LogBooks&quot;];
var:list logbooks;

// Construct list of notes that are contained in the LogBook
// repository and that also have the &quot;Log Book&quot; prototype.

logbooks=collect_if(children(log_repository),$Prototype==&quot;Log Book&quot;,$ID);

// Delete each log book in the found list
logbooks.each(logbook){delete(logbook);};

// Log this delete action in the PersistentLogBook
LogRec(&quot;PersistentLogBook&quot;,&quot;&lt;&lt;mark&gt;&gt;&quot;
 +logbooks.count+&quot; logbooks were deleted &amp; Index Reset to Zero!&quot;);

// Reset the Log index to zero
$MyNumber(log_repository)=0;
 </text>
