<item ID="1744596350" Creator="Charles Wade" proto="Function" >
<attribute name="Created" >2022-03-19T21:51:59+09:00</attribute>
<attribute name="DisplayedAttributes" >ReadOnly</attribute>
<attribute name="Height" >1.86</attribute>
<attribute name="Modified" >2022-06-25T12:06:40+09:00</attribute>
<attribute name="NLOrganizations" >LogRec</attribute>
<attribute name="Name" >Safe Paths:Update $SafePath for Document</attribute>
<attribute name="ReadOnly" >true</attribute>
<attribute name="SafePath" >/Hints/Stamps/Safe Paths:Update $SafePath for Document</attribute>
<attribute name="SelectionCount" >85</attribute>
<attribute name="Sentiment" >-0.3076923146</attribute>
<attribute name="Sentiments" >-0.6;-1;-0.4;-0.4;0.2;0.4;0.4;0.2;-0.4;-0.4;-0.8;-0.6;-0.6</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >88</attribute>
<attribute name="Ypos" >0</attribute>
<text >// This Stamp will invoke the UpdateSafePaths() function for “root”
// The result will be that $SafePath will be updated for every 
// note within the current document.

// Define debug control and timestamp variables
var:boolean debug=true;
var:string logbook=&quot;PersistentLogBook&quot;;
var:date start_time;
var:date end_time;
var:string doc_root=&quot;/&quot;;

if(debug){start_time=LogRec(logbook,&quot;&lt;&lt;start&gt;&gt;Begin UpdateSafePaths for entire Document&quot;);};

UpdateSafePaths(doc_root);

if(debug){end_time=LogRec(logbook,&quot;&lt;&lt;end&gt;&gt;&quot;+start_time);};

</text>
</item>
<item ID="1744596493" Creator="Chuck Wade" proto="Function" >
<attribute name="Created" >2025-03-03T13:26:13+09:00</attribute>
<attribute name="DisplayedAttributes" >ReadOnly</attribute>
<attribute name="Height" >1.86</attribute>
<attribute name="Modified" >2025-03-27T13:51:19+09:00</attribute>
<attribute name="Name" >Diagram:Set Active Diagram</attribute>
<attribute name="ReadOnly" >true</attribute>
<attribute name="SelectionCount" >47</attribute>
<attribute name="Sentiment" >-0.5875000106</attribute>
<attribute name="Sentiments" >-0.4;-0.8;-0.2;-0.6;-0.6;-0.4;-0.8;-0.6;-0.8;-0.8;-0.2;-0.2;-0.8;-0.8;-0.4;-1</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >91.5</attribute>
<attribute name="Ypos" >0</attribute>
<text >// A simple stamp to establish a Diagram as a currently active
// work-in-progress. The idea is that some diagramming procedures
// will be automated to facilitate assembling a diagram and
// manipulating aspects of a diagram. 

var:number diagramSettings; 
if($Prototype(this)==&quot;Diagram&quot;)
{ // Then update “Diagram Settings” to point to (this) selection
  diagramSettings=GetCommonsItemID(&quot;Global Settings&quot;);
  diagramSettings=$ID($Path(diagramSettings)+&quot;/Diagram Settings&quot;);
  $MyString(diagramSettings)=$Path(this);
  $MyNumber(diagramSettings)=$ID(this);
  show(&quot;The active Diagram is now at “&quot;+$Path(this)+&quot;” with ID=&quot;+$ID(this),&quot;cyan&quot;,&quot;black&quot;);
} else
{ // This note is not a diagram; advise user…
  show(&quot;The selection is not a Diagram Container; Prototype must be “Diagram”&quot;,&quot;poppy&quot;,&quot;bright blue&quot;);
};
</text>
