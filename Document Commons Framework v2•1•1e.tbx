<menu name="Value" kind="stamps" >
<stamp name="Logging:Stop Logging" >// Turn off logging switch to stop all logging done via LogRec() function

var:number log_repository; // Obtain $ID for “LogBooks” container
log_repository=$MyDictionary(lastSibling(cover))[&quot;LogBooks&quot;];
$LoggingEnabled(log_repository)=false;</stamp>
<stamp name="Logging:Bookmark Entry" >// Enter a special Bookmark into the log book for stamp actions

LogRec(&quot;StampLog&quot;,&quot;&lt;&lt;mark&gt;&gt;&quot;);

// The resulting bookmark record will look like this:
// ***** Bookmark: Index=00002: 22-05-19 12:34:07 *****
</stamp>
<stamp name="Logging:Stamp Log Entry" >// Record log entry with contents of $MyString from current note
// in the logbook &quot;StampLog&quot;
LogRec(StampLog,$MyString);
</stamp>
<stamp name="Logging:Restart Index Sequencing" >// Reset the global logging index so that the next log
// record will start with one (00001)

var:number log_repository; // Obtain $ID for “LogBooks” container
log_repository=$MyDictionary(lastSibling(cover))[&quot;LogBooks&quot;];
var:string persistent_logbook=$Path(log_repository)+&quot;/PersistentLogBook&quot;;

// Record in PersistentLogBook that the index is being reset
LogRec(persistent_logbook,&quot;&lt;&lt;mark&gt;&gt;Logging Index Reset to Zero!&quot;);

// Reset Index Sequence number to zero
$MyNumber(log_repository)=0;
</stamp>
<stamp name="Logging:Delete Log Books" >// Remove all non-permanent log books contained in the 
// common log book repository, normally found at:
// “/Document Commons/LogBooks/”

var:number log_repository; // Obtain $ID for “LogBooks” container
log_repository=$MyDictionary(lastSibling(cover))[&quot;LogBooks&quot;];
var:list logbooks;

// Construct list of notes that are contained in the LogBook
// repository and that also have the &quot;Log Book&quot; prototype.

logbooks=collect_if(children(log_repository),$Prototype==&quot;Log Book&quot;,$ID);

// Delete each log book in the found list
logbooks.each(logbook){delete(logbook);};

// Log this delete action in the PersistentLogBook
LogRec(&quot;PersistentLogBook&quot;,&quot;&lt;&lt;mark&gt;&gt;&quot;
 +logbooks.count+&quot; logbooks were deleted &amp; Index Reset to Zero!&quot;);

// Reset the Log index to zero
$MyNumber(log_repository)=0;
 </stamp>
<stamp name="Safe Paths:Construct $SafePath for Note" >// Construct the $SafePath for current Note/Container where the
// Path string has all forward and backward slashes escaped.

$SafePath=ConstructSafePath2Note($ID);</stamp>
<stamp name="Safe Paths:Update $SafePath for Branch" >// This Stamp will invoke the UpdateSafePaths() function for the
// currently selected note. This will update the $SafePath 
// attribute for all descendants of the current note.
// The ConstructSafePath2Note() function is called to guarantee that
// the path string supplied to the UpdateSafePaths function is 
// properly escaped.

// Define debug &amp; logbook variables
var:boolean debug=false;
var:string logbook=&quot;UpdateSafePaths&quot;;
var:date start_time;
var:date end_time;
var:string abs_path_string;
abs_path_string=ConstructSafePath2Note($ID);

if(debug)
{ LogRec(logbook,&quot;&lt;&lt;blank&gt;&gt;&quot;);
  start_time=LogRec(logbook,
    &quot;&lt;&lt;start&gt;&gt;Begin UpdateSafePaths @ Branch=&quot;
      +abs_path_string);
};

UpdateSafePaths(abs_path_string);

if(debug)
{
  LogRec(logbook,&quot;&lt;&lt;blank&gt;&gt;&quot;);
  end_time=LogRec(logbook,&quot;&lt;&lt;end&gt;&gt;&quot;+start_time);
  $MyDate=end_time;
};

</stamp>
<stamp name="Safe Paths:Update $SafePath for Document" >// This Stamp will invoke the UpdateSafePaths() function for “root”
// The result will be that $SafePath will be updated for every 
// note within the current document.

// Define debug control and timestamp variables
var:boolean debug=true;
var:string logbook=&quot;PersistentLogBook&quot;;
var:date start_time;
var:date end_time;
var:string doc_root=&quot;/&quot;;

if(debug){start_time=LogRec(logbook,&quot;&lt;&lt;start&gt;&gt;Begin UpdateSafePaths for entire Document&quot;);};

UpdateSafePaths(doc_root);

if(debug){end_time=LogRec(logbook,&quot;&lt;&lt;end&gt;&gt;&quot;+start_time);};

</stamp>
<stamp name="Diagram:Set Active Diagram" >// A simple stamp to establish a Diagram as a currently active
// work-in-progress. The idea is that some diagramming procedures
// will be automated to facilitate assembling a diagram and
// manipulating aspects of a diagram. 

var:number diagramSettings; 
if($Prototype(this)==&quot;Diagram&quot;)
{ // Then update “Diagram Settings” to point to (this) selection
  diagramSettings=GetCommonsItemID(&quot;Global Settings&quot;);
  diagramSettings=$ID($Path(diagramSettings)+&quot;/Diagram Settings&quot;);
  $MyString(diagramSettings)=$Path(this);
  $MyNumber(diagramSettings)=$ID(this);
  show(&quot;The active Diagram is now at “&quot;+$Path(this)+&quot;” with ID=&quot;+$ID(this),&quot;cyan&quot;,&quot;black&quot;);
} else
{ // This note is not a diagram; advise user…
  show(&quot;The selection is not a Diagram Container; Prototype must be “Diagram”&quot;,&quot;poppy&quot;,&quot;bright blue&quot;);
};
</stamp>
<stamp name="Diagram:Add Notes to Active Diagram" >// This stamp assumes that the user has previously set an 
// Active Diagram using the “Diagram:Set Active Diagram” stamp.
// When invoked, this stamp will then add whatever note or
// notes are currently selected to the Active Diagram. 
// This allows adding notes to a diagram in a bulk manner.

var:number diagramSettings; 
var:number activeDiagram;

// First, get $ID of currently active Diagram from “Diagram Settings”
diagramSettings=GetCommonsItemID(&quot;Global Settings&quot;);
diagramSettings=$ID($Path(diagramSettings)+&quot;/Diagram Settings&quot;);
activeDiagram=$MyNumber(diagramSettings); // Diagram where notes will be added

// Now add selected note to active Diagram
createLink(this,activeDiagram,&quot;Diagram←Note&quot;);
</stamp>
<stamp name="Links:Remove Link From" >// This stamp allows a third-party execution context to
// remove a link from a specified note to the Stamp&apos;s target.
// For this to work, the Stamp target (i.e., “this”) must have
// these attribute assignments:
//   $MyNumber(target) contains the $ID of the from-note
//   $MyString(target) optionally provides the Link Type
//
// The third-party will set these attributes in the target,
// and then execute:
//    stamp(target,&quot;Links:Remove Link From&quot;);

// LogRec(StampLog,&quot;source: &quot;+$MyNumber+&quot; dest: &quot;+$ID+&quot; type: &quot;+$MyString);

unlinkFrom($MyNumber,$MyString);
</stamp>
<stamp name="Links:Remove Link To" >// This stamp allows a third-party execution context to
// remove a link to a specified note from the Stamp&apos;s target.
// For this to work, the Stamp target (i.e., “this”) must have
// these attribute settings:
//   $MyNumber(target) contains the $ID of the to-note
//   $MyString(target) optionally provides the Link Type
//
// The third-party will set these attributes in the target,
// and then execute:
//    stamp(target,&quot;Links:Remove Link To&quot;);

// LogRec(StampLog,&quot;source: &quot;+$ID+&quot; dest: &quot;+$MyNumber+&quot; type: &quot;+$MyString);

unlinkTo($MyNumber,$MyString);</stamp>
<stamp name="Links:Remove Link Set" >// This stamp will remove a set of outbound links from the referenced
// source note (i.e., “this”). $MyDictionary(this) will indicate the 
// links to be removed with entries of the form:
//   destination_ID:link_Types
// The link_Types can be a single type, or a set of link types when
// there are parallel links between the same source and destination notes. 
// 
// The number of links removed will be captured in $MyNumber(this)

var:boolean debug=false;
var:string  logbook=&quot;Debug—RemoveLinkSet&quot;;

$MyNumber=0; // Initialize count of links removed
$MyDictionary.keys.each(destinationID)
{ // Remove outbound link(s) to “destinationID”
  $MyDictionary[destinationID].each(linkType)
  { // Process each Link Type in case of parallel links
    if(debug){LogRec(logbook,&quot;--&gt; UnLink From &quot;+$ID+&quot; to &quot;+destinationID
       +&quot; with type: &quot;+linkType);};
    unlinkTo(destinationID,linkType);
    $MyNumber+=1;
    if(debug){LogRec(logbook,&quot;--&gt; # outbound links removed: &quot;+$MyNumber);};
  }; // End loop for parallel links
}; // End each link destination loop
</stamp>
<stamp name="Network:Initialize IP Address Note" >// Initialize standard IP Address parameters for a Note that represents a 
// specific IP address, or an IP Subnet, or an IP range. The IP address
// will be obtained from the Note&apos;s $Name, or if not in the $Name, then
// the $IP_DotQuad attribute will provide the address. If the address
// cannot be obtained from these sources, then warning flags will be 
// raised for this Note.

// Try to extract IP address from Note&apos;s $Name
$IP_Octets=ip_quad2octets($Name);
if($IP_Octets.empty)
{ // No IP address found in $Name, so try $IP_DotQuad
  $IP_Octets=ip_quad2octets($IP_DotQuad);
};
if($IP_Octets.empty)
  { // IP address not found, so mark Note in error
    $Color=&quot;bright red&quot;;
    $Badge=;

} else
{ // IP address was found so initialize using $IP_Octets
  if($IP_Octets.count=5)
  { // A CIDR extension was found appended to IP address
    // Capture CIDR value (might be numerical zero)
    $IP_CIDR=$IP_Octets[4];
    // Force $IP_DotQuad into standard form with CIDR extension
    $IP_DotQuad=$IP_Octets[0]+&quot;.&quot;+$IP_Octets[1]+&quot;.&quot;+$IP_Octets[2]+&quot;.&quot;+$IP_Octets[3]+&quot;/&quot;+$IP_Octets[4];
    $IP_Integer=ip_octets2integer($IP_Octets);
    // If $IP_Range not already defined, set to CIDR range
    if(!$IP_Range){$IP_Range=-1+pow(2,(32-$IP_CIDR));};
    $IP_NetBase=$IP_Integer-mod($IP_Integer,pow(2,32-$IP_CIDR));
    $Color=;
  } else 
  { // Set CIDR to empty value (distinct from zero)
    $IP_CIDR=&quot;&quot;;
    // Force $IP_DotQuad into standard form without CIDR extension
    $IP_DotQuad=$IP_Octets[0]+&quot;.&quot;+$IP_Octets[1]+&quot;.&quot;+$IP_Octets[2]+&quot;.&quot;+$IP_Octets[3];
    $IP_Integer=ip_octets2integer($IP_Octets);
    $Color=;
  }; EndIf CIDR check
}; EndIf check for IP address found in $Name

// This stamp calls the following functions:
//   ip_quad2octets
//   ip_octets2integer
</stamp>
<stamp name="Network:IP quad to integer" >// Convert IP dotted quad address to integer and CIDR to size/range.
// This Stamp is applied to the current Note and uses the “IP_Quad” 
// attribute as the sources of the IP address with the integer placed 
// in “IP_Integer”. The “IP_CIDR” attribute is used to compute the 
// subnet size or range that is placed in “IP_Range,” but only if 
// “IP_Range” is currently zero (default). This allows a range to be set
// manually, and not overwritten with the subnet size.
// Aside: Since Tinderbox numbers are currently signed 32 bit values,
// this code converts the dotted quad to a signed 32 bit result 
// noting that 2^31 is 2147483648 and 128.0.0.0 = zero (0).

if($IP_Quad[0]&gt;127)
{ $IP_Integer=(($IP_Quad[0]-128)*16777216)
  +($IP_Quad[1]*65536)
  +($IP_Quad[2]*256)
  +$IP_Quad[3];
}else
{ $IP_Integer=((($IP_Quad[0])*16777216)-2147483648)
  +($IP_Quad[1]*65536)
  +($IP_Quad[2]*256)
  +$IP_Quad[3];
};

if(!$IP_Range){$IP_Range=-1+pow(2,(32-$IP_CIDR));};
</stamp>
<stamp name="Network:Extract IP-MAC info" >//
var:boolean debug=true; // If debug is true, issue log statements
var:string  log_books=&quot;/Core/LogBooks/&quot;;
var:string  netObjStore=&quot;Extract&quot;; // Log Book name for debugging records
var:string  log_dest=log_books+logbook;
var:string  current_line;
var:string  ip_dotQuad;
var:list    ip_octets;
var:number  ip_int;
var:number  ip_CIDR;
var:number  ip_range;
var:number  ip_netBase
var:string  mac_addr;
//
$MySet=&quot;&quot;;
0...($Text.paragraphCount-1).each(line_no)
{ // Main loop to process each line/row in $Text
  current_line=$Text.paragraph(line_no).trim;
  if(debug){LogRec(logbook,current_line);};
  // Initialize variables
  ip_dotQuad =&quot;&quot;;
  ip_int=0;
  ip_CIDR=0;
  ip_range=0;
  ip_netBase=0;
  mac_addr=&quot;&quot;;
  // Capture IP address from current line 
  ip_octets=ip_quad2octets(current_line);
  if(!ip_octets.empty)
  { // IP address found, so capture details
    ip_int=ip_octets2integer(ip_octets);
    ip_dotQuad=ip_octets[0]+&quot;.&quot;+ip_octets[1]+&quot;.&quot;+ip_octets[2]+&quot;.&quot;+ip_octets[3];
    if(ip_octets.count=5)
      { //CIDR value found with IP address
        ip_CIDR=ip_octets[4];
        ip_range=-1+pow(2,(32-ip_CIDR));
        ip_netBase=ip_int-mod(ip_int,pow(2,32-ip_CIDR));
        ip_dotQuad=ip_dotQuad+&quot;/&quot;+ip_octets[4];
      }; // Endif CIDR found
    // Create new IP Address note
    
    // Capture MAC Address from current line
    mac_addr=captureMAC(current_line);

  } else 
  {
  }; // Endif for IP address found

  if(debug){LogRec(logbook,&quot;ip_addr=&quot;+ip_addr+&quot;/&quot;);};
  if(!ip_addr.empty)
  { 
    ip_octets=ip_addr.extractAll(&quot;([0-9]+)&quot;);
    ip_int=ip_octets2integer(ip_octets);
    $MySet=$MySet+ip_int;
    if(debug){LogRec(logbook,ip_addr+&quot; | &quot;+ip_octets+&quot; | &quot;+ip_int);}; 
  };
};

// This stamp calls the following functions:
//   logRec
//   ip_quad2octets
//   ip_octets2integer
//   captureMAC
</stamp>
<stamp name="Device: SSH capture" >// This stamp will invoke a command on a remote system/device using SSH,
// and return the results in $Text. The start time will be stored in
// $StartDate, and execution elapsed time will be placed in $MyInterval.
// 
// The Stamped note should have these two Attribute assignments:
//   $SSH_Target: A string that provides either an IP address or a domain
//     name for the target system/device. This will be used as the
//     destination for the SSH command. Note that use of SSH keys is 
//     strongly recommended, though a userid and password could be 
//     passed directly via this attribute if security is not a concern.
//   $MyString: The actual command to be invoked by the remote system/device.
//     
$StartDate = date(now);
$Text += &quot;ssh &quot; + $SSH_Target + &quot; &apos;&quot; + $MyString+&quot;&apos;\n&quot;;
$Text += (runCommand(&quot;ssh &quot; + $SSH_Target + &quot; &apos;&quot; + $MyString+&quot;&apos;&quot;));
$MyInterval = interval($StartDate-date(now));</stamp>
</menu>
