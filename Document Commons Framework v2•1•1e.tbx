<text >// Build a lookup dictionary for child notes found in a container that
// is either the last top-level note in the document or is passed as
// the single input to this function, i.e., “commons_ref”
// The resulting dictionary maps $Name values to the corresponding $ID value. 
// In addition, if there are any child Notes in commons_ref named 
// “Code Archive” or “Packages,” then their children will also be included.
// The resulting dictionary is placed into the $MyDictionary attribute
// of the container referenced by commons_ref or the last top-level note.
// This function does not return any values to the caller, and it will
// normally be called with no input parameter since the last top-level
// note (container) will be used as the default.

// This function is called from the Edict set for the “Document Commons”
// container in order to keep the Commons dictionary updated.


function UpdateCommons(commons_ref)
{ 
  var:string  newLookup; // New Lookup entry for “Document Commons” Dictionary

  if(!commons_ref){commons_ref=$ID(lastSibling(cover));};

  $ID(children(commons_ref)).each(global_note)
  { 
    newLookup=$Name(global_note)+&quot;:&quot;+$ID(global_note);
    $MyDictionary(commons_ref)=
      $MyDictionary(commons_ref).add({newLookup});
    if($Name(global_note)==&quot;Packages&quot;)
    { 
      $ID(children(global_note)).each(package)
      { 
        newLookup=$Name(package)+&quot;:&quot;+$ID(package);
        $MyDictionary(commons_ref)=
          $MyDictionary(commons_ref).add({newLookup});
      }; // End each “Package” loop
    }; // EndIf “Packages” container processing
    if($Name(global_note)==&quot;Code Archive&quot;)
    {
      $ID(children(global_note)).each(code_archive)
      { 
        newLookup=$Name(code_archive)+&quot;:&quot;+$ID(code_archive);
        $MyDictionary(commons_ref)=
          $MyDictionary(commons_ref).add({newLookup});
      }; // End each “Code Archive” loop
    }; // EndIf “Code Archive” container processing
  }; //End of children-of-commons loop
  return;
}; // End of “UpdateCommons” function

// Notes:
// (1) The intended use of the resulting dictionary is to allow other 
// code to easily look up the $IDs of the notes maintained in the 
// common section of the document, which is usually the last top-level
// note in the document. In practice, this dictionary can always be
// accessed as “$MyDictionary(lastSibling(cover))” </text>
