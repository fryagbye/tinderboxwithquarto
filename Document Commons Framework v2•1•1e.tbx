<item ID="1744657458" Creator="Chuck Wade" proto="Stamp" >
<attribute name="Created" >2022-02-22T11:08:10+09:00</attribute>
<attribute name="DisplayedAttributes" >SSH_Target;MyList;MySet;MyString;MyNumber;MyBoolean;Prototype;SmartLinks</attribute>
<attribute name="Height" >1.86</attribute>
