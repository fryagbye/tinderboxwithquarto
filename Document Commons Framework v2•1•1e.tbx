<attribute name="Subtitle" >Essentials</attribute>
<attribute name="TextWindowHeight" >891</attribute>
<attribute name="TextWindowWidth" >965</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >10.5</attribute>
<attribute name="Ypos" >0</attribute>
<text >// Purpose: Install Essential items in Tinderbox document.
// This assumes that the “Document Commons” container (i.e., the parent
// of this “Essentials” container) has been copied into the document.
// The “Document Commons” container includes an $OnPaste action to 
// check if there is already a ”Document Commons” installed, in which
// case $MyBoolean for this “Essentials” container will be set to true
// and $MyNumber will be set to the $ID of the correct container to use
// for the “Document Commons” where items should be installed.
// Assuming that there is no existing “Document Commons” the $OnPaste 
// action will set up the copied “Document Commons” and force it to
// be the last top-level note/container in the document.
// As the final step in the $OnPaste action, $RuleDisabled will be set
// to false for this “Essentials” container, thereby causing this code
// to be executed as the Rule. 
// Upon completion of this Rule, it will invoke another Rule to install
// any included Add-on Packages, and then set $RuleDisabled to true so
// that this Rule will execute only once.

if($Name==&quot;Essentials&quot;)
{ //Perform installation of essential items
  var:string   docCommonsPath=$Path($MyNumber); // Path to “Document Commons”
  var:number   installerLogID=; // ID for where to log activity
  var:string   originalPrototype; // Capture original Prototype
  var:string   on_Add; // Temp capture of $OnAdd action
  var:string   workString; // Temp capture of string data
  var:number   existingID; // ID of an existing item
  var:boolean  discarded; // True if an existing item was discarded
  var:date     start_time=date(now); // Capture current date/time as of “now”
  var:interval elapsed_time; // Installation execution elapsed time
  $MyString=docCommonsPath+&quot;/LogBooks/InstallerLog&quot;; // Path to Installer Logbook
  installerLogID=$ID($MyString); // ID where activity should be logged
  // Record start of Essentials installation
  $Text(installerLogID)+=&quot;\n##### Start Essentials Installer &quot;
    +start_time.format(&quot;Y-M0-D h:mm:s&quot;)+&quot; Path: &quot;+$Path+&quot; #####\n&quot;;
  $Text(installerLogID)+=&quot;Is there an existing “Document Commons”? &quot;
    +if($MyBoolean){&quot;Yes\n&quot;}else{&quot;No\n&quot;};;

  // ########################################################################
  // # Install essential Global and Package Settings                        #
  // ########################################################################
  $Text(installerLogID)+=date(now).format(&quot;Y-M0-D h:mm:s&quot;)
   +&quot; Move contents of &quot;+$Path(&quot;./Package Settings&quot;)+&quot; into “Global Settings” container\n&quot;;

  collect(children(&quot;./Package Settings&quot;),$ID).each(pkgSettings)
  { // For each installable item
    discarded=false;
    workString=docCommonsPath+&quot;/Global Settings/&quot;+$Name(pkgSettings);
    existingID=$ID(workString);
    // existingID=$ID(docCommonsPath+&quot;/Global Settings/&quot;+$Name(pkgSettings));
    $Text(installerLogID)+=&quot;  =&gt; &quot;+pkgSettings+&quot;:&quot;+$Name(pkgSettings);

    if(existingID&amp;($Modified(pkgSettings)&gt;=$Modified(existingID)))
    { // if there is already an existing settings note, and its Modified date
      // is the same or older than installer item, then discard existing item
      $Container(existingID)=docCommonsPath+&quot;/Discards/Global Settings/&quot;;
      discarded=true;
    }; // Endif existing and older

    if(!existingID|discarded)
    { // If there is either no existing item, or it was discarded above
      // then move the installer item into place and record actions
      $Container(pkgSettings)=docCommonsPath+&quot;/Global Settings/&quot;;

      if(discarded)
      { // Record replacement action
        $Text(installerLogID)+=&quot; | Replaced existing ID:&quot;+existingID+&quot;\n&quot;;
      } else
      { // Record new item moved into place
        $Text(installerLogID)+=&quot; | Moved new item into place\n&quot;;
      }; // Endif discarded
    } else
    { // Do not move, and record reason
      $Text(installerLogID)+=&quot; | ID:&quot;+existingID+&quot; Already exists &amp; newer; so not replaced!\n&quot;;
    }; // Endif doesn’t exist or discarded
  }; // End each item loop

  // ########################################################################
  // # Install essential Action Code blocks into Hints                      #
  // ########################################################################
  $Text(installerLogID)+=date(now).format(&quot;Y-M0-D h:mm:s&quot;)
   +&quot; Move requisite action code into “/Hints” container\n&quot;;

  collect(children(&quot;./Action Items&quot;),$ID).each(actionItem)
   { // For each installable item
    discarded=false;
    existingID=$ID(&quot;/Hints/&quot;+$Name(actionItem));
    $Text(installerLogID)+=&quot;  =&gt; &quot;+actionItem+&quot;:&quot;+$Name(actionItem);

    if(existingID&amp;($Modified(actionItem)&gt;=$Modified(existingID)))
    { // if there is already an existing action code block, and its Modified date
      // is the same or older than installer item, then discard existing item
      $ReadOnly(existingID)=false;
      $Container(existingID)=docCommonsPath+&quot;/Discards/Hints Actions/&quot;;
      discarded=true;
    }; // Endif existing and older

    if(!existingID|discarded)
    { // If there is either no existing item, or it was discarded above
      // then move the installer item into place and record actions
      $Container(actionItem)=&quot;/Hints/&quot;;
      update(actionItem);

      if($IsSeparator(actionItem))
      { $Prototype(actionItem)=&quot;&quot;; 
      } else 
      { if($Name(actionItem).contains(&quot;^\(.+\)&quot;))
        { $Prototype(actionItem)=&quot;&quot;;
        } else
        { $Prototype(actionItem)=&quot;Action&quot;;
        }; // Endif Name enclosed in parentheses 
      }; // Endif IsSeparator
      
      $MySet=$DisplayedAttributes(actionItem);
      $MySet+=&quot;;ReadOnly&quot;;
      $DisplayedAttributes(actionItem)=$MySet;
      $ReadOnly(actionItem)=true;
      $Text(installerLogID)+=&quot; | Updated&quot;;

      if(discarded)
      { // Record replacement action
        $Text(installerLogID)+=&quot; | Replaced existing ID:&quot;+existingID+&quot;\n&quot;;
      } else
      { // Record new item moved into place
        $Text(installerLogID)+=&quot; | Moved new item into place\n&quot;;
      }; // Endif discarded
    } else
    { // Do not move, and record reason
      $Text(installerLogID)+=&quot; | ID:&quot;+existingID+&quot; Already exists &amp; newer; so not replaced!\n&quot;;
    }; // Endif doesn’t exist or discarded
  }; // End each item loop

  // ########################################################################
  // # Install essential User Attributes                                    #
  // ########################################################################
  $Text(installerLogID)+=date(now).format(&quot;Y-M0-D h:mm:s&quot;)
   +&quot; Move essential User Attributes into “Document Attributes” container\n&quot;;

  collect(children(&quot;./User Attributes&quot;),$ID).each(userAttribute)
   { // For each installable item
    discarded=false;
    workString=docCommonsPath+&quot;/Document Attributes/&quot;+$Name(userAttribute);
    existingID=$ID(workString);
    // The original statement below would not work; replaced with above two statements
    // existingID=$ID(docCommonsPath+&quot;/Document Attributes/&quot;+$Name(userAttribute));
    // $Text(installerLogID)+=&quot;  :: &quot;+existingID+&quot;:&quot;+$Name(workString)+&quot;\n&quot;;
    $Text(installerLogID)+=&quot;  =&gt; &quot;+userAttribute+&quot;:&quot;+$Name(userAttribute);

    if(existingID&amp;($Modified(userAttribute)&gt;=$Modified(existingID)))
    { // if there is already an existing User Attribute, and its Modified date
      // is the same or older than installer item, then discard existing item
      $EdictDisabled(existingID)=true;
      $Container(existingID)=docCommonsPath+&quot;/Discards/Document Attributes/&quot;;
      discarded=true;
    }; // Endif existing and older

    if(!existingID|discarded)
    { // If there is either no existing item, or it was discarded above
      // then move the installer item into place and record actions
      $EdictDisabled(userAttribute)=true; // Disable Edict prior to move
      $RuleDisabled(userAttribute)=true; // Disable Rule prior to move
      $Container(userAttribute)=docCommonsPath+&quot;/Document Attributes/&quot;;
      $Checked(userAttribute)=true; // Set Checked to cause User Attribute creation
      $EdictDisabled(userAttribute)=false; // Enable Edict to update Attribute
      $RuleDisabled(userAttribute)=false; // Enable Rule to run once for initialization
      update(userAttribute); // (not sure this does anything)
      $Text(installerLogID)+=&quot; | Activated&quot;;

      if(discarded)
      { // Record replacement action
        $Text(installerLogID)+=&quot; | Replaced existing ID:&quot;+existingID+&quot;\n&quot;;
      } else
      { // Record new item moved into place
        $Text(installerLogID)+=&quot; | Moved new item into place\n&quot;;
      }; // Endif discarded
    } else
    { // Do not move, and record reason
      $Text(installerLogID)+=&quot; | ID:&quot;+existingID+&quot; Already exists &amp; newer; so not replaced!\n&quot;;
    }; // Endif doesn’t exist or discarded
  }; // End each item loop

  // ########################################################################
  // # Install essential Prototypes                                         #
  // ########################################################################
  $Text(installerLogID)+=date(now).format(&quot;Y-M0-D h:mm:s&quot;)
   +&quot; Move requisite Prototype items into “/Prototypes” container\n&quot;;

  collect(children(&quot;./Prototype Items&quot;),$ID).each(prototypeItem)
  { // For each installable item
    discarded=false;
    existingID=$ID(&quot;/Prototypes/&quot;+$Name(prototypeItem));
    $Text(installerLogID)+=&quot;  =&gt; &quot;+prototypeItem+&quot;:&quot;+$Name(prototypeItem);

    if(existingID&amp;($Modified(prototypeItem)&gt;=$Modified(existingID)))
    { // if there is already an existing Prototype, and its Modified date
      // is the same or older than installer item, then discard existing Prototype
      $Container(existingID)=docCommonsPath+&quot;/Discards/Prototype Items/&quot;;
      discarded=true;
    }; // Endif existing and older

    if(!existingID|discarded)
    { // If there is either no existing item, or it was discarded above
      // then move the installer item into place and record actions
      originalPrototype=$Prototype(prototypeItem);
      $Container(prototypeItem)=&quot;/Prototypes/&quot;;
      update(prototypeItem);
      $Prototype(prototypeItem)=originalPrototype;
      if($Name(prototypeItem)==&quot;Code&quot;){$Prototype(prototypeItem)=&quot;Action&quot;;};
      if($Name(prototypeItem)==&quot;Function&quot;){$Prototype(prototypeItem)=&quot;Action&quot;;};
      if($Name(prototypeItem)==&quot;Stamp&quot;){$Prototype(prototypeItem)=&quot;Action&quot;;};
      $Text(installerLogID)+=&quot; | Updated&quot;;

      if(discarded)
      { // Record replacement action
        $Text(installerLogID)+=&quot; | Replaced existing ID:&quot;+existingID+&quot;\n&quot;;
      } else
      { // Record new item moved into place
        $Text(installerLogID)+=&quot; | Moved new item into place\n&quot;;
      }; // Endif discarded
    } else
    { // Do not move, and record reason
      $Text(installerLogID)+=&quot; | ID:&quot;+existingID+&quot; Already exists &amp; newer; so not replaced!\n&quot;;
    }; // Endif doesn’t exist or discarded
  }; // End each item loop

  // ########################################################################
  // # Install essential Templates                                          #
  // ########################################################################
  $Text(installerLogID)+=date(now).format(&quot;Y-M0-D h:mm:s&quot;)
   +&quot; Move requisite Template items into “/Templates” container\n&quot;;

  collect(children(&quot;./Template Items&quot;),$ID).each(templateItem)
  { // For each installable item
    discarded=false;
    existingID=$ID(&quot;/Templates/&quot;+$Name(templateItem));
    $Text(installerLogID)+=&quot;  =&gt; &quot;+templateItem+&quot;:&quot;+$Name(templateItem);

    if(existingID&amp;($Modified(templateItem)&gt;=$Modified(existingID)))
    { // if there is already an existing Template, and its Modified date
      // is the same or older than installer item, then discard existing Template
      $Container(existingID)=docCommonsPath+&quot;/Discards/Template Items/&quot;;
      discarded=true;
    }; // Endif existing and older

    if(!existingID|discarded)
    { // If there is either no existing item, or it was discarded above
      // then move the installer item into place and record actions
      $Container(templateItem)=&quot;/Templates/&quot;;
      update(templateItem);
      $Text(installerLogID)+=&quot; | Updated&quot;;

      if(discarded)
      { // Record replacement action
        $Text(installerLogID)+=&quot; | Replaced existing ID:&quot;+existingID+&quot;\n&quot;;
      } else
      { // Record new item moved into place
        $Text(installerLogID)+=&quot; | Moved new item into place\n&quot;;
      }; // Endif discarded
    } else
    { // Do not move, and record reason
      $Text(installerLogID)+=&quot; | ID:&quot;+existingID+&quot; Already exists &amp; newer; so not replaced!\n&quot;;
    }; // Endif doesn’t exist or discarded
  }; // End each item loop

  // ########################################################################
  // # Install essential Library Code                                       #
  // ########################################################################
  $Text(installerLogID)+=date(now).format(&quot;Y-M0-D h:mm:s&quot;)
   +&quot; Move essential Functions into “/Hints/Library” container\n&quot;;

  // Override OnAdd action for Library container
  on_Add=$OnAdd(/Hints/Library);
  $OnAdd(/Hints/Library)=&quot;&quot;;

  collect(children(&quot;./Library Items&quot;),$ID).each(libraryItem)
   { // For each installable item
    discarded=false;
    existingID=$ID(&quot;/Hints/Library/&quot;+$Name(libraryItem));
    $Text(installerLogID)+=&quot;  =&gt; &quot;+libraryItem+&quot;:&quot;+$Name(libraryItem);

    if(existingID&amp;($Modified(libraryItem)&gt;=$Modified(existingID)))
    { // if there is already an existing action code block, and its Modified date
      // is the same or older than installer item, then discard existing item
      $ReadOnly(existingID)=false;
      $Container(existingID)=docCommonsPath+&quot;/Discards/Hints Library/&quot;;
      discarded=true;
    }; // Endif existing and older

    if(!existingID|discarded)
    { // If there is either no existing item, or it was discarded above
      // then move the installer item into place and record actions
      // originalPrototype=$Prototype(libraryItem); // Override $OnAdd actions
      $Container(libraryItem)=&quot;/Hints/Library/&quot;;
      update(libraryItem);
      // $Prototype(libraryItem)=originalPrototype; // This doesn’t work as expected
      if($IsSeparator(libraryItem)|$Name(libraryItem).contains(&quot;^\(.+\)&quot;))
      { $Prototype(libraryItem)=&quot;&quot;;
      } else 
      { $Prototype(libraryItem)=&quot;Function&quot;;
        $MySet=$DisplayedAttributes(libraryItem);
        $MySet+=&quot;;ReadOnly&quot;;
        $DisplayedAttributes(libraryItem)=$MySet;
        $ReadOnly(libraryItem)=true;
      };
      $Text(installerLogID)+=&quot; | Updated&quot;;

      if(discarded)
      { // Record replacement action
        $Text(installerLogID)+=&quot; | Replaced existing ID:&quot;+existingID+&quot;\n&quot;;
      } else
      { // Record new item moved into place
        $Text(installerLogID)+=&quot; | Moved new item into place\n&quot;;
      }; // Endif discarded
    } else
    { // Do not move, and record reason
      $Text(installerLogID)+=&quot; | ID:&quot;+existingID+&quot; Already exists &amp; newer; so not replaced!\n&quot;;
    }; // Endif doesn’t exist or discarded
  }; // End each item loop

  // Restore Libaray OnAddd action
  $OnAdd(/Hints/Library)=on_Add;

  // ########################################################################
  // # Install essential Stamps                                             #
  // ########################################################################
  $Text(installerLogID)+=date(now).format(&quot;Y-M0-D h:mm:s&quot;)
   +&quot; Move essential Stamps into “/Hints/Stamps” container\n&quot;;

  // Override OnAdd action for Stamps container
  on_Add=$OnAdd(/Hints/Stamps);
  $OnAdd(/Hints/Stamps)=&quot;&quot;;

  collect(children(&quot;./Stamp Items&quot;),$ID).each(stampItem)
   { // For each installable item
    discarded=false;
    existingID=$ID(&quot;/Hints/Stamps/&quot;+$Name(stampItem));
    $Text(installerLogID)+=&quot;  =&gt; &quot;+stampItem+&quot;:&quot;+$Name(stampItem);

    if(existingID&amp;($Modified(stampItem)&gt;=$Modified(existingID)))
    { // if there is already an existing Stamp, and its Modified date
      // is the same or older than installer item, then discard existing Stamp
      $ReadOnly(existingID)=false;
      $Container(existingID)=docCommonsPath+&quot;/Discards/Hints Stamps/&quot;;
      discarded=true;
    }; // Endif existing and older

    if(!existingID|discarded)
    { // If there is either no existing item, or it was discarded above
      // then move the installer item into place and record actions
      // originalPrototype=$Prototype(stampItem); // Override $OnAdd actions
      $Container(stampItem)=&quot;/Hints/Stamps/&quot;;
      update(stampItem);
      //$Prototype(stampItem)=originalPrototype; // This doesn’t work as expected
      if($IsSeparator(stampItem)|$Name(stampItem).contains(&quot;^\(.+\)&quot;))
      { $Prototype(stampItem)=&quot;&quot;;
      } else 
      { $Prototype(stampItem)=&quot;Stamp&quot;;
        $MySet=$DisplayedAttributes(stampItem);
        $MySet+=&quot;;ReadOnly&quot;;
        $DisplayedAttributes(stampItem)=$MySet;
        $ReadOnly(stampItem)=true;
      };
      $Text(installerLogID)+=&quot; | Updated&quot;;

      if(discarded)
      { // Record replacement action
        $Text(installerLogID)+=&quot; | Replaced existing ID:&quot;+existingID+&quot;\n&quot;;
      } else
      { // Record new item moved into place
        $Text(installerLogID)+=&quot; | Moved new item into place\n&quot;;
      }; // Endif discarded
    } else
    { // Do not move, and record reason
      $Text(installerLogID)+=&quot; | ID:&quot;+existingID+&quot; Already exists &amp; newer; so not replaced!\n&quot;;
    }; // Endif doesn’t exist or discarded
  }; // End each item loop

  // Restore Stamps OnAddd action
  $OnAdd(/Hints/Stamps)=on_Add;

  // ########################################################################
  // # Install essential Preview Items                                      #
  // ########################################################################
  $Text(installerLogID)+=date(now).format(&quot;Y-M0-D h:mm:s&quot;)
   +&quot; Move requisite Preview items into “/Hints/Preview” container\n&quot;;

  collect(children(&quot;./Preview Items&quot;),$ID).each(previewItem)
  { // For each installable item
    discarded=false;
    existingID=$ID(&quot;/Hints/Preview/&quot;+$Name(previewItem));
    $Text(installerLogID)+=&quot;  =&gt; &quot;+previewItem+&quot;:&quot;+$Name(previewItem);

    if(existingID&amp;($Modified(previewItem)&gt;=$Modified(existingID)))
    { // if there is already an existing Template, and its Modified date
      // is the same or older than installer item, then discard existing Preview
      $Container(existingID)=docCommonsPath+&quot;/Discards/Hints Preview Items/&quot;;
      discarded=true;
    }; // Endif existing and older

    if(!existingID|discarded)
    { // If there is either no existing item, or it was discarded above
      // then move the installer item into place and record actions
      $Container(previewItem)=&quot;/Hints/Preview/&quot;;
      update(previewItem);
      $Text(installerLogID)+=&quot; | Updated&quot;;

      if(discarded)
      { // Record replacement action
        $Text(installerLogID)+=&quot; | Replaced existing ID:&quot;+existingID+&quot;\n&quot;;
      } else
      { // Record new item moved into place
        $Text(installerLogID)+=&quot; | Moved new item into place\n&quot;;
      }; // Endif discarded
    } else
    { // Do not move, and record reason
      $Text(installerLogID)+=&quot; | ID:&quot;+existingID+&quot; Already exists &amp; newer; so not replaced!\n&quot;;
    }; // Endif doesn’t exist or discarded
  }; // End each item loop

  // ########################################################################
  // # Install essential Highlighter Items                                  #
  // ########################################################################
  $Text(installerLogID)+=date(now).format(&quot;Y-M0-D h:mm:s&quot;)
   +&quot; Move requisite Highlighter items into “/Hints/Highlighters” container\n&quot;;

  collect(children(&quot;./Highlighter Items&quot;),$ID).each(highlighterItem)
  { // For each installable item
    discarded=false;
    existingID=$ID(&quot;/Hints/Highlighters/&quot;+$Name(highlighterItem));
    $Text(installerLogID)+=&quot;  =&gt; &quot;+highlighterItem+&quot;:&quot;+$Name(highlighterItem);

    if(existingID&amp;($Modified(highlighterItem)&gt;=$Modified(existingID)))
    { // if there is already an existing Template, and its Modified date
      // is the same or older than installer item, then discard existing Preview
      $Container(existingID)=docCommonsPath+&quot;/Discards/Hints Highlighter Items/&quot;;
      discarded=true;
    }; // Endif existing and older

    if(!existingID|discarded)
    { // If there is either no existing item, or it was discarded above
      // then move the installer item into place and record actions
      $Container(highlighterItem)=&quot;/Hints/Highlighters/&quot;;
      update(highlighterItem);
      $Text(installerLogID)+=&quot; | Updated&quot;;

      if(discarded)
      { // Record replacement action
        $Text(installerLogID)+=&quot; | Replaced existing ID:&quot;+existingID+&quot;\n&quot;;
      } else
      { // Record new item moved into place
        $Text(installerLogID)+=&quot; | Moved new item into place\n&quot;;
      }; // Endif discarded
    } else
    { // Do not move, and record reason
      $Text(installerLogID)+=&quot; | ID:&quot;+existingID+&quot; Already exists &amp; newer; so not replaced!\n&quot;;
    }; // Endif doesn’t exist or discarded
  }; // End each item loop

  // ########################################################################
  // # Install essential Tagger Items                                       #
  // ########################################################################
  $Text(installerLogID)+=date(now).format(&quot;Y-M0-D h:mm:s&quot;)
   +&quot; Move requisite Tagger items into “/Hints/Taggers” container\n&quot;;

  collect(children(&quot;./Tagger Items&quot;),$ID).each(taggerItem)
  { // For each installable item
    discarded=false;
    existingID=$ID(&quot;/Hints/Taggers/&quot;+$Name(taggerItem));
    $Text(installerLogID)+=&quot;  =&gt; &quot;+taggerItem+&quot;:&quot;+$Name(taggerItem);

    if(existingID&amp;($Modified(taggerItem)&gt;=$Modified(existingID)))
    { // if there is already an existing Template, and its Modified date
      // is the same or older than installer item, then discard existing Preview
      $Container(existingID)=docCommonsPath+&quot;/Discards/Hints Tagger Items/&quot;;
      discarded=true;
    }; // Endif existing and older

    if(!existingID|discarded)
    { // If there is either no existing item, or it was discarded above
      // then move the installer item into place and record actions
      $Container(taggerItem)=&quot;/Hints/Taggers/&quot;;
      update(taggerItem);
      $Text(installerLogID)+=&quot; | Updated&quot;;

      if(discarded)
      { // Record replacement action
        $Text(installerLogID)+=&quot; | Replaced existing ID:&quot;+existingID+&quot;\n&quot;;
      } else
      { // Record new item moved into place
        $Text(installerLogID)+=&quot; | Moved new item into place\n&quot;;
      }; // Endif discarded
    } else
    { // Do not move, and record reason
      $Text(installerLogID)+=&quot; | ID:&quot;+existingID+&quot; Already exists &amp; newer; so not replaced!\n&quot;;
    }; // Endif doesn’t exist or discarded
  }; // End each item loop

  // ########################################################################
  // # Confirm completion of Essentials Installation                        #
  // ########################################################################

  elapsed_time=interval(start_time,date(now));
  $Text(installerLogID)+=&quot;#####   End Essentials Installer &quot;
    +date(now).format(&quot;Y-M0-D h:mm:s&quot;)+&quot; ##### | Elapsed time = &quot;
    +((24*elapsed_time.day)+elapsed_time.hour).format(0,2,&quot;0&quot;)
    +&quot;:&quot;+elapsed_time.minute.format(0,2,&quot;0&quot;)
    +&quot;:&quot;+elapsed_time.second.format(0,2,&quot;0&quot;)+&quot;\n&quot;;

  // ########################################################################
  // # Now install any included Add-on Packages.                            #
  // ########################################################################
  
  $MyBoolean(&quot;./Add-on Packages&quot;)=$MyBoolean; // True if “Document Commons” already exists
  $MyNumber(&quot;./Add-on Packages&quot;)=$MyNumber;   // $ID of correct “Document Commons”
  $MyString(&quot;./Add-on Packages&quot;)=$MyString;   // Path to InstallerLog
  $RuleDisabled(&quot;./Add-on Packages&quot;)=false;   // Enable execution of Add-on Installers

  // ########################################################################
  // # Wrap up installation of Essential Items.                             #
  // ########################################################################
 
  $RuleDisabled=true; // Prevent this Installer from running again.
  $MyDate=date(now); // Capture end timestamp
  $MyInterval=elapsed_time; // Capture execution duration

  if($MyBoolean)
  { // If the “Document Commons” framework is already in place, then 
    // Move this copied version of “Document Commons” into the Discards container
    $Container(../)=$Path(lastSibling(cover))+&quot;/Discards/&quot;;
  } else 
  { // This instance of “Document Commons” has now been deployed as the framework
    // Remove this “Essentials” container from this “Document Commons”
    $Container=$Path(lastSibling(cover))+&quot;/Discards/&quot;;
  }; 
  

} else
{ // This action code has been incorrectly invoked
  $MyString=&quot;Bogus run&quot;;
}; // Endif check for proper execution from “Essentials”

//--+----1----+----2----+----3----+----4----+----5----+----6----+----7----+----8</text>
