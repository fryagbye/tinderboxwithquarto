<attribute name="NLOrganizations" >IP;Quad</attribute>
<attribute name="Name" >Convert IPv4 Integer to Dotted Quad</attribute>
<attribute name="SafePath" >/Hints/Library/Convert IPv4 Integer to Dotted Quad</attribute>
<attribute name="ScreenWidth" >604</attribute>
<attribute name="SelectionCount" >41</attribute>
<attribute name="Sentiment" >-0.3473684294</attribute>
<attribute name="Sentiments" >-0.6;-0.8;-0.6;-0.8;-0.6;-0.6;-0.6;-0.8;-0.4;0.6;0.6;-0.2;0.8;0.4;-0.8;-0.8;-0.6;-0.4;-0.4</attribute>
<attribute name="Telephone" >2025-01-16 10.0.3</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >3.5</attribute>
<attribute name="Ypos" >2.36</attribute>
<text >// Convert an IP address expressed as a signed 32-bit integer
// into a dotted quad String. This function relies on the
// “ip_integer2octets” function to obtain the four octets.

function ip_integer2dotquad(ip_int)
{ //
  var:string ip_dotquad;
  var:list ip_octets=ip_integer2octets(ip_int);
  ip_dotquad=
    ip_octets[0]+&quot;.&quot;+
    ip_octets[1]+&quot;.&quot;+
    ip_octets[2]+&quot;.&quot;+
    ip_octets[3];
  return(ip_dotquad);
};

// This function calls the following functions:
//   ip_integer2octets

// Note that the assignment to ip_octets where it is declared
// is necessary for this to work as of 2025-01-16 10.0.3b700.
// Eastgate fixed this type coercion problem in Tbx 10.0.3b701.
</text>
