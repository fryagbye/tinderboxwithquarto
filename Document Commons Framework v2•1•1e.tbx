<attribute name="Name" >Collect dictionary of outbound plain links mapped to link types</attribute>
<attribute name="SelectionCount" >109</attribute>
<attribute name="Sentiment" >-0.4111111214</attribute>
<attribute name="Sentiments" >-0.6;-0.8;-0.4;0;-0.2;0.6;-0.6;0;-0.6;-0.4;-0.4;-0.4;-0.4;-0.4;0.2;-0.2;-0.2;-0.4;-0.4;-0.6;-0.6;-0.8;0;0;-0.4;-0.8;-0.8;-0.8;-0.8;-0.6;-0.8;-0.6;-0.6;-0.8;-0.8;-0.2;-0.6;-0.6;-0.6;-0.6;-0.6;0;-0.6;-0.8;-0.8;-0.4;0;-0.6;-0.6;-0.2;-0.4;0;0;0.8</attribute>
