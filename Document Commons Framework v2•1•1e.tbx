<attribute name="Modified" >2025-04-11T14:21:12+09:00</attribute>
<attribute name="NLOrganizations" >Package Installers</attribute>
<attribute name="Name" >Installer</attribute>
<attribute name="ScreenHeight" >22</attribute>
<attribute name="SelectionCount" >76</attribute>
<attribute name="Sentiment" >-0.4505050593</attribute>
<attribute name="Sentiments" >-0.8;-0.8;-1;-0.4;-0.6;-0.8;-0.2;-0.6;-1;-0.2;-1;-0.8;-0.6;-0.6;0.2;0;-0.8;0;-0.8;-0.8;-0.6;-0.4;-0.4;-0.4;0.2;0;-0.4;0.4;0.4;-0.6;-0.6;-0.2;-0.6;-0.8;-0.6;-0.8;-0.8;-0.6;0.2;-0.4;-0.4;-0.8;0.2;-0.8;-0.8;-0.8;-0.8;0;0;-0.4;-0.4;0;0;-0.4;-0.6;0.4;0.4;-1;0;-0.6;-0.6;-0.4;-0.8;-0.8;-0.2;-0.4;-0.4;-0.6;-0.8;-0.8;-0.8;-0.2;-0.4;-0.4;-0.2;0.4;0.2;0.4;0.2;-0.6;-0.6;-0.4;-0.6;-0.4;-0.8;-0.8;-0.8;-0.8;-1;-0.6;-0.2;-0.8;-0.4;-0.4;-0.8;-0.6;-0.4;-0.8;-0.8</attribute>
<attribute name="Subtitle" >Add-on Packages</attribute>
<attribute name="TextWindowHeight" >823</attribute>
<attribute name="TextWindowWidth" >1159</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >7</attribute>
<attribute name="Ypos" >0</attribute>
<text >// Purpose: Run Installers for included Add-on Packages. 
// Before this Rule is enabled, the invoking Action should make the following
// assignments to this “Add-on Packages” container:
//   $MyBoolean: Set to true if “Document Commons” already exists
//   $MyNumber:  ID of active “Document Commons” container (new or existing)
//   $MyString:  Path to InstallerLog where events/actions should be logged
// Upon initial execution, this Rule will set $Checked to true indicating 
// that it has been initialized and that it will invoke Installer Rules for
// each Add-on Package. After each Add-on Package Installer completes, it
// will restart this Rule to invoke any remaining Add-on Package Installers.
// When all Add-on Package Installers have run, then this Rule will wrap up
// and then set $RuleDisabled to true so that it remains inactive.
// Prior to invoking each Add-on Package Installer Rule, the values of
// $MyNumber and $MyString (see above) will be passed to the Add-on Package.
// During the initialization of this Rule, it will set $MyList to the list
// of $IDs for each of the Add-on Packages (i.e., children of this container).
// Since this Rule will be restarted for each Add-on Package, the $Visits
// Attribute is used as the index into $MyList to select the next Add-on
// Package Installer. 

if($Name==&quot;Add-on Packages&quot;)
{ //Initiate installation of Add-on Packages
  var:string   docCommonsPath=$Path($MyNumber); // Path to “Document Commons”
  var:number   installerLogID=$ID($MyString); // ID for where to log activity
  var:number   addOnID; // ID of Add-on Package Installer 
  var:number   packageID; // ID of Package in “Document Commons”
  var:string   workString; // Temp string capture
  var:interval elapsed_time; // Installation execution elapsed time

  // ########################################################################
  // # Initialize Execution; Capture list of Add-on Packages (if any)       #
  // ########################################################################

  if(!$Checked)
  { // If not Checked, then set up for activating each Add-on Installer
    // Record start of Add-on Package installations
    $MyDate=date(now); // Capture current date/time as of “now”
    $Text(installerLogID)+=&quot;\n%%%%% Start Installation of Add-on Packages &quot;
      +$MyDate.format(&quot;Y-M0-D h:mm:s&quot;)+&quot; %%%%%\n&quot;;

    // Get list of Add-on Package IDs to be installed
    $MyList=collect_if(children,$Name!=&quot;Installer&quot;,$ID); 
    if($MyList.count&gt;0)
    { // If there are any Add-on Packages to install
      $Text(installerLogID)+=$MyDate.format(&quot;Y-M0-D h:mm:s&quot;)+&quot; | &quot;
        +$MyList.count+&quot; Add-on Installers found to activate\n&quot;;
      $Checked=true; // Skip initialization for subsequent executions of Rule
    } else
    { 
      $Text(installerLogID)+=$MyDate.format(&quot;Y-M0-D h:mm:s&quot;)
        +&quot; No Add-on Installers found to activate\n&quot;;
    }; // Endif any Add-on Packages available to install
    $Visits=0; // Set initial index to first Add-on Package ID in $MyList
  }; // Endif check for already initialized

  // ########################################################################
  // # For each Add-on Package, activate associated Installer               #
  // ########################################################################

  if($Visits&lt;$MyList.count)
  { // If there remains an Add-on Package to install
    addOnID=$MyList[$Visits];
    if($MyBoolean)
    { // If “Document Commons” was already installed, move new Package into it
      workString=docCommonsPath+&quot;/Packages/&quot;+$Name(addOnID);
      packageID=$ID(workString); // Get ID of already deployed Package if it exists
      if(packageID)
      { // If Package already in place, move it to “Discards/Packages”
        $Container(packageID)=docCommonsPath+&quot;/Discards/Packages/&quot;;
        $Text(installerLogID)+=&quot;  Original “&quot;+workString+&quot;” moved to “Discards/Packages”\n&quot;;
      }; // Endif Package already in place

      workString=&quot;../../Packages/&quot;+$Name(addOnID);
      packageID=$ID(workString); // ID of new Add-on Package to be installed
      if(packageID)
      { // If a new Package container exists, move into “Document Commons/Packages”
        $Container(packageID)=docCommonsPath+&quot;/Packages/&quot;;
        $Text(installerLogID)+=&quot;  Package for “&quot;+$Name(addOnID)+&quot;” moved into “Packages” container&quot;;
      }; // Endif Package already in place

    }; // Endif “Document Commons” already installed

    $Text(installerLogID)+=&quot;\n+++++ &quot;+date(now).format(&quot;Y-M0-D h:mm:s&quot;)
      +&quot; Activate Installer for: &quot;+addOnID+&quot;:&quot;+$Name(addOnID)+&quot; +++++\n&quot;;
    $MyNumber(addOnID)=$MyNumber;
    $MyString(addOnID)=$MyString;
    $RuleDisabled(addOnID)=false;
    $Visits+=1; // Bump index for next Add-on in list
    // Add-on Package Installer should now run
  } else
  { // Completion of Add-on Package installations

    $Checked=false; // Re-initialize scan of Add-on Packages for next run
    
    elapsed_time=interval($MyDate,date(now));
    $Text(installerLogID)+=&quot;\n%%%%%   End Installation of Add-on Packages &quot;
      +date(now).format(&quot;Y-M0-D h:mm:s&quot;)+&quot; %%%%% | Elapsed time = &quot;
      +((24*elapsed_time.day)+elapsed_time.hour).format(0,2,&quot;0&quot;)
      +&quot;:&quot;+elapsed_time.minute.format(0,2,&quot;0&quot;)
      +&quot;:&quot;+elapsed_time.second.format(0,2,&quot;0&quot;)+&quot;\n&quot;;

  }; // Endif any remaining Add-ons to install

  // Now disable this Rule. 
  // It should be re-enabled after each Add-on Installer completes execution
  $RuleDisabled=true;

} else
{ // This action code has been incorrectly invoked
  $MyString=&quot;Bogus run&quot;;
  $RuleDisabled=true;
}; // Endif check for proper execution from “Add-on Packages”

//--+----1----+----2----+----3----+----4----+----5----+----6----+----7----+----8</text>
