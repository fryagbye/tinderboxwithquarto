<attribute name="Name" >Links:Remove Link Set</attribute>
<attribute name="SelectionCount" >13</attribute>
<attribute name="Sentiment" >-0.3909091008</attribute>
<attribute name="Sentiments" >-0.6;-0.8;0.2;-0.8;0.4;-0.2;-0.6;-0.8;-0.8;-0.6;-0.4;0.2;-0.4;-0.2;-0.8;-0.6;-0.4;-0.6;0.2;-0.2;-0.6;-0.2</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >123.5</attribute>
<attribute name="Ypos" >0</attribute>
<text >// This stamp will remove a set of outbound links from the referenced
// source note (i.e., “this”). $MyDictionary(this) will indicate the 
// links to be removed with entries of the form:
//   destination_ID:link_Types
// The link_Types can be a single type, or a set of link types when
// there are parallel links between the same source and destination notes. 
// 
// The number of links removed will be captured in $MyNumber(this)

var:boolean debug=false;
var:string  logbook=&quot;Debug—RemoveLinkSet&quot;;

$MyNumber=0; // Initialize count of links removed
$MyDictionary.keys.each(destinationID)
{ // Remove outbound link(s) to “destinationID”
  $MyDictionary[destinationID].each(linkType)
  { // Process each Link Type in case of parallel links
    if(debug){LogRec(logbook,&quot;--&gt; UnLink From &quot;+$ID+&quot; to &quot;+destinationID
       +&quot; with type: &quot;+linkType);};
    unlinkTo(destinationID,linkType);
    $MyNumber+=1;
    if(debug){LogRec(logbook,&quot;--&gt; # outbound links removed: &quot;+$MyNumber);};
  }; // End loop for parallel links
}; // End each link destination loop
</text>
