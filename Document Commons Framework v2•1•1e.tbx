<item ID="1744596602" Creator="Chuck Wade" proto="Function" >
<attribute name="Created" >2022-01-16T11:17:15+09:00</attribute>
<attribute name="DisplayedAttributes" >Creator;Created;Modified;MyBoolean;MyList;MyNumber;MySet;MyString;Prototype;ReadOnly;SmartQuotes</attribute>
<attribute name="Height" >1.86</attribute>
<attribute name="HideDisplayedAttributes" >false</attribute>
<attribute name="Modified" >2025-04-04T19:13:36+09:00</attribute>
<attribute name="MyString" >A test log entry</attribute>
<attribute name="NLNames" >Log Entry</attribute>
<attribute name="NLOrganizations" >LogBooks Container;LogRec</attribute>
<attribute name="Name" >Record Log Entry</attribute>
<attribute name="SafePath" >/Hints/Library/Record Log Entry</attribute>
<attribute name="SelectionCount" >354</attribute>
<attribute name="Sentiment" >-0.4223684301</attribute>
<attribute name="Sentiments" >-0.6;-0.6;0;-0.6;-0.8;0.8;-0.8;-0.4;-0.4;0.4;-0.6;-0.6;-0.6;0.4;-0.8;-0.4;-0.2;-0.8;-0.4;-0.8;-0.8;-0.4;0;0.2;-0.8;-0.6;-0.6;-0.4;-0.8;-0.8;-0.4;-0.2;0;-0.8;-0.6;-0.6;-0.4;0;-0.6;-0.2;-0.4;-1;-0.4;-0.8;-0.8;0.6;-0.8;-0.4;-0.8;-0.8;-0.2;-1;-1;0.2;-0.8;-0.6;-0.8;-0.8;-0.8;-0.8;-0.8;-0.6;-0.2;-0.4;-0.2;-0.6;-0.8;-0.2;-0.4;1;-0.4;0.2;-0.6;-0.6;-0.6;-1;-0.4;0;-0.6;0.2;0;0.2;-0.8;0.4;-0.2;-0.8;0.4;0.2;-1;0.2;0.2;-0.2;-0.6;0.2;-0.4;-0.2;-0.2;-0.2;-0.2;-0.6;-0.8;-0.4;-0.2;-0.2;-0.2;-0.4;-0.6;0;-0.6;-0.4;-0.8;-0.4;-0.8;-0.8;-0.8;-0.8;-0.6;-0.6;-0.8;-1;-0.2;0.2;-0.6;-0.8;-0.8;-0.6;-0.8;0;-0.4;-0.4;-0.8;-0.2;-0.6;0.4;-0.8;-0.2;-0.8;0.4;-0.8;-0.4;0;0;0;-0.6;-0.6;-0.6;-0.6;-0.4;-0.6;-0.6;-0.8;-0.6</attribute>
<attribute name="TextWindowHeight" >1380</attribute>
<attribute name="TextWindowWidth" >1099</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >-24.5</attribute>
<attribute name="Ypos" >0</attribute>
<text >// The LogRec function can be called from any Action code to
// write a new log entry into the indicated log book.
// A container with the standard name of “LogBooks” is kept in
// the “Document Commons” container, which should be the last
// top-level note in the Tinderbox document (in outline order).
// The “LogBooks” container is itself used for several attributes
// used globally for controlling the behavior of logging actions.
// (See the note at the end of this function for further details
// on how LogBooks is found in the “Document Commons” container.)
//
// Input arguments are:
// • logbook: Name of logbook Note where log entry will be recorded.
//     However, if logbook Note does not already exist, it will be
//     automatically created and initialized. If appending new
//     log records to an existing logbook, then the logbook argument
//     must match the $Name value for the logbook Note.
// • log_entry: A text string that will be recorded in the logbook. 
//     If the log_entry string starts with &lt;&lt;option&gt;&gt;, then the option
//     string will be used to perform some optional logging 
//     behavior. Whatever follows the &lt;&lt;option&gt;&gt; will be used as 
//     the log record entry. For example, if the log_entry argument is:
//       &lt;&lt;mark&gt;&gt;Some log entry text
//     then the option is “mark” and the log entry text will be 
//     “Some log entry text”
// Output argument returned will be the date/time that the LogRec
//   function was called. This can be used with the “end” option to
//   log elapsed execution time.
//
// Currently defined options are:
// • blank: Record a blank (empty) line in target logbook. Any log_entry text 
//     following the &lt;&lt;blank&gt;&gt; option will be ignored.
// • mark: Produce a special bookmark log entry. This will be followed by
//     the log_entry text provided after &lt;&lt;mark&gt;&gt;.
// • start: Produce a special log entry similar to a bookmark, but 
//     indicating the start of some block of code.
// • end: This option expects that the log_entry text following &lt;&lt;end&gt;&gt; will
//     be a date/time stamp from a prior starting point. The log entry
//     will include the elapsed time from the provided start time to now.
// 

function LogRec(logbook,log_entry)
{
  // Declare variables used to reference logbooks and assemble entries
  var:number   log_container; // Obtain $ID for “LogBooks” container
               log_container=$MyDictionary(lastSibling(cover))[&quot;LogBooks&quot;];
  var:string   log_dest; // Construct path string to target logbook
               log_dest=$Path(log_container)+&quot;/&quot;+logbook;
  var:string   log_prepend=&quot;&quot;; // Used to assemble text prepended to log entry
  var:string   option=&quot;&quot;; // Capture any option supplied with log_entry argument
               option=log_entry.extract(&quot;^&lt;&lt;(.+)&gt;&gt;&quot;);
  var:date     start_time; // Used in computing elapsed time with &lt;&lt;end&gt;&gt; option
  var:interval elapsed_time; // elapsed time reporting with &lt;&lt;end&gt;&gt; option
  var:date     time_stamp;  // Used in time/date stamping log records &amp; return value
               time_stamp=date(now); // Capture current date/time as of “now”
  // For Tinderbox versions 9.2 or earlier, this command adds in current seconds
  //time_stamp.second=runCommand(&quot;date &apos;+%S&apos;&quot;); // Remove this for Tbx 9.2.2b561 or later!

  // If global logging is disabled, then do nothing and return
  if (!$LoggingEnabled(log_container)){return(time_stamp);};

  // Post the current date and time with seconds into LogBooks Container
  $MyDate(log_container)=time_stamp;

  // If the supplied logbook does not exist, create and initialize it.
  // Note that the current log settings from the “LogBooks” container
  // will be copied to the new log book. This means that these settings
  // remain in effect, even if they are subsequently changed in the
  // master “LogBooks” container. However, if the settings are changed
  // in the created log book, then these settings will override the 
  // settings from the “LogBooks” container.

  if (!$ID(log_dest))
  { create(log_dest);
    $Prototype(log_dest)=&quot;Log Book&quot;;
    $Text(log_dest)=; // Revert $Text to default
    // Place an initial record of logbook creation in $Text
    $Text(log_dest)=&quot;Log book &lt;&quot;+logbook+&quot;&gt; created &quot;
      +time_stamp.format(&quot;*&quot;)+&quot; Tbx ver: &quot;+version()+&quot;\n&quot;;
    // Initialize new logbook to have logging enabled
    $LoggingEnabled(log_dest)=true;
    // Copy current state of log record prepending controls from LogBooks Container
    $IndexLogs(log_dest)=$IndexLogs(log_container);
    $DatestampLogs(log_dest)=$DatestampLogs(log_container);
    $TimestampLogs(log_dest)=$TimestampLogs(log_container);
  };
  // If destination log book has logging disabled, then do nothing
  if (!$LoggingEnabled(log_dest)){return(time_stamp);};

  // Increment the global Index Sequence for log entries 
  $MyNumber(log_container)+=1;

  if (!option.empty)
  { // If option provided, then perform optional log operation…
    // First, remove option from front of log_entry argument
    log_entry=log_entry.extract(&quot;^&lt;&lt;.*&gt;&gt;(.*)&quot;);
    //
    if (option==&quot;blank&quot;)
    { // Then place a blank (empty) line in logbook…
      log_prepend=&quot; &quot;;
      log_entry=&quot;&quot;; // Clear any supplied log_entry text following “blank” option
      // Decrement index (i.e., don&apos;t count this log record)
      $MyNumber(log_container)-=1;
    } else
    { if (option==&quot;mark&quot;)
      { // Then record a special bookmark log record…
        log_prepend=&quot;***** Bookmark @ Index=&quot;
          +$MyNumber(log_container).format(0,5,&quot;0&quot;)+&quot; | &quot;
          +time_stamp.format(&quot;Y-M0-D h:mm:s&quot;)
          +&quot; ***** &quot;;
      } else
      { if (option==&quot;start&quot;)
        { // Then record a special start log record…
          log_prepend=&quot;##### Start @ Index=&quot;
            +$MyNumber(log_container).format(0,5,&quot;0&quot;)+&quot; | &quot;
            +time_stamp.format(&quot;Y-M0-D h:mm:s&quot;)
            +&quot; ##### &quot;;
        } else
        { if (option==&quot;end&quot;)
          { // Then record a special stop log record…
            start_time=date(log_entry);
            //elapsed_time=interval(date(start_time),date(time_stamp));
            elapsed_time=interval(start_time,time_stamp);
            log_prepend=&quot;#####   End @ Index=&quot;
              +$MyNumber(log_container).format(0,5,&quot;0&quot;)+&quot; | &quot;
              +time_stamp.format(&quot;Y-M0-D h:mm:s&quot;)+&quot; ##### | Elapsed time = &quot;
              +((24*elapsed_time.day)+elapsed_time.hour).format(0,2,&quot;0&quot;)
              +&quot;:&quot;+elapsed_time.minute.format(0,2,&quot;0&quot;)
              +&quot;:&quot;+elapsed_time.second.format(0,2,&quot;0&quot;);

            log_entry=&quot;&quot;; // Clear log_entry so that start time doesn’t display
          } else
          { // No recognized option, so report error…
            log_prepend=&quot;***** Error: &lt;&lt;&quot;+option+&quot;&gt;&gt; not recognized ***** &quot;;
          }; // End if end-option
        }; // End if start-option
      }; // End if mark-option
    }; // End if blank-option
  } else 
  { // Record a normal log entry…
    // Prepend the Index sequence number if Indexing is enabled either
    // in the LogBooks container or the specific destination log book
    if ($IndexLogs(log_dest))
    { log_prepend=$MyNumber(log_container).format(0,5,&quot;0&quot;)+&quot; &quot;;
    };
    // Prepend Date stamp if enabled in either the LogBooks container or
    // the specific destination log book
    if ($DatestampLogs(log_dest))
    { log_prepend+=time_stamp.format(&quot;Y-M0-D &quot;);
    };
    // Prepend Time stamp if enabled in either the LogBooks container or
    // the specific destination log book
    if ($TimestampLogs(log_dest))
    { log_prepend+=time_stamp.format(&quot;h:mm:s &quot;);
    };
  }; // End If-Then-Else sequence to assemble log_prepend

  // Append new log record to the $Text of the supplied log book note
  if (log_prepend.size&gt;1 &amp; log_entry.size&gt;1){log_prepend+=&quot;| &quot;;};
  $Text(log_dest)+=log_prepend+log_entry+&quot;\n&quot;;
  return(time_stamp);
};

// This function requires Tinderbox version 9.1 or later
// No other functions are called.
// Note that the “LogBooks” container is referenced via the $MyDictionary
// attribute in the “Document Commons” container. However, users are able
// to change the name—“Document Commons”—to whatever they want, since this
// is referenced as the last top-level Note in outline order. An Edict 
// for this container builds and maintains $MyDictionary to provide a 
// lookup for named descendants of the “Document Commons” container. The
// Rule for this container ensures that it remains the last top-level Note.

</text>
