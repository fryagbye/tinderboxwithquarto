<attribute name="ReadOnly" >true</attribute>
<attribute name="SafePath" >/Hints/Stamps/Safe Paths:Construct $SafePath for Note</attribute>
<attribute name="SelectionCount" >82</attribute>
<attribute name="Sentiment" >-0.5500000082</attribute>
