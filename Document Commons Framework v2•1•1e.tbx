<item ID="1744596494" Creator="Chuck Wade" proto="Function" >
<attribute name="Created" >2025-03-03T14:08:42+09:00</attribute>
<attribute name="DisplayedAttributes" >ReadOnly</attribute>
<attribute name="Height" >1.86</attribute>
<attribute name="Modified" >2025-03-03T15:06:14+09:00</attribute>
<attribute name="NLNames" >Diagram</attribute>
<attribute name="Name" >Diagram:Add Notes to Active Diagram</attribute>
<attribute name="ReadOnly" >true</attribute>
<attribute name="SelectionCount" >35</attribute>
<attribute name="Sentiment" >-0.5857142955</attribute>
<attribute name="Sentiments" >-1;-1;-0.6;-0.8;-0.8;-0.2;-0.4;0;-0.6;-0.8;-0.8;-0.6;-0.8;0.2</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >95</attribute>
<attribute name="Ypos" >0</attribute>
<text >// This stamp assumes that the user has previously set an 
// Active Diagram using the “Diagram:Set Active Diagram” stamp.
// When invoked, this stamp will then add whatever note or
// notes are currently selected to the Active Diagram. 
// This allows adding notes to a diagram in a bulk manner.

var:number diagramSettings; 
var:number activeDiagram;

// First, get $ID of currently active Diagram from “Diagram Settings”
diagramSettings=GetCommonsItemID(&quot;Global Settings&quot;);
diagramSettings=$ID($Path(diagramSettings)+&quot;/Diagram Settings&quot;);
activeDiagram=$MyNumber(diagramSettings); // Diagram where notes will be added

// Now add selected note to active Diagram
createLink(this,activeDiagram,&quot;Diagram←Note&quot;);
</text>
