<attrib Name="User" parent="anything" editable="0" visibleInEditor="1" lines="1" default="" >
<attrib Name="LoggingEnabled" parent="User" editable="1" visibleInEditor="1" lines="1" type="4" description="If false, logging is disabled. If true, then logging may be enabled. 







































" default="false" >
</attrib>
<attrib Name="IndexLogs" parent="User" editable="1" visibleInEditor="1" lines="1" type="4" description="If true, prepend each log record with the current index number. For the LogRec function, the current index is maintained in $MyNumber for the “LogBooks” container that normally resides in the document&apos;s commons area.






































" default="false" >
</attrib>
<attrib Name="DatestampLogs" parent="User" editable="1" visibleInEditor="1" lines="1" type="4" description="If true, place a datestamp in each log record. Note that this only controls date entries; see &quot;TimestampLogs&quot; to control whether times are included in log records.














" default="false" >
</attrib>
<attrib Name="TimestampLogs" parent="User" editable="1" visibleInEditor="1" lines="1" type="4" description="If true, place a timestamp in each log record. Note that this only controls time entries; see DatestampLogs to control whether dates are included in log records.








































" default="false" >
</attrib>
<attrib Name="SafePath" parent="User" editable="1" visibleInEditor="1" lines="1" description="This is the “safe” or “cleansed” version of the absolute path to the note or container. If notes/containers might have problematical characters, such as slashes, then absolute references should use this string instead of $Path. Note that the stamp “Safe Paths:Construct $SafePath for Note” can be used to update $SafePath for the selected Note. Also, the function “ConstructSafePath2Note(note)” will update $SafePath for the note supplied as the argument.






































" default="" >
</attrib>
<attrib Name="DiagramAttributesReflection" parent="User" editable="1" visibleInEditor="1" lines="4" type="8" description="This set is used to select which system attributes will be copied from a reflected note into its reflection in a Diagram. Individual reflection notes can change this set to select exactly which attributes should be copied for that reflection instance. 































" default="AccentColor;Badge;BadgeMonochrome;BadgeSize;Base;Bend;Border;BorderBevel;BorderColor;BorderDash;Caption;CaptionAlignment;CaptionColor;CaptionFont;CaptionOpacity;CaptionSize;ClusterTerms;Color;Direction;Flags;NameAlignment;NameBold;NameColor;NameFont;NameLeading;NameOpacity;NameStrike;NameVerticalAlignment;Opacity;Pattern;PlotColor;Shadow;ShadowBlur;ShadowColor;ShadowDistance;Shape;Stripe;StripeColor;Subtitle;SubtitleColor;SubtitleOpacity;SubtitleSize;TextBackgroundColor;Tip;TitleOpacity" >
</attrib>
<attrib Name="DiagramReflectionLocals" parent="User" editable="1" visibleInEditor="1" lines="1" type="8" suggested="AccentColor;Badge;BadgeMonochrome;BadgeSize;Base;Bend;Border;BorderBevel;BorderColor;BorderDash;Caption;CaptionAlignment;CaptionColor;CaptionFont;CaptionOpacity;CaptionSize;ClusterTerms;Color;Direction;Flags;NameAlignment;NameBold;NameColor;NameFont;NameLeading;NameOpacity;NameStrike;NameVerticalAlignment;Opacity;Pattern;PlotColor;Shadow;ShadowBlur;ShadowColor;ShadowDistance;Shape;Stripe;StripeColor;Subtitle;SubtitleColor;SubtitleOpacity;SubtitleSize;TextBackgroundColor;Tip;TitleOpacity" description="Attributes that should not be copied from the original Reflected note to a corresponding Reflection note are listed in this set. This allows select attributes to be decoupled from the original without having any impact on the original. For example, if &quot;Shape&quot; was included in this set, then the shape of a Reflection Object could be changed while the Reflected note retains its original shape.




































" default="" >
</attrib>
<attrib Name="Diagram_ID" parent="User" editable="1" visibleInEditor="1" lines="1" type="2" description="The $ID of a Diagram Container is used as a general reference to the diagram itself. $DiagramID is set for each child of a Diagram Container, and it can be used in managing multiple diagrams in a Tinderbox document.





































" default="0" >
</attrib>
<attrib Name="Reflected_ID" parent="User" editable="1" visibleInEditor="1" lines="1" type="2" description="Reflection object notes within a Diagram Container will keep the ID of the note they reflect in this attribute. If the reflected note is moved, $ReflectedID can be used to reference it no matter where it is relocated. Although the link from a reflection object note to the original reflected note can also provide access, some diagram maintenance activities may be easier to code using this attribute.


































" default="0" >
</attrib>
<attrib Name="Reflected_Notes" parent="User" editable="1" visibleInEditor="1" lines="3" type="13" description="This dictionary is maintained in a Diagram Container and used to lookup $ID for a reflection-object child in the diagram given the $ID of the reflected note. One use for this dictionary is periodically updating reflections and links and performing maintenance of a diagram&apos;s objects.





































" default="" >
</attrib>
<attrib Name="Reflected_LinkTypes" parent="User" editable="1" visibleInEditor="1" lines="2" type="8" description="A set of Link Types that are allowed to be displayed in a diagram are kept in this attribute. It defaults to the Tinderbox-defined set of Link Types, but it can be extended to include user-defined Link Types, or to exclude standard Tinderbox Link Types. This attribute is associated with Diagram Containers, and when links are reflected into a diagram, this set determines which links are allowed to be reflected.




































" default="agree;clarify;disagree;example;exception;note;response;update" >
</attrib>
<attrib Name="Reflected_Links" parent="User" editable="1" visibleInEditor="1" lines="1" type="13" description="A dictionary of all outbound, plain, visible links from the associated note. The dictionary key:value pairs are “destID:type” where “destID” is the $ID of the destination link and “type” is a list of link types. Normally, there will only be one member for the link type list, but it is possible to have multiple links between the same two notes as long as the link types are not the same. When a note is reflected into a Diagram container, then it will have this dictionary created automatically. Similarly, the associated “reflection note” in the Diagram will have a corresponding dictionary but only for links that are reflected into the Diagram, which means that the destIDs will be for reflection notes within the Diagram.













" default="" >
</attrib>
<attrib Name="IP_Address" parent="User" editable="1" visibleInEditor="1" lines="1" type="2" description="An integer representing an IPv4 address or mask. This is the preferred format for IP addresses when used with code or where information will be sorted by IP address.
" default="0" >
</attrib>
<attrib Name="IP_CIDR" parent="User" editable="1" visibleInEditor="1" lines="1" type="2" description="The integer representation of the CIDR designation for an IPv4 address or subnet. The value can only range between 0 to 32.
" default="24" >
</attrib>
<attrib Name="IP_DotQuad" parent="User" editable="1" visibleInEditor="1" lines="1" description="A string comprising an IP address expressed as a dotted quad with an optional CIDR designation appended after a forward slash.

" default="" >
</attrib>
<attrib Name="IP_Octets" parent="User" editable="1" visibleInEditor="1" lines="1" type="10" suggested="0" description="A list of the four numerical octets that comprise  an IP address with an optional fifth numerical element for the CIDR designation. 

" default="0;0;0;0" >
</attrib>
<attrib Name="MAC_Addr" parent="User" editable="1" visibleInEditor="1" lines="1" description="A string representing a standard IEEE 802.3 MAC address. Normally, this will be in canonical format with exactly 12 hex digits and no separators. However, any string representation of a MAC address can be used.

" default="" >
</attrib>
</attrib>
</attrib>
