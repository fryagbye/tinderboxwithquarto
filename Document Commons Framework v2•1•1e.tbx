<item ID="1746890361" Creator="Chuck Wade" proto="Function" >
<attribute name="Created" >2025-04-01T15:57:19+09:00</attribute>
<attribute name="DisplayedAttributes" >Creator;Created;Modified;MyBoolean;MyList;MyNumber;MySet;MyString;Prototype;ReadOnly;SmartQuotes</attribute>
<attribute name="Height" >1.86</attribute>
<attribute name="Modified" >2025-05-10T11:19:08+09:00</attribute>
<attribute name="NLNames" >Path</attribute>
<attribute name="Name" >Copy select attributes between two notes</attribute>
<attribute name="SelectionCount" >38</attribute>
<attribute name="Sentiment" >-0.4105263258</attribute>
<attribute name="Sentiments" >-0.2;-0.6;-0.6;-0.4;-0.6;-0.4;-0.4;0;-0.8;-0.2;-0.2;-0.4;-0.4;-0.8;-0.6;-0.6;-0.4;0;-0.2</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >-52.5</attribute>
<attribute name="Ypos" >0</attribute>
<text >// The CopyAttributesSet function takes three input parameters as follows:
//   src_note(string|number): Name, Path, or ID pointing to source note 
//     from where attribute values will be copied.
//   dst_note(string|number): Name, Path, or ID pointing to destination 
//     note where attribute values will be copied to. 
//   atr_set(set): A list of attribute names that will be copied from
//     source to destination (without ‘$’ prefix).

function CopyAttributeSet(src_note,dst_note,atr_set:set)
{ // Declare variables
  var:boolean debug=false; // If debug is true, issue log statements
  var:string  logbook=&quot;Debug—CopyAttributeSet&quot;; // Log Book name for debugging
  
  if(debug){LogRec(logbook,&quot;Input Parms: &quot;+src_note+&quot; | &quot;+dst_note+&quot; | &quot;+atr_set.count);};

  atr_set.each(atr_name)
  {  // if(debug){LogRec(logbook,&quot;atr_name: &quot;+atr_name);};
     action(&quot;$&quot;+atr_name+&quot;(&apos;&quot;+dst_note+&quot;&apos;)&quot;+&quot;=$&quot;+atr_name+&quot;(&apos;&quot;+src_note+&quot;&apos;)&quot;);
  }; // End atr_set.each loop
  return;

}; // End of “CopyAttributeSet” definition
</text>
