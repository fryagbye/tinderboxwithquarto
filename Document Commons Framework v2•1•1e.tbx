body{
    font-family: &quot;Ideal Sans Ssm Book&quot;,HelveticaNeue,Helvetica,Arial,sans-serif;
    margin-left: 7.5%;
    margin-right: 7.5%;
    line-height: 1.4;
    }
    
table {
    margin: 2em 0;
    font-size: 0.9em;
    border: 1px solid #888888;
}

td{
    padding: 0.5em;
    }

img{
    width: 100%;
}
    
