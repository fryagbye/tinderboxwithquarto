<attribute name="NLOrganizations" >IP</attribute>
<attribute name="Name" >Device: SSH capture</attribute>
<attribute name="SafePath" >/Hints/Stamps/Device: SSH capture</attribute>
<attribute name="ScreenWidth" >551</attribute>
<attribute name="SelectionCount" >9</attribute>
<attribute name="Sentiment" >-0.5375000108</attribute>
<attribute name="Sentiments" >-0.6;-1;-0.2;-0.8;-1;-0.6;-0.2;-0.6;0.2;-1;-0.6;-0.6;-0.4;-0.2;-0.6;-0.4</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >94.5</attribute>
<attribute name="Ypos" >-2.36</attribute>
<text >// This stamp will invoke a command on a remote system/device using SSH,
// and return the results in $Text. The start time will be stored in
// $StartDate, and execution elapsed time will be placed in $MyInterval.
// 
// The Stamped note should have these two Attribute assignments:
//   $SSH_Target: A string that provides either an IP address or a domain
//     name for the target system/device. This will be used as the
//     destination for the SSH command. Note that use of SSH keys is 
//     strongly recommended, though a userid and password could be 
//     passed directly via this attribute if security is not a concern.
//   $MyString: The actual command to be invoked by the remote system/device.
//     
$StartDate = date(now);
$Text += &quot;ssh &quot; + $SSH_Target + &quot; &apos;&quot; + $MyString+&quot;&apos;\n&quot;;
$Text += (runCommand(&quot;ssh &quot; + $SSH_Target + &quot; &apos;&quot; + $MyString+&quot;&apos;&quot;));
$MyInterval = interval($StartDate-date(now));</text>
