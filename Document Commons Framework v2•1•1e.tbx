<text >// Function to synchronize reflected links within a Diagram. 
// The function’s input argument is a name, path, or ID that is expected to be the 
// container for a Diagram. I.e., a container with “Diagram” as its prototype.
 
// When invoked, this function will examine each child note of the Diagram 
// container and then determine which links from the associated Reflected Note
// should be reflected into the Diagram. This will update all links within the
// Diagram, including creating new links when added to the user&apos;s main document
// as well as removing links that no longer exist or that should no longer be
// reflected. This function is included in the Edict for a Diagram container,
// which means it will execute every time the Diagram Container is selected. 
// It may also be executed whenever it is appropriate to update link reflections,
// including when notes are added to, or removed from, a Diagram.

// The value returned by this function indicates whether or not the function
// completed normally (return == 1) or if the supplied Diagram container does 
// not have its $Prototype == “Diagram”, then the returned value will be 
// minus 1 (-1); else a zero will be returned when there is nothing to do.

//--+----1----+----2----+----3----+----4----+----5----+----6----+----7----+----8

function UpdateDiagramLinks(diagram)
{ // Define debug &amp; logbook variables
  var:boolean    debug=false;
  var:string     logbook=&quot;Debug—UpdateDiagramLinks&quot;;
  if(debug){LogRec(logbook,&quot;&lt;&lt;blank&gt;&gt;&quot;);};
  if(debug){LogRec(logbook,&quot;&lt;&lt;mark&gt;&gt;&quot;);};

  // Is this a Diagram Container? If not, return -1 error.
  if($Prototype(diagram)!=&quot;Diagram&quot;)
  { if(debug){LogRec(logbook,&quot;Supplied parameter does not point to a Diagram Container&quot;);};
    return -1; // Not a Diagram, so return -1 status
  };
  // Gather children of Diagram Container that are Reflection Notes
  var:number     diagramID=$ID(diagram); // Absolute reference to Diagram
  var:list       reflectionObjects=collect_if(children(diagramID),$Prototype==&quot;Reflection Object&quot;,$ID);
  // If there are no Reflection Objects in Diagram Container, return 0
  if(reflectionObjects.count==0)
  { if(debug){LogRec(logbook,&quot;There are no Reflection Notes in Diagram Container&quot;);};
    return 0; // Nothing to do, so return 0 status
  };

  // Define other function variables
  var:number     counts=;             // Collect counts for removed links
  var:number     reflectedID;         // $ID of note reflected by Diagram child note
  var:set        allowedLinkTypes;    // Set of link types displayed in Diagram
  var:number     reflectionKey;       // Lookup key to find Reflection Object ID
  var:dictionary reflectionLinks={};  // Links reflected into Diagram
  var:set        reflectionLinkTypes; // Set of type(s) for source-dest link(s)
  var:set        parallelLinkTypes;   // Set of Parallel outbound link types

  if(debug){LogRec(logbook,&quot;Diagram Name: &quot;+$Name(diagram)+&quot; with &quot;+reflectionObjects.count+&quot; Reflection Notes&quot;);};

  reflectionObjects.each(reflectionID)
  { // For each Diagram child with Prototype of “Reflection Object,” do...
    reflectionLinks={}; // Clear dictionary of Reflection Links
    reflectedID=$Reflected_ID(reflectionID); // Get Reflected_ID from current child
    if(debug){LogRec(logbook,&quot;&lt;&lt;blank&gt;&gt;&quot;);};
    if(debug){LogRec(logbook,&quot;***Reflection Note: &quot;+reflectionID
      +&quot; reflects from: &quot;+reflectedID+&quot; named: &quot;+$Name(reflectedID));};

    // Capture dictionary of candidate links for reflection into Diagram
    $Reflected_Links(reflectedID)=CaptureOutboundPlainLinks(reflectedID);
    if(debug){LogRec(logbook,&quot;Candidate reflection links: &quot;+$Reflected_Links(reflectedID));};

    // The following if-then/else is the primary link processing branch.
    // If there are no outbound links from the Reflected Note in the main 
    // document, then any links that were reflected should be removed.
    // Else, determine which outbound links should be reflected, and process
    // accordingly, removing any that should no longer be reflected.

    if($Reflected_Links(reflectedID).empty)
    { // Then no outbound links should be reflected for Reflection Object
      if(!$Reflected_Links(reflectionID).empty)
      { // If there are existing outbound reflection links,
        // then remove them.
        counts=RemoveLinkSet(reflectionID,$Reflected_Links(reflectionID));
        if(debug){LogRec(logbook,counts+&quot; reflection link(s) removed&quot;);};
        // Clear the $Reflected_Links dictionary in the Reflection Object Note
        $Reflected_Links(reflectionID)={};
      }; // Endif existing outbound links to be removed
    } 
    else // There are links to be reflected
    { // This else branch provides the primary link reflection logic that
      // determines whether any outbound links from the Reflected Note
      // meet the criteria to be reflected into the Diagram. It then 
      // processes each link reflection creating any that are not currently
      // in the Diagram, and removing any that should no longer be reflected.

      // First, get the appropriate list of allowed link types
      if($Reflected_LinkTypes(reflectionID).empty)
      { // If Reflection Object does not have its own link types list,
        // then use the Diagram&apos;s list of allowed types
        allowedLinkTypes=$Reflected_LinkTypes(diagramID);
      } else
      { // otherwise, use local list from Reflection Object
        allowedLinkTypes=$Reflected_LinkTypes(reflectionID);
      }; // Endif which list of allowed link types
      if(debug){LogRec(logbook,&quot;Allowed Link Types: &quot;+allowedLinkTypes);};
    
      // Evaluate each candidate link for potential reflection into Diagram
      $Reflected_Links(reflectedID).keys.each(candidateDest)
      { // Prune any links to notes that are not reflected in Diagram
        if(!$Reflected_Notes(diagramID)[candidateDest])
        { // If candidate link destination not in Diagram,
          // then remove this destination.
          if(debug){LogRec(logbook,&quot;Remove candidate link: &quot;+candidateDest);};
          $Reflected_Links(reflectedID)-=candidateDest;
        } else
        { // candidate link destination is reflected into Diagram
          parallelLinkTypes=$Reflected_Links(reflectedID)[candidateDest];
          if(debug&amp;parallelLinkTypes.count&gt;1){LogRec(logbook,&quot;Parallel Link Types: &quot;+parallelLinkTypes);};
          parallelLinkTypes.each(linkType)
          { // Prune any links with type not allowed in Diagram
            if(!allowedLinkTypes.contains(linkType))
            { // If candidate link type is not in Diagram&apos;s allowed list of link types,
              // then remove this destination.
              if(debug){LogRec(logbook,&quot;Remove candidate link of type: &quot;+linkType);};
              parallelLinkTypes-=linkType
            }; // Endif check for link types allowed in Diagram
          }; // End parallel Link Types loop
          if(parallelLinkTypes.empty)
          { // No links to reflect, so remove link destination
            $Reflected_Links(reflectedID)-=candidateDest;
          } else
          { // Update set of Link Types to be reflected for destination
            $Reflected_Links(reflectedID)[candidateDest]=parallelLinkTypes;
          }; // Endif no link types; else update parallel link type set
        }; // Endif check for Links in Diagram
      }; // End loop pruning out links that will not be reflected

      // At this point, $Reflected_Links(reflectedID) will include only links that 
      // should be reflected into Diagram.
 
      if(debug){LogRec(logbook,&quot;&lt;&lt;blank&gt;&gt;&quot;);};
      if(debug){LogRec(logbook,&quot;Links to be reflected: &quot;+$Reflected_Links(reflectedID));};

      // There are either no links to be reflected, in which case any links
      // already in the diagram should be removed, or there are links to be
      // reflected. Any existing Diagram links should either be kept if still
      // allowed, or removed if no longer included in pruned $Reflected_Links
      // dictionary. Any new link reflections should be created.

      if($Reflected_Links(reflectedID).empty)
      { // Then no outbound links should be reflected for Reflection Object
        if(!$Reflected_Links(reflectionID).empty)
        { // If there are existing outbound reflection links,
          // then remove them.
          counts=RemoveLinkSet(reflectionID,$Reflected_Links(reflectionID));
          if(debug){LogRec(logbook,counts+&quot; reflection links removed&quot;);};
          $Reflected_Links(reflectionID)={};
        }; // Endif existing outbound links to be removed
      } 
      else // Proceed to reflect links into Diagram for current reflection object
 
      { // Map Reflected Link destinations to corresponding Diagram Reflection Notes
        
        $Reflected_Links(reflectedID).keys.each(reflectedLinkDestID)
        { // Build new dictionary of Reflection Links
          // %%% This code should handle parallel link types since the set will be copied %%%
          reflectionKey=$Reflected_Notes(diagramID)[reflectedLinkDestID];
          if(debug){LogRec(logbook,&quot;Reflected link destID: &quot;+reflectedLinkDestID
             +&quot; maps to &quot;+reflectionKey+&quot; with type &quot;+$Reflected_Links(reflectedID)[reflectedLinkDestID]);};
          // Update reflectionLinks dictionary with Diagram&apos;s {destID:type}
          reflectionLinks[reflectionKey]=$Reflected_Links(reflectedID)[reflectedLinkDestID];
          if(debug){LogRec(logbook,&quot;Reflection links: &quot;+reflectionLinks);};
        }; // End loop to map Reflected Links to Diagram Reflection Objects

        // The “reflectionLinks” dictionary now specifies exactly which links
        // should be reflected into the Diagram by creating links between 
        // reflection objects that reside in the Diagram. Only the links in the
        // “reflectionLinks” dictionary should be reflected into the Diagram,
        // and any existing links not in this dictionary need to be removed.

        // Note: “$Reflected_Links” represents the prior set of reflected links
        // for the Diagram Reflection Object (i.e., “reflectionID”) currently 
        // having its reflection links updated. The “reflectionLinks” dictionary
        // indicates what the revised set of links should be. As each valid link
        // to a Diagram reflection object is either created or left as is, then 
        // the corresponding destination entry will be removed from the
        // $Reflected_Links dictionary. Any link references remaining after
        // processing the “reflectionLinks” dictionary should be removed,
        // as they no longer have corresponding links in the main document.

        // Determine if any new links need to be reflected into Diagram
        reflectionLinks.keys.each(reflectionLinkDestID)
        { // For any link source-dest pair not already reflected into Diagram

          if(!$Reflected_Links(reflectionID).contains(reflectionLinkDestID))
          { // If reflection link does not exist, then create it.
            if(debug){LogRec(logbook,&quot;Create link from: &quot;+reflectionID+&quot; to &quot;
              +reflectionLinkDestID+&quot; of type(s) &quot;+reflectionLinks[reflectionLinkDestID]);};
            // Handle case where there are parallel links between source-dest 
            reflectionLinks[reflectionLinkDestID].each(linkType)
            { // Create reflection link for each link type for source-dest pair
              createLink(reflectionID,reflectionLinkDestID,linkType);
            }; // End loop for link types
          } 
          else // At least one link for source-dest link pair already exists
          { // Handle case where link type might be incorrect or missing

            // Get current link type(s) list for existing reflection link
            reflectionLinkTypes=$Reflected_Links(reflectionID)[reflectionLinkDestID];

            reflectionLinks[reflectionLinkDestID].each(linkType)
            { // For parallel links of different types between same two notes
              // Check to see if each type has been reflected 
              if(!reflectionLinkTypes.contains(linkType))
              { // If link with indicated link type does not exist, then create it
                if(debug){LogRec(logbook,&quot;Create link from: &quot;+reflectionID+&quot; to &quot;
                  +reflectionLinkDestID+&quot; of type &quot;+linkType);};
                createLink(reflectionID,reflectionLinkDestID,linkType);
              }
              else
              { // Link already exists, so remove type from set
                if(debug){LogRec(logbook,&quot;Pruned linkType list: &quot;+reflectionLinkTypes);};
                reflectionLinkTypes-=linkType;
              }; // Endif link does not already exist, else prune
            }; // End loop for parallel link types
            if(reflectionLinkTypes.empty)
            { // If all parallel links accounted for, remove link dest entry
              $Reflected_Links(reflectionID)-=reflectionLinkDestID;
            } else
            { // Update entry for link destination so remaining link type(s)
              // will be later removed
              $Reflected_Links(reflectionID)[reflectionLinkDestID]=reflectionLinkTypes;
            }; // Endif link types accounted for; else remainder to be removed
          }; // Endif link doesn&apos;t exist; else does exist
        }; // End loop to create any new links

        // Since all links that should be reflected into Diagram either
        // already exist, or have been created, any link entries remaining
        // in “Reflected_Links” should now be removed
        if(debug){LogRec(logbook,&quot;Updated $Reflected_Links: &quot;+$Reflected_Links(reflectionID));};
         
        counts=RemoveLinkSet(reflectionID,$Reflected_Links(reflectionID));
        if(debug){LogRec(logbook,counts+&quot; remaining reflection link(s) removed&quot;);};

        // Update “$Reflected_Links” dictionary for current reflection object
        $Reflected_Links(reflectionID)=reflectionLinks;
        if(debug){LogRec(logbook,&quot;Updated links for: &quot;+reflectionID
          +&quot; =&gt; &quot;+$Reflected_Links(reflectionID));};
      }; // Endif no pruned links to be reflected; else update link reflections
    }; // Endif no main doc links to reflect, else reflect links into Diagram
  }; // End main loop for all Diagram Reflection Objects
  return 1; // Normal execution, so return 1
}; // End of “UpdateDiagramLinks” function definition

// This function calls the following functions:
//   CaptureOutboundPlainLinks
//   RemoveLinkSet
//   LogRec

//--+----1----+----2----+----3----+----4----+----5----+----6----+----7----+----8
// Notes:
// (1) This function is both long and quite complex in terms of the 
//     processing logic. It should probably be broken up into smaller
//     modules, but there is no obvious factoring approach. There is
//     also some benefit to dealing with all the conditions associated
//     with link reflections in one code file. That said, in a future
//     version, it is likely that this will be reworked.
// (2) One new User Attribute, “$Reflected_Links,” has been added to 
//     facilitate link reflection management. This Attribute maintains
//     for each Diagram Reflection Object the current set of links 
//     that have been reflected into the Diagram for that Object.
</text>
