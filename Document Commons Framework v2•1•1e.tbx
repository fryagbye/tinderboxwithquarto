<text >// Action code for OnRemove for Diagram Containers

// When a note is removed from a diagram, whether by moving it elsewhere
// or by deleting it, then this code will handle cleanup operations.

var:boolean debug=false; // If debug is true, issue log statements
var:string  logbook=&quot;Debug—OnRemove Diagram Object&quot;; // Log Book name for debugging

// Execute If $Name is not this code note, else don&apos;t do anything
if($Name!=&quot;OnRemove «Diagram Object Note»&quot;)
{ // Execute code when properly invoked
  if(debug){LogRec(logbook,&quot;&lt;&lt;blank&gt;&gt;&quot;);};
  if(debug){LogRec(logbook,&quot;&lt;&lt;mark&gt;&gt;&quot;);};
  if(debug){LogRec(logbook,&quot;Removal of &quot;+$Name+&quot; from &quot;+$Name($Diagram_ID));};

  // If this is a Reflection Object being removed…
  if($Prototype==&quot;Reflection Object&quot;)
  { // Then perform cleanup on Diagram Container
    var:number  removedID=$ID;
    var:number  diagramID=$Diagram_ID;
    // Remove link to Diagram Container from Reflected Note
    $MyNumber($Diagram_ID)=$Reflected_ID;
    $MyString($Diagram_ID)=&quot;Diagram←Note&quot;;
    if(debug){LogRec(logbook,&quot;UnLink From &quot;+$Reflected_ID+&quot; to &quot;+$Diagram_ID);};
    // Use stamp to invoke 3rd-party execution of UnLink operation
    stamp($Diagram_ID,&quot;Links:Remove Link From&quot;);
    // Delete key for reflected note associated with removed Reflection Object
    $Reflected_Notes(diagramID)-=$Reflected_ID;
    $Diagram_ID=0;
  } else
  { // Not a Reflection Object being removed
    if(debug){LogRec(logbook,&quot;Removal of Unreflected Object &quot;+$Name+&quot; from &quot;+$Diagram_ID);};
    $Diagram_ID=0;
  }; // Endif $Prototype test
} else
{ // This OnRemove Action was invoked erroneously (probably by editing code)
