<attribute name="Ypos" >-0.1</attribute>
<text >// This code should be assigned to the $OnPaste Action for the
// “Document Commons” container. This Note is the place to 
// maintain this code.

if(!$Checked)
{ // Skip execution if Checked
  require(&quot;Hints&quot;); require(&quot;Prototypes&quot;); require(&quot;Templates&quot;);
  if($Subtitle(lastSibling(cover))!=&quot;Document Commons&quot;)
  { // “Document Commons” container does not exist
    $MyBoolean(&quot;./Essentials&quot;)=false;
    $MyNumber(&quot;./Essentials&quot;)=$ID;
    $Checked(&quot;./Document Attributes&quot;)=true;
    $Name=$Subtitle;
    $RuleDisabled=false;
    $Checked=true;
    $EdictDisabled=false;
    $Color=&quot;bright blue&quot;;
  } else 
  { // There is already a “Document Commons” container
    $MyBoolean(&quot;./Essentials&quot;)=true;
    $MyNumber(&quot;./Essentials&quot;)=$ID(lastSibling(cover));
    $Name+=&quot; copy&quot;;
  };
  // Invoke Essentials Installer to complete installation
  $RuleDisabled(&quot;./Essentials&quot;)=false;
}; //Endif not Checked
</text>
