<item ID="1744657433" Creator="Charles Wade" proto="Function" >
<attribute name="Created" >2022-02-22T19:56:26+09:00</attribute>
<attribute name="Height" >1.86</attribute>
<attribute name="Modified" >2025-01-16T19:12:54+09:00</attribute>
<attribute name="NLOrganizations" >IP</attribute>
<attribute name="Name" >Convert IPv4 Integer to Octets List</attribute>
<attribute name="SafePath" >/Hints/Library/Convert IPv4 Integer to Octets List</attribute>
<attribute name="SelectionCount" >55</attribute>
<attribute name="Sentiment" >-0.4631579056</attribute>
<attribute name="Sentiments" >-0.6;-0.8;-0.4;-0.8;-0.6;-0.6;-0.4;-0.8;-1;-0.6;0;-0.8;0.8;0.4;-0.4;-0.2;-0.6;-0.6;-0.8</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >7</attribute>
<attribute name="Ypos" >2.36</attribute>
<text >// Convert an IP address expressed as a signed 32-bit integer
// into a List of four decimal octets.

function ip_integer2octets(ip_int)
{ // Declare List variable&amp; initialize to empty
  var:list ip_octets=&quot;&quot;;

  ip_octets=floor(ip_int/16777216);
  ip_int=ip_int-ip_octets[0]*16777216;
  ip_octets=ip_octets+floor(ip_int/65536);
  ip_int=ip_int-ip_octets[1]*65536;
  ip_octets=ip_octets+floor(ip_int/256);
  ip_int=ip_int-ip_octets[2]*256;
  ip_octets=ip_octets+ip_int;
 
  return(ip_octets);
};


// There are multiple algorithms for performing
// this conversion. The algorithm used here has 
// the advantage of being obvious. However, note
// that “ip_octets=ip_octets+...” adds a new member
// to the list, and is not an arithmetic operation.</text>
