<item ID="1744596764" Creator="Chuck Wade" proto="Stamp" >
<attribute name="Created" >2025-04-01T15:59:38+09:00</attribute>
<attribute name="DisplayedAttributes" >Creator;Created;Modified;MyBoolean;MyList;MyNumber;MySet;MyString;Prototype;ReadOnly;SmartQuotes</attribute>
<attribute name="Height" >5</attribute>
<attribute name="Modified" >2025-04-16T16:10:40+09:00</attribute>
<attribute name="NLOrganizations" >LogRec</attribute>
<attribute name="Name" >Links:Remove Link To</attribute>
<attribute name="SelectionCount" >28</attribute>
<attribute name="Sentiment" >-0.483333343</attribute>
<attribute name="Sentiments" >-0.8;-0.8;-1;0;-0.4;-0.6;-0.6;-0.4;0.4;-0.8;-0.2;-0.6</attribute>
<attribute name="Width" >5</attribute>
<attribute name="Xpos" >90</attribute>
<attribute name="Ypos" >0</attribute>
<text >// This stamp allows a third-party execution context to
// remove a link to a specified note from the Stamp&apos;s target.
// For this to work, the Stamp target (i.e., “this”) must have
// these attribute settings:
//   $MyNumber(target) contains the $ID of the to-note
//   $MyString(target) optionally provides the Link Type
//
// The third-party will set these attributes in the target,
// and then execute:
//    stamp(target,&quot;Links:Remove Link To&quot;);

// LogRec(StampLog,&quot;source: &quot;+$ID+&quot; dest: &quot;+$MyNumber+&quot; type: &quot;+$MyString);

unlinkTo($MyNumber,$MyString);</text>
