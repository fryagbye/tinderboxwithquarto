<text >// Purpose: Stub Installer for “Package Name” Add-on Package. 
// Before this Rule is enabled, the invoking Action should make the following
// assignments to this “Package Name” container:
//   $MyNumber:  ID of active “Document Commons” container (new or existing)
//   $MyString:  Path to InstallerLog where events/actions should be logged

if($Subtitle==&quot;Package Name&quot;)
{ // Install Add-on Package for “Package Name”
  // ID for where to log activity
  var:string   docCommonsPath=$Path($MyNumber); // Path to “Document Commons”
  var:number   installerLogID=$ID($MyString); // ID for where to log activity
  // Path and ID for Package Manifest
  var:string   manifestPath=docCommonsPath+&quot;/Packages/&quot;+$Name+&quot;/Manifest&quot;;
  var:number   manifestID=$ID(manifestPath);
  var:date     start_time=date(now); // Capture current date/time as of “now”
  var:interval elapsed_time; // Installation execution elapsed time

  // Record start of installation for Add-on Package “Package Name”
  $Text(installerLogID)+=&quot;\n@@@@@ Start Installation of “&quot;+$Name+&quot;” Package &quot;
    +start_time.format(&quot;Y-M0-D h:mm:s&quot;)+&quot; @@@@@\n&quot;
    +&quot;Manifest: &quot;+manifestID+&quot;:&quot;+manifestPath+&quot;\n&quot;;

  // ########################################################################
  // # Initialize and Execute Package&apos;s Manifest Installer action code      #
  // ########################################################################

  // Perform Installation
  action(manifestID,$Text(&quot;./Installer&quot;));

  // ########################################################################
  // # Wrap up installation of Package Items.                               #
  // ########################################################################

  $RuleDisabled=true; // Installation complete; Cease execution of this rule. 
  $RuleDisabled(&quot;../&quot;)=false; // Return control to Add-ons Installer

  elapsed_time=interval(start_time,date(now));
  $Text(installerLogID)+=&quot;@@@@@   End Installation of “&quot;+$Name+&quot;” Package &quot;
    +date(now).format(&quot;Y-M0-D h:mm:s&quot;)+&quot; @@@@@ | Elapsed time = &quot;
    +((24*elapsed_time.day)+elapsed_time.hour).format(0,2,&quot;0&quot;)
    +&quot;:&quot;+elapsed_time.minute.format(0,2,&quot;0&quot;)
    +&quot;:&quot;+elapsed_time.second.format(0,2,&quot;0&quot;)+&quot;\n&quot;;
  
} else
{ // This action code has been incorrectly invoked; exit gracefully

  $MyString=&quot;Bogus run&quot;;
  $RuleDisabled=true;
  $RuleDisabled(&quot;../&quot;)=false; // Return control to Add-ons Installer

}; // Endif check for proper execution from Package Installer

// Note: If this code is used as a template for setting up installation of some
// other Add-on Package, then perform a global replace of the string being 
// tested in the first executable statement at the beginning of this code with
// the name of the Package. I.e., if the code reads as:
//   if($Name==&quot;Package Name&quot;)
// globally replace “Package Name” with actual package’s name (without quotes).
// For special cases, it may be necessary to perform initialization prior to 
// executing Package’s Manifest Installer, or perform post-processing afterwards.

//--+----1----+----2----+----3----+----4----+----5----+----6----+----7----+----8</text>
