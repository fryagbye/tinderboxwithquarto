<attribute name="Sentiment" >-0.3666666759</attribute>
<attribute name="Sentiments" >-0.6;-0.8;-0.8;0;0;-0.6;-0.6;-0.4;0.4;-0.8;0.2;-0.4</attribute>
<attribute name="Width" >5</attribute>
<attribute name="Xpos" >98.5</attribute>
<attribute name="Ypos" >0</attribute>
<text >// This stamp allows a third-party execution context to
// remove a link from a specified note to the Stamp&apos;s target.
// For this to work, the Stamp target (i.e., “this”) must have
// these attribute assignments:
//   $MyNumber(target) contains the $ID of the from-note
//   $MyString(target) optionally provides the Link Type
//
// The third-party will set these attributes in the target,
// and then execute:
//    stamp(target,&quot;Links:Remove Link From&quot;);

// LogRec(StampLog,&quot;source: &quot;+$MyNumber+&quot; dest: &quot;+$ID+&quot; type: &quot;+$MyString);

unlinkFrom($MyNumber,$MyString);
</text>
