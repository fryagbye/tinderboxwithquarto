<item ID="1746887582" Creator="Chuck Wade" proto="Stamp" >
<attribute name="Created" >2025-03-03T13:26:13+09:00</attribute>
<attribute name="DisplayedAttributes" >Creator;Created;Modified;MyBoolean;MyList;MyNumber;MySet;MyString;Prototype;ReadOnly;SmartQuotes</attribute>
<attribute name="Height" >1.86</attribute>
<attribute name="HideDisplayedAttributes" >false</attribute>
<attribute name="Modified" >2025-03-27T13:51:19+09:00</attribute>
<attribute name="Name" >Diagram:Set Active Diagram</attribute>
<attribute name="ReadOnly" >true</attribute>
<attribute name="SelectionCount" >55</attribute>
<attribute name="Sentiment" >-0.5875000106</attribute>
<attribute name="Sentiments" >-0.4;-0.8;-0.2;-0.6;-0.6;-0.4;-0.8;-0.6;-0.8;-0.8;-0.2;-0.2;-0.8;-0.8;-0.4;-1</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >0</attribute>
<attribute name="Ypos" >0</attribute>
<text >// A simple stamp to establish a Diagram as a currently active
// work-in-progress. The idea is that some diagramming procedures
// will be automated to facilitate assembling a diagram and
// manipulating aspects of a diagram. 

var:number diagramSettings; 
if($Prototype(this)==&quot;Diagram&quot;)
{ // Then update “Diagram Settings” to point to (this) selection
  diagramSettings=GetCommonsItemID(&quot;Global Settings&quot;);
  diagramSettings=$ID($Path(diagramSettings)+&quot;/Diagram Settings&quot;);
  $MyString(diagramSettings)=$Path(this);
  $MyNumber(diagramSettings)=$ID(this);
  show(&quot;The active Diagram is now at “&quot;+$Path(this)+&quot;” with ID=&quot;+$ID(this),&quot;cyan&quot;,&quot;black&quot;);
} else
{ // This note is not a diagram; advise user…
  show(&quot;The selection is not a Diagram Container; Prototype must be “Diagram”&quot;,&quot;poppy&quot;,&quot;bright blue&quot;);
};
</text>
