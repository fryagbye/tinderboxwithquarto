<item ID="1744596539" Creator="Chuck Wade" proto="Function" >
<attribute name="Created" >2022-02-20T14:45:09+09:00</attribute>
<attribute name="DisplayedAttributes" >MyBoolean;MyList;MyNumber;MySet;MyString;Prototype;ReadOnly;SafePath;SmartLinks</attribute>
<attribute name="Height" >1.86</attribute>
<attribute name="Modified" >2025-01-06T22:13:30+09:00</attribute>
<attribute name="NLOrganizations" >IP;IP Subnet</attribute>
<attribute name="Name" >Network:Initialize IP Address Note</attribute>
<attribute name="ReadOnly" >true</attribute>
<attribute name="SafePath" >/Hints/Stamps/Network:IP quad to integer</attribute>
<attribute name="SelectionCount" >59</attribute>
<attribute name="Sentiment" >-0.5512195211</attribute>
<attribute name="Sentiments" >-0.8;-1;0;-0.6;-0.4;-1;-0.6;-0.4;-1;-0.8;-0.8;-0.8;-0.8;-0.8;-0.2;-0.4;-0.4;-0.8;-0.6;-0.8;-0.6;0.6;-0.8;0.2;0.2;-0.8;-0.8;-1;0;0;-0.8;-0.6;-0.8;-0.6;-0.6;0;-0.4;-0.4;-0.8;-0.8;-0.8</attribute>
