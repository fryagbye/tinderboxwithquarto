<attribute name="DominantLanguage" >en</attribute>
<attribute name="Edict" >// From $Text, construct a set of Attributes to be copied from
// a Reflected Note to a Reflection Note. This set can be easily
// updated by editing $Text. It can be pasted into Diagram objects
// or prototypes as desired.
$MySet=;
$Text.eachLine(sys_attr_name)
{ 
$MySet+=sys_attr_name;
};</attribute>
