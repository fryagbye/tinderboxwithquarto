<item ID="1744596618" Creator="Charles Wade" proto="Stamp" >
<attribute name="Created" >2022-03-19T21:51:59+09:00</attribute>
<attribute name="DisplayedAttributes" >Creator;Created;Modified;MyBoolean;MyList;MyNumber;MySet;MyString;Prototype;ReadOnly;SmartQuotes</attribute>
<attribute name="Height" >1.86</attribute>
<attribute name="Modified" >2022-06-25T12:06:40+09:00</attribute>
<attribute name="NLOrganizations" >LogRec</attribute>
<attribute name="Name" >Safe Paths:Update $SafePath for Document</attribute>
<attribute name="SafePath" >/Hints/Stamps/Safe Paths:Update $SafePath for Document</attribute>
<attribute name="SelectionCount" >92</attribute>
<attribute name="Sentiment" >-0.3076923146</attribute>
<attribute name="Sentiments" >-0.6;-1;-0.4;-0.4;0.2;0.4;0.4;0.2;-0.4;-0.4;-0.8;-0.6;-0.6</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >15.5</attribute>
<attribute name="Ypos" >0</attribute>
<text >// This Stamp will invoke the UpdateSafePaths() function for “root”
// The result will be that $SafePath will be updated for every 
// note within the current document.

// Define debug control and timestamp variables
var:boolean debug=true;
var:string logbook=&quot;PersistentLogBook&quot;;
var:date start_time;
var:date end_time;
var:string doc_root=&quot;/&quot;;

if(debug){start_time=LogRec(logbook,&quot;&lt;&lt;start&gt;&gt;Begin UpdateSafePaths for entire Document&quot;);};

UpdateSafePaths(doc_root);

if(debug){end_time=LogRec(logbook,&quot;&lt;&lt;end&gt;&gt;&quot;+start_time);};

</text>
</item>
</item>
