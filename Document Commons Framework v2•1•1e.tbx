<item ID="1744596632" Creator="Chuck Wade" proto="Action" >
<attribute name="Created" >2025-04-05T17:17:57+09:00</attribute>
<attribute name="DisplayedAttributes" >Subtitle;Creator;Created;Modified;MyBoolean;MyNumber;MyString;MyList;MySet;Prototype;SmartQuotes;ReadOnly</attribute>
