<attribute name="Sentiments" >-0.6;-0.2;-0.4;-1;-0.4;-0.4;-0.6;-0.6;0.2;-0.2;-0.8;-0.8;-0.4;0;-0.2;0;-0.8;-0.6;-0.6;-0.8;-0.6;-0.6;-0.6;-0.6;-0.4;-0.4;-0.4;-0.4;-0.4;-0.6;-0.8;-0.8;-0.6;-0.4;-0.6;-0.8;-0.8;-0.4;-0.8;-0.4;-0.4;-0.6;-0.6;0;-0.8;-0.6;-0.8;-0.8;-0.8;-0.8;-0.6;-0.6;-0.8;-0.4;-0.6;-0.6;-0.8;-0.4;-0.2;-0.4;0;-0.6;-0.8;-0.4;-0.4</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >3.5</attribute>
<attribute name="Ypos" >0</attribute>
<text >// Updates Diagram reflections of original notes by copying a select set
// of appearance-oriented attributes to each diagram reflection-object
// child note from the original reflected note.
// The only input parameter is a reference to the Diagram Container,
// which can be any valid path or ID. 

// To achieve the desired results, this function relies on data sets 
// maintained in the Diagram Container (accessed via input parameter)
// as well as within each reflection-object note. The data sets are:
//   $DiagramAttributesReflection(diagramID): A set of attributes to be
//      copied from the reflected note to the reflection-object. 
//   $DiagramAttributesReflection(reflectionID): If this set resides
//      in a child reflection-object, then this version will be used 
//      to copy attributes from the reflected note. This allows a
//      reflection-object to customize the way it reflects the original.
//   $DiagramReflectionLocals(reflectionID): This set is essentially an
//      exception list of attributes that must not be copied from the
//      reflected note. This allows a simple method for declaring that
//      a reflection-object overrides a particular appearance or other
//      type of attribute when reflecting the original note.

function UpdateDiagramReflections(diagram)
{ // Define debug &amp; logbook variables
  var:boolean debug=false;
  var:string  logbook=&quot;Debug—UpdateDiagramReflections&quot;;
  // Define other function variables
  var:number  diagramID=$ID(diagram);
  var:number  reflectedID; // $ID of note reflected by Diagram child note
  var:set     attributeCopySet; // Set of attributes to reflect

  if(debug){LogRec(logbook,&quot;&lt;&lt;blank&gt;&gt;&quot;);};
  if(debug){LogRec(logbook,&quot;&lt;&lt;mark&gt;&gt;&quot;);};
  if(debug){LogRec(logbook,&quot;Diagram Name: &quot;+$Name+&quot; with &quot;+$ChildCount+&quot; children&quot;);};

  collect_if(children(diagramID),$Prototype==&quot;Reflection Object&quot;,$ID).each(reflectionID)
  { // For each Diagram child with Prototype of “Reflection Object,” do...
    reflectedID=$Reflected_ID(reflectionID); // Get Reflected_ID from current child
    if($ID(reflectedID)!=reflectedID)
    { // Apparently, Reflected Note has been removed, so remove Reflection Object
      if(debug){LogRec(logbook,&quot;*****Reflected Note: &quot;+reflectedID+&quot; doesn’t exist; delete ID:&quot;+reflectionID);};
      delete(reflectionID);
      // Delete key for reflected note associated with removed Reflection Object
      $Reflected_Notes(diagramID)-=reflectedID;
    } else
    { // Reflected Note exists, so update
      if(debug){LogRec(logbook,&quot;*****Reflection Note: &quot;+reflectionID+&quot; reflects from &quot;+$Name(reflectedID));};
      // Get correct copy set for Attribute Reflections and prune as required
      if($DiagramAttributesReflection(reflectionID).empty)
      { // Use Attribute set from Diagram Container
        if(debug){LogRec(logbook,&quot;copy set from: &quot;+$Name(diagramID)+&quot; exclude: &quot;+$DiagramReflectionLocals(reflectionID));};
        // Prune attribute set using set of attributes that are local to reflection-object
        attributeCopySet=$DiagramAttributesReflection(diagramID).remove($DiagramReflectionLocals(reflectionID));
      } else 
      { // Use Attribute set from reflection-object child note
        if(debug){LogRec(logbook,&quot;copy set from: &quot;+$Name(reflectionID)+&quot; exclude: &quot;+$DiagramReflectionLocals(reflectionID));};
        // Prune attribute set using set of attributes that are local to reflection-object
        attributeCopySet=$DiagramAttributesReflection(reflectionID).remove($DiagramReflectionLocals(reflectionID));
      }; // Endif for establishing set of Attributes to copy
      // Update reflection by copying pruned set of attributes from the Reflected note
      if(debug){LogRec(logbook,&quot;Attributes to copy: &quot;+attributeCopySet);};
      CopyAttributeSet(reflectedID,reflectionID,attributeCopySet)
    }; // Endif Reflected Note does not exist; else does exist 

  }; // End Loop for Diagram Reflection Object notes
  return;
}; // End of “UpdateDiagramReflections” definition

// This function calls the following functions:
//   CopyAttributeSet
//   LogRec
</text>
