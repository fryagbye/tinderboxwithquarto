<text >// This function will remove a set of outbound links from the indicated
// source note. The first parameter passed to this function is a 
// reference to the source note from which the outbound links will be
// removed. The second parameter is a dictionary with entries of the form:
//   destination_ID:link_Types
// The link_Types can be a single type, or a set of link types when
// there are parallel links between the same source and destination notes. 
// 
// The number of links removed will be returned to the caller.

function RemoveLinkSet(src_note,links2Remove:dictionary)
{ // Define debug &amp; logbook variables
  var:boolean debug=false;
  var:string  logbook=&quot;Debug—RemoveLinkSet&quot;;
  var:number  removeCount=0; // Count of links removed

  if(debug){LogRec(logbook,&quot;&lt;&lt;blank&gt;&gt;&quot;);};
  if(debug){LogRec(logbook,&quot;Source Note: &quot;+$Name(src_note)+&quot; (&quot;
    +$ID(src_note)+&quot;) with &quot;+$OutboundLinkCount(src_note)
    +&quot; oubound links\n    links2Remove: &quot;+links2Remove);};
  if(links2Remove.empty)
  { // If no links to remove, do nothing
    if(debug){LogRec(logbook,&quot;Nothing to remove&quot;);};
    return 0;
  } else 
  { // Remove links as specified in links2Remove dictionary
    $MyNumber(src_note)=0; // Initialize count of links removed
    $MyDictionary(src_note)=links2Remove;
    stamp(src_note,&quot;Links:Remove Link Set&quot;);
    links2Remove.keys.each(destinationID)
    { // Get count of links to be removed
      removeCount+=links2Remove[destinationID].count;
    };    
    if(debug){LogRec(logbook,&quot; # outbound links removed: &quot;+removeCount);};
  }; // Endif any links to remove
  return removeCount;
}; // End function to remove outbound link set

// This function calls the following Stamp:
//   Links:Remove Link Set

//--+----1----+----2----+----3----+----4----+----5----+----6----+----7----+----8
</text>
