<item ID="1744661366" Creator="Chuck Wade" proto="Stamp" >
<attribute name="Created" >2025-04-01T16:07:04+09:00</attribute>
<attribute name="DisplayedAttributes" >Created;Creator;Modified;MyBoolean;MyList;MyNumber;MySet;MyString;Prototype;ReadOnly;SmartQuotes</attribute>
<attribute name="Height" >1.86</attribute>
<attribute name="Modified" >2025-04-01T16:15:19+09:00</attribute>
<attribute name="Name" >Logging:Restart Index Sequencing</attribute>
<attribute name="ReadOnly" >true</attribute>
<attribute name="ScreenWidth" >551</attribute>
<attribute name="SelectionCount" >16</attribute>
<attribute name="Sentiment" >-0.4400000095</attribute>
<attribute name="Sentiments" >-0.6;-0.4;-0.6;-0.4;-0.4;-0.4;0;-0.8;-0.4;-0.4</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >130.5</attribute>
<attribute name="Ypos" >0</attribute>
<text >// Reset the global logging index so that the next log
// record will start with one (00001)

var:number log_repository; // Obtain $ID for “LogBooks” container
log_repository=$MyDictionary(lastSibling(cover))[&quot;LogBooks&quot;];
var:string persistent_logbook=$Path(log_repository)+&quot;/PersistentLogBook&quot;;

// Record in PersistentLogBook that the index is being reset
LogRec(persistent_logbook,&quot;&lt;&lt;mark&gt;&gt;Logging Index Reset to Zero!&quot;);

// Reset Index Sequence number to zero
$MyNumber(log_repository)=0;
</text>
