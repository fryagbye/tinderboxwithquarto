<text >function fSetPreviewCommandForRChunk(){
	var:string vConfigPath=&quot;TBXConfig&quot;;
	var:string vExportPath=$ExportFolder(vConfigPath);
	var:string vProjectPath=$HTMLExportFileName(collect(ancestors,$Path)[-1]);
	var:string vWarn=&quot;,warn.conflicts=F&quot;;
	var:string vCommand;
	var:string vLibList=$RLibraryListForPreview(vConfigPath);
	vCommand =&quot;export PATH=$HOME:/opt/homebrew/bin:/usr/local/bin:/Library/TeX/texbin/:$PATH;&quot;;
	vCommand+=&quot;cd &quot; + vExportPath +&quot;/&quot; + vProjectPath +&quot;;&quot;+&apos;/usr/local/bin/Rscript -e &quot;&apos;;
	vLibList.each(al){
		vCommand += &quot;library(&quot; + al + vWarn + &quot;); &quot;;
	};
	vCommand += &quot;lines &lt;- readLines(file(&apos;stdin&apos;), warn=FALSE);f &lt;- file(&apos;_RchunkPreviewOutput.qmd&apos;, &apos;w&apos;);&quot;;
	vCommand += &quot;cat(&apos;---\u000A&apos;, &apos;title: \u0022&quot; + $Name + &quot;\u0022\u000A&apos;, &apos;---\u000A&apos;, file=f, sep=&apos;&apos;);&quot;;
   vCommand += &quot;for (line in lines) {line &lt;- gsub(&apos;\`\`\`{webr&apos;,&apos;\`\`\`{r&apos;,line, fixed=TRUE); cat(line, &apos;\u000A&apos;, sep=&apos;&apos;, file=f); };  close(f);&quot;;
	vCommand += &quot;rendered_output &lt;- rmarkdown::render(&apos;_RchunkPreviewOutput.qmd&apos;, output_format=&apos;html_document&apos;, quiet=TRUE);&quot;;
	vCommand += &quot;cat(readLines(rendered_output), sep=&apos;\u000A&apos;);&quot;;
	vCommand += &quot;tmp &lt;- if(file.exists(&apos;_RchunkPreviewOutput.qmd&apos;)) {file.remove(&apos;_RchunkPreviewOutput.qmd&apos;)};&quot;;
	vCommand += &quot;tmp &lt;- if(file.exists(&apos;_RchunkPreviewOutput.html&apos;)) {file.remove(&apos;_RchunkPreviewOutput.html&apos;)};&quot;;
	vCommand += &apos;&quot;&apos;;

//	$Text(/Log)=vCommand;
	$HTMLPreviewCommand=vCommand;

};

function fSetForChunk(vID,vForPreview){
	$Text(vID)=fWriteOptionsForChunk(vID, vForPreview);
}

function fWriteFrontmatterForRChunk(vID){
	var:string vPre;
	var:string vTitle;
	if($Q_ChunkFigLabel(vID)){
		vTitle=$Q_ChunkFigLabel(vID);
	}else{
		if($Prototype==&quot;pRChunkList&quot;){
			$Name(vID).contains(&quot;&lt;(?:webr|r|python|pyodide|osj):(.*?)&gt;&quot;);
			vTitle=$1;
		}else{
			vTitle=$Name(vID);
		};
	};
	vPre =&quot;---\n&quot;;
	vPre+=&apos;title: &quot;&apos; + vTitle + &apos;&quot;\n&apos;;
	vPre+=&quot;output:\n&quot;;
	vPre+=&quot;  html_document:\n&quot;;
	vPre+=&quot;    template: &quot; + $RscriptHTMLTemplate(&quot;TBXConfig&quot;) + &quot;\n&quot;;
	vPre+=&quot;engine:\n&quot;;
	vPre+=&quot;  cache: false\n&quot;;
	vPre+=&quot;---\n\n&quot;;
	return vPre;
};


function fWriteOptionsForGraph(vID:string){
	var:string vPre;
	var:string vStr;
	var:string vTemp;
//	var:string vReg=&quot;```\{(?:mermaid|dot)\s*.*?\}\s*(?:#\|.*\n)*([\s\S]*?)\s*```&quot;;
	var:string vReg=&quot;```\{(?:mermaid|dot)\s*.*?\}\s*(?:(?:%%\||#\||//\|).*\n)*([\s\S]*?)\s*```&quot;;
	var:string vReturn;
		
	if($Text(vID).contains(vReg)){
		vTemp=$1;
	}else{
		vTemp=$Text(vID);
	};

	if($Prototype(vID)==&quot;pMFContainer&quot;){
		vStr= &quot;%%&quot;;
		vPre=&quot;```{mermaid}\n&quot;;
	}else{
		vStr= &quot;//&quot;;
		vPre=&quot;```{dot}\n&quot;;
	};
	

   if($Q_ChunkFigLabel(vID)){
		vPre+= vStr + &quot;| label: fig-&quot; +$Q_ChunkFigLabel(vID)+&quot;\n&quot;;
	};
   if($Q_ChunkEcho(vID)){
		vPre+= vStr + &quot;| echo: &quot; +$Q_ChunkEcho(vID)+&quot;\n&quot;;
	};
   if($Q_ChunkFigCaption(vID)){
		vPre+= vStr + &quot;| fig-cap: &quot; + $Q_ChunkFigCaption(vID)+&quot;\n&quot;;
	};
   if($Q_ChunkFigAlt(vID)){
		vPre+= vStr + &quot;| fig-alt: &quot; + $Q_ChunkFigAlt(vID)+&quot;\n&quot;;
	};

	vReturn += vPre;
	vReturn += vTemp + &quot;\n&quot;;
	vReturn += &quot;```\n&quot;;
	return vReturn;
};

function fWriteOptionsForChunk(vID:string, vForPreview:boolean){
	var:string vPre;
	var:string vStr;
	var:string vTemp;
	var:string vReg=&quot;```\{[.=]?[webr|r|python|pyodide|ojs]\s*.*?\}\s*(?:#\|.*\n)*([\s\S]*?)\s*```&quot;;
	var:string vReturn;
		
	if($Text(vID).contains(vReg)){
		vTemp=$1;
	}else{
		vTemp=$Text(vID);
	};
	

	if(vForPreview&amp;($Prototype==&quot;pRChunk&quot;|$Prototype=&quot;pRChunkList&quot;)){
		vReturn+= fWriteFrontmatterForRChunk(vID);
	};
	if($Q_ChunkLang(vChunkPath)==&quot;ojs&quot;){
		vStr= &quot;//&quot;;
	}else{
		vStr= &quot;#&quot;;
	};
	if($Q_IsCodeBlock(vID)){
		vPre=&quot;\n```{.&quot; + $Q_ChunkLang(vID);
	}else{
		vPre=&quot;\n```{&quot; + $Q_ChunkLang(vID);
	};
	if($Q_CodeLineNumbers(vID).size&gt;0){
		vPre+= &quot; code-line-numbers=&quot;+$Q_CodeLineNumbers(vID).format(&quot;,&quot;);
	};
	if($QR_OutputLocation(vID)){
		vPre+= &quot; output-location=&quot; + $QR_OutputLocation(vID);
	};
	vPre+=&quot;}\n&quot;;
	if($Q_ChunkEcho(vID)){
		vPre+= vStr + &quot;| echo: &quot; + $Q_ChunkEcho(vID)+&quot;\n&quot;;
	}else{
		vPre+= vStr + &quot;| echo: false\n&quot;;
	};
   if($Q_ChunkSuppressWarning(vID)){
		vPre+= vStr + &quot;| warning: &quot; + &quot;false&quot;+&quot;\n&quot;;
	};
	if($Q_ChunkAutoRun(vID)){
		vPre+= vStr + &quot;| autorun: &quot; + $Q_ChunkAutoRun(vID)+&quot;\n&quot;;
	};
   if($Q_ChunkFigLabel(vID)){
		vPre+= vStr + &quot;| label: fig-&quot; + $Q_ChunkFigLabel(vID)+&quot;\n&quot;;
	};
   if($Q_ChunkFigCaption(vID)){
		vPre+= vStr + &quot;| fig-cap: &quot; + $Q_ChunkFigCaption(vID)+&quot;\n&quot;;
	};
   if($Q_ChunkFigWidth(vID)){
		vPre+=vStr + &quot;| fig-width: &quot; + $Q_ChunkFigWidth(vID)+&quot;\n&quot;;
	};
   if($Q_ChunkFigHeight(vID)){
		vPre+= vStr + &quot;| fig-height: &quot; + $Q_ChunkFigHeight(vID)+&quot;\n&quot;;
	};

   if($Q_ChunkFigPos(vID)){
		vPre+= vStr + &quot;| fig-pos: &quot; + $Q_ChunkFigPos(vID)+&quot;\n&quot;;
	};
   if($Q_ChunkFigShow(vID)){
		vPre+= vStr + &quot;| fig-show: &quot; + $Q_ChunkFigShow(vID)+&quot;\n&quot;;
	};

   if($Q_ChunkFIgOutWidth(vID)){
		vPre+= vStr + &quot;| out-width: &quot; + $Q_ChunkFIgOutWidth(vID)+&quot;\n&quot;;
	};


	vReturn += vPre;
	vReturn += vTemp + &quot;\n&quot;;
	vReturn += &quot;```\n&quot;;
	return vReturn;
};</text>
