<attribute name="Sentiments" >-0.4;-0.2;-0.2;-0.6;-0.6;-0.6;-0.6;-0.6;-0.6;0.4;1;1;0;-0.6;-0.6;-0.6;-0.6;-0.6;-0.4</attribute>
