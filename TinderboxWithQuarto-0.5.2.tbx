<text >// This function provides a consistent method for obtaining the $ID 
// for any indexed “Document Commons” item. The supplied “commons_name”
// is a standardized name that may not match the $Name for the 
// corresponding actual Note. 

function GetCommonsItemID(commons_name)
{ 
  return($MyDictionary(lastSibling(cover))[commons_name]);
	//
}; // End of “GetCommonsItemID” definition

// This function relies upon the convention that a “Document Commons”
// container has been established as the last top-level note in
// outline order. By following this convention, the name of this
// container can be anything the user wants. 
// A version of this container can be copied into the user&apos;s document
// that will include automation to enforce it always being the last 
// top-level document note.
</text>
<rtfd >cnRmZAAAAAADAAAAAgAAAAcAAABUWFQucnRmAQAAAC6gBgAAKwAAAAEAAACYBgAAe1xydGYxXGFuc2lcYW5zaWNwZzEyNTJcY29jb2FydGYyNzA5Clxjb2NvYXRleHRzY2FsaW5nMFxjb2NvYXBsYXRmb3JtMHtcZm9udHRibFxmMFxmbmlsXGZjaGFyc2V0MCBBbmRhbGVNb25vO30Ke1xjb2xvcnRibDtccmVkMjU1XGdyZWVuMjU1XGJsdWUyNTU7XHJlZDEyM1xncmVlbjEyM1xibHVlMTI5O1xyZWQyNTVcZ3JlZW4yNTVcYmx1ZTI1NTtccmVkMFxncmVlbjBcYmx1ZTA7ClxyZWQxMFxncmVlbjk2XGJsdWUyNTU7XHJlZDE1N1xncmVlbjUxXGJsdWUyMTQ7fQp7XCpcZXhwYW5kZWRjb2xvcnRibDs7XGNzc3JnYlxjNTU2ODZcYzU1Njg2XGM1NzY0N1xjbmFtZSBzeXN0ZW1HcmF5Q29sb3I7XGNzc3JnYlxjMTAwMDAwXGMxMDAwMDBcYzEwMDAwMFxjbmFtZSB0ZXh0QmFja2dyb3VuZENvbG9yO1xjc3NyZ2JcYzBcYzBcYzBcYzg0NzA2XGNuYW1lIGNvbnRyb2xUZXh0Q29sb3I7Clxjc3NyZ2JcYzBcYzQ3ODQzXGMxMDAwMDBcY25hbWUgc3lzdGVtQmx1ZUNvbG9yO1xjc3NyZ2JcYzY4NjI3XGMzMjE1N1xjODcwNTlcY25hbWUgc3lzdGVtUHVycGxlQ29sb3I7fQpccGFyZFx0eDU2MFx0eDExMjBcdHgxNjgwXHR4MjI0MFx0eDI4MDBcdHgzMzYwXHR4MzkyMFx0eDQ0ODBcdHg1MDQwXHR4NTYwMFx0eDYxNjBcdHg2NzIwXHBhcmRpcm5hdHVyYWxccGFydGlnaHRlbmZhY3RvcjAKClxmMFxmczMyIFxjZjIgXGNiMyAvLyBUaGlzIGZ1bmN0aW9uIHByb3ZpZGVzIGEgY29uc2lzdGVudCBtZXRob2QgZm9yIG9idGFpbmluZyB0aGUgJElEIFxjZjQgXApcY2YyIC8vIGZvciBhbnkgaW5kZXhlZCBcJzkzRG9jdW1lbnQgQ29tbW9uc1wnOTQgaXRlbS4gVGhlIHN1cHBsaWVkIFwnOTNjb21tb25zX25hbWVcJzk0XGNmNCBcClxjZjIgLy8gaXMgYSBzdGFuZGFyZGl6ZWQgbmFtZSB0aGF0IG1heSBub3QgbWF0Y2ggdGhlICROYW1lIGZvciB0aGUgXGNmNCBcClxjZjIgLy8gY29ycmVzcG9uZGluZyBhY3R1YWwgTm90ZS4gXGNmNCBcClwKXGNmNSBmdW5jdGlvblxjZjQgIEdldENvbW1vbnNJdGVtSUQoY29tbW9uc19uYW1lKVwKXHsgXAogIFxjZjUgcmV0dXJuXGNmNCAoXGNmNiAkTXlEaWN0aW9uYXJ5XGNmNCAobGFzdFNpYmxpbmcoY292ZXIpKVtjb21tb25zX25hbWVdKTtcCglcY2YyIC8vXGNmNCBcClx9OyBcY2YyIC8vIEVuZCBvZiBcJzkzR2V0Q29tbW9uc0l0ZW1JRFwnOTQgZGVmaW5pdGlvblxjZjQgXApcClxjZjIgLy8gVGhpcyBmdW5jdGlvbiByZWxpZXMgdXBvbiB0aGUgY29udmVudGlvbiB0aGF0IGEgXCc5M0RvY3VtZW50IENvbW1vbnNcJzk0XGNmNCBcClxjZjIgLy8gY29udGFpbmVyIGhhcyBiZWVuIGVzdGFibGlzaGVkIGFzIHRoZSBsYXN0IHRvcC1sZXZlbCBub3RlIGluXGNmNCBcClxjZjIgLy8gb3V0bGluZSBvcmRlci4gQnkgZm9sbG93aW5nIHRoaXMgY29udmVudGlvbiwgdGhlIG5hbWUgb2YgdGhpc1xjZjQg