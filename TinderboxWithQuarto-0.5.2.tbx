<text >// This function will find an IP address in dotted quad format from 
// a supplied string, and extract any found IP address as a list of 
// four octets plus any CIDR extension. 
// The RegEx used to find and capture an IP address is robust enough
// discover any address residing within any supplied string, while 
// rejecting anything that is not a valid IP address.
// If the supplied IP address is followed by a forward slash ‘/’ and
// a CIDR value between 0 - 32, then the CIDR value will be returned
// as the fifth item on the list.
// Here is how to interpret the returned List:
//   If return is an empty List, then no IP address was found
//   If return is a List with just 4 items, then no CIDR found
//   If return is a List with 5 items, then 5th item is CIDR value
//   Each List item is forced to be of type “number”

function ip_quad2octets(ip_string)
{ // Declare variables
  var:boolean debug=false; // If debug is true, issue log statements
  var:list ip_octets=&quot;&quot;;   // list of octets plus optional CIDR value
  var:string ip_addr=&quot;&quot;;   // extracted IP address as found (optional use)

//
  if(debug){LogRec(&quot;ip_quad2octets&quot;,&quot;***** &quot;+ip_string+&quot; &quot;+date(today)+&quot; *****&quot;);};

  // Extract dotted quad with, or without CIDR, from input arg
  if(ip_string.contains(&quot;(\b25[0-5]|\b2[0-4][0-9]|\b[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(/((3[0-2]|[0-2][0-9]|[0-9])[\D]|(3[0-2]|[0-2][0-9]|[0-9])$)|[\D]|$)&quot;))
  { // An IP address was found, so extract octets
    ip_addr=$0;
    ip_octets=$1+&quot;;&quot;+$2+&quot;;&quot;+$3+&quot;;&quot;+$4+&quot;;&quot;+$5;
    ip_octets[4]=ip_octets[4].extractAll(&quot;([0-9]+)&quot;); // Just the digits
    ip_addr=ip_addr.extractAll(&quot;([0-9\./]+)&quot;);

    if(debug){LogRec(&quot;ip_quad2octets&quot;,ip_addr + &quot; | &quot; + ip_octets);};

    // Force each Octet List item to be of type “number”
    0...(ip_octets.count-1).each(index)
    {ip_octets[index]=ip_octets[index].toNumber};

    if(ip_addr.contains(&quot;/&quot;)){return(ip_octets);}
    else {ip_octers=ip_octets[0,1,2,3];};
    if(debug){LogRec(&quot;ip_quad2octets&quot;,&quot; No CIDR found | &quot; + ip_octets);};
    // return four octets only
    return(ip_octets)
  }
  else { // No IP address found, so return empty string
    ip_octets=&quot;&quot;;
    return(ip_octets);
  };
};

// This function calls the following functions:
//   LogRec
//
// Some related functions:
//   ip_octets2integer
//   ip_integer2octets
//   ip_integer2dotquad
//   captureMAC
</text>
