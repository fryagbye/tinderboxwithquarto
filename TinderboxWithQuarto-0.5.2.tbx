<text >// Convert an IP address expressed as a signed 32-bit integer
// into a List of four decimal octets.

function ip_integer2octets(ip_int)
{ // Declare List variable&amp; initialize to empty
  var:list ip_octets=&quot;&quot;;

  ip_octets=floor(ip_int/16777216);
  ip_int=ip_int-ip_octets[0]*16777216;
  ip_octets=ip_octets+floor(ip_int/65536);
  ip_int=ip_int-ip_octets[1]*65536;
  ip_octets=ip_octets+floor(ip_int/256);
  ip_int=ip_int-ip_octets[2]*256;
  ip_octets=ip_octets+ip_int;
 
  return(ip_octets);
};


// There are multiple algorithms for performing
// this conversion. The algorithm used here has 
// the advantage of being obvious. However, note
// that “ip_octets=ip_octets+...” adds a new member
// to the list, and is not an arithmetic operation.</text>
