<text >
function fMakeFigureList(vContainer:string, vPath:string){
    var:string vName;
    var:string vTest;
    var:number vCount(0);
    var:string vLabel;
    var:string vTemp;
    var:list vList;

    LogRec(&quot;MakeFigureList&quot;, &quot;&lt;&lt;mark&gt;&gt;vContainer=&quot; + vContainer + &quot; vPath=&quot; + vPath);

    if($IsLabelGenerateON(vPath)&amp;($Prototype(vPath)==&quot;pLabelListContainer&quot;|$Prototype($Prototype(vPath))==&quot;pLabelListContainer&quot;)){

        $Text(vPath)=;
        $MyList(vPath)=;
        $ListKey(vPath)=;
        $ListValue(vPath)=;
        $MyDictionary(vPath)=;
        
        //Notes contains chunk &quot;fig-&quot; label with style &quot;#| label: fig- &quot;
        vList = collect_if(descendants(vContainer),$Text.contains(&quot;(#\| label: fig-[\w\d-]*)+?&quot;)&amp;!$IsAlias&amp;$Prototype(parent)!=&quot;pLabelListContainer&quot;,$Path);

        // Add Figures From pChunk, pRChunk, pPChunk
        vList.each(L){
            L=L.replace(&apos;&quot;&apos;,&quot;&quot;);
            $Text(L).eachLine(aLine:aLine.contains(&quot;(#\| label: fig-[\w\d-]*)+?&quot;)){
                vTemp = $1;
                vTemp = vTemp.replace(&quot;#\| label: &quot;,&quot;@&quot;);
                $MyList(vPath) += vTemp;
                $ListKey(vPath) += vTemp;
                $ListValue(vPath) += L;
                $MyDictionary(vPath) = $MyDictionary(vPath).add(&quot;{&quot;+ $ListKey(vPath) +&quot;:&quot;+ $ListValue(vPath) +&quot;}&quot;);
            };
        };

       //Notes contains chunk &quot;fig-&quot; label with style &quot;#fig-&quot;
        vList = collect_if(descendants(vContainer),$Text.contains(&quot;(#fig-[\w\d-]*)+?&quot;)&amp;!$IsAlias&amp;$Prototype(parent)!=&quot;pLabelListContainer&quot;,$Path);
        vList.each(L){
            L=L.replace(&apos;&quot;&apos;,&quot;&quot;);
            $Text(L).eachLine(aLine:aLine.contains(&quot;.*(#fig-[\w\d-]*)+?.*&quot;)){
                vTemp = $1;
                vTemp = vTemp.replace(&quot;#fig-&quot;,&quot;@fig-&quot;);
                $MyList(vPath) += vTemp;
                $ListKey(vPath) += vTemp;
                $ListValue(vPath) += L;
                $MyDictionary(vPath) = $MyDictionary(vPath).add(&quot;{&quot;+ $ListKey(vPath) +&quot;:&quot;+ $ListValue(vPath) +&quot;}&quot;);
            };
        };      

       //Notes contains chunk &quot;fig-&quot; label with style &quot;%%| label: fig-&quot; for Mermaid Flowchart

        vList = collect_if(descendants(vContainer),$Text.contains(&quot;(%%\| label: fig-[\w\d-]*)+?&quot;)&amp;!$IsAlias&amp;$Prototype(parent)!=&quot;pLabelListContainer&quot;,$Path);
        LogRec(&quot;MakeFigureList&quot;, &quot;&lt;&lt;mark&gt;&gt; vList=&quot; + vList + &quot; vContainer=&quot; + vContainer + &quot; $Path=&quot; + $Path);
        vList.each(L){
            L=L.replace(&apos;&quot;&apos;,&quot;&quot;);
            $Text(L).eachLine(aLine:aLine.contains(&quot;(%%\| label: fig-[\w\d-]*)+?&quot;)){
                vTemp = $1;
                vTemp = vTemp.replace(&quot;%%\| label: &quot;,&quot;@&quot;);
                $MyList(vPath) += vTemp;
                $ListKey(vPath) += vTemp;
                $ListValue(vPath) += L;
                $MyDictionary(vPath) = $MyDictionary(vPath).add(&quot;{&quot;+ $ListKey(vPath) +&quot;:&quot;+ $ListValue(vPath) +&quot;}&quot;);
            };
        };

        //Notes contains chunk &quot;fig-&quot; label with style &quot;//| label: fig-&quot; for Graphviz
        vList = collect_if(descendants(vContainer),$Text.contains(&quot;(\/\/\| label: fig-[\w\d-]*)+?&quot;)&amp;!$IsAlias&amp;$Prototype(parent)!=&quot;pLabelListContainer&quot;,$Path);
        vList.each(L){
            L=L.replace(&apos;&quot;&apos;,&quot;&quot;);
            $Text(L).eachLine(aLine:aLine.contains(&quot;(\/\/\| label: fig-[\w\d-]*)+?&quot;)){
                vTemp = $1;
                vTemp = vTemp.replace(&quot;\/\/\| label: &quot;,&quot;@&quot;);
                $MyList(vPath) += vTemp;
                $ListKey(vPath) += vTemp;
                $ListValue(vPath) += L;
                $MyDictionary(vPath) = $MyDictionary(vPath).add(&quot;{&quot;+ $ListKey(vPath) +&quot;:&quot;+ $ListValue(vPath) +&quot;}&quot;);
            };
        };
        $MySet(vPath)=$MyList(vPath);
        $MySet(vPath).each(S){
            vName = S;
            vLabel = S.replace(&quot;@&quot;,&quot;&quot;);
        
            vTest = $IDString(vName);
            if(vTest==&quot;&quot;&amp;vName!=&quot;@fig-&quot;){
                LogRec(&quot;MakeFigureList&quot;, &quot;&lt;&lt;mark&gt;&gt; create vName=&quot; + vName + &quot; vLabel=&quot; + vLabel + &quot; vTest=&quot; + vTest);
                create(vPath, vName + &quot;#pReferenceList&quot;);
                $OutlineBackgroundColor(vName)=&quot;green&quot;;

            //  $Text(vName) = fFigureChunk($ListValue(vPath)[vCount], vLabel);
            };
            if(vName!=&quot;@fig-&quot;){
                $Text(vPath)+= vName + &quot;\n&quot;;
            };
        };
        vCount = 0;
        $ListKey(vPath).each(K){
            vName = K;
            $ToDummyLinkPath(vName) = $ListValue(vPath)[vCount];
            $Text(vName) = fFigureChunk($ListValue(vPath)[vCount], vName.replace(&quot;@&quot;,&quot;&quot;));
            createLink(K, $ListValue(vPath)[vCount], &quot;dummy&quot;);
            vCount += 1;
        };
    };
};

function fFigureChunk(vName:string, vLabel:string){
    var:string vReg1;
    var:string vReg2;
    var:string vReg3;
    var:string vReg4;
    var:string vTemp;
    
    vReg1 = &quot;(```[^`]+#\| label: &quot; + vLabel + &quot;[^`]+```)&quot;; 
    vReg2 = &quot;(:::[\s\S]*?\{#&quot; + vLabel + &quot;\}[\s\S]*?:::)&quot;;
    vReg3 = &quot;(:::\s*\{#&quot;+ vLabel + &quot;[\s\S]*?\}[\s\S]*?:::)&quot;;
    vReg4 = &quot;(!\[.*?\]\(.*?\)\{#&quot; + vLabel + &quot;.*?\})&quot;;


    if($Text(vName).contains(vReg1)){
        vTemp=$1;
    };
    if($Text(vName).contains(vReg2)){
        vTemp=$1;
    };
    if($Text(vName).contains(vReg3)){
        vTemp=$1;
    };
    if($Text(vName).contains(vReg4)){
        vTemp=$1;
    };
    return vTemp;
};
