<text >^if($Q_ToggleBrandYML)^brand: ^value($Q_BrandYmlFile)^^endIf^

format: live-^value($Q_ProjectType)^
webr:
  ^if($Q_ChunkPackageList)^packages:^action(
	var:string vTemp;
	$Q_ChunkPackageList.each(aP){
		vTemp+= 4 * &quot; &quot; + &quot;- &quot; + aP+&quot;\n&quot;;
	};
)^
^value(vTemp)^
^endIf^

^if($Q_BibliographyFile)^bibliography: ^value($Q_BibliographyFile)^^endIf^
execute:
  cache: ^value($Q_Cache)^
  freeze: ^value($Q_Freeze)^


</text>
