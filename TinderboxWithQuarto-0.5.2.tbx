<attrib Name="TimestampLogs" parent="User" editable="1" visibleInEditor="1" lines="1" type="4" description="If true, place a timestamp in each log record. Note that this only controls time entries; see DatestampLogs to control whether dates are included in log records.                                         " default="false" >
