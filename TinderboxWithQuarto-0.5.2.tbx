<text >

{{&lt; include ./_extensions/r-wasm/live/_knitr.qmd &gt;}}


```{r, echo=FALSE}
#| include: false
out_type &lt;- knitr::opts_knit$get(&quot;rmarkdown.pandoc.to&quot;)
source(&quot;_common.R&quot;)
```

^action(
	var:string vPre;
	var:string vTemp;
	var:string vText;
	var:string vReg=&quot;```\{r\s*.*?\}\s*(?:#\|.*\n)*([\s\S]*?)\s*```&quot;;
	
		
	if($Text.contains(vReg)){
		vTemp= $1;
	}else{
		vTemp= $Text;
	};
	vText= fWriteOptionsForRChunk($ID, false)
)^


^if($IsRawOutput)^^value($Text)^^else^```{^value($Q_ChunkLang)^^if($Q_CodeLineNumbers.size&gt;0)^code-line-numbers=^value($Q_CodeLineNumbers.format(&quot;,&quot;))^^endIf^}
^value(vText)^
```^endIf^
</text>
