<attribute name="Name" >tSubnote_manuscript</attribute>
<attribute name="NeverComposite" >true</attribute>
<attribute name="OutlineBackgroundColor" >light bright green</attribute>
<attribute name="Q_Affiliation_ID" >150</attribute>
<attribute name="SelectionCount" >484</attribute>
<attribute name="Sentiment" >-0.3052631654</attribute>
<attribute name="Sentiments" >-0.6;0.2;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;0.2;0.8;-0.4;-0.2;-0.2;-0.2;0.4;-0.6;-0.6;-0.4;-0.2;0.2;0.2;-0.8;-0.6;0.4;-0.2;-0.2;-0.4;-0.4;0;-0.6;-0.4;-0.2;-0.2;0.2;-0.6;-0.6;0.4;0.4;-0.2;-0.2;-0.2;-0.6;-0.6;-0.2;-0.2;-0.2;-0.6;-0.2;-0.2;-0.2;-0.6;-0.2;-0.4;-0.2;0;-0.6;0.2;-0.2;-0.6;-0.8;0;-0.2;-0.4;-0.2;-0.6;0.2;0.8;0.4;-0.6</attribute>
<attribute name="Width" >5</attribute>
<attribute name="Xpos" >38.5</attribute>
<attribute name="Ypos" >3.5</attribute>
<text >^action(
    var:string vChunkListPath=&quot;/Chunk List&quot;;
    var:string vGraphListPath=&quot;/Graph List&quot;;
    var:string vText;
    var:string vReg1=&quot;&lt;(?:webr|r|python|pyodide|osj):(.*?)&gt;&quot;;
    var:string vReg2=&quot;&lt;(?:dot|mermaid):(.*?)&gt;&quot;;
    var:string vReg3=&quot;&quot;;
    var:string vChunkPath;
    var:string vChunkName;
    var:string vGraphPath;
    var:string vGraphName;
    var:string vTest;
    var:boolean vCheck;
    var:boolean vOpenFlag;


    var:number vLineCount = 0;
    $Text.eachLine(aLine){
        vLineCount += 1;
        vCheck=true;
        //chunk tag
        if(aLine.extract(vReg1)){
            vChunkName=$1;
//          vChunkPath=$Path(original)+&quot;/&quot;+vChunkName;
            vChunkPath=$ToDummyLinkPath($0);
            $FromDummyLinkPath($0)+=$Path;
            createLink($Path, $0);

            vTest=$ID(vChunkPath);
        
            if(!vTest){
                vChunkPath=collect_if(children(vChunkListPath),$Name==vChunkName,$Path).first;
            };
            if(vLineCount &gt; 1){
                vText += &quot;\n &quot;;
            };
            vText += fWriteOptionsForChunk($ID(vChunkPath), false)+&quot;\n \n &quot;;
            vCheck=false;
        };

        //graph tag
        if(aLine.extract(vReg2)){
            vGraphName=$1;
            vGraphPath=$ToDummyLinkPath($0);
            $FromDummyLinkPath($0)+=$Path;
            createLink($Path, $0);

            vTest=$ID(vGraphPath);
            if(!vTest){
                vGraphPath=collect_if(children(vGraphListPath),$Name==vGraphName,$Path).first;
            };
            
            if(vLineCount &gt; 1){
                vText += &quot;\n &quot;;
            };
            vText += fWriteOptionsForGraph($ID(vGraphPath)) +&quot;\n \n &quot;;
            vCheck=false;
        };  

        if(vCheck){
            if(aLine.beginsWith(&quot;$$&quot;)){
                if(vOpenFlag){
                    vText+= aLine+&quot;\n \n &quot;;
                    vOpenFlag=false;
                }else{
                    if(vLineCount &gt; 1){ vText+= &quot;\n&quot;; };
                    vText+= aLine+&quot;\n&quot;;
                    vOpenFlag=true;
                };
                vCheck=false;
            };
            if(vCheck&amp;(aLine.beginsWith(&quot;:::&quot;)|aLine.beginsWith(&quot;[&quot;)|aLine.beginsWith(&quot;![&quot;)|aLine.endsWith(&quot;```&quot;))){
                if(vLineCount &gt; 1){ vText+=&quot;\n&quot;; };
                vText+= &quot;\n&quot; + aLine +&quot;\n \n &quot;;
                vCheck=false;
            };
            if(vCheck&amp;(aLine.beginsWith(&quot;:&quot;)|aLine.contains(&quot;^\s*([-*+]|\d+\.)\s+&quot;))){
                if(vLineCount &gt; 1){ vText+=&quot;\n &quot;; };
                vText+= aLine +&quot;\n \n &quot;;
                vCheck=false;
            };
            if(vCheck&amp;(aLine.beginsWith(&quot;```{&quot;))){
                if(vLineCount &gt; 1){ vText+= &quot;\n &quot;; };
                vText+= aLine + &quot;\n&quot;;
                vCheck=false;
            };
            if(vCheck){
                vText+= aLine+ &quot;\n&quot;;
            };
        };
    };
    if(vLineCount &gt; 0){
        vText+=&quot;\n&quot;;
    };

)^
 
^value(($OutlineDepthBase + $OutlineBaseControl(collect(ancestors,$Path)[-1])) * &quot;#&quot; + &quot; &quot; + $Name)^^if(($IsUnnumbered)|($HasSectionLabel))^^value(&quot; {&quot;)^^endIf^^if($IsUnnumbered)^ ^value(&quot;.unnumbered&quot;)^^endIf^^if($HasSectionLabel)^^value(&quot; #sec-&quot; + $SectionLabel )^^endIf^^if(($IsUnnumbered)|($HasSectionLabel))^^value(&quot; }&quot;)^^endIf^
 
^value(vText)^
^include(^value($IncludeNotes)^,&quot;tSubnote_manuscript&quot;)^
</text>
