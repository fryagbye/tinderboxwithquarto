<attribute name="Name" >Graphviz: Toggle $G_HasCustomAttributes</attribute>
<attribute name="ScreenHeight" >28</attribute>
<attribute name="SelectionCount" >64</attribute>
<attribute name="Sentiment" >-0.7500000149</attribute>
<attribute name="Sentiments" >-0.6;-0.6;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >136.5</attribute>
<attribute name="Ypos" >0</attribute>
<text >if($Prototype==&quot;pGContainer&quot;|$Prototype==&quot;pGSubgraph&quot;|$Prototype==&quot;pGNode&quot;){
	if($G_HasCustomAttributes){
		$G_HasCustomAttributes=false;
		(&quot;$G_HasCustomAttributes OFF&quot;).show;
	}else{
		$G_HasCustomAttributes=true;
		(&quot;$G_HasCustomAttributes ON&quot;).show;	};
};</text>
