if($DANGEROUSCOMMAND(&quot;DELETE: DEMO FILES&quot;)==&quot;DELETEDEMOFILES&quot;){
    vList.each(aL){
        delete(aL);
    };
    $Text(/citation/references)=;
    $TerminalApp(vConf)=&quot;Terminal&quot;;
    $ProjectContainer(vConf)=&quot;&quot;;
