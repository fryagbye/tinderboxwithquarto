<text >if(!($IsNamesLocked)){
	if($IsIndexqmd){
		$HTMLExportFileName=&quot;index&quot;;
	}else{
		$HTMLExportFileName=$Name.deleteCharacters(&quot;/\?%*:|&lt;&gt;.&amp;+()!,#`&quot;).lowercase().replace(&quot; &quot;,&quot;-&quot;).replace(&quot;&apos;&quot;,&quot;&quot;);
	};

//	if(!($SectionLabel)){
		$SectionLabel = $HTMLExportFileName;
//	};
}else{
	(&quot;$IsNamesLocked is true.&quot;).show();
};

$HTMLExportExtension=$HTMLExportExtension($Prototype);
</text>
