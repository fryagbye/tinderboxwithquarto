<text >function fCreateBookProject(){
    //var:string vProjectName=$ProjectContainer(&quot;TBXConfig&quot;);
    var:string vTempPath;
    var:string vTempName;
    var:string vLabelList=[Section;Figure;Table;Equation];

    if($Prototype($ID)==&quot;pBookFolder&quot; &amp; $ChildCount($ID)==0){
    
    vLabelList.each(x){
        vTempName = x+&quot; Label List&quot;;
        vTempPath = $Path($ID)+&quot;/&quot;+vTempName;

        create($Path($ID), vTempName+&quot;#pLabelListContainer&quot;);
        $TypeOfList(vTempPath) = x;
        $ProjectContainer(vTempPath) = $Path($ID);
        //$Edict(vTempPath)=&quot;$ProjectContainer=collect(ancestors,$Path)[-1];\nfMake&quot;+ x +&quot;List($ProjectContainer,$Path);&quot;;
    };

        create($Path($ID), &quot;_quarto#pYML&quot;);
        create($Path($ID), &quot;index#pIndexQmd&quot;);
        $HTMLExportFileName($Path($ID))=fDeleteCharacters($Name($ID));
    }else{
        if($ChildCount($ID)&gt;0){
            ($Name($ID)+&quot; already has child Notes&quot;).show();
        }else{
            &quot;Please select a pBookFolder Note&quot;.show();
        };
    };
};

function fCreateManuscriptProject(){
    var:string vTempPath;
    var:string vTempName;
    var:string vLabelList=[Section;Figure;Table;Equation];

    if($Prototype($ID)==&quot;pManuscriptFolder&quot; &amp; $ChildCount($ID)==0){
    
        vLabelList.each(x){
            vTempName = x+&quot; Label List&quot;;
            vTempPath = $Path($ID)+&quot;/&quot;+vTempName;

            create($Path($ID), vTempName+&quot;#pLabelListContainer&quot;);
            $TypeOfList(vTempPath) = x;
            $ProjectContainer(vTempPath) = $Path($ID);
            //$Edict(vTempPath)=&quot;fMake&quot;+ x +&quot;List($ProjectContainer,$Path);\n$ProjectContainer=collect(ancestors,$Path)[-1];&quot;;
        };

        create($Path($ID), &quot;_quarto_manuscript#pYMLmanuscript&quot;);
        create($Path($ID), &quot;main#pFrontmatterManuscript&quot;);
        create($Path($ID) + &quot;/main&quot;, &quot;SectionTitle#pSubnoteManuscript&quot;);
        create($Path($ID), &quot;Authors#pAuthorsContainer&quot;);
        create($Path($ID)+&quot;/Authors&quot;, &quot;Author#pAuthor&quot;);
        $Q_Title($Path($ID)+&quot;/main&quot;)=$Name($ID);
        $HTMLExportFileName($Path($ID))=fDeleteCharacters($Name($ID));

    }else{
        if($ChildCount($ID)&gt;0){
            ($Name($ID)+&quot; already has child Notes&quot;).show();
        }else{
            &quot;Please select a pManuscriptFolder Note&quot;.show();
        };
    };
};

function fCreateRevealjsProject(){
    var:string vTempPath;
    var:string vTempName;
    var:string vLabelList=[Figure;Table;Equation];
    
    if($Prototype($ID)==&quot;pRevealjsFolder&quot; &amp; $ChildCount($ID)==0){
        
        vLabelList.each(x){
            vTempName = x+&quot; Label List&quot;;
            vTempPath = $Path($ID)+&quot;/&quot;+vTempName;

            create($Path($ID), vTempName+&quot;#pLabelListContainer&quot;);
            $TypeOfList(vTempPath) = x;
            $ProjectContainer(vTempPath) = $Path($ID);
            //$Edict(vTempPath)=&quot;fMake&quot;+ x +&quot;List($ProjectContainer,$Path);\n$ProjectContainer=collect(ancestors,$Path)[-1];&quot;;
        };

        create($Path($ID), &quot;_quarto_manuscript#pYMLQuartolive&quot;);
        create($Path($ID), &quot;main#pFrontmatterRevealjs&quot;);
        create($Path($ID) + &quot;/main&quot;, &quot;Slide#pSubnoteRevealjs&quot;);
        $Q_Title($Path($ID)+&quot;/main&quot;)=$Name($ID);
        $HTMLExportFileName($Path($ID))=fDeleteCharacters($Name($ID));
    }else{
        if($ChildCount($ID)&gt;0){
            ($Name($ID)+&quot; already has child Notes&quot;).show();
        }else{
            &quot;Please select a pRevealjsFolder Note&quot;.show();
        };
    };
};


</text>
