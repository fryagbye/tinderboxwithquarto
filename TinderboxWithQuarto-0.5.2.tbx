<item ID="1765002019" Creator="fryagbye" >
<attribute name="Created" >2023-10-13T23:49:18+09:00</attribute>
<attribute name="DominantLanguage" >en</attribute>
<attribute name="Height" >1.86</attribute>
<attribute name="IsAction" >true</attribute>
<attribute name="Modified" >2025-05-03T20:31:10+09:00</attribute>
<attribute name="Name" >Make Table Label List</attribute>
<attribute name="NeverComposite" >true</attribute>
<attribute name="Q_Affiliation_ID" >119</attribute>
<attribute name="ScreenWidth" >454</attribute>
<attribute name="SelectionCount" >921</attribute>
<attribute name="Sentiment" >-0.3192307766</attribute>
<attribute name="Sentiments" >-0.2;-0.6;-0.6;-0.6;0;0;0;0;-0.6;0.8;-0.4;-0.4;-0.6;-0.4;-0.6;0;-0.2;-0.2;-0.4;0.8;-0.4;-0.4;-0.6;-0.4;-0.2;-0.4;0;0.2;-0.4;-0.4;-0.8;0.2;-0.2;-0.4;-0.6;-0.2;0;-0.2;-0.4;0;0;-0.8;-0.2;0;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.6;-0.4</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >44</attribute>
<attribute name="Ypos" >2.36</attribute>
<text >
function fMakeTableList(vContainer:string, vPath){
	var:string vName;
	var:string vTest;
	var:number vCount(0);
	var:string vLabel;
	var:string vTemp;
	var:list vList;

	if($IsLabelGenerateON(vPath)&amp;($Prototype(vPath)==&quot;pLabelListContainer&quot;|$Prototype($Prototype(vPath))==&quot;pLabelListContainer&quot;)){

		$Text(vPath)=;
		$MyList(vPath)=;
		$ListKey(vPath)=;
		$ListValue(vPath)=;
		$MyDictionary(vPath)=;
	
		//Notes contains chunk &quot;tbl-&quot; label 
		vList = collect_if(descendants(vContainer),$Text.contains(&quot;(#tbl-[\w\d-]*)+?&quot;)&amp;!$IsAlias&amp;$Prototype(parent)!=&quot;pLabelListContainer&quot;,$ID);

		vList.each(L){
			//L=L.replace(&apos;&quot;&apos;,&quot;&quot;);
			$Text(L).eachLine(aLine:aLine.contains(&quot;(#tbl-[\w\d-]*)+?&quot;)){
				vTemp = $1;
				vTemp = vTemp.replace(&quot;#tbl-&quot;,&quot;@tbl-&quot;);
				$MyList(vPath) += vTemp;
				$ListKey(vPath) += vTemp;
				$ListValue(vPath) += $Path(L);
				$MyDictionary(vPath) = $MyDictionary(vPath).add(&quot;{&quot;+ $ListKey(vPath) +&quot;:&quot;+ $ListValue(vPath) +&quot;}&quot;);
			};
		};
	

		$MyList(vPath).each(S){
			vName = S;
			vLabel = S.replace(&quot;@&quot;,&quot;&quot;);
			vTemp= vPath + &quot;/&quot; + S;
			vTest = $IDString(vTemp);

			if(vTest==&quot;&quot;&amp;vName!=&quot;@tbl-&quot;){
				create(vPath, vName + &quot;#pReferenceList&quot;);
				$OutlineBackgroundColor(vName)=&quot;purple&quot;;
			};
	//		$Text(vName) = fTableChunk($ListValue(vPath)[vCount], vLabel);
			if(vName!=&quot;@tbl-&quot;){	
				$Text(vPath)+= vName + &quot;\n&quot;;
			};
			vCount += 1;
		};
		vCount = 0;
		$ListKey(vPath).each(K){
			vName = vPath +&quot;/&quot;+ K;
			$ToDummyLinkPath(vName) = $ListValue(vPath)[vCount];
			$Text(vName) = fTableChunk($ListValue(vPath)[vCount], K.replace(&quot;@&quot;,&quot;&quot;));
			createLink(K, $ListValue(vPath)[vCount], &quot;dummy&quot;);
			vCount += 1;
		};
	};
};

function fTableChunk(vName:string, vLabel:string){
	var:string vReg;
	var:string vTemp;
	//vReg = &quot;:\s*(.*?)\s*\{#(&quot;+ vLabel +&quot;)\s*?\}\s*\n(?:\s*\|.*\n)+\n&quot;;
	vReg = &quot;:\s*(.*?)\s*\{#(&quot;+vLabel+&quot;)\s*?\}\s*\n(?:\s*\|.*\n)+&quot;;
	//vReg = &quot;```([\s\S]*?\{#(&quot;+ vLabel + &quot;)\}[\s\S]*?)```&quot;;
	if($Text(vName).contains(vReg)){
		return $0;
	};

};</text>
