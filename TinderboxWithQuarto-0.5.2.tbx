<attribute name="Name" >Construct Safe Absolute Path to an indicated Note</attribute>
<attribute name="ReadOnly" >true</attribute>
<attribute name="ScreenHeight" >37</attribute>
<attribute name="Sentiment" >-0.3891891982</attribute>
<attribute name="Sentiments" >0;0.2;-0.4;0.4;-0.4;-0.6;-0.2;-0.8;-0.6;-0.6;-0.6;-0.8;-0.4;0.8;0.2;0;-0.4;-0.6;-0.8;-0.4;-0.2;-0.8;-0.2;0;-0.6;-0.8;-0.8;-1;-0.8;0.6;-0.6;-0.8;0.2;-0.6;-0.8;-0.6;-0.6</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >215.5</attribute>
<attribute name="Ypos" >5.86</attribute>
<text >// Construct a “safe” absolute path to a Note referenced in the input
// argument, which can be any relative or absolute path reference,
// or the unique $ID of a Note.
// This function returns a path string with any forward or backward
// slashes found in note names escaped with a backslash. 
// By getting the $ID values for the list of ancestors for the
// referenced Note, this function avoids problems with semantic
// collisions when $Name strings might include semicolons that
// would be confused with list delimiters. 
//  
function ConstructSafePath2Note(note_ref)
{ // Capture the list of ancestors for the current note
  var:list ancestor_list;
  ancestor_list=$ID(ancestors(original(note_ref))); 
  // Construct a safe absolute path to the referenced note
  var:string escaped_path;
  // Set Path string initially to slash-escaped $Name of referenced Note
  escaped_path=&quot;/&quot;+$Name(original(note_ref)).replace(&quot;\\&quot;,&quot;\\\\&quot;).replace(&apos;/&apos;,&apos;\\/&apos;);

  ancestor_list.each(ancestor_id)
  { // Cleanse each ancestor name and prepend to Path
    escaped_path=&quot;/&quot;+$Name(ancestor_id)
      .replace(&quot;\\&quot;,&quot;\\\\&quot;)
      .replace(&apos;/&apos;,&apos;\\/&apos;)
      +escaped_path;
  };
return(escaped_path);
};

// Forked from CleansePath() on 2022-04-29 to allow getting a 
// Safe Path for a particular referenced note. In practice,
// this ConstructSafePath2Note() function can replace CleansePath(),
// while providing greater flexibility.
//
// Modified on 2022-05-20 to handle aliases correctly. Now, if the
// “note_ref” argument references an alias, then this function
// will return the escaped path to the original, instead of the
// path to the alias.
//
// On 2022-06-21, Modified name to be ConstructSafePath2Note instead
// of GetSafePath2Note to better clarify the objective and approach.

// This function requires Tinderbox version 9.1 or later
</text>
