<attribute name="Sentiments" >-0.4;-0.4;-0.4;-0.4;0;0;0.2;0.2;-0.6;0.8;-0.4;-0.4;-0.6;-0.8;-0.4;0.4;-0.6;0;-0.6;-0.2;0.2;-0.2;-0.6;-0.4;0.6;0;-0.8;0.2;0.2;0;-0.2;-0.4;-0.8;0.6;-0.6;-0.6;-0.8;-0.8;-0.8;-0.6;-0.8;0;-0.2;-0.4;0.8;-0.2;-0.2;0</attribute>
<attribute name="URL" >https://www.acrobatfaq.com/atbref95/index/Automating_Tinderbox/Coding/Action_Code/Operators/Full_Operator_List/create_containerStr_nameStr.html</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >51</attribute>
<attribute name="Ypos" >2.36</attribute>
<text >

function fMakeSectionList(vContainer:string, vPath:string){
	var:string vName;
	var:string vTest;
	var:number vCount(0);
	var:set vCheck;
	var:dictionary vDict=;
	var:string vTemp;


	if($IsLabelGenerateON(vPath)&amp;($Prototype(vPath)==&quot;pLabelListContainer&quot;|$Prototype($Prototype(vPath))==&quot;pLabelListContainer&quot;)){

		$Text(vPath)=;
		$MyList(vPath) =;
		$ListKey(vPath)=;
		$ListValue(vPath)=;
		$OutlineDepthBaseDictionary(vPath)=;
		$MyDictionary(vPath)=;

		$MyList(vPath) = collect_if(descendants(vContainer),$HasSectionLabel&amp;$SectionLabel&amp;!$IsAlias&amp;$Prototype(parent)!=&quot;pLabelListContainer&quot;,$Path);
		$MyList(vPath).each(L){
			L=L.replace(&apos;&quot;&apos;,&quot;&quot;);
			if(!(vCheck.contains($Path(L)))){
				vCheck +=  $Path(L);
				vDict+=dictionary($SectionLabel(L)+&quot;:&quot;+L+&quot;;&quot;);
				//$MyString(vPath)=vDict;
				$ListKey(vPath) += $SectionLabel(L);
				$ListValue(vPath) += L;
				
				if($SectionLabel(L)!=&quot;&quot;){
					$MyDictionary(vPath)+=dictionary(&quot;@sec-&quot; + $SectionLabel(L)+&quot;:&quot;+ L +&quot;;&quot;);
					if($Is_Part_qmd(L)){
						$OutlineDepthBaseDictionary(vPath) += dictionary(&quot;@sec-&quot; + $SectionLabel(L)+&quot;:&quot;+ 0 +&quot;;&quot;);
					}else{
						$OutlineDepthBaseDictionary(vPath) += dictionary(&quot;@sec-&quot; + $SectionLabel(L)+&quot;:&quot;+ $OutlineDepthBase(L) +&quot;;&quot;);
					};
				};
			};
		};
	
		vCount = 0;
		$ListKey(vPath).each(S){
			vName = &quot;@sec-&quot; + S;
			vTest = $IDString(vName);
			if(vTest==&quot;&quot;){
				create(vPath, vName+&quot;#pReferenceList&quot;);
				$OutlineBackgroundColor(vName)=&quot;blue&quot;;
			};
			$Text(vName) = exportedString($ListValue(vPath)[vCount], &quot;tNote&quot;);
			//参照元のアウトラインの階層を記録
			$OutlineDepthBase(vName) = $OutlineDepthBaseDictionary(vPath)[vName];
			$Text(vPath)+= $OutlineDepthBase(vName) + &quot;:&quot; + vName + &quot;\n&quot;;
			vCount += 1;
		};
		vCount = 0;

		$ListKey(vPath).each(K){
			K = &quot;@sec-&quot; + K;
			$ToDummyLinkPath(K) += $ListValue(vPath)[vCount];
			createLink(K, $ListValue(vPath)[vCount], &quot;dummy&quot;);
			vCount += 1;
		};
	};
};

</text>
