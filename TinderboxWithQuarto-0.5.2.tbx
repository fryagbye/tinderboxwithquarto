<attribute name="Tabs" >0.375;0.375;0.375;0.375;0.375;0.375;0.375;0.375;</attribute>
<attribute name="URL" >https://www.acrobatfaq.com/atbref10/index/Automating_Tinderbox/Coding/Action_Code/Operators/Full_Operator_List/attribute_attributeNameStr_keyStr.html</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >19.5</attribute>
<attribute name="Ypos" >8.5</attribute>
<text >// This code will be invoked by the Edicts for Attribute Notes.
// I.e., action($Text(&quot;/Hints/Library/Edict (Attribute Note)&quot;));

var:boolean is_new_attr=;

// Create new User Attribute. This will only succeed if there
// is not already an Attribute with the same name. 

is_new_attr=createAttribute($Name,$Subtitle);
if(is_new_attr)
{
  $MyDate=time(date(today)); // Capture creation date &amp; time
  $Caption=&quot;User Attribute created &quot;+$MyDate.format(&quot;Y-M0-D h:mm:s&quot;);
  // For number types, &quot;sequential&quot; has to be set via Inspector
  $MyBoolean=false; // &quot;sequential&quot; not initially set.
} else
{
  $Caption=&quot;User Attribute updated from this Note at &quot;+date(today).format(&quot;Y-M0-D h:mm:s&quot;);
};
// Copy $Text into the corresponding User Attribute&apos;s description.
action(&quot;attribute(&quot;+$Name+&apos;)[&quot;description&quot;]=&apos;+&quot;$Text&quot;);
// If $Checked is true or is_new_attr is true, then 
// also update the default, suggested, and lines settings
// for the User Attribute. 
if($Checked | is_new_attr)
{ // Then update default, suggested, and lines
  action(&quot;attribute(&quot;+$Name+&apos;)[&quot;default&quot;]=&apos;+&quot;$MyString&quot;);
  action(&quot;attribute(&quot;+$Name+&apos;)[&quot;suggested&quot;]=&apos;+&quot;$MySet&quot;);
  action(&quot;attribute(&quot;+$Name+&apos;)[&quot;lines&quot;]=&apos;+&quot;$MyNumber&quot;);
};

// The System Attributes used within the User Attribute Notes
// are mapped in this table:
//
// MyDictionary : Retrieval of complete attribute dictionary
//      Caption : Used to provide status, warnings, or errors
//     Subtitle : &quot;type&quot;
//    MyBoolean : &quot;sequential&quot;
//     MyString : &quot;default&quot;
//        MySet : &quot;suggested&quot;
//     MyNumber : &quot;lines&quot;
//         Text : &quot;description&quot;
</text>
