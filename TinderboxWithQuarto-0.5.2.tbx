	fSetForChunk($ID, true);
	fMakeChunkList();
	vCheck=false;
};

if($Prototype==&quot;pChunk&quot;){

	vCheck=false;
};

if(vCheck){
	(&quot;Please select pRChunk, pRChunkList, pPChunk or pChunk note&quot;).show();
};
</text>
