<attrib Name="Reflected_ID" parent="User" editable="1" visibleInEditor="1" lines="1" type="2" description="Reflection object notes within a Diagram Container will keep the ID of the note they reflect in this attribute. If the reflected note is moved, $ReflectedID can be used to reference it no matter where it is relocated. Although the link from a reflection object note to the original reflected note can also provide access, some diagram maintenance activities may be easier to code using this attribute.                                   " default="0" >
</attrib>
<attrib Name="Reflected_LinkTypes" parent="User" editable="1" visibleInEditor="1" lines="2" type="8" description="A set of Link Types that are allowed to be displayed in a diagram are kept in this attribute. It defaults to the Tinderbox-defined set of Link Types, but it can be extended to include user-defined Link Types, or to exclude standard Tinderbox Link Types. This attribute is associated with Diagram Containers, and when links are reflected into a diagram, this set determines which links are allowed to be reflected.                                     " default="agree;clarify;disagree;example;exception;note;response;update" >
</attrib>
<attrib Name="Reflected_Links" parent="User" editable="1" visibleInEditor="1" lines="1" type="13" description="A dictionary of all outbound, plain, visible links from the associated note. The dictionary key:value pairs are “destID:type” where “destID” is the $ID of the destination link and “type” is a list of link types. Normally, there will only be one member for the link type list, but it is possible to have multiple links between the same two notes as long as the link types are not the same. When a note is reflected into a Diagram container, then it will have this dictionary created automatically. Similarly, the associated “reflection note” in the Diagram will have a corresponding dictionary but only for links that are reflected into the Diagram, which means that the destIDs will be for reflection notes within the Diagram.              " default="" >
</attrib>
<attrib Name="Reflected_Notes" parent="User" editable="1" visibleInEditor="1" lines="3" type="13" description="This dictionary is maintained in a Diagram Container and used to lookup $ID for a reflection-object child in the diagram given the $ID of the reflected note. One use for this dictionary is periodically updating reflections and links and performing maintenance of a diagram&apos;s objects.                                      " default="" >
</attrib>
<attrib Name="Rename_in" parent="User" editable="1" visibleInEditor="1" lines="1" description=" " default="" >
</attrib>
<attrib Name="RscriptHTMLTemplate" parent="User" editable="1" visibleInEditor="1" lines="1" type="3" description=" " default="Rscript/template.html" >
</attrib>
<attrib Name="SafePath" parent="User" editable="1" visibleInEditor="1" lines="1" description="This is the “safe” or “cleansed” version of the absolute path to the note or container. If notes/containers might have problematical characters, such as slashes, then absolute references should use this string instead of $Path. Note that the stamp “Safe Paths:Construct $SafePath for Note” can be used to update $SafePath for the selected Note. Also, the function “ConstructSafePath2Note(note)” will update $SafePath for the note supplied as the argument.                                       " default="" >
</attrib>
<attrib Name="SecLabelListContainer" parent="User" editable="1" visibleInEditor="1" lines="1" description=" " default="/Section Label List" >
</attrib>
<attrib Name="SectionLabel" parent="User" editable="1" visibleInEditor="1" lines="1" description="Section Label for cross-reference " default="" >
