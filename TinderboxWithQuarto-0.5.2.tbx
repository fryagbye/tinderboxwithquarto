<text >function fMakeLinkSecFromReferenceList(vContainer,vNote){
	var:string vStrDic;
//	var:string vNote=$SecLabelListContainer(&quot;TBXConfig&quot;);
	var:string vTest;
	var:number vCount(0);

	$MyList(vNote) =;
	$MyDictionary(vNote)=;
	
//	$MyList(vNote) = collect_if(descendants($Container.contains($CurrentBookProject($AgentNameForQmdFiles(&quot;TBXConfig&quot;)))), $Text.contains(&quot;(@sec-[\w\d-]*)+?&quot;),$ID);
	$MyList(vNote) = collect_if(descendants(vContainer), $Text.contains(&quot;(@sec-[\w\d-]*)+?&quot;),$ID);
	$MyList(vNote).each(L){
			$Text(L).eachLine(aLine){
			vTest=aLine.contains(&quot;(@sec-[\w\d-]*)+?&quot;);
			vStrDic = &quot;{&quot;+$1 + &quot;:&quot; + L + &quot;}&quot;;
			$MyDictionary(vNote)=$MyDictionary(vNote).add(vStrDic);
			$FromDummyLinkPath($1) += $Path(L);
			createLink(L, $1, &quot;dummy&quot;); 
		};
	};
};

function fMakeLinkFigFromReferenceList(vContainer,vNote){
	var:string vStrDic;
//	var:string vNote=$FigLabelListContainer(&quot;TBXConfig&quot;);
	var:string vTest;
	var:number vCount(0);

	$MyList(vNote) =;
	$MyDictionary(vNote)=;

//	$MyList(vNote) = collect_if(descendants($Container.contains($CurrentBookProject($AgentNameForQmdFiles(&quot;TBXConfig&quot;)))), $Text.contains(&quot;(@fig-[\w\d-]*)+?&quot;), $ID);
	$MyList(vNote) = collect_if(descendants(vContainer), $Text.contains(&quot;(@fig-[\w\d-]*)+?&quot;), $ID);
	$MyList(vNote).each(L){
			$Text(L).eachLine(aLine){
			vTest=aLine.contains(&quot;(@fig-[\w\d-]*)+?&quot;);
			vStrDic = &quot;{&quot; + $1 + &quot;:&quot; + L + &quot;}&quot;;
			$MyDictionary(vNote)=$MyDictionary(vNote).add(vStrDic);
			$FromDummyLinkPath($1) += L;
			createLink(L, $1, &quot;dummy&quot;);
		};
	};

};


function fMakeLinkTableFromReferenceList(vContainer,vNote){
	var:string vStrDic;
//	var:string vNote=$TblLabelListContainer(&quot;TBXConfig&quot;);
