<attribute name="HTMLPreviewCommand" >export PATH=$HOME:/opt/homebrew/bin:/usr/local/bin:/Library/TeX/texbin/:$PATH;cd ~/github/tinderboxwithquarto;/usr/local/bin/Rscript -e &quot;library(datasets,warn.conflicts=F); library(dplyr,warn.conflicts=F); library(grDevices,warn.conflicts=F); library(graphics,warn.conflicts=F); library(kableExtra,warn.conflicts=F); library(knitr,warn.conflicts=F); library(rmarkdown,warn.conflicts=F); library(stats,warn.conflicts=F); lines &lt;- readLines(file(&apos;stdin&apos;), warn=FALSE);f &lt;- file(&apos;_RchunkPreviewOutput.qmd&apos;, &apos;w&apos;);cat(&apos;---\u000A&apos;, &apos;title: \u0022Utility\u0022\u000A&apos;, &apos;---\u000A&apos;, file=f, sep=&apos;&apos;);for (line in lines) {line &lt;- gsub(&apos;\`\`\`{webr&apos;,&apos;\`\`\`{r&apos;,line, fixed=TRUE); cat(line, &apos;\u000A&apos;, sep=&apos;&apos;, file=f); };  close(f);rendered_output &lt;- rmarkdown::render(&apos;_RchunkPreviewOutput.qmd&apos;, output_format=&apos;html_document&apos;, quiet=TRUE);cat(readLines(rendered_output), sep=&apos;\u000A&apos;);&quot;</attribute>
