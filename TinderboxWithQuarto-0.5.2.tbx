<text >&lt;!DOCTYPE html&gt;
&lt;html&gt;
&lt;head&gt;
  &lt;meta charset=&quot;UTF-8&quot;&gt;
  &lt;title&gt;^value($Name)^ - Pyodide Preview&lt;/title&gt;
  
  &lt;script src=&quot;https://cdn.jsdelivr.net/pyodide/v0.27.1/full/pyodide.js&quot;&gt;&lt;/script&gt;
  
  &lt;style&gt;
    body { font-family: -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif; padding: 20px; max-width: 800px; margin: 0 auto; color: #333; }
    h1 { border-bottom: 2px solid #eee; padding-bottom: 10px; }
    
    #code-display {
      background: #f8f9fa; border: 1px solid #e9ecef; border-radius: 4px;
      padding: 15px; margin-bottom: 15px; font-family: &quot;SFMono-Regular&quot;, Consolas, monospace;
      font-size: 0.9em; overflow-x: auto; color: #495057;
      white-space: pre-wrap;
    }

    /* 画像出力エリア */
    #output-plot { 
        text-align: center; 
        margin-top: 10px;
        min-height: 100px;
    }
    #output-plot img {
        max-width: 100%;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        border-radius: 4px;
    }

    #output-log { 
      background: #2d2d2d; color: #f8f8f2; padding: 15px; border-radius: 4px;
      font-family: monospace; white-space: pre-wrap; margin-top: 10px; display: none;
    }
    
    #status { font-size: 0.8em; color: #666; margin-bottom: 10px; font-style: italic; min-height: 1.2em;}
    .hidden { display: none !important; }
  &lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
  &lt;h1&gt;^value($Name)^&lt;/h1&gt;
  
  &lt;div id=&quot;status&quot;&gt;Initializing (v0.27.1)...&lt;/div&gt;
  &lt;div id=&quot;code-display&quot; class=&quot;hidden&quot;&gt;&lt;/div&gt;
  &lt;div id=&quot;output-plot&quot;&gt;&lt;/div&gt;
  &lt;div id=&quot;output-log&quot;&gt;&lt;/div&gt;

  &lt;script id=&quot;source-code&quot; type=&quot;text/template&quot;&gt;^value($Text)^&lt;/script&gt;

  &lt;script type=&quot;text/javascript&quot;&gt;
    const SHOW_FULL_ERROR_LOG = ^if($PyodideErrorOutput($HTMLExportTemplate))^true^else^false^endif^;
    const statusEl = document.getElementById(&quot;status&quot;);
    const logEl = document.getElementById(&quot;output-log&quot;);
    const codeEl = document.getElementById(&quot;code-display&quot;);

    function log(message, isSystem = false) {
      if (SHOW_FULL_ERROR_LOG) {
         logEl.style.display = &quot;block&quot;;
         logEl.textContent += message + &quot;\n&quot;;
         if(isSystem) statusEl.textContent = message; 
      } else {
         if (!isSystem) {
           logEl.style.display = &quot;block&quot;;
           logEl.textContent += message + &quot;\n&quot;;
         } else {
           statusEl.textContent = message;
         }
      }
    }

    function parseQuartoOptions(code) {
      const options = { echo: true, eval: true, output: true };
      const lines = code.split(&apos;\n&apos;);
      lines.forEach(line =&gt; {
        const trimmed = line.trim();
        if (trimmed.startsWith(&quot;#|&quot;)) {
          const parts = trimmed.replace(/^#\|\s*/, &apos;&apos;).split(&apos;:&apos;);
          if (parts.length &gt;= 2) {
            const key = parts[0].trim();
            const val = parts[1].trim().toLowerCase();
            if (val === &apos;false&apos;) options[key] = false;
            else if (val === &apos;true&apos;) options[key] = true;
          }
        }
      });
      return options;
    }

    function injectImports(code) {
        let imports = [];
        const hasNumpy = code.includes(&quot;np.&quot;) || code.includes(&quot;numpy&quot;);
        const hasPandas = code.includes(&quot;pd.&quot;) || code.includes(&quot;pandas&quot;);
        // Matplotlib検知
        const hasMatplotlib = code.includes(&quot;plt.&quot;) || code.includes(&quot;matplotlib&quot;);
        // Seaborn検知（またはMatplotlibがある場合も強制的にSeabornを意識させる）
        const hasSeaborn = code.includes(&quot;sns.&quot;) || code.includes(&quot;seaborn&quot;) || hasMatplotlib;

        if (hasNumpy &amp;&amp; !code.match(/import\s+numpy/)) imports.push(&quot;import numpy as np&quot;);
        if (hasPandas &amp;&amp; !code.match(/import\s+pandas/)) imports.push(&quot;import pandas as pd&quot;);
        if (hasMatplotlib &amp;&amp; !code.match(/import\s+matplotlib\.pyplot/)) imports.push(&quot;import matplotlib.pyplot as plt&quot;);
        
        // 【修正点1】Matplotlibがある場合、Seabornも自動でimportリストに入れる
        if (hasSeaborn &amp;&amp; !code.match(/import\s+seaborn/)) imports.push(&quot;import seaborn as sns&quot;);

        if (imports.length &gt; 0) return imports.join(&quot;\n&quot;) + &quot;\n&quot; + code;
        return code;
    }

    async function main() {
      try {
        let rawCode = document.getElementById(&quot;source-code&quot;).text;
        let cleanCode = rawCode.replace(/```\{python\}|```/g, &quot;&quot;).trim();
        const opts = parseQuartoOptions(cleanCode);

        if (opts.echo) {
          codeEl.textContent = cleanCode;
          codeEl.classList.remove(&quot;hidden&quot;);
        }

        if (!opts.eval) {
          log(&quot;&quot;, true);
          return;
        }

        let executableCode = injectImports(cleanCode);
        
        // 描画系のライブラリを使うかどうかのフラグ
        const useViz = executableCode.includes(&quot;matplotlib&quot;) || executableCode.includes(&quot;plt.&quot;) || executableCode.includes(&quot;seaborn&quot;) || executableCode.includes(&quot;sns.&quot;);

        log(&quot;Loading Pyodide core...&quot;, true);
        let pyodide = await loadPyodide({
          stdout: (text) =&gt; { 
              if (text.startsWith(&quot;Loading &quot;) || text.startsWith(&quot;Loaded &quot;)) {
                  log(text, true); 
              } else if (opts.output) {
                  log(text, false); 
              }
          },
          stderr: (text) =&gt; {
             if (text.includes(&quot;font cache&quot;) || text.includes(&quot;FigureCanvasAgg&quot;)) {
                 log(text, true); 
             } else {
                 if(SHOW_FULL_ERROR_LOG) log(text, false);
                 else log(&quot;Error: &quot; + text, false);
             }
          }
        });

        // 1. 標準パッケージロード (Numpy, Pandas, Matplotlib)
        let packagesToLoad = [];
        if (executableCode.includes(&quot;numpy&quot;) || executableCode.includes(&quot;np.&quot;)) packagesToLoad.push(&quot;numpy&quot;);
        if (executableCode.includes(&quot;pandas&quot;) || executableCode.includes(&quot;pd.&quot;)) packagesToLoad.push(&quot;pandas&quot;);
        
        // Matplotlibはここでロード
        if (useViz) {
            packagesToLoad.push(&quot;matplotlib&quot;);
        }
        
        if (packagesToLoad.length &gt; 0) {
            log(&quot;Loading standard packages...&quot;, true);
            await pyodide.loadPackage(packagesToLoad);
        }

        // 2. Seabornのインストール (Matplotlibを使う場合は必ず入れる)
        // 【修正点2】条件を useViz (Matplotlib含む) に変更
        if (useViz) {
            log(&quot;Loading micropip...&quot;, true);
            await pyodide.loadPackage(&quot;micropip&quot;);
            
            log(&quot;Installing seaborn &amp; dependencies (this takes time)...&quot;, true);
            
            // 明示的に依存関係(pandas, scipy)を先にロードして安定化
            // scipyは重いがseabornに必須
            await pyodide.loadPackage([&quot;pandas&quot;, &quot;scipy&quot;]); 
            
            await pyodide.runPythonAsync(`
                import micropip
                # Matplotlibが入っているならSeabornをインストールしてエラーを防ぐ
                await micropip.install(&apos;seaborn&apos;)
            `);
            log(&quot;Seaborn installed.&quot;, true);
        }

        // 残りのimport
        await pyodide.loadPackagesFromImports(executableCode);

        // Matplotlib/Seaborn 共通セットアップ
        if (useViz) {
             log(&quot;Configuring graphics...&quot;, true);
             await pyodide.runPythonAsync(`
                import matplotlib
                matplotlib.use(&quot;Agg&quot;) 
                import matplotlib.pyplot as plt
                
                # Seabornをimportしてデフォルトスタイルを適用可能にする
                import seaborn as sns
                
                from js import document
                import io, base64

                # デフォルトスタイル設定 (エラー回避のためseabornインストール後に実行)
                sns.set_theme(style=&quot;whitegrid&quot;)

                # plt.show() を無効化
                def custom_plt_show(*args, **kwargs):
                    pass 
                plt.show = custom_plt_show

                # 描画関数
                def show_current_plot_mpl():
                    if plt.get_fignums():
                        buf = io.BytesIO()
                        plt.savefig(buf, format=&apos;png&apos;, dpi=120, bbox_inches=&apos;tight&apos;)
                        buf.seek(0)
                        img_str = base64.b64encode(buf.read()).decode(&apos;UTF-8&apos;)
                        if &quot;${opts.output}&quot; == &quot;true&quot;:
                            img_html = f&apos;&lt;img src=&quot;data:image/png;base64,{img_str}&quot; /&gt;&apos;
                            div = document.getElementById(&apos;output-plot&apos;)
                            div.innerHTML = img_html
                        plt.clf()
            `);
        }

        // 実行
        log(&quot;Running Python code...&quot;, true);
        let result = await pyodide.runPythonAsync(executableCode);

        // 描画反映
        if (useViz &amp;&amp; opts.output) {
             await pyodide.runPythonAsync(`show_current_plot_mpl()`);
        }

        if (!SHOW_FULL_ERROR_LOG) log(&quot;&quot;, true);
        if(result &amp;&amp; opts.output) log(&quot;Result: &quot; + result, false);

      } catch (err) {
        log(&quot;Execution Error: &quot; + err, false);
        console.error(err);
      }
    }

    main();
  &lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;</text>
