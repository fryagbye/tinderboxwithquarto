<text >if($HasSectionLabel){
	$HasSectionLabel=false;
}else{
	if($SectionLabel==&quot;&quot;){
		fRenameIn($Name);
		$IsNamesLocked=true;
	};
	$HasSectionLabel=true;
};</text>
