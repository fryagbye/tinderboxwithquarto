<attribute name="NeverComposite" >true</attribute>
<attribute name="QR_Attributes" >QR_Date:{create:true;type:date;suggested:[];default:;description:&apos;Document date&apos;;OptionName:date;};QR_FigAsp:{create:false;type:number;suggested:[];default:;description:&apos;The aspect ratio of the plot, i.e., the ratio of height/width. When fig-asp is specified, the height of a plot (the option fig-height) is calculated from fig-width * fig-asp.The fig-asp option is only available within the knitr engine.&apos;;OptionName:fig-asp;};QR_IncludeBeforeBody:{create:true;type:string;suggested:[];default:;description:&apos;Include contents at the beginning of the document body (e.g. after the &lt;body&gt; tag in HTML, or the \begin{document} command in LaTeX).A string value or an object with key “file” indicates a filename whose contents are to be includedAn object with key “text” indicates textual content to be included&apos;;OptionName:include-before-body;};QR_TocDepth:{create:true;type:number;suggested:[];default:;description:&apos;Specify the number of section levels to include in the table of contents. The default is 3&apos;;OptionName:toc-depth;};QR_CenterTitleSlide:{create:false;type:boolean;suggested:[];default:;description:&apos;Vertical centering of title slide&apos;;OptionName:center-title-slide;};QR_ParallaxBackgroundSize:{create:true;type:string;suggested:[];default:;description:&apos;Parallax background size (e.g. ‘2100px 900px’)&apos;;OptionName:parallax-background-size;};QR_Touch:{create:true;type:boolean;suggested:[];default:;description:&apos;Enable touch navigation on devices with touch input&apos;;OptionName:touch;};QR_Chalkboard:{create:true;type:boolean;suggested:[];default:;description:&apos;Configuration for revealjs chalkboard.&apos;;OptionName:chalkboard;};QR_Pagetitle:{create:true;type:string;suggested:[];default:;description:&apos;Sets the title metadata for the document&apos;;OptionName:pagetitle;};QR_SlideLevel:{create:true;type:number;suggested:[];default:;description:&apos;Specifies that headings with the specified level create slides. Headings above this level in the hierarchy are used to divide the slide show into sections; headings below this level create subheads within a slide. Valid values are 0-6. If a slide level of 0 is specified, slides will not be split automatically on headings, and horizontal rules must be used to indicate slide boundaries. If a slide level is not specified explicitly, the slide level will be set automatically based on the contents of the document&apos;;OptionName:slide-level;};QR_CitationAbbreviations:{create:false;type:string;suggested:[];default:;description:&apos;JSON file containing abbreviations of journals that should be used in formatted bibliographies when form=short is specified. The format of the file can be illustrated with an example:{ default: {    container-title: {      Lloyds Law Reports: Lloyds Rep,      Estates Gazette: EG,      Scots Law Times: SLT    }  }}&apos;;OptionName:citation-abbreviations;};QR_LinkExternalFilter:{create:false;type:string;suggested:[];default:;description:&apos;A regular expression that can be used to determine whether a link is an internal link. For example, the following will treat links that start with http://www.quarto.org as internal links (and others will be considered external):^(?:http:|https:)\/\/www\.quarto\.org\/custom&apos;;OptionName:link-external-filter;};QR_Margin:{create:true;type:number;suggested:[];default:;description:&apos;For revealjs, the factor of the display size that should remain empty around the content (e.g. 0.1).For typst, a dictionary with the fields defined in the Typst documentation: x, y, top, bottom, left, right (margins are specified in cm units, e.g. 5cm).&apos;;OptionName:margin;};QR_HideCursorTime:{create:true;type:number;suggested:[];default:;description:&apos;Time before the cursor is hidden (in ms)&apos;;OptionName:hide-cursor-time;};QR_Bibliography:{create:false;type:file;suggested:[];default:;description:&apos;Document bibliography (BibTeX or CSL). May be a single file or a list of files&apos;;OptionName:bibliography;};QR_FigDpi:{create:true;type:number;suggested:[];default:;description:&apos;Default DPI for figures generated by Matplotlib or R graphics.Note that with the Jupyter engine, this option has no effect when provided at the cell level; it can only be provided with document or project metadata.&apos;;OptionName:fig-dpi;};QR_TemplatePartials:{create:true;type:file;suggested:[];default:;description:&apos;Include the specified files as partials accessible to the template for the generated content.&apos;;OptionName:template-partials;};QR_SyntaxDefinitions:{create:false;type:file;suggested:[];default:;description:&apos;KDE language syntax definition files (XML)&apos;;OptionName:syntax-definitions;};QR_DateMeta:{create:true;type:set;suggested:[];default:;description:&apos;Sets the date metadata for the document&apos;;OptionName:date-meta;};QR_IncludeAfterBody:{create:true;type:string;suggested:[];default:;description:&apos;Include content at the end of the document body immediately after the markdown content. While it will be included before the closing &lt;/body&gt; tag in HTML and the \end{document} command in LaTeX, this option refers to the end of the markdown content.A string value or an object with key “file” indicates a filename whose contents are to be includedAn object with key “text” indicates textual content to be included&apos;;OptionName:include-after-body;};QR_FigFormat:{create:true;type:string;suggested:[retina;png;jpeg;svg;pdf];default:;description:&apos;Default format for figures generated by Matplotlib or R graphics (retina, png, jpeg, svg, or pdf)&apos;;OptionName:fig-format;};QR_Title:{create:true;type:string;suggested:[];default:;description:&apos;Document title&apos;;OptionName:title;};QR_Menu:{create:true;type:boolean;suggested:[];default:;description:&apos;Configuration for revealjs menu.&apos;;OptionName:menu;};QR_HtmlTableProcessing:{create:true;type:string;suggested:[none];default:;description:&apos;If none, do not process tables in HTML input.&apos;;OptionName:html-table-processing;};QR_Multiplex:{create:true;type:boolean;suggested:[];default:;description:&apos;Configuration for reveal presentation multiplexing.&apos;;OptionName:multiplex;};QR_Theme:{create:true;type:list;suggested:[];default:;description:&apos;Theme name, theme scss file, or a mix of both.&apos;;OptionName:theme;};QR_Resources:{create:true;type:string;suggested:[];default:;description:&apos;Path (or glob) to files to publish with this document.&apos;;OptionName:resources;};QR_Scrollable:{create:true;type:boolean;suggested:[];default:;description:&apos;true to allow content that overflows slides vertically to scroll. This can also be set per-slide by including the .scrollable class on the slide title.&apos;;OptionName:scrollable;};QR_Height:{create:true;type:number;suggested:[];default:;description:&apos;The “normal” height of the presentation, aspect ratio will be preserved when the presentation is scaled to fit different resolutions. Can be specified using percentage units.&apos;;OptionName:height;};QR_MarginTop:{create:true;type:string;suggested:[];default:;description:&apos;For HTML output, sets the margin-top property on the Body element.For LaTeX output, sets the top margin if geometry is not used (otherwise geometry overrides this value)For ConTeXt output, sets the top margin if layout is not used, otherwise layout overrides these.For wkhtmltopdf sets the top page margin.&apos;;OptionName:margin-top;};QR_IdentifierPrefix:{create:false;type:string;suggested:[];default:;description:&apos;Specify a prefix to be added to all identifiers and internal links in HTML and DocBook output, and to footnote numbers in Markdown and Haddock output. This is useful for preventing duplicate identifiers when generating fragments to be included in other pages.&apos;;OptionName:identifier-prefix;};QR_OutputExt:{create:true;type:string;suggested:[];default:;description:&apos;Extension to use for generated output file&apos;;OptionName:output-ext;};QR_Subtitle:{create:true;type:string;suggested:[];default:;description:&apos;Identifies the subtitle of the document.&apos;;OptionName:subtitle;};QR_FootnotesHover:{create:true;type:boolean;suggested:[];default:;description:&apos;Enables a hover popup for footnotes that shows the footnote contents.&apos;;OptionName:footnotes-hover;};QR_CodeOverflow:{create:true;type:string;suggested:[scroll;wrap];default:;description:&apos;Choose how to handle code overflow, when code lines are too wide for their container. One of:scrollwrap&apos;;OptionName:code-overflow;};QR_MaxScale:{create:true;type:number;suggested:[];default:;description:&apos;Bounds for largest possible scale to apply to content&apos;;OptionName:max-scale;};QR_JumpToSlide:{create:true;type:boolean;suggested:[];default:;description:&apos;Deactivate jump to slide feature.&apos;;OptionName:jump-to-slide;};QR_TransitionSpeed:{create:true;type:string;suggested:[default;fast;slow];default:;description:&apos;Slide transition speed (default, fast, or slow)&apos;;OptionName:transition-speed;};QR_ParallaxBackgroundHorizontal:{create:true;type:string;suggested:[];default:;description:&apos;Number of pixels to move the parallax background horizontally per slide.&apos;;OptionName:parallax-background-horizontal;};QR_Citeproc:{create:true;type:boolean;suggested:[];default:;description:&apos;Turn on built-in citation processing. To use this feature, you will need to have a document containing citations and a source of bibliographic data: either an external bibliography file or a list of references in the document’s YAML metadata. You can optionally also include a csl citation style file.&apos;;OptionName:citeproc;};QR_IncludeInHeader:{create:true;type:string;suggested:[];default:;description:&apos;Include contents at the end of the header. This can be used, for example, to include special CSS or JavaScript in HTML documents.A string value or an object with key “file” indicates a filename whose contents are to be includedAn object with key “text” indicates textual content to be included&apos;;OptionName:include-in-header;};QR_CitationsHover:{create:true;type:boolean;suggested:[];default:;description:&apos;Enables a hover popup for citation that shows the reference information.&apos;;OptionName:citations-hover;};QR_Lang:{create:true;type:string;suggested:[];default:;description:&apos;Identifies the main language of the document using IETF language tags (following the BCP 47 standard), such as en or en-GB. The Language subtag lookup tool can look up or verify these tags.This affects most formats, and controls hyphenation in PDF output when using LaTeX (through babel and polyglossia) or ConTeXt.&apos;;OptionName:lang;};QR_CodeAnnotations:{create:true;type:boolean;suggested:[];default:;description:&apos;The style to use when displaying code annotations. Set this value to false to hide code annotations.&apos;;OptionName:code-annotations;};QR_ShowNotes:{create:false;type:boolean;suggested:[];default:;description:&apos;Make speaker notes visible to all viewers&apos;;OptionName:show-notes;};QR_FigHeight:{create:true;type:number;suggested:[];default:;description:&apos;Default height for figures generated by Matplotlib or R graphics.Note that with the Jupyter engine, this option has no effect when provided at the cell level; it can only be provided with document or project metadata.&apos;;OptionName:fig-height;};QR_Language:{create:true;type:file;suggested:[];default:;description:&apos;YAML file containing custom language translations&apos;;OptionName:language;};QR_ShiftHeadingLevelBy:{create:true;type:number;suggested:[];default:;description:&apos;Shift heading levels by a positive or negative integer. For example, with shift-heading-level-by: -1, level 2 headings become level 1 headings, and level 3 headings become level 2 headings. Headings cannot have a level less than 1, so a heading that would be shifted below level 1 becomes a regular paragraph. Exception: with a shift of -N, a level-N heading at the beginning of the document replaces the metadata title.&apos;;OptionName:shift-heading-level-by;};QR_ViewDistance:{create:true;type:number;suggested:[];default:;description:&apos;Number of slides away from the current slide to pre-load resources for&apos;;OptionName:view-distance;};QR_PdfSeparateFragments:{create:true;type:boolean;suggested:[];default:;description:&apos;Prints each fragment on a separate slide&apos;;OptionName:pdf-separate-fragments;};QR_TitleSlideAttributes:{create:false;type:string;suggested:[];default:;description:&apos;Additional attributes for the title slide of a reveal.js presentation as a map of attribute names and values. For example  title-slide-attributes:      data-background-image: /path/to/title_image.png      data-background-size: contain      (Note that the data- prefix is required here, as it isn’t added automatically.)&apos;;OptionName:title-slide-attributes;};QR_MarginLeft:{create:true;type:string;suggested:[];default:;description:&apos;For HTML output, sets the margin-left property on the Body element.For LaTeX output, sets the left margin if geometry is not used (otherwise geometry overrides this value)For ConTeXt output, sets the left margin if layout is not used, otherwise layout overrides these.For wkhtmltopdf sets the left page margin.For LaTeX output, sets the left margin if geometry is not used (otherwise geometry overrides this value)For ConTeXt output, sets the left margin if layout is not used, otherwise layout overrides these.For wkhtmltopdf sets the left page margin.&apos;;OptionName:margin-left;};QR_Smaller:{create:true;type:boolean;suggested:[];default:;description:&apos;true to use a smaller default font for slide content. This can also be set per-slide by including the .smaller class on the slide title.&apos;;OptionName:smaller;};QR_CodeCopy:{create:true;type:string;suggested:[true;false;hover];default:;description:&apos;Enable a code copy icon for code blocks.true: Always show the iconfalse: Never show the iconhover (default): Show the icon when the mouse hovers over the code block&apos;;OptionName:code-copy;};QR_PreloadIframes:{create:true;type:string;suggested:[null;true;false];default:;description:&apos;Global override for preloading lazy-loaded iframesnull: Iframes with data-src AND data-preload will be loaded when within the viewDistance, iframes with only data-src will be loaded when visibletrue: All iframes with data-src will be loaded when within the viewDistancefalse: All iframes with data-src will be loaded only when visible&apos;;OptionName:preload-iframes;};QR_Include:{create:true;type:boolean;suggested:[];default:;description:&apos;Catch all for preventing any output (code or results) from being included in output.&apos;;OptionName:include;};QR_HashType:{create:true;type:string;suggested:[number;title];default:;description:&apos;URL hash type (number or title)&apos;;OptionName:hash-type;};QR_CodeLink:{create:false;type:boolean;suggested:[];default:;description:&apos;Enables hyper-linking of functions within code blocks to their online documentation.Code linking is currently implemented only for the knitr engine (via the downlit package). A limitation of downlit currently prevents code linking if code-line-numbers is also true.&apos;;OptionName:code-link;};QR_NavigationMode:{create:true;type:string;suggested:[linear;vertical;grid];default:;description:&apos;Changes the behavior of navigation directions.linear: Removes the up/down arrows. Left/right arrows step through all slides (both horizontal and vertical).vertical: Left/right arrow keys step between horizontal slides, up/down arrow keys step between vertical slides. Space key steps through all slides (both horizontal and vertical).grid: When this is enabled, stepping left/right from a vertical stack to an adjacent vertical stack will land you at the same vertical index.&apos;;OptionName:navigation-mode;};QR_OutputLocation:{create:true;type:string;suggested:[default;fragment;slide;column;column-fragment];default:;description:&apos;Location of output relative to the code that generated it. The possible values are as follows:default: Normal flow of the slide after the codefragment: In a fragment (not visible until you advance)slide: On a new slide after the curent onecolumn: In an adjacent columncolumn-fragment: In an adjacent column (not visible until you advance)Note that this option is supported only for the revealjs format.&apos;;OptionName:output-location;};QR_ControlsLayout:{create:true;type:string;suggested:[edges;bottom-right];default:;description:&apos;Location for navigation controls (edges or bottom-right)&apos;;OptionName:controls-layout;};QR_EmailObfuscation:{create:true;type:string;suggested:[javascript;references;none];default:;description:&apos;Specify a method for obfuscating mailto: links in HTML documents.javascript: Obfuscate links using JavaScript.references: Obfuscate links by printing their letters as decimal or hexadecimal character references.none (default): Do not obfuscate links.&apos;;OptionName:email-obfuscation;};QR_MetadataFiles:{create:true;type:file;suggested:[];default:;description:&apos;Read metadata from the supplied YAML (or JSON) files. This option can be used with every input format, but string scalars in the YAML file will always be parsed as Markdown. Generally, the input will be handled the same as in YAML metadata blocks. Values in files specified later in the list will be preferred over those specified earlier. Metadata values specified inside the document, or by using -M, overwrite values specified with this option.&apos;;OptionName:metadata-files;};QR_CodeSummary:{create:true;type:string;suggested:[];default:;description:&apos;Summary text to use for code blocks collapsed using code-fold&apos;;OptionName:code-summary;};QR_Echo:{create:true;type:boolean;suggested:[];default:;description:&apos;Include cell source code in rendered output.true (default in most formats): include source code in outputfalse (default in presentation formats like beamer, revealjs, and pptx): do not include source code in outputfenced: in addition to echoing, include the cell delimiter as part of the output.[...]: A list of positive or negative line numbers to selectively include or exclude lines (explicit inclusion/excusion of lines is available only when using the knitr engine)true (default in most formats): include source code in outputfalse (default in presentation formats like beamer, revealjs, and pptx): do not include source code in outputfenced: in addition to echoing, include the cell delimiter as part of the output.[...]: A list of positive or negative line numbers to selectively include or exclude lines (explicit inclusion/excusion of lines is available only when using the knitr engine)&apos;;OptionName:echo;};QR_OutputFile:{create:true;type:file;suggested:[];default:;description:&apos;Output file to write to&apos;;OptionName:output-file;};QR_Incremental:{create:true;type:boolean;suggested:[];default:;description:&apos;Make list items in slide shows display incrementally (one by one). The default is for lists to be displayed all at once.&apos;;OptionName:incremental;};QR_MouseWheel:{create:true;type:boolean;suggested:[];default:;description:&apos;Enable slide navigation via mouse wheel&apos;;OptionName:mouse-wheel;};QR_TblCapLocation:{create:true;type:string;suggested:[top;bottom;margin];default:;description:&apos;Where to place table captions (top, bottom, or margin)&apos;;OptionName:tbl-cap-location;};{create:true;type:string;suggested:[top;bottom;margin];default:;description:&apos;Where to place table captions (top, bottom, or margin)&apos;;OptionName:tbl-cap-location;};QR_AutoSlideStoppable:{create:true;type:boolean;suggested:[];default:;description:&apos;Stop auto-sliding after user input&apos;;OptionName:auto-slide-stoppable;};QR_CapLocation:{create:true;type:string;suggested:[top;bottom;margin];default:;description:&apos;Where to place figure and table captions (top, bottom, or margin)&apos;;OptionName:cap-location;};QR_IndentedCodeClasses:{create:false;type:string;suggested:[];default:;description:&apos;Specify classes to use for all indented code blocks&apos;;OptionName:indented-code-classes;};QR_DescriptionMeta:{create:true;type:set;suggested:[];default:;description:&apos;Sets the description metadata for the document&apos;;OptionName:description-meta;};QR_MobileViewDistance:{create:true;type:number;suggested:[];default:;description:&apos;Number of slides away from the current slide to pre-load resources for (on mobile devices).&apos;;OptionName:mobile-view-distance;};QR_LinkExternalIcon:{create:true;type:boolean;suggested:[];default:;description:&apos;Show a special icon next to links that leave the current site.&apos;;OptionName:link-external-icon;};QR_CodeLineNumbers:{create:true;type:list;suggested:[];default:;description:&apos;Include line numbers in code block output (true or false).For revealjs output only, you can also specify a string to highlight specific lines (and/or animate between sets of highlighted lines).Sets of lines are denoted with commas:3,4,51,10,12Ranges can be denoted with dashes and combined with commas:1-3,55-10,12,14Finally, animation steps are separated by |:1-3|1-3,5 first shows 1-3, then 1-3,5|5|5-10,12 first shows no numbering, then 5, then lines 5-10 and 12&apos;;OptionName:code-line-numbers;};QR_Overview:{create:true;type:boolean;suggested:[];default:;description:&apos;Enable the slide overview mode&apos;;OptionName:overview;};QR_EmbedResources:{create:true;type:boolean;suggested:[];default:;description:&apos;Produce a standalone HTML file with no external dependencies, using data: URIs to incorporate the contents of linked scripts, stylesheets, images, and videos. The resulting file should be “self-contained,” in the sense that it needs no external files and no net access to be displayed properly by a browser. This option works only with HTML output formats, including html4, html5, html+lhs, html5+lhs, s5, slidy, slideous, dzslides, and revealjs. Scripts, images, and stylesheets at absolute URLs will be downloaded; those at relative URLs will be sought relative to the working directory (if the first source file is local) or relative to the base URL (if the first source file is remote). Elements with the attribute data-external=1 will be left alone; the documents they link to will not be incorporated in the document. Limitation: resources that are loaded dynamically through JavaScript cannot be incorporated; as a result, some advanced features (e.g. zoom or speaker notes) may not work in an offline “self-contained” reveal.js slide show.&apos;;OptionName:embed-resources;};QR_ExtractMedia:{create:true;type:file;suggested:[];default:;description:&apos;Extract images and other media contained in or linked from the source document to the path DIR, creating it if necessary, and adjust the images references in the document so they point to the extracted files. Media are downloaded, read from the file system, or extracted from a binary container (e.g. docx), as needed. The original file paths are used if they are relative paths not containing … Otherwise filenames are constructed from the SHA1 hash of the contents.&apos;;OptionName:extract-media;};QR_AutoPlayMedia:{create:true;type:string;suggested:[null;true;false];default:;description:&apos;Autoplay embedded media (null, true, or false). Default is null (only when autoplay attribute is specified)&apos;;OptionName:auto-play-media;};QR_SelfContainedMath:{create:true;type:boolean;suggested:[];default:;description:&apos;Embed math libraries (e.g. MathJax) within self-contained output. Note that math libraries are not embedded by default because they are quite large and often time consuming to download.&apos;;OptionName:self-contained-math;};QR_HtmlQTags:{create:true;type:boolean;suggested:[];default:;description:&apos;Use &lt;q&gt; tags for quotes in HTML.&apos;;OptionName:html-q-tags;};QR_AutoAnimate:{create:true;type:boolean;suggested:[];default:;description:&apos;Globally enable/disable auto-animate (enabled by default)&apos;;OptionName:auto-animate;};QR_Output:{create:true;type:string;suggested:[true;false;asis];default:;description:&apos;Include the results of executing the code in the output. Possible values:true: Include results.false: Do not include results.asis: Treat output as raw markdown with no enclosing containers.&apos;;OptionName:output;};QR_FigWidth:{create:true;type:number;suggested:[];default:;description:&apos;Default width for figures generated by Matplotlib or R graphics.Note that with the Jupyter engine, this option has no effect when provided at the cell level; it can only be provided with document or project metadata.&apos;;OptionName:fig-width;};QR_Grid:{create:true;type:string;suggested:[];default:;description:&apos;Properties of the grid system used to layout Quarto HTML pages.&apos;;OptionName:grid;};QR_Keywords:{create:true;type:set;suggested:[];default:;description:&apos;List of keywords to be included in the document metadata.&apos;;OptionName:keywords;};QR_HashOneBasedIndex:{create:true;type:boolean;suggested:[];default:;description:&apos;Use 1 based indexing for hash links to match slide number&apos;;OptionName:hash-one-based-index;};QR_MaxWidth:{create:true;type:boolean;suggested:[];default:;description:&apos;Adds a css max-width to the body Element.&apos;;OptionName:max-width;};QR_PlotlyConnected:{create:true;type:boolean;suggested:[];default:;description:&apos;If true, use the “notebook_connected” plotly renderer, which downloads its dependencies from a CDN and requires an internet connection to view.&apos;;OptionName:plotly-connected;};QR_Abbreviations:{create:false;type:file;suggested:[];default:;description:&apos;Specifies a custom abbreviations file, with abbreviations one to a line. This list is used when reading Markdown input: strings found in this list will be followed by a nonbreaking space, and the period will not produce sentence-ending space in formats like LaTeX. The strings may not contain spaces.&apos;;OptionName:abbreviations;};QR_Cache:{create:true;type:string;suggested:[true;false;refresh];default:;description:&apos;Cache results of computations (using the knitr cache for R documents, and Jupyter Cache for Jupyter documents).Note that cache invalidation is triggered by changes in chunk source code (or other cache attributes you’ve defined).true: Cache resultsfalse: Do not cache resultsrefresh: Force a refresh of the cache even if has not been otherwise invalidated.&apos;;OptionName:cache;};QR_Error:{create:true;type:boolean;suggested:[];default:;description:&apos;Include errors in the output (note that this implies that errors executing code will not halt processing of the document).&apos;;OptionName:error;};QR_ParallaxBackgroundImage:{create:true;type:file;suggested:[];default:;description:&apos;Parallax background image&apos;;OptionName:parallax-background-image;};QR_AutoAnimateUnmatched:{create:true;type:boolean;suggested:[];default:;description:&apos;Auto-animate unmatched elements. Can be overridden per-slide or per-element via attributes.&apos;;OptionName:auto-animate-unmatched;};QR_ParallaxBackgroundVertical:{create:true;type:string;suggested:[];default:;description:&apos;Number of pixels to move the parallax background vertically per slide.&apos;;OptionName:parallax-background-vertical;};QR_NumberSections:{create:true;type:boolean;suggested:[];default:;description:&apos;Number section headings rendered output. By default, sections are not numbered. Sections with class .unnumbered will never be numbered, even if number-sections is specified.&apos;;OptionName:number-sections;};QR_Pause:{create:true;type:number;suggested:[];default:;description:&apos;Flags whether it should be possible to pause the presentation (blackout)&apos;;OptionName:pause;};QR_TblColwidths:{create:true;type:string;suggested:[auto;true;false;];default:;description:&apos;Apply explicit table column widths for markdown grid tables and pipe tables that are more than columns characters wide (72 by default).Some formats (e.g. HTML) do an excellent job automatically sizing table columns and so don’t benefit much from column width specifications. Other formats (e.g. LaTeX) require table column sizes in order to correctly flow longer cell content (this is a major reason why tables &gt; 72 columns wide are assigned explicit widths by Pandoc).This can be specified as:auto: Apply markdown table column widths except when there is a hyperlink in the table (which tends to throw off automatic calculation of column widths based on the markdown text width of cells). (auto is the default for HTML output formats)true: Always apply markdown table widths (true is the default for all non-HTML formats)false: Never apply markdown table widths.An array of numbers (e.g. [40, 30, 30]): Array of explicit width percentages.Some formats (e.g. HTML) do an excellent job automatically sizing table columns and so don’t benefit much from column width specifications. Other formats (e.g. LaTeX) require table column sizes in order to correctly flow longer cell content (this is a major reason why tables &gt; 72 columns wide are assigned explicit widths by Pandoc).This can be specified as:auto: Apply markdown table column widths except when there is a hyperlink in the table (which tends to throw off automatic calculation of column widths based on the markdown text width of cells). (auto is the default for HTML output formats)true: Always apply markdown table widths (true is the default for all non-HTML formats)false: Never apply markdown table widths.An array of numbers (e.g. [40, 30, 30]): Array of explicit width percentages.&apos;;OptionName:tbl-colwidths;};QR_Shortcodes:{create:true;type:string;suggested:[];default:;description:&apos;Specify Lua scripts that implement shortcode handlers&apos;;OptionName:shortcodes;};QR_KeepIpynb:{create:true;type:boolean;suggested:[];default:;description:&apos;Keep the notebook file generated from executing code.&apos;;OptionName:keep-ipynb;};QR_RespondToHashChanges:{create:true;type:boolean;suggested:[];default:;description:&apos;Monitor the hash and change slides accordingly&apos;;OptionName:respond-to-hash-changes;};QR_Eval:{create:true;type:boolean;suggested:[];default:;description:&apos;Evaluate code cells (if false just echos the code into output).true (default): evaluate code cellfalse: don’t evaluate code cell[...]: A list of positive or negative line numbers to selectively include or exclude lines (explicit inclusion/excusion of lines is available only when using the knitr engine)true (default): evaluate code cellfalse: don’t evaluate code cell[...]: A list of positive or negative line numbers to selectively include or exclude lines (explicit inclusion/excusion of lines is available only when using the knitr engine)&apos;;OptionName:eval;};QR_Freeze:{create:true;type:string;suggested:[true;false;auto];default:;description:&apos;Control the re-use of previous computational output when rendering.true: Never recompute previously generated computational output during a global project renderfalse (default): Recompute previously generated computational outputauto: Re-compute previously generated computational output only in case their source file changes&apos;;OptionName:freeze;};QR_AuthorMeta:{create:true;type:set;suggested:[];default:;description:&apos;Sets the author metadata for the document&apos;;OptionName:author-meta;};QR_KeepMd:{create:true;type:boolean;suggested:[];default:;description:&apos;Keep the markdown file generated by executing code&apos;;OptionName:keep-md;};QR_Csl:{create:false;type:file;suggested:[];default:;description:&apos;Citation Style Language file to use for formatting references.&apos;;OptionName:csl;};QR_Dpi:{create:true;type:number;suggested:[];default:;description:&apos;Specify the default dpi (dots per inch) value for conversion from pixels to inch/ centimeters and vice versa. (Technically, the correct term would be ppi: pixels per inch.) The default is 96. When images contain information about dpi internally, the encoded value is used instead of the default specified by this option.&apos;;OptionName:dpi;};QR_Rtl:{create:false;type:boolean;suggested:[];default:;description:&apos;Change the presentation direction to be RTL&apos;;OptionName:rtl;};QR_FigAlign:{create:true;type:string;suggested:[default;left;right;center];default:;description:&apos;Figure horizontal alignment (default, left, right, or center)&apos;;OptionName:fig-align;};QR_Classoption:{create:false;type:string;suggested:[];default:;description:&apos;For LaTeX/PDF output, the options set for the document class.For HTML output using KaTeX, you can render display math equations flush left using classoption: fleqn&apos;;OptionName:classoption;};QR_PreviewLinks:{create:true;type:string;suggested:[true;false;auto];default:;description:&apos;Open links in an iframe preview overlay.true: Open links in iframe preview overlayfalse: Do not open links in iframe preview overlayauto (default): Open links in iframe preview overlay, in fullscreen mode.&apos;;OptionName:preview-links;};QR_Citation:{create:false;type:string;suggested:[];default:;description:&apos;Citation information for the document itself specified as CSL YAML in the document front matter.For more on supported options, see Citation Metadata.&apos;;OptionName:citation;};QR_ShowSlideNumber:{create:true;type:string;suggested:[all;print;speaker];default:;description:&apos;Contexts in which the slide number appears (all, print, or speaker)&apos;;OptionName:show-slide-number;};QR_Brand:{create:true;type:string;suggested:[];default:;description:&apos;Branding information to use for this document. If a string, the path to a brand file. If false, don’t use branding on this document. If an object, an inline brand definition.&apos;;OptionName:brand;};QR_ResourcePath:{create:true;type:list;suggested:[];default:;description:&apos;List of paths to search for images and other resources.&apos;;OptionName:resource-path;};QR_StripComments:{create:true;type:boolean;suggested:[];default:;description:&apos;Strip out HTML comments in the Markdown source, rather than passing them on to Markdown, Textile or HTML output as raw HTML. This does not apply to HTML comments inside raw HTML blocks when the markdown_in_html_blocks extension is not set.&apos;;OptionName:strip-comments;};QR_DefaultImageExtension:{create:false;type:string;suggested:[];default:;description:&apos;Specify a default extension to use when image paths/URLs have no extension. This allows you to use the same source for formats that require different kinds of images. Currently this option only affects the Markdown and LaTeX readers.&apos;;OptionName:default-image-extension;};QR_QuartoRequired:{create:true;type:string;suggested:[];default:;description:&apos;A semver version range describing the supported quarto versions for this document or project.Examples:&gt;= 1.1.0: Require at least quarto version 1.11.*: Require any quarto versions whose major version number is 1&apos;;OptionName:quarto-required;};QR_History:{create:true;type:boolean;suggested:[];default:;description:&apos;Push each slide change to the browser history&apos;;OptionName:history;};QR_Center:{create:true;type:boolean;suggested:[];default:;description:&apos;Vertical centering of slides&apos;;OptionName:center;};QR_HideInactiveCursor:{create:true;type:boolean;suggested:[];default:;description:&apos;Hide cursor if inactive&apos;;OptionName:hide-inactive-cursor;};QR_AutoAnimateDuration:{create:true;type:number;suggested:[];default:;description:&apos;Duration (in seconds) of auto-animate transition. Can be overridden per-slide or per-element via attributes.&apos;;OptionName:auto-animate-duration;};QR_Transition:{create:true;type:string;suggested:[none;fade;slide;convex;concave;zoom];default:;description:&apos;Transition style for slides backgrounds. (none, fade, slide, convex, concave, or zoom)&apos;;OptionName:transition;};QR_Loop:{create:true;type:boolean;suggested:[];default:;description:&apos;Loop the presentation&apos;;OptionName:loop;};QR_MarginBottom:{create:true;type:string;suggested:[];default:;description:&apos;For HTML output, sets the margin-bottom property on the Body element.For LaTeX output, sets the bottom margin if geometry is not used (otherwise geometry overrides this value)For ConTeXt output, sets the bottom margin if layout is not used, otherwise layout overrides these.For wkhtmltopdf sets the bottom page margin.&apos;;OptionName:margin-bottom;};QR_CodeBlockHeight:{create:true;type:string;suggested:[];default:;description:&apos;Sets the maximum height for source code blocks that appear in the presentation.&apos;;OptionName:code-block-height;};QR_Toc:{create:true;type:boolean;suggested:[];default:;description:&apos;Include an automatically generated table of contents (or, in the case of latex, context, docx, odt, opendocument, rst, or ms, an instruction to create one) in the output document.Note that if you are producing a PDF via ms, the table of contents will appear at the beginning of the document, before the title. If you would prefer it to be at the end of the document, use the option pdf-engine-opt: --no-toc-relocation.&apos;;OptionName:toc;};QR_ControlsTutorial:{create:true;type:boolean;suggested:[];default:;description:&apos;Help the user learn the controls by providing visual hints.&apos;;OptionName:controls-tutorial;};QR_Order:{create:false;type:list;suggested:[];default:;description:&apos;Order for document when included in a website automatic sidebar menu.&apos;;OptionName:order;};QR_IpynbFilters:{create:true;type:string;suggested:[];default:;description:&apos;Filters to pre-process ipynb files before rendering to markdown&apos;;OptionName:ipynb-filters;};QR_Css:{create:true;type:file;suggested:[];default:;description:&apos;One or more CSS style sheets.&apos;;OptionName:css;};QR_From:{create:true;type:string;suggested:[markdown+emoji];default:;description:&apos;Format to read from. Extensions can be individually enabled or disabled by appending +EXTENSION or -EXTENSION to the format name (e.g. markdown+emoji).&apos;;OptionName:from;};QR_RevealjsUrl:{create:true;type:url;suggested:[];default:;description:&apos;Directory containing reveal.js files.&apos;;OptionName:revealjs-url;};QR_AutoAnimateStyles:{create:false;type:string;suggested:[top;left;right;];default:;description:&apos;CSS properties that can be auto-animated (positional styles like top, left, etc. are always animated).&apos;;OptionName:auto-animate-styles;};QR_IpynbShellInteractivity:{create:true;type:string;suggested:[];default:;description:&apos;Specify which nodes should be run interactively (displaying output from expressions)&apos;;OptionName:ipynb-shell-interactivity;};QR_FigCapLocation:{create:true;type:string;suggested:[top;bottom;margin];default:;description:&apos;Where to place figure captions (top, bottom, or margin)&apos;;OptionName:fig-cap-location;};{create:true;type:string;suggested:[top;bottom;margin];default:;description:&apos;Where to place figure captions (top, bottom, or margin)&apos;;OptionName:fig-cap-location;};QR_Dir:{create:false;type:string;suggested:[rtl;ltr];default:;description:&apos;The base script direction for the document (rtl or ltr).For bidirectional documents, native pandoc spans and divs with the dir attribute can be used to override the base direction in some output formats. This may not always be necessary if the final renderer (e.g. the browser, when generating HTML) supports the [Unicode Bidirectional Algorithm].When using LaTeX for bidirectional documents, only the xelatex engine is fully supported (use --pdf-engine=xelatex).&apos;;OptionName:dir;};QR_AutoSlide:{create:true;type:boolean;suggested:[];default:;description:&apos;Automatically progress all slides at the specified interval&apos;;OptionName:auto-slide;};QR_AutoAnimateEasing:{create:true;type:string;suggested:[ease;ease-in;ease-out;ease-in-out];default:;description:&apos;Default CSS easing function for auto-animation. Can be overridden per-slide or per-element via attributes.&apos;;OptionName:auto-animate-easing;};QR_TitleSlideStyle:{create:false;type:string;suggested:[pandoc];default:;description:&apos;The title slide style. Use pandoc to select the Pandoc default title slide style.&apos;;OptionName:title-slide-style;};QR_PdfMaxPagesPerSlide:{create:true;type:number;suggested:[];default:;description:&apos;Slides that are too tall to fit within a single page will expand onto multiple pages. You can limit how many pages a slide may expand to using this option.&apos;;OptionName:pdf-max-pages-per-slide;};QR_DefaultTiming:{create:true;type:number;suggested:[];default:;description:&apos;Expected average seconds per slide (used by pacing timer in speaker view)&apos;;OptionName:default-timing;};QR_MarginRight:{create:true;type:string;suggested:[];default:;description:&apos;For HTML output, sets the margin-right property on the Body element.For LaTeX output, sets the right margin if geometry is not used (otherwise geometry overrides this value)For ConTeXt output, sets the right margin if layout is not used, otherwise layout overrides these.For wkhtmltopdf sets the right page margin.For LaTeX output, sets the right margin if geometry is not used (otherwise geometry overrides this value)For ConTeXt output, sets the right margin if layout is not used, otherwise layout overrides these.For wkhtmltopdf sets the right page margin.&apos;;OptionName:margin-right;};QR_Help:{create:true;type:boolean;suggested:[];default:;description:&apos;Show a help overlay when the ? key is pressed&apos;;OptionName:help;};QR_ScrollView:{create:true;type:boolean;suggested:[];default:;description:&apos;Control the scroll view feature of Revealjs&apos;;OptionName:scroll-view;};QR_Logo:{create:true;type:file;suggested:[];default:;description:&apos;Logo image (placed in bottom right corner of slides)&apos;;OptionName:logo;};QR_Ascii:{create:true;type:boolean;suggested:[];default:;description:&apos;Use only ASCII characters in output. Currently supported for XML and HTML formats (which use entities instead of UTF-8 when this option is selected), CommonMark, gfm, and Markdown (which use entities), roff ms (which use hexadecimal escapes), and to a limited degree LaTeX (which uses standard commands for accented characters when possible). roff man output uses ASCII by default.&apos;;OptionName:ascii;};QR_NumberOffset:{create:true;type:number;suggested:[];default:;description:&apos;Offset for section headings in output (offsets are 0 by default) The first number is added to the section number for top-level headings, the second for second-level headings, and so on. So, for example, if you want the first top-level heading in your document to be numbered “6”, specify number-offset: 5. If your document starts with a level-2 heading which you want to be numbered “1.5”, specify number-offset: [1,4]. Implies number-sections&apos;;OptionName:number-offset;};QR_DfPrint:{create:true;type:string;suggested:[default;kable;tibble;paged];default:;description:&apos;Method used to print tables in Knitr engine documents:default: Use the default S3 method for the data frame.kable: Markdown table using the knitr::kable() function.tibble: Plain text table using the tibble package.paged: HTML table with paging for row and column overflow.The default printing method is kable.&apos;;OptionName:df-print;};QR_LinkExternalNewwindow:{create:true;type:boolean;suggested:[];default:;description:&apos;Open external links in a new browser window or tab (rather than navigating the current tab).&apos;;OptionName:link-external-newwindow;};QR_Fragments:{create:true;type:boolean;suggested:[];default:;description:&apos;Turns fragments on and off globally&apos;;OptionName:fragments;};QR_Shuffle:{create:false;type:boolean;suggested:[];default:;description:&apos;Randomize the order of slides each time the presentation loads&apos;;OptionName:shuffle;};QR_Filters:{create:true;type:string;suggested:[];default:;description:&apos;Specify executables or Lua scripts to be used as a filter transforming the pandoc AST after the input is parsed and before the output is written.&apos;;OptionName:filters;};QR_HighlightStyle:{create:false;type:string;suggested:[];default:;description:&apos;Specifies the coloring style to be used in highlighted source code.Instead of a STYLE name, a JSON file with extension .theme may be supplied. This will be parsed as a KDE syntax highlighting theme and (if valid) used as the highlighting style.&apos;;OptionName:highlight-style;};QR_Footer:{create:true;type:string;suggested:[];default:;description:&apos;Footer to include on all slides. Can also be set per-slide by including a div with class .footer on the slide.&apos;;OptionName:footer;};QR_TocTitle:{create:true;type:string;suggested:[];default:;description:&apos;The title used for the table of contents.&apos;;OptionName:toc-title;};QR_Crossref:{create:false;type:string;suggested:[];default:;description:&apos;Configuration for cross-reference labels and prefixes. See Cross-Reference Options for more details.&apos;;OptionName:crossref;};QR_FigResponsive:{create:true;type:boolean;suggested:[];default:;description:&apos;Whether to make images in this document responsive.&apos;;OptionName:fig-responsive;};QR_CrossrefsHover:{create:true;type:boolean;suggested:[];default:;description:&apos;Enables a hover popup for cross references that shows the item being referenced.&apos;;OptionName:crossrefs-hover;};QR_Controls:{create:true;type:string;suggested:[true;false;auto];default:;description:&apos;Show arrow controls for navigating through slides.true: Always show controlsfalse: Never show controlsauto (default): Show controls when vertical slides are present or when the deck is embedded in an iframe.&apos;;OptionName:controls;};QR_Institute:{create:true;type:string;suggested:[];default:;description:&apos;Author affiliations for the presentation.&apos;;OptionName:institute;};QR_SlideNumber:{create:true;type:string;suggested:[true;false;h.v;h/v;c;c/t];default:;description:&apos;Display the page number of the current slidetrue: Show slide numberfalse: Hide slide numberCan optionally be set as a string that specifies the number formatting:h.v: Horizontal . vertical slide numberh/v: Horizontal / vertical slide numberc: Flattened slide numberc/t: Flattened slide number / total slides (default)&apos;;OptionName:slide-number;};QR_AutoStretch:{create:true;type:boolean;suggested:[];default:;description:&apos;For slides with a single top-level image, automatically stretch it to fill the slide.&apos;;OptionName:auto-stretch;};QR_MinScale:{create:true;type:number;suggested:[];default:;description:&apos;Bounds for smallest possible scale to apply to content&apos;;OptionName:min-scale;};QR_BackgroundTransition:{create:true;type:string;suggested:[none;fade;slide;convex;concave;zoom];default:;description:&apos;Transition style for full page slide backgrounds. (none, fade, slide, convex, concave, or zoom)&apos;;OptionName:background-transition;};QR_Progress:{create:true;type:boolean;suggested:[];default:;description:&apos;Display a presentation progress bar&apos;;OptionName:progress;};QR_FragmentInUrl:{create:true;type:boolean;suggested:[];default:;description:&apos;Include the current fragment in the URL&apos;;OptionName:fragment-in-url;};QR_CodeFold:{create:true;type:string;suggested:[true;false;show];default:;description:&apos;Collapse code into an HTML &lt;details&gt; tag so the user can display it on-demand.true: collapse codefalse (default): do not collapse codeshow: use the &lt;details&gt; tag, but show the expanded code initially.&apos;;OptionName:code-fold;};QR_PdfPageHeightOffset:{create:true;type:number;suggested:[];default:;description:&apos;Offset used to reduce the height of content within exported PDF pages. This exists to account for environment differences based on how you print to PDF. CLI printing options, like phantomjs and wkpdf, can end on precisely the total height of the document whereas in-browser printing has to end one pixel before.&apos;;OptionName:pdf-page-height-offset;};QR_Template:{create:true;type:file;suggested:[];default:;description:&apos;Use the specified file as a custom template for the generated document.&apos;;OptionName:template;};QR_Hash:{create:true;type:boolean;suggested:[];default:;description:&apos;Add the current slide to the URL hash&apos;;OptionName:hash;};QR_Author:{create:true;type:string;suggested:[];default:;description:&apos;Author or authors of the document&apos;;OptionName:author;};QR_TitlePrefix:{create:true;type:string;suggested:[];default:;description:&apos;Specify STRING as a prefix at the beginning of the title that appears in the HTML header (but not in the title as it appears at the beginning of the body)&apos;;OptionName:title-prefix;};QR_Keyboard:{create:true;type:boolean;suggested:[];default:;description:&apos;Enable keyboard shortcuts for navigation&apos;;OptionName:keyboard;};QR_AutoSlideMethod:{create:false;type:string;suggested:[Reveal.right();];default:;description:&apos;Navigation method to use when auto sliding (defaults to navigateNext)&apos;;OptionName:auto-slide-method;};QR_ReferenceLocation:{create:true;type:string;suggested:[block;section;margin;document];default:;description:&apos;Specify location for footnotes. Also controls the location of references, if reference-links is set.block: Place at end of current top-level blocksection: Place at end of current sectionmargin: Place at the margindocument: Place at end of document&apos;;OptionName:reference-location;};QR_NumberDepth:{create:true;type:number;suggested:[];default:;description:&apos;By default, all headings in your document create a numbered section. You customize numbering depth using the number-depth option.For example, to only number sections immediately below the chapter level, use this:number-depth: 1&apos;;OptionName:number-depth;};QR_Width:{create:true;type:number;suggested:[];default:;description:&apos;The “normal” width of the presentation, aspect ratio will be preserved when the presentation is scaled to fit different resolutions. Can be specified using percentage units.&apos;;OptionName:width;};QR_SlideTone:{create:true;type:boolean;suggested:[];default:;description:&apos;Play a subtle sound when changing slides&apos;;OptionName:slide-tone;};QR_ControlsBackArrows:{create:true;type:string;suggested:[faded;hidden;visible];default:;description:&apos;Visibility rule for backwards navigation arrows (faded, hidden, or visible).&apos;;OptionName:controls-back-arrows;};QR_Warning:{create:true;type:boolean;suggested:[];default:;description:&apos;Include warnings in rendered output.&apos;;OptionName:warning;};QR_DisableLayout:{create:true;type:boolean;suggested:[];default:;description:&apos;Disables the default reveal.js slide layout (scaling and centering)&apos;;OptionName:disable-layout;}</attribute>
