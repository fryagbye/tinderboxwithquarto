<menu name="Value" kind="stamps" >
<stamp name="New: New Project ( Book )" >fCreateBookProject();</stamp>
<stamp name="New: New Project ( Manuscript )" >fCreateManuscriptProject();</stamp>
<stamp name="New: New Project ( revealjs )" >fCreateRevealjsProject();</stamp>
<stamp name="Quarto: Book Preview ( Select Export Agent )" >fBookPreview();</stamp>
<stamp name="Quarto: Book Render ( Select For Export )" >fBookRender();</stamp>
<stamp name="Quarto: Manuscript Preview ( Select manuscipt folder )" >fManuscriptPreview();</stamp>
<stamp name="Quarto: Revealjs Preveiw( Select Revealjs folder )" >fRevealjsPreview();</stamp>
<stamp name="Setup: Create TOC note" >
fMakeTOC();</stamp>
<stamp name="Notes: Set SectionLabel &amp; HTMLExportFileName" >if(!($IsNamesLocked)){
	if($IsIndexqmd){
		$HTMLExportFileName=&quot;index&quot;;
	}else{
		$HTMLExportFileName=$Name.deleteCharacters(&quot;/\?%*:|&lt;&gt;.&amp;+()!,#`&quot;).lowercase().replace(&quot; &quot;,&quot;-&quot;).replace(&quot;&apos;&quot;,&quot;&quot;);
	};

//	if(!($SectionLabel)){
		$SectionLabel = $HTMLExportFileName;
//	};
}else{
	(&quot;$IsNamesLocked is true.&quot;).show();
};

$HTMLExportExtension=$HTMLExportExtension($Prototype);
</stamp>
<stamp name="Notes: Set Export Mode" >fSetExportMode($Path);</stamp>
<stamp name="Notes: Set Preview Mode" >fSetPreviewMode($Path);</stamp>
<stamp name="Notes: Tranlate Section Labels" >$IsNamesLocked=false;
fRenameIn($Name);
$IsNamesLocked=true;
$HasSectionLabel=true;</stamp>
<stamp name="Notes: Toggle $HasSectionLabel" >if($HasSectionLabel){
	$HasSectionLabel=false;
}else{
	if($SectionLabel==&quot;&quot;){
		fRenameIn($Name);
		$IsNamesLocked=true;
	};
	$HasSectionLabel=true;
};</stamp>
<stamp name="Notes: Fix Displayed Attributes ( Prototype )" >fFixDisplayedAttributesWithPrototype();</stamp>
<stamp name="Notes: Fix Displayed Attributes ( Template )" >fFixDisplayedAttributesWithTemplate();</stamp>
<stamp name="Notes: Fix display expression" >fDisplayExpression();</stamp>
<stamp name="Labels: Force update Lists &amp; Cross-Ref" >fCrossRefUpdate(true);
</stamp>
<stamp name="Labels: Clear Cross-Reference List in Selected Project" >fClearReferenceListFromSelectedProject();
</stamp>
<stamp name="Labels: Make Cross-Reference List in Selected Project" >fMakeReferenceListFromSelectedProject();</stamp>
<stamp name="Labels: Make Dummy Links For Cross-Reference" >fMakeLinkFigFromReferenceList();
fMakeLinkSecFromReferenceList();
fMakeLinkTableFromReferenceList();
fMakeLinkEquationFromReferenceList();</stamp>
<stamp name="Chunk &amp; Graph: Clear Chunk and Graph List" >fClearChunkList();
fClearGraphList();</stamp>
<stamp name="Chunk &amp; Graph: Make Chunk and Graph List" >fMakeChunkList();
fMakeGraphList();</stamp>
<stamp name="Chunk &amp; Graph: Set Frontmatter and options for Chunk" >var:boolean vCheck=true;

if($Prototype==&quot;pRChunk&quot;|$Prototype==&quot;pRChunkList&quot;|$Prototype==&quot;pPChunk&quot;){
	fSetForChunk($ID, true);
	fMakeChunkList();
	vCheck=false;
};

if($Prototype==&quot;pChunk&quot;){

	vCheck=false;
};

if(vCheck){
	(&quot;Please select pRChunk, pRChunkList, pPChunk or pChunk note&quot;).show();
};
</stamp>
<stamp name="Chunk &amp; Graph: Set RChunk Preview" >if($Prototype==&quot;pRChunk&quot;){
	fSetPreviewCommandForRChunk();
}else{
	(&quot;Please select a pRChunk note&quot;).show;
};</stamp>
<stamp name="Chunk &amp; Graph: Set PChunk Preview" >if($Prototype==&quot;pPChunk&quot;){
	$HTMLExportTemplate=&quot;/Templates/tPChunk_Preview&quot;;
	$HTMLExportExtension=&quot;.html&quot;;
}else{
	(&quot;Please select a pPChunk note&quot;).show;
};</stamp>
<stamp name="Export: Change quarto.yml template" >select(/_quarto);
fChangeTemplateQuartoYML();</stamp>
<stamp name="Export: Toggle Export and Preview mode for Agent" >fToggleBookAgent(); </stamp>
<stamp name="Export: Toggle Export and Preview mode for Subnotes" >var:string vProject;
vProject=collect(ancestors,$Path)[-1];

if($Prototype(vProject)==&quot;pBookFolder&quot;|$Prototype(vProject)==&quot;pManuscriptFolder&quot;|$Prototype(vProject)==&quot;pRevealjsFolder&quot;){
	fSetPreviewForpSubnoteFromPath(vProject);
};</stamp>
<stamp name="Export: Toggle Book Agent Query ON/OFF" >var:string vAgentExport=$AgentNameForQmdFiles(&quot;TBXConfig&quot;);
if($AgentPriority(vAgentExport)==-1){
	$AgentPriority(vAgentExport)=1;
}else{
	$AgentPriority(vAgentExport)=-1;
};</stamp>
<stamp name="Export: Change a template of &quot;Export Agent&quot;" >select(/For Export);
fChangeTemplateOfAgentQmd();</stamp>
<stamp name="Export: Copy Index List to Table Of Contents" >$Text($TableOfContaintsNote(&quot;TBXConfig&quot;)) = $Text(&quot;Index List&quot;);</stamp>
<stamp name="Utilities: _language.yml" >fGetLanguageYML($LanguageYMLLang);</stamp>
<stamp name="Utilities: Biblography for Bookends" >if($Prototype==&quot;Reference&quot;){
	$Path=&quot;/Reference DB&quot;;
	$Prototype=&quot;pReference&quot;;
	fSetReference();
};</stamp>
<stamp name="Utilities: Table Order" >var:list vlist;
var:number vsum=0;
var:number vorder=1;
if($Prototype==&quot;pTable&quot;){
	vlist = collect(children,$Path);
	vsum = sum(children, $TableOrder);
	$MyNumber = vsum;
//$MyList= vlist;
	if(vsum=0){
		vlist.each(alist){
			$TableOrder(alist)=vorder;
			vorder += 1;
		};
		$Sort=&quot;TableOrder&quot;;
		$SortBackward=false;
		$SortAlso=&quot;&quot;;
		$SortBackwardAlso=false;
	show(&quot;ordered&quot;);
	}else{
		vlist.each(alist){
			$TableOrder(alist)=0;
		};
		$Sort=&quot;&quot;;
		$SortBackward=false;
		$SortAlso=&quot;&quot;;
		$SortBackwardAlso=false;
	show(&quot;reset&quot;);		
	};

};</stamp>
<stamp name="Mermaid: Make a Flowchart" >if($Prototype=&quot;pMFContainer&quot;){
	fWriteMermaidFlowchart($M_Direction, $ID, $CopyClipboard);
}else{
	(&quot;Select pMFContainer note&quot;).show();
};</stamp>
<stamp name="Mermaid: Toggle Mermaid Poster" >if($Prototype==&quot;pMFContainer&quot;){
if($PosterTemplate){
	$PosterTemplate=;
	(&quot;Poster OFF&quot;).show();
}else{
	$PosterTemplate=&quot;/Templates/tMermaid&quot;;
	(&quot;Poster ON&quot;).show();
};
};</stamp>
<stamp name="Graphviz: Make a Dot graph" >if($Prototype==&quot;pGContainer&quot;){
	fGenerateGraphviz($ID, $CopyClipboard);
}else{
	(&quot;Select pGContainer note&quot;).show;
};</stamp>
<stamp name="Graphviz: Toggle Graphviz Poster" >if($Prototype==&quot;pGContainer&quot;){
	if($PosterTemplate){
		$PosterTemplate=;
		(&quot;Poster OFF&quot;).show();
	}else{
		$PosterTemplate=&quot;/Templates/tGraphviz&quot;;
		(&quot;Poster ON&quot;).show();
	};
};</stamp>
<stamp name="Graphviz: Toggle $G_HasCustomAttributes" >if($Prototype==&quot;pGContainer&quot;|$Prototype==&quot;pGSubgraph&quot;|$Prototype==&quot;pGNode&quot;){
	if($G_HasCustomAttributes){
		$G_HasCustomAttributes=false;
		(&quot;$G_HasCustomAttributes OFF&quot;).show;
	}else{
		$G_HasCustomAttributes=true;
		(&quot;$G_HasCustomAttributes ON&quot;).show;	};
};</stamp>
<stamp name="Graphviz: Set Attributes Default" >//Select pGAttribute 
fSetupAttibutesDictionaryDefaultValue($ID, &quot;pGAttributeDefault&quot;, &quot;default&quot;);
</stamp>
<stamp name="Graphviz: Set Attributes Description" >//Select pGAttribute 
fSetupAttibutesValue($ID, &quot;pGAttributeDescription&quot;, &quot;description&quot;);
</stamp>
