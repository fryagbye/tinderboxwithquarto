<text >
function fBookPreview(){
    var:string vSelected=$ID;
    var:string vOutputFolder;
    var:string vVenv;
    var:string vCheck;
    var:string vOption;
    var:string vRoot=collect(ancestors,$Path)[-1];
    var:string vConf=&quot;TBXConfig&quot;;
    var:boolean debug=true;

    if($HasVenvEnv){
        vVenv=$VenvActivateCommand;
    }else{
        vVenv=&quot;&quot;;
    };


    if($Prototype!=&quot;pBookFolder&quot;){
        if($Prototype(vRoot)==&quot;pBookFolder&quot;){
            if($HasVenvEnv){
                vVenv=$VenvActivateCommand(vRoot);
            }else{
                vVenv=&quot;&quot;;
            };
            if($HTMLExportFileName(vRoot)){
                vOutputFolder=$HTMLExportFileName(vRoot);
            }else{
                vOutputFolder=$Name(vRoot);
            };
            vCheck=true;

        };
    }else{
        if($HTMLExportFileName){
            vOutputFolder=$HTMLExportFileName;
        }else{
            vOutputFolder=$Name;
        };
    };
    if(debug){LogRec(&quot;Quarto&quot;, &quot;&lt;&lt;mark&gt;&gt;Preview: vCheck=&quot; + vCheck + &quot; vOutputFolder=&quot; + vOutputFolder + &quot; vOption=&quot; + vOption + &quot; vVenv=&quot; + vVenv);};
    if($Prototype==&quot;pBookFolder&quot;|vCheck){

        fActivateAppName($TerminalApp(vConf));
        if($TerminalApp(vConf)==&quot;Wezterm&quot;){
            fQuartoCommnadInWezterm(&quot;preview&quot;, vOutputFolder, vOption, vVenv);
        };
        if($TerminalApp(vConf)==&quot;Terminal&quot;){
            fQuartoCommnadInTerminal(&quot;preview&quot;, vOutputFolder, vOption, vVenv);
        };
        select($Path(vSelected));
    }else{
        if(debug){LogRec(&quot;Quarto&quot;, &quot;&lt;&lt;mark&gt;&gt;Preview: vCheck=&quot; + vCheck + &quot; vOutputFolder=&quot; + vOutputFolder + &quot; vOption=&quot; + vOption + &quot; vVenv=&quot; + vVenv);};
        (&quot;Please select the pBookFolder note or any of its descendant notes.&quot;).show;
    };
};

function fBookRender(){
    var:string vSelected=$ID;
    var:string vVenv;
    var:string vCheck;
    var:string vOption;
    var:string vOutputFolder;
    var:string vConf=&quot;TBXConfig&quot;;
    var:string vRoot=collect(ancestors,$Path)[-1];
    var:boolean debug=true;

    if($HasVenvEnv){
        vVenv=$VenvActivateCommand;
    }else{
        vVenv=&quot;&quot;;
    };

    if($Prototype!=&quot;pBookFolder&quot;){

        if($Prototype(vRoot)==&quot;pBookFolder&quot;){
            if($HasVenvEnv(vRoot)){
                vVenv=$VenvActivateCommand(vRoot);
            }else{
                vVenv=&quot;&quot;;
            };
            vCheck=true;
        };
    }else{
        if($HTMLExportFileName){
            vOutputFolder=$HTMLExportFileName;
        }else{
            vOutputFolder=$Name;
        };
    };

    if(debug){LogRec(&quot;Quarto&quot;, &quot;&lt;&lt;mark&gt;&gt;Render: vCheck=&quot; + vCheck + &quot; vOutputFolder=&quot; + vOutputFolder + &quot; vOption=&quot; + vOption + &quot; vVenv=&quot; + vVenv);};
    if($Prototype==&quot;pBookFolder&quot;|vCheck){
        fActivateAppName($TerminalApp(vConf));
        if($TerminalApp(vConf)==&quot;Wezterm&quot;){
            fQuartoCommnadInWezterm(&quot;render&quot;, vOutputFolder, &quot;&quot;, vVenv);
        };
        if($TerminalApp(vConf)==&quot;Terminal&quot;){
            fQuartoCommnadInTerminal(&quot;render&quot;, vOutputFolder, &quot;&quot;, vVenv);
        };

        select($Path(vSelected));
    }else{
        if(debug){LogRec(&quot;TBXConfig&quot;, &quot;&lt;&lt;mark&gt;&gt;Render: vCheck=&quot; + vCheck + &quot; vOutputFolder=&quot; + vOutputFolder + &quot; vOption=&quot; + vOption + &quot; vVenv=&quot; + vVenv);};
        (&quot;Please select the pBookFolder note or any of its descendant notes.&quot;).show();
    };  
};


function fManuscriptPreview(){
    var:string vOption;
    var:string vOutputFolder;
    var:string vVenv;
    var:string vCheck;
    var:string vSelected=$ID;
    var:string vRoot=collect(ancestors,$Path)[-1];
    var:string vConf=&quot;TBXConfig&quot;;
    var:boolean debug=true;

    if($HasVenvEnv){
        vVenv=$VenvActivateCommand;
    }else{
        vVenv=&quot;&quot;;
    };

    vOption=&quot;--to html&quot;;

    if($Prototype!=&quot;pManuscriptFolder&quot;){
        if($Prototype(vRoot)==&quot;pManuscriptFolder&quot;){
            if($HasVenvEnv(vRoot)){
                vVenv=$VenvActivateCommand(vRoot);
            }else{
                vVenv=&quot;&quot;;
            };
            if($HTMLExportFileName(vRoot)){
                vOutputFolder=$HTMLExportFileName(vRoot);
            }else{
                vOutputFolder=$Name(vRoot);
            };
            vCheck=true;
        };
    }else{
        if($HTMLExportFileName){
            vOutputFolder=$HTMLExportFileName;
        }else{
            vOutputFolder=$Name;
        };
    };

    if(debug){LogRec(&quot;Quarto&quot;, &quot;&lt;&lt;mark&gt;&gt;Preview: vCheck=&quot; + vCheck + &quot; vOutputFolder=&quot; + vOutputFolder + &quot; vOption=&quot; + vOption + &quot; vVenv=&quot; + vVenv);};
    if($Prototype==&quot;pManuscriptFolder&quot;|vCheck){
        fActivateAppName($TerminalApp(vConf));
        if($TerminalApp(vConf)==&quot;Wezterm&quot;){
            fQuartoCommnadInWezterm(&quot;preview&quot;, vOutputFolder, vOption, vVenv);
        };
        if($TerminalApp(vConf)==&quot;Terminal&quot;){
            fQuartoCommnadInTerminal(&quot;preview&quot;, vOutputFolder, vOption, vVenv);
        };
        select($Path(vSelected));
    }else{
        if(debug){LogRec(&quot;Quarto&quot;, &quot;&lt;&lt;mark&gt;&gt;Render: vCheck=&quot; + vCheck + &quot; vOutputFolder=&quot; + vOutputFolder + &quot; vOption=&quot; + vOption + &quot; vVenv=&quot; + vVenv);};
        (&quot;Please select the pManuscriptFolder note or any of its descendant notes.&quot;).show;
    };
};

function fRevealjsPreview(){
    var:string vSelected=$ID;
    var:string vOption;
    var:string vOutputFolder;
    var:string vVenv;
    var:string vCheck;
    var:string vConf=&quot;TBXConfig&quot;;
    var:string vRoot=collect(ancestors,$Path)[-1];
    var:boolean debug=true;

    if($HasVenvEnv){
        vVenv=$VenvActivateCommand;
    }else{
        vVenv=&quot;&quot;;
    };

    if($Q_HasQuartoLiveChunk(vRoot)){
        vOption=&quot;--to live-revealjs&quot;;
    }else{  
        vOption=&quot;--to revealjs&quot;;
    };

    if($Prototype!=&quot;pRevealjsFolder&quot;){
        var:string vRoot=collect(ancestors,$Path)[-1];
        if($Prototype(vRoot)==&quot;pRevealjsFolder&quot;){
            if($HasVenvEnv(vRoot)){
                vVenv=$VenvActivateCommand(vRoot);
            }else{
                vVenv=&quot;&quot;;
            };
            if($HTMLExportFileName(vRoot)){
                vOutputFolder=$HTMLExportFileName(vRoot);
            }else{
                vOutputFolder=$Name(vRoot);
            };

            if($Q_HasQuartoLiveChunk(vRoot)){
                vOption=&quot;--to live-revealjs&quot;;
            }else{
                vOption=&quot;--to revealjs&quot;;
            };

        vCheck=true;
        };
    }else{
        if($HTMLExportFileName){
            vOutputFolder=$HTMLExportFileName;
        }else{
            vOutputFolder=$Name;
        };
    };

    if($Prototype==&quot;pRevealjsFolder&quot;|vCheck){

        if($TerminalApp(vConf)==&quot;Wezterm&quot;){
            fQuartoCommnadInWezterm(&quot;preview&quot;, vOutputFolder, vOption, vVenv);
        };
        if($TerminalApp(vConf)==&quot;Terminal&quot;){
            fQuartoCommnadInTerminal(&quot;preview&quot;, vOutputFolder, vOption, vVenv);
        };
        select($Path(vSelected));
    }else{
        (&quot;Please select the pRevealjsFolder note or any of its descendant notes.&quot;).show;
    };
};

function fQuartoCommnadInTerminal(vQCommand:string, vProjectPath:string, vQuartoOptions:string, vVenvCommand){
    var:string vVenv;
    var:string vCommand;
    var:string vReturn;
    var:string vConf=&quot;TBXConfig&quot;;
    var:boolean debug=true;

    if(vVenvCommand){
        vCommand=&quot;/usr/bin/osascript -e &apos;&quot;+ &apos;tell application &quot;Terminal&quot; to do script &quot;cd &apos;+ $ExportFolder(&quot;TBXConfig&quot;) +&apos;;&apos;+ vVenvCommand + &apos; &amp;&amp; sleep 0.5; &apos;+ $Quarto_Path(&quot;TBXConfig&quot;) + &quot; &quot; + vQCommand + &quot; &quot; + vProjectPath + &quot; &quot; + vQuartoOptions + &apos;&quot;&apos; + &quot;&apos;&quot;;
    }else{
        vCommand=&quot;/usr/bin/osascript -e &apos;&quot;+ &apos;tell application &quot;Terminal&quot; to do script &quot;cd &apos;+ $ExportFolder(&quot;TBXConfig&quot;) +&apos;; sleep 0.5; &apos;+ $Quarto_Path(&quot;TBXConfig&quot;) + &quot; &quot; + vQCommand + &quot; &quot; + vProjectPath + &quot; &quot; + vQuartoOptions + &apos;&quot;&apos; + &quot;&apos;&quot;;
    };

    if(debug){LogRec(&quot;Quarto&quot;, &quot;&lt;&lt;mark&gt;&gt; Terminal vCommand=&quot; + vCommand);};
    vReturn = runCommand(vCommand);
    fActivateAppName(&quot;Terminal&quot;);
};

function fActivateAppName(vApp:string){
    var:string vCommand = &quot;/usr/bin/osascript -e &apos;&quot; + &apos;tell application &quot;&apos; + vApp + &apos;&quot; to activate&apos;+ &quot;&apos;&quot;;
    runCommand(vCommand);
};

function fActivateAppID(vID:string){
    var:string vCommand = &quot;/usr/bin/osascript -e &apos;&quot; + &apos;tell application id&quot;&apos; + vID + &apos;&quot; to activate&apos;+ &quot;&apos;&quot;;
    runCommand(vCommand);
};

function fQuartoCommnadInWezterm(vQuartoCommand:string, vProjectPath:string, vQuartoOptions:string, vVenvCommand){
    var:string vCommand = &quot;/opt/homebrew/bin/wezterm cli spawn --cwd &quot; + $ExportFolder(&quot;TBXConfig&quot;) + &quot; -- zsh -c &apos;&quot;;
    var:string vReturn;
    var:string vPre;
    var:boolean debug=true;

    if(vVenvCommand){
        vPre = &quot;cd &quot; +$ExportFolder(&quot;TBXConfig&quot;) +&quot;&amp;&amp;export PATH=/usr/local/bin:/opt/homebrew/bin:&quot; + $RScriptLibraryPath(&quot;TBXConfig&quot;) + &quot;:$PATH&amp;&amp;&quot;+ vVenvCommand +&quot;&amp;&amp;&quot;;
    }else{
        vPre = &quot;cd &quot; +$ExportFolder(&quot;TBXConfig&quot;) +&quot;&amp;&amp;export PATH=/usr/local/bin:/opt/homebrew/bin:&quot; + $RScriptLibraryPath(&quot;TBXConfig&quot;) + &quot;:$PATH&amp;&amp;&quot;;
    };
    vCommand += vPre + $Quarto_Path(&quot;TBXConfig&quot;) + &quot; &quot; + vQuartoCommand + &quot; &quot; + vProjectPath + &quot; &quot; + vQuartoOptions +&quot;;exec zsh;&apos;&quot;;

    if(debug){LogRec(&quot;Quarto&quot;, &quot;&lt;&lt;mark&gt;&gt;Wezterm: vCommand=&quot; + vCommand);};
    vReturn = runCommand(vCommand);
    if(debug){LogRec(&quot;Quarto&quot;, &quot;&lt;&lt;mark&gt;&gt;Wezterm: vReturn=&quot; + vReturn);};
    
    fActivateAppName(&quot;Wezterm&quot;);
};

function fQuartoCommnadInKitty(vQuartoCommand:string, vSubProjectPath:string, vQuartoOptions:string, vVenvCommand){
    var:string vCommand = &quot;/opt/homebrew/bin/kitty --single-instance --instance-group tbx -d &quot; + $ExportFolder(&quot;TBXConfig&quot;) + &quot; zsh -c &apos;&quot;;
    var:string vReturn;
    var:string vPre;

    if(vVenvCommand){
        vPre = &quot;cd &quot; +$ExportFolder(&quot;TBXConfig&quot;) +&quot;&amp;&amp;export PATH=/usr/local/bin:/opt/homebrew/bin:&quot; + $RScriptLibraryPath(&quot;TBXConfig&quot;) + &quot;:$PATH&amp;&amp;&quot;+ vVenvCommand +&quot;&amp;&amp;&quot;;
    }else{
        vPre = &quot;cd &quot; +$ExportFolder(&quot;TBXConfig&quot;) +&quot;&amp;&amp;export PATH=/usr/local/bin:/opt/homebrew/bin:&quot; + $RScriptLibraryPath(&quot;TBXConfig&quot;) + &quot;:$PATH&amp;&amp;&quot;;
    };
    vCommand += vPre + $Quarto_Path(&quot;TBXConfig&quot;) + &quot; &quot; + vQuartoCommand + &quot; &quot; + vSubProjectPath + &quot; &quot; + vQuartoOptions +&quot;;exec zsh&amp;;&apos;&quot;; //$Text(/Log)+= vCommand + &quot;\n&quot;;
    (&quot;This Stamp will remain running until you exit Kitty.app.&quot;).show;
    vReturn = runCommand(vCommand);
    fActivateAppName(&quot;Kitty&quot;);
};

