<text >function fRuleForpRevealjs(){

	$IncludeNotes = collect_if(children, $Prototype==&quot;pSubnoteRevealjs&quot;, $ID);
	$OutlineDepthBase = $OutlineDepth - 1;

};

function fOnAddForpFrontmatterRevealjs(){
	if(!$Prototype|$Prototype==&quot;pFrontmatterRevealjs&quot;){
		$Prototype=&quot;pSubnoteRevealjs&quot;;
	};
	if(!($IsNamesLocked)){
			$HTMLExportFileName=$Name.deleteCharacters(&quot;/\?%*:|&lt;&gt;.&amp;+()!#`&quot;).lowercase().replace(&quot; &quot;,&quot;-&quot;).replace(&quot;&apos;&quot;,&quot;&quot;);
		if(!($SectionLabel)&amp;!($IsPrototype)){
			$SectionLabel = $HTMLExportFileName;
		};
	};
};


function fRuleForpRevealjsFolder(){
   var:list vList;
	vList = collect_if(descendants, $Q_ChunkLang==&quot;webr&quot;|$Q_ChunkLang==&quot;pyodide&quot;, $ID);
	if(vList){
		$Q_HasQuartoLiveChunk=true;
	}else{
		$Q_HasQuartoLiveChunk=false;
	};

};</text>
