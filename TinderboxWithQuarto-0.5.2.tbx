<item ID="1765002502" Creator="Takeshi Otsuka" proto="HTML" >
<attribute name="Created" >2025-04-02T18:55:56+09:00</attribute>
<attribute name="DominantLanguage" >fi</attribute>
<attribute name="HTMLDontExport" >false</attribute>
<attribute name="HTMLExportChildren" >true</attribute>
<attribute name="HTMLExportExtension" >.md</attribute>
<attribute name="HTMLMarkupText" >false</attribute>
<attribute name="Height" >3</attribute>
<attribute name="IsAction" >true</attribute>
<attribute name="Modified" >2025-12-07T20:35:09+09:00</attribute>
<attribute name="Name" >tNote_all_MD</attribute>
<attribute name="NeverComposite" >true</attribute>
<attribute name="OutlineBackgroundColor" >light cyan</attribute>
<attribute name="Q_Affiliation_ID" >148</attribute>
<attribute name="SelectionCount" >1490</attribute>
<attribute name="Sentiment" >-0.2164705927</attribute>
<attribute name="Sentiments" >-0.8;0.2;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;0.8;1;0.4;0.4;0.4;0.6;-0.2;0;-0.2;0;0.2;0.4;-0.6;0.6;-0.6;0;-0.4;0;-0.4;-0.4;0.2;-0.4;-0.2;0;-0.4;0.2;-0.6;0.6;-0.6;0.4;-0.4;0;-0.2;-0.6;-0.6;0.4;0.4;0.4;-0.6;-0.6;0;-0.6;0;0;-0.2;0.2;0;-0.4;0.6;0;-0.2;-0.2;0.4;0.4;0.4;-0.6;-0.6;0;-0.4;-0.2;0.6;0.4;-0.8</attribute>
<attribute name="Width" >5</attribute>
<attribute name="Xpos" >104.5</attribute>
<attribute name="Ypos" >0</attribute>
<text >^action(
	var:string vChunkListPath=&quot;/Chunk List&quot;;
	var:string vGraphListPath=&quot;/Graph List&quot;;
	var:string vText;
	var:string vPre;
	var:string vReg1=&quot;&lt;(?:webr|r|python|pyodide|osj):(.*?)&gt;&quot;;
	var:string vReg2=&quot;&lt;(?:dot|mermaid):(.*?)&gt;&quot;;
	var:string vReg3=&quot;&quot;;
	var:string vChunkPath;
	var:string vChunkName;
	var:string vGraphPath;
	var:string vGraphName;
	var:string vTest;
	var:boolean vCheck;
	var:boolean vOpenFlag1;
	var:boolean vOpenFlag2;
	var:boolean vOpenFlag3;
	var:boolean vOpenFlag4;

	if($Prototype==&quot;pNote&quot;|$Prototype($Prototype)==&quot;pNote&quot;|$Prototype==&quot;pSubnote&quot;|$Prototype($Prototype)==&quot;pSubnote&quot;){

	vPre = $OutlineDepthBase * &quot;#&quot;  + &quot; &quot; + $Name;
	vPre+=&quot;\n \n&quot;;
	vText=vPre;

	$Text.eachLine(aLine){
		vCheck=true;
		//chunk tag
		if(aLine.extract(vReg1)){
			vChunkName=$1;
//			vChunkPath=$Path(original)+&quot;/&quot;+vChunkName;
			vChunkPath=$ToDummyLinkPath($0);
			$FromDummyLinkPath($0)+=$Path;
			createLink($Path, $0);

			vTest=$ID(vChunkPath);
		
			if(!vTest){
				vChunkPath=collect_if(children(vChunkListPath),$Name==vChunkName,$Path).first;
			};
			if(!vTest &amp; !$ID(vChunkPath)&amp;!vWarn){
				(&quot;No Chunk Tag Label Detected&quot;).show;
			};
			
			
			vText += &quot;\n \n&quot;;
			vText += fWriteOptionsForChunk($ID(vChunkPath), false)+&quot;\n \n&quot;;
			vCheck=false;
		};

		//graph tag
		if(aLine.extract(vReg2)){
			vGraphName=$1;
			vGraphPath=$ToDummyLinkPath($0);
			$FromDummyLinkPath($0)+=$Path;
			createLink($Path, $0);

			vTest=$ID(vGraphPath);
			if(!vTest &amp; !$ID(vChunkPath)){
				vGraphPath=collect_if(children(vGraphListPath),$Name==vGraphName,$Path).first;
			};

			if(!vTest &amp; !$ID(vChunkPath)&amp;!vWarn){
				(&quot;No Chunk Tag Label Detected&quot;).show;
			};

			vText += &quot;\n \n&quot;;	
			vText += fWriteOptionsForGraph($ID(vGraphPath)) +&quot;\n \n&quot;;
			vCheck=false;
		};	

		if(vCheck){
			if(aLine.beginsWith(&quot;$$&quot;)){
				if(vOpenFlag1){
					vText+= aLine+&quot;\n \n&quot;;
					vOpenFlag1=false;
				}else{
					vText+= &quot;\n&quot;+aLine+&quot;\n&quot;;
					vOpenFlag1=true;
				};
				vCheck=false;
			};
			if(vCheck&amp;(aLine.beginsWith(&quot;:::&quot;)|aLine.beginsWith(&quot;[&quot;)|aLine.beginsWith(&quot;![&quot;))){
				vText+=&quot;\n&quot;+ aLine +&quot;\n \n&quot;;
				vCheck=false;
			};
			if(vCheck&amp;(aLine.beginsWith(&quot;:&quot;)|aLine.contains(&quot;^\s*([*+]|\d+\.)\s+&quot;))){
				vText+=&quot;\n \n&quot;+ aLine +&quot;\n \n&quot;;
				vCheck=false;
			};
			if(vCheck&amp;(aLine.beginsWith(&quot;[^&quot;))){
				vText+= aLine+&quot;\n \n&quot;;
				vCheck=false;
			};
			if(vCheck&amp;(aLine.beginsWith(&quot;```&quot;))){
				if(vOpenFlag3){
					vText+= aLine+&quot;\n \n&quot;;
					vOpenFlag3=false;
				}else{
					vText+= &quot;\n&quot;+aLine+&quot;\n&quot;;
					vOpenFlag3=true;
				};
				vCheck=false;
			};
			if(vCheck){
				vText+= aLine+ &quot;\n&quot;;
			};
		};
	};
	vText+=&quot;\n&quot;;
};

)^

^value(vText)^


^include(^value($IncludeNotes)^, /Templates/tNote_all_MD)^
</text>
