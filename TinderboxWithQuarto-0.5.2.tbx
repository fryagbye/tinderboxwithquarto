<text >//For Graphviz Attribute
function fCreateAttributesFromDictionary(vID, vPrototype){
	// Create User-Attributes from $Text.eachLine of a pAttribute note;
	// Example
   // QR_Title:{create:true;type:string;suggested:[];default:;description:&apos;Document title&apos;;OptionName:title;}
   var:dictionary vDict;
	var:string vTemp;
	var:string vName;
	var:list vTempKey=[default;description;suggested];
	var:string vTempStr;
	var:list vAttributes = document[&quot;user-attributes&quot;];
	$Text(/Log)=&quot;&quot;;
	if($Prototype==vPrototype){
		if($IsUnLocked(vID)){
			$Text(vID).eachLine(aLine){
				var:dictionary vDict=vDict.extend(aline);
				vTempStr=aLine.captureTo(&quot;:&quot;,vName);
				action(&apos;vDict=vDict.extend(&quot;{&apos; + aLine + &apos;}&quot;);&apos;);
				if(vAttributes.contains(vName)){
					$Text(/Log)+= vName + &quot;: exists&quot; + &quot;\n&quot;;
						vTempKey.each(aKey){
							action(&apos;attribute(&apos; + vName+ &apos;)[&quot;&apos;+ aKey +&apos;&quot;] = vDict[vName][&quot;&apos; + aKey +&apos;&quot;];&apos;);
						};
				}else{
					$Text(/Log)+= vDict[vName][&quot;create&quot;] + &quot;\n&quot;;
					if(vDict[vName][&quot;create&quot;]){
						createAttribute(vName,vDict[vName][&quot;type&quot;]);
						vTempKey.each(aKey){
							action(&apos;attribute(&apos; + vName+ &apos;)[&quot;&apos;+ aKey +&apos;&quot;] = vDict[vName][&quot;&apos; + aKey +&apos;&quot;];&apos;);
						};
						$Text(/Log)+= vName + &quot;:is created&quot; + &quot;\n&quot;;
					}else{
						$Text(/Log)+= vName + &quot;:except creation&quot; + &quot;\n&quot;;
					};
				};
			};
//			$MyDictionary(vID)=vDict;
//			$MyString(vID) = &apos;attribute(&apos; + vName+ &apos;)[&quot;&apos;+ vKey +&apos;&quot;] = $MyDictionary(vID)&apos;;
//			action($MyString(vID));
			$Text(/Log)+= vDict + &quot;\n&quot;;
		}else{
			($Name(vID) + &quot; is Locked.&quot;).show;
		};
	}else{
		(&quot;Select &quot; + vPrototype + &quot; note&quot;).show;
		
	};

};

function fSetupAttibutesDictionary(vID){
	if($IsUnLocked(vID)){
		$MyString(vID) = &apos;$&apos;+ $Name(vID)+&apos;(&apos;+vID+&apos;)&apos;+&apos;=&quot;&quot;;&apos;;
		
		action($MyString(vID));
		$Text(vID).eachLine(aLine){
			$MyString(vID) = &apos;$&apos;+ $Name(vID)+&apos;(&apos;+vID+&apos;)&apos;+&apos;=&apos;+&apos;$&apos;+ $Name(vID)+&apos;(&apos;+vID+&apos;)&apos;+&apos;.extend(&quot;{&apos; + aLine + &apos;}&quot;);&apos;;
			action($MyString(vID));
		}
	}else{
		($Name(vID) + &quot; is Locked.&quot;).show;
	};
};

function fSetupAttibutesDictionaryDefaultValue(vID, vPrototype, vKey){
	//$Name(vID)-&gt; a Name of user attribute
	//vKey= &quot;default&quot; or &quot;description&quot; or &quot;suggested&quot; etc.

	var:dictionary vDict;
	var:string vTemp;
	var:number vCount=1;
	var:string vName=$Name(vID);
	var:string vTempKey;
	var:list vAttributes = document[&quot;user-attributes&quot;];
	if($Prototype(vID)==vPrototype){
		if($IsUnLocked(vID)){
			$Text(vID).eachLine(aLine){
				if(vAttributes.contains(vTempKey)){
					$MyString(vID) = &apos;vDict=vDict.extend(&quot;{&apos;+vCount+&apos;:{&apos; + aLine + &apos;}}&quot;);&apos;;
					action($MyString(vID));
					vCount+=1;
				};
			};
			$MyDictionary(vID)=vDict;
			$MyString(vID) = &apos;attribute(&apos; + vName+ &apos;)[&quot;&apos;+ vKey +&apos;&quot;] = $MyDictionary(vID);&apos;;
			action($MyString(vID));
		}else{
			($Name(vID) + &quot; is Locked.&quot;).show;
		};
	}else{
		(&quot;Select &quot; + vPrototype + &quot; note&quot;).show;
		
	};
};

function fSetupAttibutesValue(vID, vPrototype, vKey){
	//$Name(vID)-&gt; a Name of user attribute
	//vKey= &quot;default&quot; or &quot;description&quot; or &quot;suggested&quot; etc.

	var:dictionary vDict;
	var:string vStr;
	var:string vTempKey;
	var:string vValue;
	var:string vTranslated;

	var:list vAttributes = document[&quot;user-attributes&quot;];
	if($Prototype==vPrototype){
		if($IsUnLocked(vID)){
			$Text(vID).eachLine(aLine){
				vValue=aLine.captureTo(&quot;:&quot;,vTempKey);
				if(vAttributes.contains(vTempKey)){
					if($Rename_in(vID)){
						$Text(/Log)+= vTempKey + &quot; ; &quot;;
						vTranslated=fTranslateStrings($Rename_in(vID), vValue);
						if(!vTranslated.contains(&quot;Oops!&quot;)){
							vValue=vTranslated.replace(&quot;「&quot;,&quot;&quot;).replace(&quot;」&quot;,&quot;&quot;);
						};
					};
					vStr = &apos;attribute(&apos; + vTempKey+ &apos;)[&quot;&apos;+ vKey +&apos;&quot;] = vValue&apos;;
					action(vStr);
				};
			};
		}else{
			($Name(vID) + &quot; is Locked.&quot;).show;
		};
	}else{
		(&quot;Select &quot; + vPrototype + &quot; note&quot;).show;
		
	};
};</text>
