<text >function fChangeNoteTemplate(){
	var:string vName1=&quot;pNote&quot;;
	var:string vName2=&quot;pSubnote&quot;;
	if($HTMLExportTemplate(vName1)==&quot;/Templates/tNote&quot;){
		$HTMLExportTemplate(vName1)=&quot;/Templates/tNote_preview&quot;;
	}else{
		$HTMLExportTemplate(vName1)=&quot;/Templates/tNote&quot;;
	};

	if($HTMLExportTemplate(vName2)==&quot;/Templates/tSubnote&quot;){
		$HTMLExportTemplate(vName2)=&quot;/Templates/tSubnote_preview&quot;;
	}else{
		$HTMLExportTemplate(vName2)=&quot;/Templates/tSubnote&quot;;
	};
		(vName1 + &quot; template is set with &quot; + $HTMLExportTemplate(vName1) + &quot;\n&quot;+vName2 + &quot; template is set with &quot; + 	$HTMLExportTemplate(vName2) + &quot;\n&quot;).show();
};

function fChangeQuartoYMLDisplayedAttributes(vName){
	$DisplayedAttributes(vName)=$DisplayedAttributes($HTMLExportTemplate(vName));
};

function fTranslateStrings(vLang, vStr:string){
	//you nead install trans-shell
	//var:string vCommand=&quot;export PATH=/opt/homebrew/bin:$PATH;/opt/homebrew/bin/trans -b &quot;;
	var:string vCommand;
	var:string vFilePathOfTrans=$PathOfTransExe(&quot;TBXConfig&quot;);
	var:string vPathOfTrans;
	var:string vReturn;

	vFilePathOfTrans.icontains(&quot;(.*)/&quot;);
	vPathOfTrans=&quot;export PATH=&quot; + $1 + &quot;:$PATH;&quot;;
	vStr=&quot;&apos;&quot; + vStr + &quot;&apos;&quot;;

	vCommand = vPathOfTrans + vFilePathOfTrans + &quot; -b &quot;;
	
	vCommand = vCommand + &quot;{&quot; + vLang + &quot;} &quot;;
	$MyString = vCommand;

	vReturn = runCommand(vCommand, vStr).replace(&quot;\n&quot;,&quot;&quot;).replace(&apos;&quot;&apos;,&quot;&quot;);
	return vReturn; 
};

function fRenameIn(vStr:string){
	var:string vTempName;
	var:string vLang=$Rename_in(&quot;TBXConfig&quot;);

	$MyString(&quot;TBXConfig&quot;)=vLang;
	vTempName = fTranslateStrings(vLang, vStr);
	//$MyString = vTempName;
	if(!($IsNamesLocked)){
		if($IsIndexqmd){
			$HTMLExportFileName=&quot;index&quot;;
		}else{
			$HTMLExportFileName=vTempName.deleteCharacters(&quot;/\?%*:|&lt;&gt;.&amp;+()!#,’`&quot;).lowercase().replace(&quot; &quot;,&quot;-&quot;).replace(&quot;&apos;&quot;,&quot;&quot;);
			$SectionLabel=$HTMLExportFileName;
		};
		(&quot;Name Changed to:&quot; + $HTMLExportFileName + $HTMLExportExtension).show();
	}else{
		(&quot;Name is Locked&quot;).show();
	};
};

function fGetLanguageYML(vLang:string){
	var:string vURL;
	if($Prototype==&quot;pLanguageYML&quot;&amp;!$ReadOnly){
		if(vLang==&quot;en&quot;|vLang==&quot;&quot;){
			vURL=&quot;https://raw.githubusercontent.com/quarto-dev/quarto-cli/main/src/resources/language/_language.yml&quot;;
			$Name = &quot;_language&quot;;
			$HTMLExportExtension = &quot;.yml&quot;;
		}else{
			vURL=&quot;https://raw.githubusercontent.com/quarto-dev/quarto-cli/main/src/resources/language/_language-&quot; + vLang + &quot;.yml&quot;;
			$Name = &quot;_language-&quot; + vLang;
			$HTMLExportExtension = &quot;.yml&quot;;
		};
		$URL = vURL;

		$AutoFetch = true;
		(&quot;get from &quot; + vURL).show();
	};
};

