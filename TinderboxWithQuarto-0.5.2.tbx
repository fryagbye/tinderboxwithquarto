<text >// The complete set of links for a referenced source Note are scanned
// by this function, and any outbound, plain, &amp; visible links are 
// put into a dictionary where the destination ID is the key, and the
// Link type is the data element associated with the key. This 
// resulting dictionary is returned to the function caller.
// If there are parallel links between the same two notes, then the 
// dictionary entry will provide a set of the link types corresponding
// to each parallel link.

function CaptureOutboundPlainLinks(src_note)
{ // Define debug &amp; logbook variables
  var:boolean debug=false;
  var:string  logbook=&quot;Debug—CaptureOutboundPlainLinks&quot;;
  // Define other function variables
  var:dictionary outboundLinks; // Return Dictionary of Outbound Links
  var:string nextOBLink; // Outbound Link to extend outboundLinks
  var:string extendFix;
  var:list   extendList;

  if(debug){LogRec(logbook,&quot;&lt;&lt;blank&gt;&gt;&quot;);};
  if(debug){LogRec(logbook,&quot;&lt;&lt;mark&gt;&gt;&quot;);};
  if(debug){LogRec(logbook,&quot;Source Note: &quot;+$Name(src_note));};
  eachLink(linkDetails,src_note)
  { // Find every outbound Link from this source note
    // (i.e., no anchor or url, it must be visible, &amp; it must be outbound) 
    if(debug){LogRec(logbook,&quot;&lt;&lt;blank&gt;&gt;&quot;);};
    if(debug){LogRec(logbook,&quot;Link Details:\n&quot;+linkDetails);};
    if(debug){LogRec(logbook,&quot;anchor: &quot;+if(linkDetails[&quot;anchor&quot;]==&quot;&quot;){&quot;empty | &quot;}else{&quot;not empty | &quot;}
               +&quot;url: &quot;+if(linkDetails[&quot;url&quot;]==&quot;&quot;){&quot;empty | &quot;}else{&quot;not empty | &quot;}
               +&quot;visible: &quot;+linkDetails[&quot;visible&quot;]
               +&quot; | Outbound: &quot;+if($ID(src_note)==linkDetails[&quot;sourceID&quot;]){&quot;yes&quot;}else{&quot;no&quot;})};
    if(linkDetails[&quot;anchor&quot;]==&quot;&quot; &amp; linkDetails[&quot;url&quot;]==&quot;&quot;
           &amp; linkDetails[&quot;visible&quot;]
           &amp; ($ID(src_note)==linkDetails[&quot;sourceID&quot;]))
    { // Then capture this link as a new outbound Link Dictionary entry
      if(debug){LogRec(logbook,&quot;Already found destination? &quot;+outboundLinks[linkDetails[&quot;destID&quot;]]);};
      nextOBLink=&quot;outboundLinks=outboundLinks.extend({&quot;
        +linkDetails[&quot;destID&quot;]+&quot;:&quot;+linkDetails[&quot;type&quot;]+&quot;})&quot;;
      if(debug){LogRec(logbook,nextOBLink);};
      if(outboundLinks[linkDetails[&quot;destID&quot;]])
      { // Then this outbound destination has already been found, so…
        extendList=outboundLinks[linkDetails[&quot;destID&quot;]];
        extendList+=linkDetails[&quot;type&quot;]+&quot;;&quot;;
        outboundLinks[linkDetails[&quot;destID&quot;]]=extendList;
        if(debug){LogRec(logbook,&quot;Multi-link: &quot;+extendList);};
      } else 
      { // Add newly found link to outboundLinks dictionary…
        extendList=linkDetails[&quot;type&quot;]+&quot;;&quot;;
        outboundLinks[linkDetails[&quot;destID&quot;]]=extendList;
      }; // Endif multiple links to same destination
      if(debug){LogRec(logbook,outboundLinks);};
    }; // Endif proper outbound link
  }; // End eachLink loop
  return(outboundLinks);
}; // End Function definition

</text>
