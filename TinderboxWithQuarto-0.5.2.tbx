<text >function fMakeTOC(){
	var:string vTOC($TableOfContaintsNote(&quot;TBXConfig&quot;));
	var:string vPath=$ProjectContainer(&quot;TBXConfig&quot;);
	var:string vNewNote=  vTOC + &quot;#pTOCQmd&quot;;
	var:string vMessage=&quot;Move the TOC note where you want to place it.&quot; + vPath;
	if(!$ToggleTOC){
		vMessage+=&quot;\nPlease set $ToggleTOC ON in TBXConfig note&quot;;
	};
	//select(vPath);
	create(vPath, vNewNote);
	$Text($TableOfContaintsNote(&quot;TBXConfig&quot;)) = $Text(&quot;Index List&quot;);
	vMessage.show(); 
};

function fMakeIndexList(vProjectPath:string){
	var:string vNote1=vProjectPath + $SecLabelListContainer(&quot;TBXConfig&quot;);
	var:string vNote2=vProjectPath + $IndexListContainer(&quot;TBXConfig&quot;);
	var:string vNote3=vProjectPath + &quot;/&quot; + $TableOfContaintsNote(&quot;TBXConfig&quot;);
	var:boolean vInJapanese=$IsInJapaneseTOC(&quot;TBXConfig&quot;);
	var:number vLevel = $MakeIndexLevel(&quot;TBXConfig&quot;);
	var:string vTest;
	var:string vSectionName;
	var:string vName;

	$Text(vNote2)=&quot;&quot;;
	$Text(vNote1).eachLine(aline){
		vName = aline.substr(2);
		if($ChildCount(&quot;agent unnumbered&quot;) == 0){
			vSectionName = $Name($MyDictionary(vNote1)[vName]);
		}else{
			vSectionName =;
		};
		if(aline.beginsWith(&quot;1:&quot;)){

			if(vInJapanese &amp; $ChildCount(&quot;agent unnumbered&quot;)== 0){
				$Text(vNote2) += &quot;第[-&quot;+ vName +&quot;]章 &quot; + vSectionName + &quot;\n  \n&quot;;
			}else{ 
				$Text(vNote2) += &quot;[&quot; + vName + &quot;] &quot; + vSectionName + &quot;\n  \n&quot;;
			};
		};
		if(vLevel&gt;=2){
			if(aline.beginsWith(&quot;2:&quot;)){
				aline = aline.substr(2);
				if(vInJapanese &amp; $ChildCount(&quot;agent unnumbered&quot;)== 0){
					$Text(vNote2) += &quot;- [-&quot;+ vName +&quot;] &quot; + vSectionName + &quot;\n  \n&quot;;
				}else{
					$Text(vNote2) += &quot;- [&quot; + vName + &quot;] &quot; + vSectionName + &quot;\n  \n&quot;;
				}
			};
		};
			if(vLevel&gt;=3){
			if(aline.beginsWith(&quot;3:&quot;)){
				aline = aline.substr(2);
				if(vInJapanese &amp; $ChildCount(&quot;agent unnumbered&quot;)== 0){
					$Text(vNote2) += &quot;- [-&quot;+ vName +&quot;] &quot; + vSectionName + &quot;\n  \n&quot;;
				}else{
					$Text(vNote2) += &quot;- [&quot; + vName + &quot;] &quot; + vSectionName + &quot;\n  \n&quot;;
				}
			};
		};
	};
	vTest = $IDString(vNote3);
	if(vTest){
		$Text(vNote3)=$Text(vNote2);
	};
};</text>
