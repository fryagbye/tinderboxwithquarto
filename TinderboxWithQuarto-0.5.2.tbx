<text >function fSetOutlineDepthBaseForpSubnote(){
		$OutlineDepthBase = $OutlineDepthBase(parent) + 1;
};

// For pSubnote
function fSetAttributeForpSubnote(){
	fSetHTMLExportFileName();
	fSetOutlineDepthBaseForpSubnote();
	fCollectIncludeNotes();
};



function fSetPreviewForpSubnote(vID:string){
	if($Prototype(vID)==&quot;pSubnote&quot;|$Prototype($Prototype(vID))==&quot;pSubnote&quot;){
		if($HTMLExportExtension==&quot;.txt&quot;){
			$HTMLPreviewCommand(vID)=&quot;/opt/homebrew/bin/pandoc -f markdown --quiet --citeproc --bibliography=&quot;+ $Q_BibliographyFile(&quot;TBXConfig&quot;) 
			 + &quot; --resource-path=&quot;+ $ImagePathForPandoc(&quot;TBXConfig&quot;)  + &quot; --css=&quot; + $PandocCSSPath(&quot;TBXConfig&quot;) + &quot; -t html&quot;;
			$HTMLExportTemplate(vID)=&quot;/Templates/tSubnote_all_Preview&quot;;
			$HTMLExportExtension(vID)=&quot;.html&quot;;
			$HTMLMarkdown(vID)=false;
			$HTMLMarkupText(vID)=false;
		}else{
			$HTMLPreviewCommand(vAgentExport)=&quot;CommonMark&quot;;
			$HTMLExportTemplate(vID)=&quot;/Templates/tSubnote&quot;;
			$HTMLExportExtension(vID)=&quot;.txt&quot;;
			$HTMLMarkdown(vID)=true;
			$HTMLMarkupText(vID)=false;
		};
	};
};


function fSetPreviewForpSubnoteFromPath(vPath:string){
	var:list vList = collect_if(descendants(vPath), $Prototype==&quot;pSubnote&quot;|$Prototype($Prototype)==&quot;pSubnote&quot;, $ID);

	vList.each(aL){
		fSetPreviewForpSubnote(aL);
		update(aL);
	};
};</text>
