<text >function fSetIncludeNotesForExportAgent(){
    $IncludeNotes = collect_if(children, $Prototype==&quot;pNote&quot;|$Prototype($Prototype)==&quot;pNote&quot;, $ID);
};


function fCrossRefUpdate(vForce:boolean){
    var:string vName=&quot;TBXConfig&quot;;
    var:string vContainer=$ProjectContainer(vName);

    var:string vChunkPath = $ChunkListContainer(vName);
    var:string vGraphPath = $GraphListContainer(vName);
    
    var:number vInterval;
    vInterval=interval($CrossRefLastUpdate(vName), date(&quot;now&quot;)).minute*60+interval($CrossRefLastUpdate(vName), date(&quot;now&quot;)).second;


    if( vForce |(vInterval &gt; $CrossRefListUpdateCycle(&quot;TBXConfig&quot;) * 60)){
        //clear Label list, Chunk list and Graph list
        (&quot;Cross-Res List Update: Start&quot;).show(&quot;blue&quot;);

        fClearChunkList();
        fClearGraphList();


        //Chunk
        fMakeChunkList();
        update(vChunkPath);
        //Graph
        fMakeGraphList();
        update(vGraphPath);
    

        $ProjectList(vName).each(aP){
            var:string vSecPath =aP + $SecLabelListContainer(vName);
            var:string vFigPath =aP + $FigLabelListContainer(vName);
            var:string vTblPath =aP + $TblLabelListContainer(vName);
            var:string vEquPath =aP + $EquLabelListContainer(vName);
            fClearReferenceList(aP);

        // Section
            fMakeSectionList(aP, vSecPath);
            update(vSecPath);

        //Figure
            LogRec(&quot;Figure&quot;,&quot;&lt;&lt;mark&gt;&gt; Make Figure List aP:&quot; + aP + &quot; vFigPath:&quot; + vFigPath + &quot;vName:&quot; + vName);
            fMakeFigureList(aP, vFigPath);
            update(vFigPath);

        //Table
            fMakeTableList(aP, vTblPath);
            update(vTblPath);

        //Equation
            fMakeEquationList(aP, vEquPath);
            update(vEquPath);

        //Make dummy links
            fMakeLinkSecFromReferenceList(aP, vSecPath);
            fMakeLinkFigFromReferenceList(aP, vFigPath);
            fMakeLinkTableFromReferenceList(aP, vTblPath);
            fMakeLinkEquationFromReferenceList(aP, vEquPath);

        };

        $CrossRefLastUpdate(&quot;TBXConfig&quot;)=date(&quot;now&quot;);
        (&quot;Cross-Res List Update: Finish&quot;).show(&quot;blue&quot;);
    };
};

function fMakeQmdList(){
    var:string vName = $AgentNameForQmdFiles(&quot;TBXConfig&quot;);
    //$QmdList(vName) = find($AgentQuery(vName));
    $QmdList(vName) = find($HTMLExportExtension==&quot;.qmd&quot;&amp;$Prototype==&quot;pNote&quot;);
    $MyString = $AgentQuery(vName);
};

function fChangeTemplateOfAgentQmd(){
    var:string vName = $AgentNameForQmdFiles(&quot;TBXConfig&quot;);
    if($HTMLExportTemplate(vName)==&quot;/Templates/tOutputAll_MD&quot;){
        $HTMLExportTemplate(vName)=&quot;/Templates/tOutputAll_QMD&quot;;
        $HTMLExportExtension(vName)=&quot;.qmd&quot;;

    }else{
            $HTMLExportTemplate(vName)=&quot;/Templates/tOutputAll_MD&quot;;
            $HTMLExportExtension(vName)=&quot;.md&quot;;
    };

    (vName + &quot; template is set with &quot; + $HTMLExportTemplate(vName)).show;
};

function fToggleBookAgent(){
    var:string vAgentExport=$AgentNameForQmdFiles(&quot;TBXConfig&quot;);
//$Text(/Log)+= $BookAgentMode(vAgentExport) + &quot;\n&quot;;
    if($BookAgentMode(vAgentExport)==&quot;Export&quot;){
        fSetBookAgentPreviewMode();
    }else{
        fSetBookAgentExportMode();
    };
};

function fSetBookAgentPreviewMode(){
    var:string vAgentExport=$AgentNameForQmdFiles(&quot;TBXConfig&quot;);
    var:string vModeNote=&quot;/Mode ➡&quot;;
    var:number vPriority=$ExportAgentPriority(&quot;TBXConfig&quot;);
    var:string vAgentQuery;
    
//  $AgentPriority(vAgentExport)=-1;

    //Book Agent Condition
    $BookAgentMode(vAgentExport)=&quot;Preview&quot;;
    $Badge(vModeNote)=&quot;display&quot;;
    $Badge(vAgentExport)=&quot;display&quot;;
    $OutlineBackgroundColor(vAgentExport)=&quot;automatic&quot;;

    vAgentQuery = &apos;if($ToggleTOC(&quot;TBXConfig&quot;)){($HTMLExportExtension==&quot;.html&quot;)&apos;;
    vAgentQuery+= &apos;&amp;$Container.beginsWith($CurrentBookProject($AgentNameForQmdFiles(&quot;TBXConfig&quot;)))&apos;;
    vAgentQuery+= &apos;&amp;($Prototype==&quot;pNote&quot;|$Prototype($Prototype)==&quot;pNote&quot;|$Prototype==&quot;pYML&quot;|$Prototype==&quot;pDotR&quot;|$Prototype==&quot;pLanguageYML&quot;)&apos;;
    vAgentQuery+= &apos;&amp;!$IsPrototype}else{($HTMLExportExtension==&quot;.html&quot;)&apos;;
    vAgentQuery+= &apos;&amp;$Container.beginsWith($CurrentBookProject($AgentNameForQmdFiles(&quot;TBXConfig&quot;)))&apos;;
    vAgentQuery+= &apos;&amp;($Prototype==&quot;pNote&quot;|$Prototype($Prototype)==&quot;pNote&quot;|$Prototype==&quot;pYML&quot;|$Prototype==&quot;pDotR&quot;|$Prototype==&quot;pLanguageYML&quot;)&apos;;
    vAgentQuery+= &apos;&amp;!$IsPrototype&amp;($Name!=$TableOfContaintsNote(&quot;TBXConfig&quot;))}&apos;;

    $AgentQuery(vAgentExport)=vAgentQuery;

    $AgentPriority(vAgentExport)=0;

    //Export Setting for Book Agent
    update(vAgentExport);
    $HTMLPreviewCommand(vAgentExport)=&quot;/opt/homebrew/bin/pandoc -f markdown --quiet --citeproc --bibliography=&quot;+ $Q_BibliographyFile(&quot;TBXConfig&quot;) 
             + &quot; --resource-path=&quot;+ $ImagePathForPandoc(&quot;TBXConfig&quot;)  + &quot; --css=&quot; + $PandocCSSPath(&quot;TBXConfig&quot;) + &quot; -t html&quot;;
    $HTMLExportExtension(vAgentExport)=&quot;.html&quot;;
//  $HTMLExportTemplate(vAgentExport)=&quot;/Templates/tOutputAll_Preview&quot;;
    $HTMLExportTemplate(vAgentExport)=&quot;/Templates/tOutputAll_Preview&quot;;

    $HTMLMarkdown(vAgentExport)=true;
    $HTMLMarkupText(vAgentExport)=false;

    //Change collected Notes to Preview mode
    var:list vNoteList = collect_if(descendant($CurrentBookProject($AgentNameForQmdFiles(&quot;TBXConfig&quot;))),($Prototype==&quot;pNote&quot;|$Prototype($Prototype)==&quot;pNote&quot;)&amp;!$IsPrototype, $ID);
    vNoteList.each(aList){
        $HTMLPreviewCommand(aList)=&quot;/opt/homebrew/bin/pandoc -f markdown --quiet --citeproc --bibliography=&quot;+ $Q_BibliographyFile(&quot;TBXConfig&quot;) 
             + &quot; --resource-path=&quot;+ $ImagePathForPandoc(&quot;TBXConfig&quot;)  + &quot; --css=&quot; + $PandocCSSPath(&quot;TBXConfig&quot;) + &quot; -t html&quot;;
        $HTMLExportExtension(aList)=&quot;.html&quot;;
        $HTMLExportTemplate(aList)=&quot;/Templates/tNote_Preview&quot;;
        $HTMLMarkdown(aList)=true;
        $HTMLMarkupText(aList)=false;
    };

$AgentPriority(vAgentExport)= vPriority;
    (&quot;Preview is ready.&quot;).show;
    
    //$AgentPriority(vAgentExport)=1;   
};

function fSetBookAgentExportMode(){
    var:string vAgentExport=$AgentNameForQmdFiles(&quot;TBXConfig&quot;); 
    var:string vModeNote=&quot;/Mode ➡&quot;;
    var:number vPriority=$ExportAgentPriority(&quot;TBXConfig&quot;);
    var:string vAgentQuery;
    var:string vPath = collect(ancestors(vAgentExport))[-1];

    $AgentPriority(vAgentExport)= 0;

    $BookAgentMode(vAgentExport)=&quot;Export&quot;;
    $Badge(vModeNote)=&quot;printer&quot;;
    $Badge(vAgentExport)=&quot;printer&quot;;
    $OutlineBackgroundColor(vAgentExport)=&quot;ff grass green&quot;;

    vAgentQuery = &apos;if($ToggleTOC(&quot;TBXConfig&quot;)){($HTMLExportExtension==&quot;.yml&quot;|$HTMLExportExtension==&quot;.R&quot;|$HTMLExportExtension==&quot;.qmd&quot;)&apos;;
    vAgentQuery+= &apos;&amp;$Container.beginsWith($CurrentBookProject($AgentNameForQmdFiles(&quot;TBXConfig&quot;)))&apos;;
    vAgentQuery+= &apos;&amp;($Prototype==&quot;pNote&quot;|$Prototype($Prototype)==&quot;pNote&quot;|$Prototype==&quot;pYML&quot;|$Prototype==&quot;pDotR&quot;|$Prototype==&quot;pLanguageYML&quot;)&apos;;
    vAgentQuery+= &apos;&amp;!$IsPrototype}else{($HTMLExportExtension==&quot;.yml&quot;|$HTMLExportExtension==&quot;.R&quot;|$HTMLExportExtension==&quot;.qmd&quot;)&apos;;
    vAgentQuery+= &apos;&amp;$Container.beginsWith($CurrentBookProject($AgentNameForQmdFiles(&quot;TBXConfig&quot;)))&apos;;
    vAgentQuery+= &apos;&amp;($Prototype==&quot;pNote&quot;|$Prototype($Prototype)==&quot;pNote&quot;|$Prototype==&quot;pYML&quot;|$Prototype==&quot;pDotR&quot;|$Prototype==&quot;pLanguageYML&quot;)&apos;;
    vAgentQuery+= &apos;&amp;!$IsPrototype&amp;($Name!=$TableOfContaintsNote(&quot;TBXConfig&quot;))}&apos;;
    $AgentQuery(vAgentExport)=vAgentQuery;



    //Export Setting for Book Agent 
    update(vAgentExport);
    $HTMLExportExtension(vAgentExport)=&quot;.md&quot;;
    $HTMLExportTemplate(vAgentExport)=&quot;/Templates/tOutputAll_MD&quot;;
    $HTMLMarkdown(vAgentExport)=true;
    $HTMLMarkupText(vAgentExport)=false;
    
    //Change collected Notes to Export mode
    var:list vNoteList=collect_if(descendant($CurrentBookProject($AgentNameForQmdFiles(&quot;TBXConfig&quot;))), ($Prototype==&quot;pNote&quot;|$Prototype($Prototype)==&quot;pNote&quot;)&amp;!$IsPrototype, $ID);
    vNoteList.each(aList){

        if($Prototype($Prototype(aList))==&quot;pNote&quot;|$Prototype(aList)==&quot;pNote&quot;){
            $HTMLExportExtension(aList)=&quot;.qmd&quot;;
            $HTMLExportTemplate(aList)=&quot;/Templates/tNote&quot;;
        };
        if($Prototype($Prototype(aList))==&quot;pSubnote&quot;|$Prototype(aList)==&quot;pSubnote&quot;){
            $HTMLExportExtension(aList)=&quot;.txt&quot;;
            $HTMLExportTemplate(aList)=&quot;/Templates/tSubnote&quot;;   
        };

        $HTMLMarkdown(aList)=true;
        $HTMLMarkupText(aList)=false;
    };

    $AgentPriority(vAgentExport)= vPriority;

    
    (&quot;Export is ready.&quot;).show;
    
        
};


</text>
