<attribute name="Name" >Link “Reflect Note into Diagram”</attribute>
<attribute name="NeverComposite" >true</attribute>
<attribute name="RuleDisabled" >true</attribute>
<attribute name="ScreenHeight" >30</attribute>
<attribute name="ScreenWidth" >1016</attribute>
<attribute name="SelectionCount" >158</attribute>
<attribute name="Sentiment" >-0.4879120986</attribute>
<attribute name="Sentiments" >-0.6;-0.8;-0.6;-0.6;-0.6;-0.8;0.2;-0.4;-0.6;-0.6;-0.8;-0.6;-0.6;-0.4;-0.6;-0.8;-0.8;-0.8;-0.4;-0.4;-0.2;-0.2;-0.8;-0.6;-0.8;-0.6;-0.8;-0.8;-0.8;0;-0.2;-0.4;0.2;-0.2;0.4;-0.2;-0.6;-0.2;-0.4;-0.8;-0.8;0.2;-0.8;0;-0.6;-0.6;-0.6;-0.4;-1;-0.2;-0.8;-0.2;0.2;-0.8;-0.8;-0.4;-0.4;-0.4;-0.6;-0.4;-0.4;-0.4;-0.2;-0.8;-0.2;-0.8;-0.6;-0.6;-0.4;0.2;-0.8;-0.8;-0.8;-0.6;-0.8;-0.8;-0.6;-0.6;-1;-0.8;-0.8;-0.4;0.4;-0.6;0.4;-0.6;-0.8;-0.4;-0.4;-0.4;0</attribute>
<attribute name="TextWindowHeight" >1097</attribute>
<attribute name="TextWindowWidth" >983</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >16</attribute>
<attribute name="Ypos" >8.5</attribute>
<text >// Action code for link type “Diagram←Note”
//
// The destination of the link should be a Diagram Container with the 
// Prototype “Diagram” and the source can be any note in the entire
// document that will be reflected as an object in the Diagram. 

// This code will create a new child note under the Diagram Container
// that will become a “reflection” of the source note.

// After the child reflection-object note is created, a new entry will be 
// added to the $Reflected_Notes dictionary for the Diagram Container
// comprising the $ID of the source as key and the $ID of the new
// reflection-object note as the associated value.

// The $ID of the reflected original source note will be captured in 
// $ReflectedID for the new child reflection-object note.

// The $DiagramAttributesReflection set from the Diagram Container 
// (destination) will not be copied to the new child reflection-object.
// Instead, reflections will be governed by this attribute in the 
// Diagram Container unless the reflection-object is later updated
// to include a custom version of $DiagramAttributesReflection.

// Finally, a new link of type “Diagram_Reflection→Note” will be
// established from the new child reflected-object note to the
// original source note.

var:boolean debug=false; // If debug is true, issue log statements
var:string  logbook=&quot;Debug—Diagram←Note Link&quot;; // Log Book name for debugging

// If source is empty, don&apos;t do anything
if($Name(source)!=&quot;&quot;)
{ // Execution context appears to be valid
  if($Prototype(destination)==&quot;Diagram&quot;)
  { // This is a valid link establishment, proceed to create reflection-object child
    if(debug){LogRec(logbook,$Name(source)+&quot; =&gt; &quot;+$Name(destination));};

    var:number  sourceID=$ID(source); // Capture ID of original Reflected Note
    var:number  destinationID=$ID(destination); // Capture ID of Diagram Container
    var:string  newChild; // Path to new reflection-object note
    var:number  newChildID; // ID for new reflection-object note
    var:string  newLookup; // New Lookup entry for “Reflected_Notes” Dictionary

    if(debug){LogRec(logbook,sourceID+&quot; =&gt; &quot;+destinationID);};
    if(debug){LogRec(logbook,$Path(destination)+&quot;/&quot;+$Name(source));};

    // Create new child reflection-object note using a temporary name.
    // Once the new child has been set up and its $ID captured, the name
    // will be replaced with the original source reflected note&apos;s $Name.
    // This handles the situation where two different notes with the same
    // name are added to a Diagram Container. There will be two notes
    // named the same, but each will still be a unique note with a link
    // to the correct Reflected Note. I.e., same name, different reflections.

    newChild=create($Path(destination)
      +&quot;/Temp«&quot;+$Name(source).replace(&quot;\\&quot;,&quot;\\\\&quot;).replace(&apos;/&apos;,&apos;\\/&apos;)+&quot;»&quot;);
    if(debug){LogRec(logbook,&quot;Temp new child Path: &quot;+newChild);};
    // Capture $ID for new child, and rename with Reflected note&apos;s name.
    newChildID=$ID(newChild);
    $Name(newChildID)=$Name(source);
    // Initialize structural attributes in the new child note
    $Prototype(newChildID)=&quot;Reflection Object&quot;;
    $Reflected_ID(newChildID)=sourceID; // absolute pointer to reflected note
    $Diagram_ID(newChildID)=destinationID; // i.e., parent of newChild
    // Initialize $DiagramAttributesReflection in newChild to an empty set.
    // Unless this is later assigned in the new reflection-object child, 
    // the default for future reflections will be the set maintained in the
    // Diagram Container. 
    $DiagramAttributesReflection(newChildID)=&quot;&quot;;

    // Reflect appearance-related attributes from reflected note (source) to
    // new child reflection-object

    CopyAttributeSet(sourceID,newChildID,$DiagramAttributesReflection(destinationID));

    if(debug){LogRec(logbook,&quot;Path to Reflection Object: &quot;+$Path(newChildID));};

    // Create new entry in $Reflected_Notes dictionary for Diagram Container
    // to allow looking up reflection-object $ID given the reflected-note $ID

    newLookup=sourceID+&quot;:&quot;+newChildID;
    if(debug){LogRec(logbook,newLookup);};
    $Reflected_Notes(destinationID)=$Reflected_Notes(destinationID).add({newLookup}); 

    // Create a link from the reflection-object note to the original
    // source reflected note.

    createLink(newChildID,source,&quot;Diagram_Reflection→Note&quot;);

    // Update Reflected Links for entire diagram

    UpdateDiagramLinks(destinationID)

  } else 
  { // Endif Link destination not a Diagram Container
    if(debug){LogRec(logbook,&quot;Link destination “&quot;+$Name(destination)+&quot;” is not a Diagram Container&quot;);};
    show(&quot;Links of type “Diagram←Note” must land on a Diagram Container&quot;,&quot;poppy&quot;,&quot;bright blue&quot;);
    unlinkTo($ID(destination),&quot;Diagram←Note&quot;);
  };
} else
{ // This Link Action was invoked erroneously (probably by editing code)
// if(debug){LogRec(logbook,&quot;Skipped bogus execution context&quot;);};
}; // Endif check for empty invocation of Link Action
// End of Link Action code block

// Notes:
// (1) Actions associated with the Diagram Container will maintain the
// reflected relationship between the original source note and its
// corresponding Diagram reflection-object (child) using the 
// $Reflected_Notes dictionary as a lookup table.

// Functions used in this code block: 
//   LogRec
//   CopyAttributeSet
//   UpdateDiagramLinks</text>
