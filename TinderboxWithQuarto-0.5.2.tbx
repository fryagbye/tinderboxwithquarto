<item ID="1767341084" Creator="fryagbye" >
<attribute name="Created" >2026-01-02T17:04:33+09:00</attribute>
<attribute name="DominantLanguage" >en</attribute>
<attribute name="Modified" >2026-01-02T17:04:33+09:00</attribute>
<attribute name="NLNames" >Axis</attribute>
<attribute name="Name" >@fig-plotly</attribute>
<attribute name="OutlineBackgroundColor" >light violet</attribute>
<attribute name="Sentiment" >-0.147826095</attribute>
<attribute name="Sentiments" >-0.6;-0.2;-0.6;-0.6;0.4;-0.6;-0.6;-0.6;-0.6;-0.6;-0.6;-0.6;-0.6;-0.6;0.6;0.6;0.6;-0.4;0;-0.2;0.8;0.8;0.8</attribute>
<attribute name="ToDummyLinkPath" >/myproject/main/Plotly/plotly</attribute>
<attribute name="Xpos" >9</attribute>
<attribute name="Ypos" >0</attribute>
<text >```{python}
#| label: fig-plotly
import plotly.express as px
import pandas as pd
import numpy as np

# 1. 外部データを使わず、手動でデータを作成
# （ランダムな100個のデータを作成）
np.random.seed(42)
df = pd.DataFrame({
    &quot;x_val&quot;: np.linspace(0, 10, 100),
    &quot;y_val&quot;: np.sin(np.linspace(0, 10, 100)) + np.random.normal(0, 0.1, 100),
    &quot;category&quot;: np.random.choice([&quot;A&quot;, &quot;B&quot;], 100)
})

# 2. 散布図を作成
fig = px.scatter(
    df, 
    x=&quot;x_val&quot;, 
    y=&quot;y_val&quot;, 
    color=&quot;category&quot;,
    title=&quot;Local Data Test (No Network)&quot;,
    labels={&quot;x_val&quot;: &quot;X Axis&quot;, &quot;y_val&quot;: &quot;Y Axis&quot;}
)

# 3. 描画
fig.show()
