<text >function fSetExportMode(aPath:string){

		if($Prototype($Prototype(aPath))==&quot;pNote&quot;|$Prototype(aPath)==&quot;pNote&quot;){
			$HTMLExportExtension(aPath)=&quot;.qmd&quot;;
			$HTMLExportTemplate(aPath)=&quot;/Templates/tNote&quot;;
		};
		if($Prototype($Prototype(aPath))==&quot;pSubnote&quot;|$Prototype(aPath)==&quot;pSubnote&quot;){
			$HTMLExportExtension(aPath)=&quot;.txt&quot;;
			$HTMLExportTemplate(aPath)=&quot;/Templates/tSubnote&quot;;
		};

		$HTMLMarkdown(aPath)=true;
		$HTMLMarkupText(aPath)=false;

}

function fSetPreviewMode(aPath:string){

		$HTMLPreviewCommand(aPath)=&quot;/opt/homebrew/bin/pandoc -f markdown --quiet --citeproc --bibliography=&quot;+ $Q_BibliographyFile(&quot;TBXConfig&quot;) 
			 + &quot; --resource-path=&quot;+ $ImagePathForPandoc(&quot;TBXConfig&quot;)  + &quot; --css=&quot; + $PandocCSSPath(&quot;TBXConfig&quot;) + &quot; -t html&quot;;
		$HTMLExportExtension(aPath)=&quot;.html&quot;;

		if($Prototype($Prototype(aPath))==&quot;pNote&quot;|$Prototype(aPath)==&quot;pNote&quot;){
			$HTMLExportTemplate(aPath)=&quot;/Templates/tNote_Preview&quot;;
		};
		if($Prototype($Prototype(aPath))==&quot;pSubnote&quot;|$Prototype(aPath)==&quot;pSubnote&quot;){
			$HTMLExportTemplate(aPath)=&quot;/Templates/tSubnote_Preview&quot;;
		};

		$HTMLMarkdown(aPath)=true;
		$HTMLMarkupText(aPath)=false;

}

function fSetHTMLExportFileName(){
	if(!($IsNamesLocked)){
		if($IsIndexqmd){
			$HTMLExportFileName=&quot;index&quot;;
		}else{
			$HTMLExportFileName= fDeleteCharacters($Name);
		};

		if(($SectionLabel==&quot;untitled&quot;|$HTMLExportFileName==&quot;untitled&quot;|!$SectionLabel|!$HTMLExportFileName)&amp;!$IsPrototype){
				$HTMLExportFileName= fDeleteCharacters($Name);
				$SectionLabel = $HTMLExportFileName;
		};
		if(($SectionLabel!=$HTMLExportFileName)&amp;!$IsPrototype){
			$SectionLabel = $HTMLExportFileName;
		};
		if(($SectionLabel==$HTMLExportFileName)&amp;$SectionLabel!=&quot;untitled&quot;&amp;!$IsPrototype){
			$IsNamesLocked=true;
		};
	};
	if($IsUnnumbered){
		$HasSectionLabel=false;
	};
};

function fSetIsPartQmd(){
    var:number vBaseOutlineDepth=2;
	if(($OutlineDepth==vBaseOutlineDepth)&amp;(collect_if(children, $Prototype==&quot;pNote&quot;|$Prototype($Prototype)==&quot;pNote&quot;,$Name).count&gt;0)){
		$Is_Part_qmd = true;
	}else{
		$Is_Part_qmd = false;
	};

	if($OutlineDepth==vBaseOutlineDepth + 1){
		$Is_Part_qmd = false;
	};
};

function fCollectIncludeNotes(){
	if($Is_Part_qmd){
		$IncludeNotes= collect_if(children, $Prototype==&quot;pNote&quot;|$Prototype($Prototype)==&quot;pNote&quot;, $ID);
	}else{
		$IncludeNotes = collect_if(children, $Prototype==&quot;pSubnote&quot;|$Prototype($Prototype)==&quot;pSubnote&quot;, $ID);

	};
};

function fSetPartFileAttribute(){
	var:number vBaseOutlineDepth=2;
	if(($OutlineDepth==vBaseOutlineDepth + 1)&amp;($Is_Part_qmd(parent))){
		$Part_file = $HTMLExportFileName(parent)+$HTMLExportExtension(parent);
	}else{
		$Part_file = ;
	};
	fCollectIncludeNotes();
};

function fSetOutlineDepthBaseForpNote(){
	var:number vOutlineDepthControle=1;
		if($Part_file){
			$OutlineDepthBase = $OutlineDepth - 1 - vOutlineDepthControle;
		}else{
			$OutlineDepthBase = $OutlineDepth - vOutlineDepthControle;
		};
};



//For pNote

function fSetAttributeForpNote(){

	fSetHTMLExportFileName();

	// Is a part-qmd or not.  	
	fSetIsPartQmd();

	//Set attribute for Nested qmd file ( Under the Part file ) 
	fSetPartFileAttribute();
	//Adjust OutlineDepthBase
	fSetOutlineDepthBaseForpNote();

};



