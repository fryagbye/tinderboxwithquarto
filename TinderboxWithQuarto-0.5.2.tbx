<item ID="1765002456" Creator="Takeshi Otsuka" >
<attribute name="Badge" >sf-rectangle.and.paperclip</attribute>
<attribute name="BadgeMonochrome" >true</attribute>
<attribute name="Color" >7</attribute>
<attribute name="Created" >2025-01-14T18:43:44+09:00</attribute>
<attribute name="CreatedFrom" >/Mermaid flowchart (optional)</attribute>
<attribute name="DisplayExpression" >if($M_SubgraphName){
	if($M_SubgraphDirection){
		$M_SubgraphName + &quot; : &quot; + $Name   + &quot; (&quot; +$M_SubgraphDirection.substr(0,1) + &quot;→&quot; +$M_SubgraphDirection.substr(-1) +&quot; )&quot;;
	}else{
		$M_SubgraphName + &quot; : &quot; + $Name;
	};
}else{
	if($M_SubgraphDirection){
		 $Name   + &quot; (&quot; + $M_SubgraphDirection.substr(0,1) + &quot;→&quot; +$M_SubgraphDirection.substr(-1) + &quot; )&quot;;
	}else{
		$Name;
	};

};</attribute>
<attribute name="DisplayedAttributes" >GS_SubgraphName;GS_HasOutputStyle;GS_NodeOnSubgraph;Color;BorderColor;Border;BorderDash;NameColor;AccentColor;ID;OutboundLinkCount</attribute>
<attribute name="DominantLanguage" >en</attribute>
<attribute name="GridColumns" >2</attribute>
<attribute name="GridLabelSize" >15</attribute>
<attribute name="GridRows" >5</attribute>
<attribute name="HTMLDontExport" >true</attribute>
<attribute name="HTMLExportChildren" >false</attribute>
<attribute name="Height" >1.86</attribute>
<attribute name="IsPrototype" >true</attribute>
<attribute name="M_HasOutputStyle" >true</attribute>
<attribute name="Modified" >2025-01-14T18:43:44+09:00</attribute>
<attribute name="Name" >pMFSubgraph</attribute>
<attribute name="NameColor" >black</attribute>
<attribute name="NeverComposite" >true</attribute>
<attribute name="OnAdd" >if($Prototype==&quot;&quot;){
	$Prototype=&quot;pMFNode&quot;;
}</attribute>
<attribute name="OnRemove" >$M_Subgraph(parent)= $M_Subgraph(parent) - $ID;
$M_Adornments(parent)=$M_Adornments(parent) - $ID(adornment);
$M_NodeOnSubgraph(adornment) -= &quot;[&quot; + $ID +&quot;]&quot;;
</attribute>
<attribute name="Rule" >$GridLabels = $M_SubgraphLinks;</attribute>
