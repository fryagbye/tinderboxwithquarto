<text >// Set the $SafePath attribute for a Container referenced by the
// supplied absolute path string argument (abs_path) as well as for 
// all descendants of the Container.
// Caution: the supplied absolute path string must be “clean” or
// “safe” with all problem characters escaped. The ConstructSafePath2Note()
// function can be used to construct the correct absolute path to
// the starting Container when it might be referenced by non-absolute
// paths or when note names in the Path might contain slash characters.
// This function calls itself recursively to “walk” the entire branch
// starting from the supplied absolute path (i.e., abs_path argument).
// If the supplied abs_path argument is a single ‘/’ (i.e., “root”), then 
// every note in the document will have its $SafePath updated.


function UpdateSafePaths(abs_path)
{ // Define debug &amp; logbook variables
  var:boolean debug=false;
  var:string logbook=&quot;UpdateSafePaths&quot;;

  // Define “child_list” as a list of children of the Container
  // referenced by “abs_path” argument
  var:list child_list;
  // Define string used for “abs_path” argument for recursive
  // calls to this function
  var:string next_abs_path=;

  if(debug)
  { LogRec(logbook,&quot;&lt;&lt;blank&gt;&gt;&quot;);
    LogRec(logbook,&quot;&lt;&lt;mark&gt;&gt;Recursion for UpdateSafePaths&quot;);
    LogRec(logbook,&quot;abs_path:  &quot;+abs_path
                   +&quot; | child count=&quot;+$ChildCount(abs_path)
                   +&quot; Is Alias? &quot;+$IsAlias(abs_path));
  };

  // If there are no children, return after updating $SafePath
  if(!$ChildCount(abs_path))
  { // If not root or not alias, assign $SafePath for Note referenced
    //  by “abs_path”—Note that this assignment is a logical tautology.
    if(!(abs_path==&quot;/&quot;|$IsAlias(abs_path))){$SafePath(abs_path)=abs_path;};
    return();
  };
  // Otherwise, get list of children for supplied absolute path
  child_list=collect(children(abs_path),$ID);
  if(debug){LogRec(logbook,&quot;Child list: &quot;+child_list);};
  // Handle special case where abs_path is “root,” i.e. == “/” 
  if(abs_path==&quot;/&quot;)
  { // This is “root,” so do not set $SafePath attribute and clear abs_path
    abs_path=&quot;&quot;;
  } else
  { // Assign $SafePath for Note/Container referenced by “abs_path”
    // unless the referenced note is an alias.
    // Note that this assignment is a logical tautology
    if(!$IsAlias){$SafePath(abs_path)=abs_path;};
  };
  // Now call this function recursively for each child
  child_list.each(next_child)
  { //Now log each next_child
    if(debug){LogRec(logbook,&quot;Next child: &quot;+next_child+&quot; Name: &quot;+$Name(next_child));};
    // Construct absolute path to next child with safe child name
    next_abs_path=abs_path+&quot;/&quot;
      +$Name(next_child).replace(&quot;\\&quot;,&quot;\\\\&quot;).replace(&apos;/&apos;,&apos;\\/&apos;);
    if(debug){LogRec(logbook,&quot;Next path: &quot;+next_abs_path);};
    // Recursively call this function for child
    UpdateSafePaths(next_abs_path);
  };
  return();
};

// Modified 2022-04-29 making these changes:
//   • If supplied “abs_path” argument references a note with no 
//     children, set $SafePath for referenced note anyway
//   • Use $ID instead of $Name to avoid confusion with list delimiters
//   • Use direct replacement of forward and back slashes instead of
//     CleanseName() function. This should improve portability.
//
// Modified 2022-05-20 to not set $SafePath if the referenced note
// is an alias.
// 
// On 2022-06-21, Modified function name to be UpdateSafePaths instead 
// of SetSafePaths to convey that this function will always update the
// current $SafePath attribute in each note traversed.

// This function requires Tinderbox version 9.1 or later
</text>
