<item ID="1765002483" Creator="Takeshi Otsuka" proto="HTML" >
<attribute name="Created" >2023-08-27T12:02:23+09:00</attribute>
<attribute name="HTMLDontExport" >false</attribute>
<attribute name="HTMLExportChildren" >true</attribute>
<attribute name="HTMLMarkupText" >false</attribute>
<attribute name="Height" >3</attribute>
<attribute name="IsAction" >true</attribute>
<attribute name="Modified" >2026-01-02T17:15:10+09:00</attribute>
<attribute name="Name" >tNote</attribute>
<attribute name="NeverComposite" >true</attribute>
<attribute name="OutlineBackgroundColor" >light cyan</attribute>
<attribute name="Q_Affiliation_ID" >148</attribute>
<attribute name="SelectionCount" >1503</attribute>
<attribute name="Sentiment" >-0.2905982973</attribute>
<attribute name="Sentiments" >1;0.2;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;0.6;-0.2;-0.6;0;-0.8;0.8;-0.6;0.2;0.8;0.8;0.6;-0.8;-0.8;-0.8;-0.6;1;-0.8;-0.4;-0.4;-0.4;-0.8;-0.8;-0.8;-0.8;0.8;0.2;0.8;-0.4;-0.2;-0.2;-0.2;0.4;-0.6;-0.6;-0.4;-0.2;0.2;0.2;-0.8;0.2;-0.8;-0.6;0.4;-0.2;-0.2;-0.4;-0.4;0;-0.6;-0.4;-0.2;-0.2;0.4;-0.6;0.2;-0.6;-0.6;0.4;0.2;-0.2;-0.2;-0.2;-0.6;-0.6;-0.2;-0.2;-0.2;-0.6;-0.2;-0.2;-0.2;-0.6;-0.2;-0.4;-0.2;-0.2;-0.6;0.2;-0.2;-0.6;-0.2;-0.2;-0.4;-0.4;-0.2;-0.2;-0.2;-0.6;-0.2;-0.2;-0.2;-0.4;-0.2;-0.6;0.2;1</attribute>
<attribute name="Width" >5</attribute>
<attribute name="Xpos" >11</attribute>
<attribute name="Ypos" >0</attribute>
<text >^action(
    var:string vChunkListPath=&quot;/Chunk List&quot;;
    var:string vGraphListPath=&quot;/Graph List&quot;;
    var:string vText;
    var:string vPre;
    var:string vReg1=&quot;&lt;(?:webr|r|python|pyodide|osj):(.*?)&gt;&quot;;
    var:string vReg2=&quot;&lt;(?:dot|mermaid):(.*?)&gt;&quot;;
    var:string vReg3=&quot;&quot;;
    var:string vChunkPath;
    var:string vChunkName;
    var:string vGraphPath;
    var:string vGraphName;
    var:string vTest;
    var:boolean vCheck;
    var:boolean vOpenFlag1;
    var:boolean vOpenFlag2;
    var:boolean vOpenFlag3;
    var:boolean vOpenFlag4;
    var:string vProjectPath;
    var:string vTemp;
	 var:boolean vWarn=false;

    vProjectPath=collect(ancestors(original),$Path)[-1];

    if($HasOutType(vProjectPath)){
        vTemp =&apos;out_type &lt;- knitr::opts_knit$get(&quot;rmarkdown.pandoc.to&quot;)\n&apos;;
    };
    if($HasCommonR(vProjectPath)){
        vTemp +=&apos;source(&quot;_common.R&quot;)\n&apos;;
    };

    if($HasOutType(vProjectPath)|$HasCommonR(vProjectPath)){
        vPre += &apos;```{r, echo=FALSE}\n&apos;;
        vPre += &apos;#| include: false\n&apos;;
        vPre += vTemp;
        vPre += &apos;```\n&apos;;
    };


    vPre += $OutlineDepthBase * &quot;#&quot;  + &quot; &quot; + $Name;
    if($IsUnnumbered|$HasSectionLabel|$IsAppendix){
        vPre +=&quot; {&quot;;
    };
    if($HasSectionLabel){
        vPre +=&quot;#sec-&quot; + $SectionLabel;
    };
    if($IsUnnumbered){
        vPre +=&quot; .unnumbered&quot;;
    };
    if($IsAppendix){
        vPre +=&quot; .appendix&quot;;
    };
    if($IsUnnumbered|$HasSectionLabel|$IsAppendix){
        vPre +=&quot; }\n \n &quot;;
    }else{
        vPre +=&quot;\n \n &quot;;
    };

    vText=vPre;
    var:number vLineCount = 0;
    $Text.eachLine(aLine){
        vLineCount += 1;
        vCheck=true;
        //chunk tag
        if(aLine.extract(vReg1)){
            vChunkName=$1;
//          vChunkPath=$Path(original)+&quot;/&quot;+vChunkName;
            vChunkPath=$ToDummyLinkPath($0);
            $FromDummyLinkPath($0)+=$Path;
            createLink($Path, $0);

            vTest=$ID(vChunkPath);
        
            if(!vTest){
                vChunkPath=collect_if(children(vChunkListPath),$Name==vChunkName,$Path).first;
            };
            if(!vTest &amp; !$ID(vChunkPath)&amp;vWarn){
                (&quot;No Chunk Tag Label Detected&quot;).show;
            };
            
            
            if(vLineCount &gt; 1){
                vText += &quot;\n &quot;;
            };
            vText += fWriteOptionsForChunk($ID(vChunkPath), false)+&quot;\n &quot;;
            vCheck=false;
        };

        //graph tag
        if(aLine.extract(vReg2)){
            vGraphName=$1;
            vGraphPath=$ToDummyLinkPath($0);
            $FromDummyLinkPath($0)+=$Path;
            createLink($Path, $0);

            vTest=$ID(vGraphPath);
            if(!vTest &amp; !$ID(vChunkPath)){
                vGraphPath=collect_if(children(vGraphListPath),$Name==vGraphName,$Path).first;
            };

            if(!vTest &amp; !$ID(vChunkPath)&amp;vWarn){
                (&quot;No Graph Tag Label Detected&quot;).show;
            };

            if(vLineCount &gt; 1){
                vText += &quot;\n &quot;;
            };
            vText += fWriteOptionsForGraph($ID(vGraphPath)) +&quot;\n &quot;;
            vCheck=false;
        };  

        if(vCheck){
            if(aLine.beginsWith(&quot;$$&quot;)){
                if(vOpenFlag1){
                    vText+= aLine+&quot;\n &quot;;
                    vOpenFlag1=false;
                }else{
                    if(vLineCount &gt; 1){ vText+= &quot;\n&quot;; };
                    vText+= aLine+&quot;\n&quot;;
                    vOpenFlag1=true;
                };
                vCheck=false;
            };
            if(vCheck&amp;(aLine.beginsWith(&quot;:::&quot;)|aLine.beginsWith(&quot;[&quot;)|aLine.beginsWith(&quot;![&quot;))){
                if(vLineCount &gt; 1){ vText+=&quot;\n&quot;; };
                vText+= &quot;\n&quot; + aLine +&quot;\n \n &quot;;
                vCheck=false;
            };
            if(vCheck&amp;(aLine.beginsWith(&quot;:&quot;)|aLine.contains(&quot;^\s*([*+]|\d+\.)\s+&quot;))){
                if(vLineCount &gt; 1){ vText+=&quot;\n &quot;; };
                vText+= aLine +&quot;\n \n &quot;;
                vCheck=false;
            };
            if(vCheck&amp;(aLine.beginsWith(&quot;[^&quot;))){
                vText+= aLine+&quot;\n &quot;;
                vCheck=false;
            };
            if(vCheck&amp;(aLine.beginsWith(&quot;```&quot;))){
                if(vOpenFlag3){
                    vText+= aLine+&quot;\n &quot;;
                    vOpenFlag3=false;
                }else{
                    if(vLineCount &gt; 1){ vText+= &quot;\n&quot;; };
                    vText+= aLine+&quot;\n&quot;;
                    vOpenFlag3=true;
                };
                vCheck=false;
            };

            
            if(vCheck){
                vText+= aLine+ &quot;\n&quot;;
            };
        };
    };
    if(vLineCount &gt; 0){
        vText+=&quot;\n&quot;;
    };

)^^value(vText)^^if(^value(!$Is_Part_qmd))^^include(^value($IncludeNotes)^, /Templates/tSubnote)^^endIf^
</text>
