<text >```{python}
#| label: fig-seaborn

import seaborn as sns
import matplotlib.pyplot as plt
import pandas as pd
import numpy as np

# データの作成
np.random.seed(42)
df = pd.DataFrame({
    &quot;sepal_width&quot;: np.random.normal(3, 0.5, 100),
    &quot;sepal_length&quot;: np.random.normal(6, 0.8, 100),
    &quot;species&quot;: np.random.choice([&quot;setosa&quot;, &quot;versicolor&quot;, &quot;virginica&quot;], 100)
})

# グラフの作成
plt.figure(figsize=(6, 4))
sns.scatterplot(
    data=df, 
    x=&quot;sepal_width&quot;, 
    y=&quot;sepal_length&quot;, 
    hue=&quot;species&quot;,
    s=100,
    alpha=0.7
)

plt.title(&quot;Iris Data (Seaborn on Pyodide v0.27.1)&quot;)
plt.show()
```
</text>
