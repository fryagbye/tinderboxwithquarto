<text >function fRuleForpFrontmatterManuscript(){
	//stamp(&quot;exportfilename&quot;);

	$IncludeNotes = collect_if(children, $Prototype==&quot;pSubnoteManuscript&quot;, $ID);
	$OutlineDepthBase = $OutlineDepth - 1;

};

function fOnAddForpFrontmatterManuscript(){
	if(!$Prototype|$Prototype==&quot;pFrontmatterManuscript&quot;){
		$Prototype=&quot;pSubnoteManuscript&quot;;
	};
	if(!($IsNamesLocked)){
			$HTMLExportFileName=$Name.deleteCharacters(&quot;/\?%*:|&lt;&gt;.&amp;+()!#`&quot;).lowercase().replace(&quot; &quot;,&quot;-&quot;).replace(&quot;&apos;&quot;,&quot;&quot;);
		if(!($SectionLabel)&amp;!($IsPrototype)){
			$SectionLabel = $HTMLExportFileName;
		};
	};

	
	
};</text>
