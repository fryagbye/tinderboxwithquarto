<text >

function fGetAttributeList(vNote){
	var:list vKeys;
	var:string vOutput;
	var:string vLeft;
	var:string vRight;
	$Text(/Log) =;
	
	vKeys = $MySet(&quot;System Attributes&quot;);
	vKeys.each(aKey){
		if(!( aKey==&quot;Text&quot; | aKey==&quot;Name&quot;)){
			vLeft = eval(&quot;$&quot;+aKey+&quot;(vNote)&quot;);
			vLeft = vLeft.replace(&quot;\n&quot;,&quot;&quot;);
			vRight = attribute(aKey)[&quot;default&quot;];
			vRight = vRight.replace(&quot;\n&quot;,&quot;&quot;);
			if(vLeft != vRight){
				vOutput += aKey + &quot;:&quot; + eval(&quot;$&quot;+aKey+&quot;(vNote)&quot;) +&quot;⬅️&quot; + attribute(aKey)[&quot;default&quot;] + &quot;\n&quot;;
//				vOutput += aKey + &quot;\n&quot;;
			};
		};
	};
	
	$Text(/Log) = $Name + &quot;\n\n&quot;;
	$Text(/Log) += &quot;-----System Attribute(changed):value⬅️default\n&quot;;
	$Text(/Log) += vOutput;
	vOutput=&quot;&quot;;
	vKeys = document[&quot;user-attributes&quot;];

	vKeys.each(aKey){
		vLeft = eval(&quot;$&quot;+aKey+&quot;(vNote)&quot;);
		vLeft = vLeft.replace(&quot;\n&quot;,&quot;&quot;);
		vRight = attribute(aKey)[&quot;default&quot;];
		vRight = vRight.replace(&quot;\n&quot;,&quot;&quot;);
		if(vLeft != vRight){
			vOutput += aKey + &quot;:&quot; + eval(&quot;$&quot;+aKey+&quot;(vNote)&quot;) +&quot;⬅️&quot; + attribute(aKey)[&quot;default&quot;] + &quot;\n&quot;;
//			vOutput += aKey + &quot;\n&quot;;
		};
	};
	$Text(/Log) += &quot;\n-----User Attribute(changed):value⬅️default\n&quot;;
	$Text(/Log) += vOutput;	
};

function fGetAttributeList2(vNote){
	$Text(/Log) =;
	var:list vKey = document[&quot;user-attributes&quot;];
	$Text(/Log)+= vKey + &quot;\n\n&quot;;
	vKey.each(aKey){
		$Text(/Log) += aKey +&quot;:&quot; + eval(&quot;$&quot;+aKey+&quot;(vNote)&quot;) +&quot;⬅️&quot; +attribute(aKey)[&quot;default&quot;]+&quot;\n&quot;;
	};
};</text>
