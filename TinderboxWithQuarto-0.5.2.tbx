<text >function fDisplayExpression(){
	$DisplayExpression =&apos;$OutlineDepthBase(original)  * $Indent_Charactor(&quot;TBXConfig&quot;) +&quot; &quot;+ if($Name.size &lt;= 30){$Name +  (30 - $Name.size) * &quot; &quot; }else{$Name} + if(($HasSectionLabel)&amp;($SectionLabel)){&quot; {&quot; + $SectionLabel + &quot;}&quot;};&apos;;
};


function fDisplayExpression2(){
	$DisplayExpression =&apos;$OutlineDepthBase(original)  * $Indent_Charactor(&quot;TBXConfig&quot;) +&quot; &quot;+ if($Name.size &lt;= 30){$Name +  (30 - $Name.size) * &quot; &quot; }else{$Name} + if(($HasSectionLabel)|($IsUnnumbered)|($IsAppendix)){&quot; {&quot;} + if(($HasSectionLabel)&amp;($SectionLabel)){ $SectionLabel } + if(($HasSectionLabel)|($IsUnnumbered)|($IsAppendix)){&quot;}&quot;};&apos;;
};</text>
