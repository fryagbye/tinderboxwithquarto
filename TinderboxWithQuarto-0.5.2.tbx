<text >function fSetReference(){
	var:string vText=$ReferenceRIS.following(&quot;U1  - &quot;);
	
	if(($Prototype==&quot;pReference&quot;)){
		if(vText){
			$CiteKey = vText;
			$Name = &quot;@&quot; + vText;
			$DisplayExpression = &apos;$Name + &quot;\n&quot; + $BookTitle + &quot; in &quot; + $PublicationYear.substr(0,4)&apos;;
			$Abstract=$ReferenceRIS.following(&quot;AB  - &quot;);
		};
		//if($Text=;){
			$Text = &quot;Abstract: \n&quot; + $Abstract;
		//}
		if(!($ReferenceURL)){
			 $ReferenceURL= $ReferenceRIS.following(&quot;U20  - &quot;);
		};
	};
	
};
</text>
