<attribute name="NLOrganizations" >TableOrder</attribute>
<attribute name="Name" >Utilities: Table Order</attribute>
<attribute name="Q_Affiliation_ID" >108</attribute>
<attribute name="ScreenHeight" >28</attribute>
<attribute name="SelectionCount" >75</attribute>
<attribute name="Sentiment" >-0.2923077012</attribute>
<attribute name="Sentiments" >-0.6;-0.6;0;-0.2;-0.8;0.4;0;0;0;0.6;0.6;-0.4;-0.4;0.2;-0.4;-0.4;-0.6;-0.6;-0.6;-0.6;-0.6;-0.6;-0.4;-0.4;-0.6;-0.6</attribute>
<attribute name="Width" >3</attribute>
<attribute name="Xpos" >80.5</attribute>
<attribute name="Ypos" >2.36</attribute>
<text >var:list vlist;
var:number vsum=0;
var:number vorder=1;
if($Prototype==&quot;pTable&quot;){
	vlist = collect(children,$Path);
	vsum = sum(children, $TableOrder);
	$MyNumber = vsum;
//$MyList= vlist;
	if(vsum=0){
		vlist.each(alist){
			$TableOrder(alist)=vorder;
			vorder += 1;
		};
		$Sort=&quot;TableOrder&quot;;
		$SortBackward=false;
		$SortAlso=&quot;&quot;;
		$SortBackwardAlso=false;
	show(&quot;ordered&quot;);
	}else{
		vlist.each(alist){
			$TableOrder(alist)=0;
		};
		$Sort=&quot;&quot;;
		$SortBackward=false;
		$SortAlso=&quot;&quot;;
		$SortBackwardAlso=false;
	show(&quot;reset&quot;);		
	};

};</text>
