<text >---
title: &quot;^value($Q_Title)^&quot;
^if($Q_Subtitle)^subtitle: &quot;^value($Q_Subtitle)^&quot;^endIf^
^if($Q_Date!=&quot;never&quot;)^date: ^value($Q_Date.format(&quot;y-M0-D&quot;))^^endIf^
^if($QR_Author)^author: ^value($Q_Author)^^endIf^
^if($Q_Affiliation_Name)^institute: &quot;^value($Q_Affiliation_Name)^&quot;^endIf^
format:
   ^if($Q_QuartoLiveExt)^live-^endIf^revealjs:
    number-sections: ^if($Q_HasNumberSection)^true^else^false^endIf^
    ^if($Q_HasNumberSection)^number-depth: ^value($Q_NumberSection)^^endIf^
    ^if($QR_ShiftHeadingLevelBy)^shift-heading-level-by: ^value($QR_ShiftHeadingLevelBy)^^endIf^
    ^if($QR_Css)^css: ^value($QR_Css)^^endIf^
    ^if($QR_SlideNumber)^slide-number: ^value($QR_SlideNumber)^^endIf^
    ^if($QR_Logo)^logo: ^value($QR_Logo)^^endIf^
    ^if($QR_Footer)^footer: ^value($QR_Footer)^^endIf^
    ^if($QR_IsScrollable)^scrollable: true^endIf^
    ^if($QR_IsSmaller)^smaller: true^endIf^
    ^if($QR_OutputLocation)^output-location: ^value($QR_OutputLocation)^^endIf^
    ^if($QR_Transition)^transition: ^value($QR_Transition)^^endIf^
    ^if($QR_TransitionSpeed)^transition-speed: ^value($QR_TransitionSpeed)^^endIf^
    ^if($QR_BackgroundTransition)^background-transition: ^value($QR_BackgroundTransition)^^endIf^
    ^if($QR_MermaidFormat)^mermaid-format: ^value($QR_MermaidFormat)^^endIf^

---

^action(
	var:string vProjectPath;
	var:string vTemp;
	var:string vPre;

	vProjectPath=collect(ancestors(original),$Path)[-1];

	if($HasOutType(vProjectPath)){
		vTemp =&apos;out_type &lt;- knitr::opts_knit$get(&quot;rmarkdown.pandoc.to&quot;)\n&apos;;
	};
	if($HasCommonR(vProjectPath)){
		vTemp +=&apos;source(&quot;_common.R&quot;)\n&apos;;
	};

	if($HasOutType(vProjectPath)|$HasCommonR(vProjectPath)){
		vPre += &apos;```{r, echo=FALSE}\n&apos;;
		vPre += &apos;#| include: false\n&apos;;
		vPre += vTemp;
		vPre += &apos;```\n&apos;;
	};
)^

^value(vPre)^


^if($Q_QuartoLiveExt)^{{&lt; include ./_extensions/r-wasm/live/_knitr.qmd &gt;}}^endIf^



^include(^value($IncludeNotes)^,&quot;tSubnote_revealjs&quot;)^
</text>
