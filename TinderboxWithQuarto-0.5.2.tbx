</attrib>
<attrib Name="DiagramAttributesReflection" parent="User" editable="1" visibleInEditor="1" lines="4" type="8" description="This set is used to select which system attributes will be copied from a reflected note into its reflection in a Diagram. Individual reflection notes can change this set to select exactly which attributes should be copied for that reflection instance.                                 " default="AccentColor;Badge;BadgeMonochrome;BadgeSize;Base;Bend;Border;BorderBevel;BorderColor;BorderDash;Caption;CaptionAlignment;CaptionColor;CaptionFont;CaptionOpacity;CaptionSize;ClusterTerms;Color;Direction;Flags;NameAlignment;NameBold;NameColor;NameFont;NameLeading;NameOpacity;NameStrike;NameVerticalAlignment;Opacity;Pattern;PlotColor;Shadow;ShadowBlur;ShadowColor;ShadowDistance;Shape;Stripe;StripeColor;Subtitle;SubtitleColor;SubtitleOpacity;SubtitleSize;TextBackgroundColor;Tip;TitleOpacity" >
</attrib>
<attrib Name="DiagramReflectionLocals" parent="User" editable="1" visibleInEditor="1" lines="1" type="8" suggested="AccentColor;Badge;BadgeMonochrome;BadgeSize;Base;Bend;Border;BorderBevel;BorderColor;BorderDash;Caption;CaptionAlignment;CaptionColor;CaptionFont;CaptionOpacity;CaptionSize;ClusterTerms;Color;Direction;Flags;NameAlignment;NameBold;NameColor;NameFont;NameLeading;NameOpacity;NameStrike;NameVerticalAlignment;Opacity;Pattern;PlotColor;Shadow;ShadowBlur;ShadowColor;ShadowDistance;Shape;Stripe;StripeColor;Subtitle;SubtitleColor;SubtitleOpacity;SubtitleSize;TextBackgroundColor;Tip;TitleOpacity" description="Attributes that should not be copied from the original Reflected note to a corresponding Reflection note are listed in this set. This allows select attributes to be decoupled from the original without having any impact on the original. For example, if &quot;Shape&quot; was included in this set, then the shape of a Reflection Object could be changed while the Reflected note retains its original shape.                                     " default="" >
</attrib>
<attrib Name="Diagram_ID" parent="User" editable="1" visibleInEditor="1" lines="1" type="2" description="The $ID of a Diagram Container is used as a general reference to the diagram itself. $DiagramID is set for each child of a Diagram Container, and it can be used in managing multiple diagrams in a Tinderbox document.                                      " default="0" >
</attrib>
