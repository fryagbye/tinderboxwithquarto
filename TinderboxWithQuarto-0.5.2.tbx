<text >function fagentqmd(){
    var:string vName($AgentNameForQmdFiles(&quot;TBXConfig&quot;));
    var:string vQuote=&apos;&quot;&apos;;
    var:string vProjectPath=collect(ancestors,$Path)[-1];
    var:boolean debug=false;

    if(debug){LogRec(&quot;Quarto&quot;, &quot;&lt;&lt;mark&gt;&gt;fagentqmd: vName=&quot; + vName + &quot; vProjectPath=&quot; + vProjectPath);};

    $QmdList=collect_if(descendants(vProjectPath),($Prototype==&quot;pNote&quot;|$Prototype($Prototype)==&quot;pNote&quot;)&amp;$IsAppendix==false,$ID);
    
    $AppendixList=collect_if(descendants(vProjectPath),($Prototype==&quot;pNote&quot;|$Prototype($Prototype)==&quot;pNote&quot;)&amp;$IsAppendix==true,$ID);
};

function fqmdlist(){
    var:string vName($AgentNameForQmdFiles(&quot;TBXConfig&quot;));
    var:string vNameTOC=$TableOfContaintsNote(&quot;TBXConfig&quot;);
    var:string vProjectPath=collect(ancestors,$Path)[-1];
    $Text=&quot;  chapters:\n&quot;;

    $QmdList.each(x){
        x=x.replace(&apos;&quot;&apos;,&apos;&apos;);
        if($Is_Part_qmd(x)){
            if($Text(x).wordCount==0){
                    $Text += &apos;    - part: &quot;&apos; + $Name(x) +&apos;&quot;\n      chapters:\n&apos;;
            }else{
                    $Text += &quot;    - part: &quot; + $HTMLExportFileName(x) + $HTMLExportExtension(x)  + &quot;\n      chapters:\n&quot;;
            };
        }else{
            if($Part_file(x)){
                $Text += &quot;        - &quot; + $HTMLExportFileName(x) + $HTMLExportExtension(x)+ &quot;\n&quot;;
            }else{
                $Text += &quot;    - &quot; + $HTMLExportFileName(x) + $HTMLExportExtension(x)+ &quot;\n&quot;;
            };
        };
    };  
    if($AppendixList.count&gt;0){
        $Text +=&quot;  appendices:\n&quot;;
        $AppendixList.each(x){
            x=x.replace(&apos;&quot;&apos;,&apos;&apos;);
            $Text += &quot;    - &quot; + $HTMLExportFileName(x) + $HTMLExportExtension(x)+ &quot;\n&quot;;
        };  
    };
};

function fChangeTemplateQuartoYML(){
    var:string vName=&quot;_quarto&quot;;
    var:string vProjectPath=collect(ancestors,$Path)[-1];
    var:string vYmlPath=$Path(vProjectPath) + &quot;/&quot; + vName;

    if($ID(vYmlPath)&amp;$Prototype(vYmlPath)==&quot;pYML&quot;){
        if($HTMLExportTemplate(vYmlPath)==&quot;/Templates/tYML_bookhtml&quot;){
            $HTMLExportTemplate(vYmlPath)=&quot;/Templates/tYML_bookpdf&quot;;
            $Q_OutputType(vYmlPath)=&quot;pdf&quot;;
        }else{
            $HTMLExportTemplate(vYmlPath)=&quot;/Templates/tYML_bookhtml&quot;;
            $Q_OutputType(vYmlPath)=&quot;html&quot;;
        };
    
        fChangeQuartoYMLDisplayedAttributes(vYmlPath);
        $DisplayExpression(vYmlPath) = &apos;$Name + &quot; ( &quot; + $HTMLExportTemplate +&quot; )&quot;&apos;;
        $MyString=$Name($HTMLExportTemplate);
        $OutlineBackgroundColor = $OutlineBackgroundColor($Name($HTMLExportTemplate));
        (vYmlPath + &quot; template is set with &quot; + $HTMLExportTemplate(vYmlPath)).show();   
    }else{
        (&quot; Please select _quarto.yml or inside of project folder&quot;).show();
    };
};</text>
