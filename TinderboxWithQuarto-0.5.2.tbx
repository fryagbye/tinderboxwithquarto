<attribute name="Ypos" >2.36</attribute>
<text >
function fMakeEquationList(vContainer:string,vPath){
	var:string vName;
	var:string vTest;
	var:number vCount(0);
	var:string vLabel;
	var:string vTemp;
	var:list vList;

	if($IsLabelGenerateON(vPath)&amp;($Prototype(vPath)==&quot;pLabelListContainer&quot;|$Prototype($Prototype(vPath))==&quot;pLabelListContainer&quot;)){
	
		$Text(vPath)=;
		$MyList(vPath) =;
		$ListKey(vPath)=;
		$ListValue(vPath)=;
		$MyDictionary(vPath)=;
	
		//Notes contains chunk &quot;eq-&quot; label 
		vList = collect_if(descendants(vContainer),$Text.contains(&quot;(eq-[\w\d-]*)+?&quot;)&amp;!$IsAlias&amp;$Prototype(parent)!=&quot;pLabelListContainer&quot;,$Path);

		vList.each(L){
			L=L.replace(&apos;&quot;&apos;,&quot;&quot;);
			$Text(L).eachLine(aLine:aLine.contains(&quot;(#eq-[\w\d-]*)+?&quot;)){
				vTemp = $1;
				vTemp = vTemp.replace(&quot;#eq-&quot;,&quot;@eq-&quot;);
				$MyList(vPath) += vTemp;
				$ListKey(vPath) += vTemp;
				$ListValue(vPath) += L;
				$MyDictionary(vPath) = $MyDictionary(vPath).add(&quot;{&quot;+ $ListKey(vPath) +&quot;:&quot;+ $ListValue(vPath) +&quot;}&quot;);
			};
		};


		$MyList(vPath).each(S){
			vName = S;
			vLabel = S.replace(&quot;@&quot;,&quot;&quot;);
		
			vTest = $IDString(vName);
		
			if(vTest==&quot;&quot;&amp;vName!=&quot;@eq-&quot;){
				create(vPath, vName + &quot;#pReferenceList&quot;);
				$OutlineBackgroundColor(vName)=&quot;purple&quot;;
				$Text(vName) = fEquationChunk($ListValue(vPath)[vCount], vLabel);
			};

			if(vName!=&quot;@eq-&quot;){	
				$Text(vPath)+= vName + &quot;\n&quot;;
			};
		
			vCount += 1;
		};
		vCount = 0;
		$ListKey(vPath).each(K){
			vName = K;
			$ToDummyLinkPath(vName) = $ListValue(vPath)[vCount];
			$Text(vName) = fEquationChunk($ListValue(vPath)[vCount], vName.replace(&quot;@&quot;,&quot;&quot;));
			createLink(K, $ListValue(vPath)[vCount], &quot;dummy&quot;);
			vCount += 1;
		};
	};
};

function fEquationChunk(vName:string, vLabel:string){
	var:string vReg;
	var:string vTemp;
	vReg = &quot;(\$\$([\s\S]*?)\$\$)\s*\{#(&quot;+ vLabel +&quot;)\}&quot;;
	if($Text(vName).contains(vReg)){
		return $1;
	};

};</text>
