<text >function fLinkDirection(iIdNote:string, iIdLink:string){
	if(iIdNote == iIdLink){
		return &quot;outbound&quot;;
	}else{
		return &quot;inbound&quot;;
	}
};


// The function fTypeOfShapeForNode generates a node shape suitable for Mermaid diagrams 
// based on the given node name (aName), shape (aShape), and shape override (mShapeOverride).
// - Maps Tinderbox shapes (lowercase) to Mermaid node shapes.
// - If an override is specified, it takes precedence.
// - Combines the node shape and name into a final representation.
function fTypeOfShapeForNode(aName:string, aShape:string, mShapeOverride:string){
	var:dictionary vShapes;
	var:string vTemp;
	var:number vNumOfChar;
	var:string vReturn;

    // Dictionary that maps Tinderbox shapes to Mermaid node shapes
    // Lowercase: Tinderbox shapes
    // Uppercase: Shape override shapes
	vShapes = dictionary(&quot;normal:\[\];rounded:\(\);oval:\(\(\)\);lozenge:&apos;\(\[\]\)&apos;;diamond:\{\};hex:\{\{\}\};
				DoubleCircle:\(\(\(\)\)\);Subroutine:\[\[\]\];Cylindrical:\[\(\)\];Asymmetric:\&gt;\];
				Parallelogram:\[\/\/];ParallelogramAlt:\[\\\\\];Trapezoid:\[\/\\\];TrapezoidAlt:\[\\\/\]&quot;);

    // Use the shape override if it is specified
	if(mShapeOverride){
		vTemp = vShapes[mShapeOverride];
	}else{
		vTemp = vShapes[aShape];
	};

    // Calculate the number of characters to split the Mermaid shape string in half
	vNumOfChar = (vTemp.size())/2;
　　// If the node name (aName) has associated text, include it with the node name
	if($M_IsTextDisplayed(aName)&amp;$Text(aName).wordCount&gt;0){
		vReturn = &apos;&quot;&apos; + aName + &apos;\n&apos;+ $Text(aName) + &apos;&quot;&apos;;
	}else{
		vReturn = &apos;&quot;&apos; + aName + &apos;&quot;&apos;;
	};

    // Apply the Mermaid shape and return the result
	if(vTemp){
		return vTemp.substr(0, vNumOfChar) + vReturn + vTemp.substr(-vNumOfChar);
	}else{
		
		return &apos;[&apos; + vReturn + &apos;]&apos;;
	};
	
};

// The function fTyepOfLineForLink generates a link representation based on the provided parameters,
// including the type of the link (aType), the link properties (aLink), the length of the link (aLength),
// the style of the line ending (aEnd), and whether the link is bidirectional (aBidirection).
function fTypeOfLineForLink(aType:string, aLink:dictionary, aLength:number, aEnd:string, aBidirection:bool){
    // Extract properties from the aLink dictionary
    var:boolean vVisible = aLink[&quot;visible&quot;];  // Whether the link is visible
    var:boolean vDotted = aLink[&quot;dotted&quot;] | aLink[&quot;dashed&quot;]; // Check if the link is dotted or dashed
    var:boolean vBold = aLink[&quot;bold&quot;] | aLink[&quot;broad&quot;]; // Check if the link is bold or broad
    var:string vLineType; // To store the type of line: dotted, bold, or normal
    var:dictionary vEdgeType; // Dictionary mapping line endings
    var:string vReturn; // The final representation of the link

	//$Text(/Log)= aLink + &quot;\n&quot;;

    // Determine the line type and the corresponding edge type mappings
    // Priority: dotted &gt; bold &gt; normal
    if (vDotted) {
        vLineType = &quot;dotted&quot;;
        vEdgeType = dictionary(&quot;Arrow:\&gt;;Circle:o;Cross:x;Open:\-&quot;);
    } else {
        if (vBold) {
            vLineType = &quot;bold&quot;;
            vEdgeType = dictionary(&quot;Arrow:\&gt;;Circle:o;Cross:x;Open:\=&quot;);
        } else {
            vLineType = &quot;normal&quot;;
            vEdgeType = dictionary(&quot;Arrow:\&gt;;Circle:o;Cross:x;Open:\-&quot;);
        }
    }

    // Generate the link representation based on the line type
    if (vLineType == &quot;dotted&quot;) {
        // Dotted line style
        if (aBidirection) {
            // Bidirectional dotted line
            if (aEnd == &quot;Arrow&quot;) {
                vReturn = &quot;&lt;-&quot; + &quot;.&quot; * (aLength - 2) + &quot;-&gt;&quot;;
            } else {
                vReturn = vEdgeType[aEnd] + &quot;-&quot; + &quot;.&quot; * (aLength - 2) + &quot;-&quot; + vEdgeType[aEnd];
            }
        } else {
            // Unidirectional dotted line
            vReturn = &quot;-&quot; + &quot;.&quot; * (aLength - 2) + &quot;-&quot; + vEdgeType[aEnd];
        }
    }

    if (vLineType == &quot;bold&quot;) {
        // Bold line style
        if (aBidirection) {
            // Bidirectional bold line
            if (aEnd == &quot;Arrow&quot;) {
                vReturn = &quot;&lt;-&quot; + &quot;-&quot; * (aLength - 2) + &quot;-&gt;&quot;;
            } else {
                vReturn = vEdgeType[aEnd] + &quot;-&quot; * (aLength - 2) + vEdgeType[aEnd];
            }
        } else {
            // Unidirectional bold line
            vReturn = &quot;-&quot; * (aLength - 1) + vEdgeType[aEnd];
        }
        vReturn = vReturn.replace(&quot;-&quot;, &quot;=&quot;); // Replace &quot;-&quot; with &quot;=&quot; for bold lines
    }

    if (vLineType == &quot;normal&quot;) {
        // Normal line style
        if (aBidirection) {
            // Bidirectional normal line
            if (aEnd == &quot;Arrow&quot;) {
                vReturn = &quot;&lt;-&quot; + &quot;-&quot; * (aLength - 2) + &quot;-&gt;&quot;;
            } else {
                vReturn = vEdgeType[aEnd] + &quot;-&quot; * (aLength - 2) + vEdgeType[aEnd];
            }
        } else {
            // Unidirectional normal line
            vReturn = &quot;-&quot; * (aLength - 1) + vEdgeType[aEnd];
        }
    }

    // Append the link type to the representation if it is specified and not &quot;untitled&quot;
    if (aType &amp; !(aType == &quot;*untitled&quot;)) {
        vReturn += &apos;|&quot;&apos; + aType + &apos;&quot;|&apos;;
    } else {
        vReturn += &quot; &quot;;
    }

    // Handle the visibility of the link
    if (!vVisible) {
        // If the link is not visible, use &quot;~&quot; for the line representation
        vReturn = &quot; ~&quot; + &quot;-&quot; * (aLength - 2) + &quot;~ &quot;;
        vReturn = vReturn.replace(&quot;-&quot;, &quot;~&quot;);
    } else {
        // Add spacing around the link representation for visible links
        vReturn = &quot; &quot; + vReturn + &quot; &quot;;
    }
    return vReturn;
};

function fSetCustomTheme(aID:string){
	var:string vConfig;
	if($M_HasCustomTheme){
			vConfig = &apos;%%{init: {&quot;theme&quot;: &quot;base&quot;,&quot;themeVariables&quot;: {&quot;primaryColor&quot;: &quot;&apos; + $Color(aID).format() + &apos;&quot;,&quot;primaryTextColor&quot;: &quot;&apos; + $NameColor(aID).format() + &apos;&quot;,&quot;primaryBorderColor&quot;: &quot;&apos; + $BorderColor(aID).format() + &apos;&quot;,&quot;lineColor&quot;: &quot;&apos; + $M_LinkLineColor(aID).format() + &apos;&quot;,&quot;secondaryColor&quot;: &quot;&apos; + $M_LinkTextBackgroundColor(aID).format() + &apos;&quot;,&quot;tertiaryColor&quot;: &quot;&apos; + $M_SubgraphBackgroundColor(aID).format() + &apos;&quot;}}}%%\n&apos;;
	}else{
		if($M_HasOutputTheme(aID)){	
			vConfig = &quot;%%{init: {&apos;theme&apos;:&apos;&quot;+ $M_Theme +&quot;&apos;}}%%\n&quot;;
			
		};
	};
	return vConfig;
}


function fNSortDictionary(aDict:dictionary){
	var:number vCount=0;
	var:list vKeyList=aDict.keys();
	var:dictionary vDict;
	vKeyList = vKeyList.nsort();
	vKeyList.each(aKey){
		vDict = vDict.extend(&quot;{&quot;+ aKey + &quot;:&quot; + aDict[aKey] + &quot;}&quot;);
	};
	return vDict;
};

