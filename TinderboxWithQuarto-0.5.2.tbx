<attribute name="IsAction" >true</attribute>
<attribute name="Modified" >2026-01-02T11:32:31+09:00</attribute>
<attribute name="NLNames" >Graphviz</attribute>
<attribute name="Name" >Make Figure Label List</attribute>
<attribute name="NeverComposite" >true</attribute>
<attribute name="Q_Affiliation_ID" >118</attribute>
<attribute name="ScreenWidth" >454</attribute>
<attribute name="SelectionCount" >1434</attribute>
<attribute name="Sentiment" >-0.3180000073</attribute>
<attribute name="Sentiments" >-0.4;-0.4;-0.4;-0.4;0.2;0.2;0.2;0.2;-0.8;-0.6;0.4;-0.4;-0.2;-0.4;-0.2;-0.6;-0.6;-0.4;-0.6;-0.4;-0.8;0.8;-0.8;-0.4;-0.6;-0.4;0;-0.8;0;-0.6;-0.4;-0.8;0.8;-0.6;-0.4;-0.6;-0.4;0;0;-0.8;-0.4;-0.6;-0.6;-0.4;-0.8;0.8;-0.4;-0.4;-0.6;-0.4;0;-0.6;-0.2;-0.6;-0.4;-0.6;0.8;-0.8;-0.4;-0.6;-0.4;0;-0.2;-0.4;0.4;-0.4;0.6;-0.4;-0.6;0.4;-0.6;-0.6;-0.4;-0.4;-0.4;-0.4;0.4;-0.2;-0.8;0.4;-0.4;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.8;-0.6;0.6;-0.6;0.6;-0.6;0.6;-0.6;0.6;0.2</attribute>
