<text >//******************* Make Chunk List ***************************************
function fMakeFigLabelListFrompChunk(){
   var:string vName;
    var:string vPath=$FigLabelListContainer(&quot;TBXConfig&quot;);
    var:list vList=collect(children(vPath),$ID);
    var:list vReturn;
    vList.each(a){
        vReturn= vReturn +$Q_ChunkFigLabel($ToDummyLinkPath(a));
    };
    return vList;
};

function fMakeChunkList(){
    var:string vName;
    var:string vName2;
    var:string vChunkLabelListPath=$ChunkListContainer(&quot;TBXConfig&quot;);
    var:string vProjectLabelListPath;
    var:string vProjectPath;
    var:string vTest;
    var:dictionary vDict;
    var:list vList;
    var:string vID;

    if($Container($Path)==&quot;/&quot;){
        vProjectPath = $Path;
    }else{
        vProjectPath = collect(ancestors,$Path)[-1];
    };

    vProjectLabelListPath = vProjectPath + $ChunkListContainer(&quot;TBXConfig&quot;);

    if($IsLabelGenerateON(vChunkLabelListPath)&amp;($Prototype(vChunkLabelListPath)==&quot;pLabelListContainer&quot;|$Prototype($Prototype(vChunkLabelListPath))==&quot;pLabelListContainer&quot;)){

        $Text(vChunkLabelListPath)=&quot;&quot;;

        vList=collect_if(all,($Prototype==&quot;pChunk&quot;|$Prototype==&quot;pRChunk&quot;|$Prototype==&quot;pPChunk&quot;)&amp;!$IsPrototype&amp;!$IsAlias&amp;($Container!=vChunkLabelListPath),$ID);
        vList=vList.sort($Q_ChunkLang);

        vList.each(aChunk){
            var:string vFigRef;
            if($Q_ChunkFigLabel(aChunk)){
                vFigRef=&quot;➡️fig-&quot;+$Q_ChunkFigLabel(aChunk)+&quot;&quot;;
            };
            $Name(aChunk)=fDeleteCharacters($Name(aChunk));
            vName = &quot;&lt;&quot;+$Q_ChunkLang(aChunk)+&quot;:&quot; + $Name(aChunk) + vFigRef+&quot;&gt;&quot;;
            vName2= &quot;\&lt;&quot;+$Q_ChunkLang(aChunk)+&quot;:&quot; + $Name(aChunk) + vFigRef+&quot;\&gt;&quot;;

            vTest = $ID(vName);

            if(!vTest){
                if($Text(aChunk).wordCount&gt;0){
                    var:string vPrototype;
                    var:string vPath;
                    if($Q_ChunkLang(aChunk)==&quot;r&quot;|$Q_ChunkLang(aChunk)==&quot;webr&quot;){
                        vPrototype=&quot;#pRChunkList&quot;;
                    }else{
                        vPrototype=&quot;#pChunkList&quot;;
                    };
                    vPath = vChunkLabelListPath + &quot;/&quot; + vName2;
                    LogRec(&quot;MakeChunkList&quot;, &quot;&lt;&lt;mark&gt;&gt; vPath=&quot; + vPath+vPrototype);
                    create(vPath + vPrototype);
                    $Text(vPath) = $Text(aChunk);
                    createLink($Path(vPath), $Path(aChunk),&quot;dummy&quot;);
                    $ToDummyLinkPath(vPath) = $Path(aChunk);
                    $Text(vChunkLabelListPath) += vName + &quot;:&quot; + $ToDummyLinkPath(vPath) + &quot;\n&quot;;
                    $Name(vPath) = vName;
                };
            };  

            //Create Figure Label
            var:string vFigName;
            var:string vLabelPath;
            var:list vAttributes=$DisplayedAttributes($Prototype(aChunk));
            var:string vTemp;
            
            vFigName=&quot;@fig-&quot;+$Q_ChunkFigLabel($Path(aChunk));
            LogRec(&quot;MakeChunkList&quot;, &quot;&lt;&lt;mark&gt;&gt; vProjectPath=&quot; + vProjectPath + &quot; vChunkLabelListPath=&quot; + vChunkLabelListPath + &quot; vFigName=&quot; + vFigName);
            vLabelPath = vProjectPath + vChunkLabelListPath + &quot;/&quot; + vFigName;
            vTest=$ID(vLabelPath);
            if(!vTest &amp; vFigName!=&quot;@fig-&quot;){

                create(vLabelPath, vFigName + &quot;#pReferenceList&quot;);
                $ToDummyLinkPath(vLabelPath)=$Path(aChunk);
                $OutlineBackgroundColor(vLabelPath)=&quot;light violet&quot;;
                $Text(vLabelPath)=$Text(aChunk);
                createLink(vChunkLabelListPath+&quot;/&quot;+ vFigName, vLabelPath, &quot;dummy&quot;);
            };
    
            vAttributes.each(x){
                vTemp= &quot;$&quot; + x + &quot;(&quot; + vChunkLabelListPath +&quot;/&quot; + vFigName + &quot;)=$&quot; + x + &quot;(&quot; + $Path(aChunk) + &quot;);&quot;;
                action(vTemp);
            };
    
        };
    };
};

function fClearChunkList(){
    var:string vPath1 =$ChunkListContainer(&quot;TBXConfig&quot;);
    var:list vDellist;
    vDellist = collect(children(vPath1), $Path);
    if(vDellist.count&gt;0){
        delete(vDellist);
        $Text(vPath1)=&quot;&quot;;
    };
};

function fCheckDuplicateChunkName(){
    var:string vPath1 =$ChunkListContainer(&quot;TBXConfig&quot;);
    var:list vList=collect_if(children(vPath1),$Prototype==&quot;pChunkList&quot;&amp;$Name==$Name(this)&amp;$Path!=$Path(this));
    
    if(vList.count=&gt;2){
        $Color=&quot;red&quot;;
    }else{
        $Color=$Color($Prototype);
    };
};

//******************* Make Graph Label List ***************************************
function fMakeFigLabelListFromGraph(){
    var:string vName;
    var:string vPath=$FigLabelListContainer(&quot;TBXConfig&quot;);
    var:list vList=collect(children(vPath),$ID);
    var:list vReturn;
    vList.each(a){
        vReturn= vReturn + $Q_ChunkFigLabel($ToDummyLinkPath(a));
    };
    return vReturn;
};

function fMakeGraphList(){
    var:string vName;
    var:string vName2;
    var:string vGraphLabelListPath=$GraphListContainer(&quot;TBXConfig&quot;);
    var:string vProjectLabelListPath;
    var:string vProjectPath;
    var:string vTest;
    var:dictionary vDict;
    var:list vList;

    if($Container==&quot;/&quot;){
        vProjectPath = $Path;
    }else{
        vProjectPath = collect(ancestors,$Path)[-1];
    };
    vProjectLabelListPath = vProjectPath + $FigLabelListContainer(&quot;TBXConfig&quot;);

    if($IsLabelGenerateON(vGraphLabelListPath)&amp;($Prototype(vGraphLabelListPath)==&quot;pLabelListContainer&quot;|$Prototype($Prototype(vGraphLabelListPath))==&quot;pLabelListContainer&quot;)){

        $Text(vGraphLabelListPath)=&quot;&quot;;

        vList = collect_if(all,($Prototype==&quot;pMFContainer&quot;|$Prototype==&quot;pGContainer&quot;)&amp;!$IsPrototype&amp;!$IsAlias&amp;($Container!=vGraphLabelListPath),$ID);

        vList.each(aGraph){
            var:string vFigRef;
            if($Q_ChunkFigLabel(aGraph)){
                vFigRef=&quot;➡️fig-&quot;+$Q_ChunkFigLabel(aGraph)+&quot;&quot;;
            };
            if(!$Q_ChunkFigCaption(aGraph)){
                $Q_ChunkFigCaption(aGraph)=$Name(aGraph);
            };
            $Name(aGraph)=fDeleteCharacters($Name(aGraph));
            if($Prototype(aGraph)==&quot;pMFContainer&quot;){
                vName = &quot;&lt;mermaid:&quot; + $Name(aGraph) + vFigRef+&quot;&gt;&quot;;
                vName2= &quot;\&lt;mermaid:&quot; + $Name(aGraph) + vFigRef+&quot;\&gt;&quot;;
            }else{
                vName = &quot;&lt;dot:&quot; + $Name(aGraph) + vFigRef+&quot;&gt;&quot;;
                vName2= &quot;\&lt;dot:&quot; + $Name(aGraph) + vFigRef+&quot;\&gt;&quot;;
            };

            vTest = $ID(vName);
            if(!vTest &amp; vFigName!=&quot;@fig-&quot;){
                if($Text(aGraph).wordCount&gt;0){
                    var:string vPrototype;
                    var:string vPath;
                if($Prototype(aGraph)==&quot;pMFContainer&quot;){
                    vPrototype=&quot;#pMFGraphList&quot;;
                }else{
                    vPrototype=&quot;#pGGraphList&quot;;
                };
                vPath = vGraphLabelListPath + &quot;/&quot; + vName2;
                create(vPath + vPrototype);
                $Text(vPath) = $Text(aGraph);
                createLink($Path(vPath), $Path(aGraph),&quot;dummy&quot;);
                $ToDummyLinkPath(vPath) = $Path(aGraph);
                $Text(vGraphLabelListPath+= vName + &quot;:&quot; + $ToDummyLinkPath(vPath) + &quot;\n&quot;);
                $Name(vPath) = vName;
                };
            };  
            //Create Figure Label
            var:string vFigName;
            var:string vLabelPath;
            var:list   vAttributes = $DisplayedAttributes($Prototype(aGraph));
            var:string vTemp;
            
            vFigName = &quot;@fig-&quot;+$Q_ChunkFigLabel($Path(aGraph));

            vLabelPath = vProjectPath + vGraphLabelListPath + &quot;/&quot;+vFigName;
            
            vTest=$ID(vLabelPath);
            if(!vTest &amp; vFigName!=&quot;@fig-&quot;){
                LogRec(&quot;MakeGraphList&quot;, &quot;&lt;&lt;mark&gt;&gt; create vLabelPath=&quot; + vLabelPath + &quot; vFigName=&quot; + vFigName + &quot; vGraphLabelListPath=&quot; + vGraphLabelListPath);
                create(vLabelPath, vFigName + &quot;#pReferenceList&quot;);
                $ToDummyLinkPath(vLabelPath)=$Path(aGraph);
                $OutlineBackgroundColor(vLabelPath)=&quot;light violet&quot;;
                $Text(vLabelPath)=$Text(aGraph);
                createLink(vGraphLabelListPath+&quot;/&quot;+ vFigName, vLabelPath, &quot;dummy&quot;);
            };

            vAttributes.each(x){
                vTemp= &quot;$&quot; + x + &quot;(&quot; + vLabelPath + &quot;)=$&quot; + x + &quot;(&quot; + $Path(aGraph) + &quot;);&quot;;
                action(vTemp);
            };
        };
    };
};

function fClearGraphList(){
    var:string vPath1 =$GraphListContainer(&quot;TBXConfig&quot;);
    var:list vDellist;
    vDellist = collect(children(vPath1), $Path);
    if(vDellist.count&gt;0){
        delete(vDellist);
        $Text(vPath1)=&quot;&quot;;
    };
};
</text>
