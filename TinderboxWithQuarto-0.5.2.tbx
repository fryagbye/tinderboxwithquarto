<text >function fClearReferenceList(vProjectPath:string){
    var:list vdellist;
    var:string vConf=&quot;TBXConfig&quot;;
    var:string vPath1 =vProjectPath + $SecLabelListContainer(vConf);
    var:string vPath2 =vProjectPath + $FigLabelListContainer(vConf);
    var:string vPath3 =vProjectPath + $TblLabelListContainer(vConf);
    var:string vPath4 =vProjectPath + $EquLabelListContainer(vConf);

    vdellist = collect(children(vPath1), $Path);
    vdellist += collect(children(vPath2), $Path); 
    vdellist += collect(children(vPath3), $Path); 
    vdellist += collect(children(vPath4), $Path); 

    delete(vdellist);
};

function fClearReferenceListFromSelectedProject(){
    var:string vPath;

    if($Container!=&quot;/&quot;){
        vPath=collect(ancestors,$Path)[-1];
    }else{
        vPath=$Path;
    };

    fClearReferenceList(vPath);
};

function fMakeReferenceListFromSelectedProject(){
    var:string vPath;
    var:string vConf=&quot;TBXConfig&quot;;

    if($Container!=&quot;/&quot;){
        vPath=collect(ancestors,$Path)[-1];
    }else{
        vPath=$Path;
    };

    fMakeSectionList(vPath, $SecLabelListContainer(vConf));
    fMakeFigureList(vPath, $FigLabelListContainer(vConf));
    fMakeTableList(vPath, $TblLabelListContainer(vConf));
    fMakeEquationList(vPath, $EquLabelListContainer(vConf));
    fMakeLinkFigFromReferenceList();
    fMakeLinkSecFromReferenceList();
    fMakeLinkTableFromReferenceList();
    fMakeLinkEquationFromReferenceList();
};


</text>
