<text >pattern: (?&lt;!^)//.*
    color: dark red
    
pattern: ^//.*
    size: 10

pattern: ^# .+
    size: 28

pattern: ^## .+
    size: 22

pattern: ^### .+
    size: 18

pattern: (\*\*|__)(.*?)\1
    bold: yes
	background: gray

pattern: (\*|_)(.*?)\1
    italic: yes
	background: gray

pattern: ```[\s\S]*?```
	color: green
	background: gray

pattern: ^:::[\s\S]*?:::
	color: green
	background: gray

pattern: `[\S]+?`
	color: green
	background: gray

pattern: `r\s[\S]+?`
	color: green
	bold: yes
	background: gray

pattern: (@fig-[\w\d-][\w\d-]*)
	color: black
	bold: yes
	background: lightest violet

pattern: (@sec-[\w\d-][\w\d-]*)
	color: black
	bold: yes
	background: lighter blue

pattern: (@tbl-[\w\d-][\w\d-]*)
	color: black
	bold: yes
	background: lighter yellow

pattern: (@eq-[\w\d-][\w\d-]*)
	color: black
	bold: yes
	background: lighter green

pattern: (#\|\slabel:\s[\w\d-][\w\d-]*)
	color: black
	bold: yes
	background: lightest violet

pattern: (%%\|\slabel:\s[\w\d-][\w\d-]*)+?
	color: black
	bold: yes
	background: lightest violet

pattern: (\/\/\|\slabel:\s[\w\d-][\w\d-]*)+?
	color: black
	bold: yes
	background: lightest violet

pattern: ^!\[.*\]\(.*\)\{(#fig-.*\s?).*\}.*
	color: blue
	bold: yes
	background: pale yellow

pattern ^::::\s\{(#fig-[\w\d-]*)+?
	color: blue
	bold: yes
	background: pale yellow

pattern (\$\$[\s\S]*?\$\$)
	color: blue
	bold: yes
	background: pale yellow


pattern: ^!\[.*\]\(.*\)\{(#tbl-.*\s?).*\}.*
	color: blue
	bold: yes
	background: pale yellow
</text>
