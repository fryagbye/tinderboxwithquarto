title: &quot;^value($Q_Title)^&quot;
date: ^value($Q_Date.format(&quot;y-M0-D&quot;))^
author:
^include(^value(find(inside($Q_AuthorPath)))^)^

abstract: &gt;
  ^value($Q_Abstract)^
keywords: ^value($Q_KeyWords.format(&quot;,&quot;))^


license: &quot;^value($Q_License)^&quot;
copyright:
  holder: ^value($Q_CopyrightHolder)^
  year: [^value($Q_CopyrightYear.format(&quot;,&quot;))^]
citation:
  container-title: ^value($Q_CitationContaierTitle)^
  volume: ^value($Q_CitationVolume)^
  issue: ^value($Q_CitationIssue)^
  doi: ^value($Q_CitationDOI)^
funding: &quot;^value($Q_Funding)^&quot;
---

^action(
	var:string vProjectPath;
	var:string vTemp;
	var:string vPre;

	vProjectPath=collect(ancestors(original),$Path)[-1];

	if($HasOutType(vProjectPath)){
		vTemp =&apos;out_type &lt;- knitr::opts_knit$get(&quot;rmarkdown.pandoc.to&quot;)\n&apos;;
	};
	if($HasCommonR(vProjectPath)){
		vTemp +=&apos;source(&quot;_common.R&quot;)\n&apos;;
	};

	if($HasOutType(vProjectPath)|$HasCommonR(vProjectPath)){
		vPre += &apos;```{r, echo=FALSE}\n&apos;;
		vPre += &apos;#| include: false\n&apos;;
		vPre += vTemp;
		vPre += &apos;```\n&apos;;
	};
)^

^value(vPre)^

^include(^value($IncludeNotes)^)^
</text>
