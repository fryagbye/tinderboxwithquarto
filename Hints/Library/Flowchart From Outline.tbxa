// /Hints/Library/Flowchart From Outline

// Setting up the header for Quarto label and R chunk
function fCreateMermaidHeader(vDirection:string, vID:string){
	var:vHeader;
	if($Q_HasChunkBlock){
		vHeader = "```{mermaid} \n";
		if($Q_ChunkFigLabel){
			vHeader += "%%| label: fig-" +fDeleteCharacters($Q_ChunkFigLabel) + "\n";
		};
		if($Q_ChunkFigCaption){
			vHeader += "%%| fig-cap: " + $Q_ChunkFigCaption + "\n";
		};
		if($Q_ChunkFigWidth){
			vHeader += "%%| fig-width: " + $Q_ChunkFigWidth + "\n";
		};
	};


   // Start output text with header and flowchart direction
	vHeader += fSetCustomTheme(vID);
	vHeader += "flowchart "+ vDirection +"\n";
	return vHeader;
}

function fOutputNodesAndLinks(vID:string, vIDtoName:dictionary){
	var:number vCount=0;	
	var:list vTempList;
   var:dictionary vTempDict;
	var:string vReturn;
    // Output main graph nodes and links
	$M_NoteList(vID).each(aNote){
		vTempList="";
		vTempDict="";
		if($OutboundLinkCount(aNote)>0){
			eachLink(alink,aNote){
				var:string vSource =alink["source"];
				var:string vDest =alink["destID"];
				vDirection=fLinkDirection($ID(aNote), alink["sourceID"]);
				// treat outboud link only. 
				if(vDirection=="outbound"){
					vTempList+= $OutlineOrder(vDest);
					vTempDict = vTempDict.extend("{"+$OutlineOrder(vDest)+":"+"    "+vIDtoName[aNote] + fTypeOfShapeForNode($Name(aNote),$Shape(aNote), $M_ShapeOverride(aNote))
								+ fTypeOfLineForLink(alink["type"], alink, $M_ArrowLength(vSource),$M_ArrowType(vSource),$M_IsBidirectional(vSource))
								+ vIDtoName[vDest] + fTypeOfShapeForNode($Name(vDest),$Shape(vDest),$M_ShapeOverride(vDest))+"}");
				};
			};
				vTempList=vTempList.nsort();
				vTempList.each(aOrder){
					vReturn += vTempDict[aOrder]+"\n";
				};
		}else{
			vReturn += "    "+ vIDtoName[aNote] + fTypeOfShapeForNode($Name(aNote),$Shape(aNote), $M_ShapeOverride(aNote)) + "\n";
		};
	};
	return vReturn;
}

function fOutputSubgraphs(vID:string, vIDtoName:dictionary){
	var:string vReturn;
	$M_Subgraphs(vID).each(aSubID){

		$M_SubgraphName(aSubID) = vIDtoName[aSubID];
		
		vReturn += "\n subgraph " + $M_SubgraphName(aSubID) + '["'+ $Name(aSubID) + '"]\n';
		
		if($M_SubgraphDirection(aSubID)){
			vReturn += "    direction " + $M_SubgraphDirection(aSubID) +"\n";
		};
		$M_NodeOnSubgraph(aSubID).each(aKey){
			vReturn += "    " + vIDtoName[aKey] + "\n";
		};
		vReturn += "end \n";
	};
	vReturn += "\n";
	return vReturn;
}

function fOutputSubgraphLinks(vID:string, vIDtoName:dictionary){
	var:list vTempList;
   var:dictionary vTempDict;
	var:string vReturn;

		$M_Subgraphs(vID).each(aSubID){
		vTempList="";
		vTempDict="";

		if($OutboundLinkCount(aSubID)>0){
			eachLink(alink, aSubID){
				var:string vSource =alink["source"];
				var:string vDest =alink["destID"];

				vDirection= fLinkDirection(aSubID, alink["sourceID"]);
				// treat outboud link only. 

				if(vDirection=="outbound"){
				vTempList+= $OutlineOrder(vDest);
					vTempDict = vTempDict.extend("{"+$OutlineOrder(vDest)+":"+"    "+vIDtoName[aSubID] + fTypeOfShapeForNode($Name(aSubID),$Shape(aSubID), $M_ShapeOverride(aSubID))
								+ fTypeOfLineForLink(alink["type"], alink, $M_ArrowLength(vSource),$M_ArrowType(vSource),$M_IsBidirectional(vSource))
								+ vIDtoName[vDest] + fTypeOfShapeForNode($Name(vDest),$Shape(vDest),$M_ShapeOverride(vDest))+"}");
				};
			};
				vTempList=vTempList.nsort();
				vTempList.each(aOrder){
					vReturn += vTempDict[aOrder]+"\n";
				};

		};
	};
	return vReturn;
}

