function fBookAction(vQCommand:string, vQuartoOptions:string){
    var:string vSelected = $ID;
    var:string vOutputFolder;
    var:string vVenv;
    var:string vCheck = false;
    var:string vRoot = collect(ancestors, $Path)[-1];
    var:string vConf = "TBXConfig";
    var:boolean debug = true;
    var:string vAgentName = "Export Agent";
    var:string vProject = "";

    // プロジェクトノートの特定
    if ($Prototype == "pBookFolder") {
        vProject = $Path;
    } else {
        if ($Prototype(vRoot) == "pBookFolder") {
            vProject = vRoot;
            vCheck = true;
        } else {
            if ($IsAgent(vRoot) & $Name(vRoot) == vAgentName) {
                vProject = $CurrentBookProject(vAgentName);
                vCheck = true;
            };
        };
    };
    // プロジェクト情報の設定
    if (vProject) {
        vVenv = $VenvActivateCommand(vProject);
        vOutputFolder = $HTMLExportFileName(vProject);
        if ( ! vOutputFolder) { vOutputFolder = $Name(vProject); };
    } else {
        vVenv = $VenvActivateCommand;
        vOutputFolder = $HTMLExportFileName;
        if ( ! vOutputFolder) { vOutputFolder = $Name; };
    };
    if($Prototype == "pBookFolder" | vCheck){
        fActivateAppName($TerminalApp(vConf));
        if(debug){LogRec("Quarto", " < < mark > > " + vQCommand + ": vCheck = " + vCheck + " vOutputFolder = " + vOutputFolder + " vOption = " + vQuartoOptions + " vVenv = " + vVenv);};
        if($TerminalApp(vConf) == "Wezterm"){
            fQuartoCommnadInWezterm(vQCommand, vOutputFolder, vQuartoOptions, vVenv);
        };
        if($TerminalApp(vConf) == "Terminal"){
            fQuartoCommnadInTerminal(vQCommand, vOutputFolder, vQuartoOptions, vVenv);
        };
        if($TerminalApp(vConf) == "Ghostty"){
            fQuartoCommnadInGhostty(vQCommand, vOutputFolder, vQuartoOptions, vVenv);
        };
        select($Path(vSelected));
    }else{
        ("Please select the pBookFolder note or any of its descendant notes.").show;
    };
};


function fManuscriptPreview(){
    var:string vOption;
    var:string vOutputFolder;
    var:string vVenv;
    var:string vCheck;
    var:string vSelected = $ID;
    var:string vRoot = collect(ancestors, $Path)[-1];
    var:string vConf = "TBXConfig";
    var:boolean debug = true;
    var:string vProject = "";

    vOption = "--to html";
    // プロジェクトノートの特定
    if ($Prototype == "pManuscriptFolder") {
        vProject = $Path;
    } else {
        if ($Prototype(vRoot) == "pManuscriptFolder") {
            vProject = vRoot;
            vCheck = true;
        };
    };
    // プロジェクト情報の設定
    if (vProject) {
        vVenv = $VenvActivateCommand(vProject);
        vOutputFolder = $HTMLExportFileName(vProject);
        if ( ! vOutputFolder) { vOutputFolder = $Name(vProject); };
    } else {
        vVenv = $VenvActivateCommand;
        vOutputFolder = $HTMLExportFileName;
        if ( ! vOutputFolder) { vOutputFolder = $Name; };
    };
    if(debug){LogRec("Quarto", " < < mark > > Preview: vCheck = " + vCheck + " vOutputFolder = " + vOutputFolder + " vOption = " + vOption + " vVenv = " + vVenv);};
    if($Prototype == "pManuscriptFolder" | vCheck){
        fActivateAppName($TerminalApp(vConf));
        if($TerminalApp(vConf) == "Wezterm"){
            fQuartoCommnadInWezterm("preview", vOutputFolder, vOption, vVenv);
        };
        if($TerminalApp(vConf) == "Terminal"){
            fQuartoCommnadInTerminal("preview", vOutputFolder, vOption, vVenv);
        };
        if($TerminalApp(vConf) == "Ghostty"){
            fQuartoCommnadInGhostty("preview", vOutputFolder, vOption, vVenv);
        };
        select($Path(vSelected));
    }else{
        if(debug){LogRec("Quarto", " < < mark > > Render: vCheck = " + vCheck + " vOutputFolder = " + vOutputFolder + " vOption = " + vOption + " vVenv = " + vVenv);};
        ("Please select the pManuscriptFolder note or any of its descendant notes.").show;
    };
};


function fRevealjsPreview(){
    var:string vSelected = $ID;
    var:string vOption;
    var:string vOutputFolder;
    var:string vVenv;
    var:string vCheck;
    var:string vConf = "TBXConfig";
    var:string vRoot = collect(ancestors, $Path)[-1];
    var:boolean debug = true;
    var:string vProject = "";

    // プロジェクトノートの特定
    if ($Prototype == "pRevealjsFolder") {
        vProject = $Path;
    } else {
        if ($Prototype(vRoot) == "pRevealjsFolder") {
            vProject = vRoot;
            vCheck = true;
        };
    };
    // プロジェクト情報の設定
    if (vProject) {
        vVenv = $VenvActivateCommand(vProject);
        vOutputFolder = $HTMLExportFileName(vProject);
        if ( ! vOutputFolder) { vOutputFolder = $Name(vProject); };
        if ($Q_HasQuartoLiveChunk(vProject)) {
            vOption = "--to live-revealjs";
        } else {
            vOption = "--to revealjs";
        };
    } else {
        vVenv = $VenvActivateCommand;
        vOutputFolder = $HTMLExportFileName;
        if ( ! vOutputFolder) { vOutputFolder = $Name; };
        if ($Q_HasQuartoLiveChunk) {
            vOption = "--to live-revealjs";
        } else {
            vOption = "--to revealjs";
        };
    };
    if($Prototype == "pRevealjsFolder" | vCheck){
        if($TerminalApp(vConf) == "Wezterm"){
            fQuartoCommnadInWezterm("preview", vOutputFolder, vOption, vVenv);
        };
        if($TerminalApp(vConf) == "Terminal"){
            fQuartoCommnadInTerminal("preview", vOutputFolder, vOption, vVenv);
        };
        if($TerminalApp(vConf) == "Ghostty"){
            fQuartoCommnadInGhostty("preview", vOutputFolder, vOption, vVenv);
        };
        select($Path(vSelected));
    }else{
        ("Please select the pRevealjsFolder note or any of its descendant notes.").show;
    };
};


function fQuartoCommnadInTerminal(vQCommand:string, vProjectPath:string, vQuartoOptions:string, vVenvCommand){
    var:string vVenv;
    var:string vCommand;
    var:string vReturn;
    var:string vConf = "TBXConfig";
    var:boolean debug = true;

    if(vVenvCommand){
        vCommand = "/usr/bin/osascript -e '" + 'tell application "Terminal" to do script "cd ' + $ExportFolder("TBXConfig") + ';' + vVenvCommand + ' && sleep 0.5; ' + $Quarto_Path("TBXConfig") + " " + vQCommand + " " + vProjectPath + " " + vQuartoOptions + '"' + "'";
    }else{
        vCommand = "/usr/bin/osascript -e '" + 'tell application "Terminal" to do script "cd ' + $ExportFolder("TBXConfig") + '; sleep 0.5; ' + $Quarto_Path("TBXConfig") + " " + vQCommand + " " + vProjectPath + " " + vQuartoOptions + '"' + "'";
    };
    if(debug){LogRec("Quarto", "<<mark>> Terminal vCommand=" + vCommand);};
    vReturn = runCommand(vCommand);
    fActivateAppName("Terminal");
};


function fActivateAppName(vApp:string){
    var:string vCommand = "/usr/bin/osascript -e '" + 'tell application "' + vApp + '" to activate' + "'";

    runCommand(vCommand);
};


function fActivateAppID(vID:string){
    var:string vCommand = "/usr/bin/osascript -e '" + 'tell application id"' + vID + '" to activate' + "'";

    runCommand(vCommand);
};


function fQuartoCommnadInWezterm(vQuartoCommand:string, vProjectPath:string, vQuartoOptions:string, vVenvCommand){
    var:string vCommand = "/opt/homebrew/bin/wezterm cli spawn --cwd " + $ExportFolder("TBXConfig") + " -- zsh -c '";
    var:string vReturn;
    var:string vPre;
    var:boolean debug = true;

    if(vVenvCommand){
        vPre = "cd " + $ExportFolder("TBXConfig") + "&&export PATH=/usr/local/bin:/opt/homebrew/bin:" + $RScriptLibraryPath("TBXConfig") + ":$PATH&&" + vVenvCommand + "&&";
    }else{
        vPre = "cd " + $ExportFolder("TBXConfig") + "&&export PATH=/usr/local/bin:/opt/homebrew/bin:" + $RScriptLibraryPath("TBXConfig") + ":$PATH&&";
    };
    vCommand += vPre + $Quarto_Path("TBXConfig") + " " + vQuartoCommand + " " + vProjectPath + " " + vQuartoOptions + ";exec zsh;'";
    if(debug){LogRec("Quarto", "<<mark>>Wezterm: vCommand=" + vCommand);};
    vReturn = runCommand(vCommand);
    if(debug){LogRec("Quarto", "<<mark>>Wezterm: vReturn=" + vReturn);};
    fActivateAppName("Wezterm");
};


function fQuartoCommnadInKitty(vQuartoCommand:string, vSubProjectPath:string, vQuartoOptions:string, vVenvCommand){
    var:string vCommand = "/opt/homebrew/bin/kitty --single-instance --instance-group tbx -d " + $ExportFolder("TBXConfig") + " zsh -c '";
    var:string vReturn;
    var:string vPre;

    if(vVenvCommand){
        vPre = "cd " + $ExportFolder("TBXConfig") + "&&export PATH=/usr/local/bin:/opt/homebrew/bin:" + $RScriptLibraryPath("TBXConfig") + ":$PATH&&" + vVenvCommand + "&&";
    }else{
        vPre = "cd " + $ExportFolder("TBXConfig") + "&&export PATH=/usr/local/bin:/opt/homebrew/bin:" + $RScriptLibraryPath("TBXConfig") + ":$PATH&&";
    };
    vCommand += vPre + $Quarto_Path("TBXConfig") + " " + vQuartoCommand + " " + vSubProjectPath + " " + vQuartoOptions + ";exec zsh&;'"; //$Text(/Log)+= vCommand + "\n";
    ("This Stamp will remain running until you exit Kitty.app.").show;
    vReturn = runCommand(vCommand);
    fActivateAppName("Kitty");
};


function fQuartoCommnadInGhostty(vQuartoCommand:string, vSubProjectPath:string, vQuartoOptions:string, vVenvCommand){
    var:string vCommand;
    var:string vReturn;
    var:string vPre;
    var:boolean debug = true;
    var:string vQ = '"';

    if(vVenvCommand){
        vPre = "cd " + $ExportFolder("TBXConfig") + " && export PATH=/usr/local/bin:/opt/homebrew/bin:" + $RScriptLibraryPath("TBXConfig") + ":$PATH && " + vVenvCommand + " && ";
    }else{
        vPre = "cd " + $ExportFolder("TBXConfig") + " && export PATH=/usr/local/bin:/opt/homebrew/bin:" + $RScriptLibraryPath("TBXConfig") + ":$PATH && ";
    };
    var:string vFullTerminalCommand = vPre + $Quarto_Path("TBXConfig") + " " + vQuartoCommand + " " + vSubProjectPath + " " + vQuartoOptions;

    // Use AppleScript to activate Ghostty, handle window/tab creation based on running state;
    vCommand = "/usr/bin/osascript -e 'set isRunning to application " + vQ + "Ghostty" + vQ + " is running' ";
    vCommand += "-e 'tell application " + vQ + "Ghostty" + vQ + "' ";
    vCommand += "-e 'activate' ";
    vCommand += "-e 'if not isRunning then' ";
    vCommand += "-e 'delay 0.5' "; // Wait for Ghostty to initialize window;
    vCommand += "-e 'set tObj to tab 1 of front window' ";
    vCommand += "-e 'else' ";
    vCommand += "-e 'if (count of windows) is 0 then' ";
    vCommand += "-e 'set win to new window' ";
    vCommand += "-e 'set tObj to tab 1 of win' ";
    vCommand += "-e 'else' ";
    vCommand += "-e 'set win to front window' ";
    vCommand += "-e 'set tObj to new tab in win' ";
    vCommand += "-e 'end if' ";
    vCommand += "-e 'end if' ";
    vCommand += "-e 'delay 0.1' ";
    vCommand += "-e 'input text " + vQ + vFullTerminalCommand + vQ + " & return to focused terminal of tObj' ";
    vCommand += "-e 'end tell'";
    if(debug){LogRec("Quarto", " < < mark > > Ghostty vCommand = " + vCommand);};
    vReturn = runCommand(vCommand);
};