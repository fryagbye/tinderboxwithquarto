    }else{
        if(debug){LogRec("TBXConfig", " < < mark > > Render: vCheck = " + vCheck + " vOutputFolder = " + vOutputFolder + " vOption = " + vOption + " vVenv = " + vVenv);};
        ("Please select the pBookFolder note or any of its descendant notes.").show();
    };
};


