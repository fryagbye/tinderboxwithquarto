// /Hints/Library/Quarto Commands;


function fBookPreview(){
    var:string vSelected = $ID;
    var:string vOutputFolder;
    var:string vVenv;
    var:string vCheck;
    var:string vOption;
    var:string vRoot = collect(ancestors, $Path)[-1];
    var:string vConf = "TBXConfig";
    var:boolean debug = true;

    if($HasVenvEnv){
        vVenv = $VenvActivateCommand;
    }else{
        vVenv = "";
    };
    if($Prototype != "pBookFolder"){
        if($Prototype(vRoot) == "pBookFolder"){
            if($HasVenvEnv){
                vVenv = $VenvActivateCommand(vRoot);
            }else{
                vVenv = "";
            };
            if($HTMLExportFileName(vRoot)){
                vOutputFolder = $HTMLExportFileName(vRoot);
            }else{
                vOutputFolder = $Name(vRoot);
            };
            vCheck = true;
        };
    }else{
        if($HTMLExportFileName){
            vOutputFolder = $HTMLExportFileName;
        }else{
            vOutputFolder = $Name;
        };
    };
    if(debug){LogRec("Quarto", " < < mark > > Preview: vCheck = " + vCheck + " vOutputFolder = " + vOutputFolder + " vOption = " + vOption + " vVenv = " + vVenv);};
    if($Prototype == "pBookFolder"|vCheck){
        fActivateAppName($TerminalApp(vConf));
        if($TerminalApp(vConf) == "Wezterm"){
            fQuartoCommnadInWezterm("preview", vOutputFolder, vOption, vVenv);
        };
        if($TerminalApp(vConf) == "Terminal"){
            fQuartoCommnadInTerminal("preview", vOutputFolder, vOption, vVenv);
        };
        if($TerminalApp(vConf) == "Ghostty"){
            fQuartoCommnadInGhostty("preview", vOutputFolder, vOption, vVenv);
        };
        select($Path(vSelected));
    }else{
        if(debug){LogRec("Quarto", " < < mark > > Preview: vCheck = " + vCheck + " vOutputFolder = " + vOutputFolder + " vOption = " + vOption + " vVenv = " + vVenv);};
        ("Please select the pBookFolder note or any of its descendant notes.").show;
    };
};


function fBookRender(){
    var:string vSelected = $ID;
    var:string vVenv;
    var:string vCheck;
    var:string vOption;
    var:string vOutputFolder;
    var:string vConf = "TBXConfig";
    var:string vRoot = collect(ancestors, $Path)[-1];
    var:boolean debug = true;

    if($HasVenvEnv){
        vVenv = $VenvActivateCommand;
    }else{
        vVenv = "";
    };
    if($Prototype != "pBookFolder"){
        if($Prototype(vRoot) == "pBookFolder"){
            if($HasVenvEnv(vRoot)){
                vVenv = $VenvActivateCommand(vRoot);
            }else{
                vVenv = "";
            };
            vCheck = true;
        };
    }else{
        if($HTMLExportFileName){
            vOutputFolder = $HTMLExportFileName;
        }else{
            vOutputFolder = $Name;
        };
    };
    if(debug){LogRec("Quarto", " < < mark > > Render: vCheck = " + vCheck + " vOutputFolder = " + vOutputFolder + " vOption = " + vOption + " vVenv = " + vVenv);};
    if($Prototype == "pBookFolder"|vCheck){
        fActivateAppName($TerminalApp(vConf));
        if($TerminalApp(vConf) == "Wezterm"){
            fQuartoCommnadInWezterm("render", vOutputFolder, "", vVenv);
        };
        if($TerminalApp(vConf) == "Terminal"){
            fQuartoCommnadInTerminal("render", vOutputFolder, "", vVenv);
        };
        if($TerminalApp(vConf) == "Ghostty"){
