// /Hints/Library/Make Code Listing Label List;


function fMakeCodeListingList(vContainer:string, vPath:string){
    var:string vName;
    var:string vTest;
    var:number vCount(0);
    var:string vLabel;
    var:string vTemp;
    var:list vList;

    LogRec("MakeCodeList", "<<mark>>vContainer=" + vContainer + " vPath=" + vPath);
    if($IsLabelGenerateON(vPath) & ($Prototype(vPath) == "pLabelListContainer" | $Prototype($Prototype(vPath)) == "pLabelListContainer")){
        $Text(vPath) =;
        $MyList(vPath) =;
        $ListKey(vPath) =;
        $ListValue(vPath) =;
        $MyDictionary(vPath) =;
        //Notes contains chunk "lst-" label with style "#| label: lst- " or "#| lst-label: lst- ";
        vList = collect_if(descendants(vContainer), $Text.contains("(#\| (lst-)?label: lst-[\w\d-]*)+?") & ! $IsAlias & $Prototype(parent) != "pLabelListContainer", $Path);
        vList.each(L){
            L = L.replace('"', "");
            $Text(L).eachLine(aLine:aLine.contains("(#\| (lst-)?label: lst-[\w\d-]*)+?")){
                vTemp = $1;
                vTemp = vTemp.replace("#\| label: ", "@").replace("#\| lst-label: ", "@");
                $MyList(vPath) += vTemp;
                $ListKey(vPath) += vTemp;
                $ListValue(vPath) += L;
                $MyDictionary(vPath) = $MyDictionary(vPath).add("{" + $ListKey(vPath) + ":" + $ListValue(vPath) + "}");
            };
        };
        //Notes contains chunk "lst-" label with style "{#lst-";
        vList = collect_if(descendants(vContainer), $Text.contains("(\{#lst-[\w\d-]*)+?") & ! $IsAlias & $Prototype(parent) != "pLabelListContainer", $Path);
        vList.each(L){
            L = L.replace('"', "");
            $Text(L).eachLine(aLine:aLine.contains(".*(\{#lst-[\w\d-]*)+?.*")){
                vTemp = $1;
                vTemp = vTemp.replace("\{#", "@");
                $MyList(vPath) += vTemp;
                $ListKey(vPath) += vTemp;
                $ListValue(vPath) += L;
                $MyDictionary(vPath) = $MyDictionary(vPath).add("{" + $ListKey(vPath) + ":" + $ListValue(vPath) + "}");
            };
        };
        $MySet(vPath) = $MyList(vPath);
        $MySet(vPath).each(S){
            vName = S;
            vLabel = S.replace("@", "");
            vTest = $IDString(vName);
            if(vTest == "" & vName != "@lst-"){
                LogRec("MakeCodeList", "<<mark>> create vName=" + vName + " vLabel=" + vLabel + " vTest=" + vTest);
                create(vPath, vName + "#pReferenceList");
                $OutlineBackgroundColor(vName) = "blue";
            };
            if(vName != "@lst-"){
                $Text(vPath) += vName + "\n";
            };
        };
        vCount = 0;
        $ListKey(vPath).each(K){
            vName = K;
            $ToDummyLinkPath(vName) = $ListValue(vPath)[vCount];
            $Text(vName) = fCodeListingChunk($ListValue(vPath)[vCount], vName.replace("@", ""));
            createLink(K, $ListValue(vPath)[vCount], "dummy");
            vCount += 1;
        };
    };
};


function fCodeListingChunk(vName:string, vLabel:string){
    var:string vReg1;
    var:string vReg2;
    var:string vReg3;
    var:string vReg4;
    var:string vReg5;
    var:string vTemp;

    vReg1 = "(```[^`]+#\| label: " + vLabel + "[^`]+```)";
    vReg2 = "(```[^`]+#\| lst-label: " + vLabel + "[^`]+```)";
    vReg3 = "(```\{#" + vLabel + "[^`]+```)";
    vReg4 = "(:::[\s\S]*?\{#" + vLabel + "\}[\s\S]*?:::)";
    vReg5 = "(:::\s*\{#" + vLabel + "[\s\S]*?\}[\s\S]*?:::)";
    if($Text(vName).contains(vReg1)){
        vTemp = $1;
    };
    if($Text(vName).contains(vReg2)){
        vTemp = $1;
    };
    if($Text(vName).contains(vReg3)){
        vTemp = $1;
    };
    if($Text(vName).contains(vReg4)){
        vTemp = $1;
    };
    if($Text(vName).contains(vReg5)){
        vTemp = $1;
    };

    if(vTemp){
        // Remove opening backticks line
        vTemp = vTemp.replace("^```.*\n", "");
        // Remove YAML options lines starting with #|
        vTemp = vTemp.replace("(?m)^#\|.*\n", "");
        // Remove closing backticks
        vTemp = vTemp.replace("\n```$", "");
        // Trim whitespace
        vTemp = vTemp.trim();
    };

    return vTemp;
};