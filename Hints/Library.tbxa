// /Hints/Library
// /Hints/Library/Set Display Expression;


function fDisplayExpression(){
	$DisplayExpression = '$OutlineDepthBase(original) * $Indent_Charactor("TBXConfig") + " " + if($Name.size <= 30){$Name + (30 - $Name.size) * " " }else{$Name} + if(($HasSectionLabel)&($SectionLabel)){" {" + $SectionLabel + "}"};';
};


function fDisplayExpression2(){
	$DisplayExpression = '$OutlineDepthBase(original) * $Indent_Charactor("TBXConfig") + " " + if($Name.size <= 30){$Name + (30 - $Name.size) * " " }else{$Name} + if(($HasSectionLabel)|($IsUnnumbered)|($IsAppendix)){" {"} + if(($HasSectionLabel)&($SectionLabel)){ $SectionLabel } + if(($HasSectionLabel)|($IsUnnumbered)|($IsAppendix)){"}"};';
};
// /Hints/Library/Utility;


function fDeleteCharacters(vStr:string){
	var:string vReturn;

	vReturn = vStr.deleteCharacters("/\?% * :| < > .& + ()!#, ’`").lowercase().replace(" ", "-").replace("'", "");
	return vReturn;
};


function fTranslateStrings(vLang, vStr:string){
	//you nead install trans-shell
	//var:string vCommand="export PATH=/opt/homebrew/bin:$PATH;/opt/homebrew/bin/trans -b ";
	var:string vCommand;
	var:string vFilePathOfTrans = $PathOfTransExe("TBXConfig");
	var:string vPathOfTrans;
	var:string vReturn;

	vFilePathOfTrans.icontains("(. * ) / ");
	vPathOfTrans = "export PATH = " + $1 + ":$PATH;";
	vStr = "'" + vStr + "'";
	vCommand = vPathOfTrans + vFilePathOfTrans + " -b ";
	vCommand = vCommand + "{" + vLang + "} ";
	$MyString = vCommand;
	vReturn = runCommand(vCommand, vStr).replace("\n", "").replace('"', "");
	return vReturn;
};


function fRenameIn(vStr:string){
	var:string vTempName;
	var:string vLang = $Rename_in("TBXConfig");

	$MyString("TBXConfig") = vLang;
	vTempName = fTranslateStrings(vLang, vStr);
	//$MyString = vTempName;
	if(!($IsNamesLocked)){
		if($IsIndexqmd){
			$HTMLExportFileName = "index";
		}else{
			$HTMLExportFileName = vTempName.deleteCharacters("/\?% * :| < > .& + ()!#, ’`").lowercase().replace(" ", "-").replace("'", "");
			$SectionLabel = $HTMLExportFileName;
		};
		("Name Changed to:" + $HTMLExportFileName + $HTMLExportExtension).show();
	}else{
		("Name is Locked").show();
	};
};


function fGetLanguageYML(vLang:string){
	var:string vURL;
	var:string vYML = " / Prototypes / Quarto Book / pYML";
	var:string vRoot = collect(ancestors, $Path)[-1];
	var:string vYMLPath = collect_if(children(vRoot), $Prototype == "pYML", $Path).first;

	if($Prototype == "pLanguageYML"&!$ReadOnly){
		if(vLang == "en"|vLang == ""){
			vURL = "https://raw.githubusercontent.com / quarto-dev / quarto-cli / main / src / resources / language / _language.yml";
			$Name = "_language";
			$HTMLExportFileName = $Name;
			$HTMLExportExtension = ".yml";
		}else{
			vURL = "https://raw.githubusercontent.com / quarto-dev / quarto-cli / main / src / resources / language / _language-" + vLang + ".yml";
			$Name = "_language-" + vLang;
			$HTMLExportFileName = $Name;
			$HTMLExportExtension = ".yml";
		};
		$URL = vURL;
		$AutoFetch = true;
		$ReadOnly = true;
		$Q_LanguageYml(vYMLPath) = $HTMLExportFileName + $HTMLExportExtension;
		("Get from " + vURL + ". It may take a little time to autofetch").show();
	}else{
		if($Prototype != "pLanguageYML"){
			("Select pLanguageYML note").show();
		};
		if($ReadOnly){
			($Name + " is read only").show();
		};
	};
};


function fFixDisplayedAttributesWithTemplate(){
	if($Prototype){
		$DisplayedAttributes = $DisplayedAttributes($HTMLExportTemplate);
	};
};


function fFixDisplayedAttributesWithPrototype(){
	if($Prototype){
		$DisplayedAttributes = $DisplayedAttributes($Prototype);
	};
};
// /Hints/Library/Chunk;


function fSetPreviewCommandForRChunk(){
	var:string vConfigPath = "TBXConfig";
	var:string vExportPath = $ExportFolder(vConfigPath);
	var:string vProjectPath = $HTMLExportFileName(collect(ancestors, $Path)[-1]);
	var:string vWarn = ", warn.conflicts = F";
	var:string vCommand;
	var:string vLibList = $RLibraryListForPreview(vConfigPath);

	vCommand = "export PATH = $HOME:/opt / homebrew / bin:/usr / local / bin:/Library / TeX / texbin/:$PATH;";
	vCommand += "cd " + vExportPath + " / " + vProjectPath + ";" + ' / usr / local / bin / Rscript -e "';
	vLibList.each(al){
		vCommand += "library(" + al + vWarn + "); ";
	};
	vCommand += "lines < - readLines(file('stdin'), warn = FALSE);f < - file('_RchunkPreviewOutput.qmd', 'w');";
	vCommand += "cat('---\u000A', 'title: \u0022" + $Name + "\u0022\u000A', '---\u000A', file = f, sep = '');";
	vCommand += "for (line in lines) {line < - gsub('\`\`\`{webr', '\`\`\`{r', line, fixed = TRUE); cat(line, '\u000A', sep = '', file = f); }; close(f);";
	vCommand += "rendered_output < - rmarkdown::render('_RchunkPreviewOutput.qmd', output_format = 'html_document', quiet = TRUE);";
	vCommand += "cat(readLines(rendered_output), sep = '\u000A');";
	vCommand += "tmp < - if(file.exists('_RchunkPreviewOutput.qmd')) {file.remove('_RchunkPreviewOutput.qmd')};";
	vCommand += "tmp < - if(file.exists('_RchunkPreviewOutput.html')) {file.remove('_RchunkPreviewOutput.html')};";
	vCommand += '"';
	//	$Text(/Log)=vCommand;
	$HTMLPreviewCommand = vCommand;
};


function fSetForChunk(vID, vForPreview){
	$Text(vID) = fWriteOptionsForChunk(vID, vForPreview);
}


function fWriteFrontmatterForRChunk(vID){
	var:string vPre;
	var:string vTitle;

	if($Q_ChunkFigLabel(vID)){
		vTitle = $Q_ChunkFigLabel(vID);
	}else{
		if($Prototype == "pRChunkList"){
			$Name(vID).contains(" < (?:webr|r|python|pyodide|osj):(. * ?) > ");
			vTitle = $1;
		}else{
			vTitle = $Name(vID);
		};
	};
	vPre = "---\n";
	vPre += 'title: "' + vTitle + '"\n';
	vPre += "output:\n";
	vPre += " html_document:\n";
	vPre += " template: " + $RscriptHTMLTemplate("TBXConfig") + "\n";
	vPre += "engine:\n";
	vPre += " cache: false\n";
	vPre += "---\n\n";
	return vPre;
};


function fWriteOptionsForGraph(vID:string){
	var:string vPre;
	var:string vStr;
	var:string vTemp;

	//	var:string vReg="```\{(?:mermaid|dot)\s*.*?\}\s*(?:#\|.*\n)*([\s\S]*?)\s*```";
	var:string vReg = "```\{(?:mermaid|dot)\s * . * ?\}\s * (?:(?:%%\||#\||//\|). * \n) * ([\s\S] * ?)\s * ```";
	var:string vReturn;

	if($Text(vID).contains(vReg)){
		vTemp = $1;
	}else{
		vTemp = $Text(vID);
	};
	if($Prototype(vID) == "pMFContainer"){
		vStr = "%%";
		vPre = "```{mermaid}\n";
	}else{
		vStr = "//";
		vPre = "```{dot}\n";
	};
	if($Q_ChunkFigLabel(vID)){
		vPre += vStr + "| label: fig-" + $Q_ChunkFigLabel(vID) + "\n";
	};
	if($Q_ChunkEcho(vID)){
		vPre += vStr + "| echo: " + $Q_ChunkEcho(vID) + "\n";
	};
	if($Q_ChunkFigCaption(vID)){
		vPre += vStr + "| fig-cap: " + $Q_ChunkFigCaption(vID) + "\n";
	};
	if($Q_ChunkFigAlt(vID)){
		vPre += vStr + "| fig-alt: " + $Q_ChunkFigAlt(vID) + "\n";
	};
	vReturn += vPre;
	vReturn += vTemp + "\n";
	vReturn += "```\n";
	return vReturn;
};


function fWriteOptionsForChunk(vID:string, vForPreview:boolean){
	var:string vPre;
	var:string vStr;
	var:string vTemp;
	var:string vReg = "```\{[. = ]?[webr|r|python|pyodide|ojs]\s * . * ?\}\s * (?:#\|. * \n) * ([\s\S] * ?)\s * ```";
	var:string vReturn;

	if($Text(vID).contains(vReg)){
		vTemp = $1;
	}else{
		vTemp = $Text(vID);
	};
	if(vForPreview&($Prototype == "pRChunk"|$Prototype = "pRChunkList")){
		vReturn += fWriteFrontmatterForRChunk(vID);
	};
	if($Q_ChunkLang(vChunkPath) == "ojs"){
		vStr = "//";
	}else{
		vStr = "#";
	};
	if($Q_IsCodeBlock(vID)){
		vPre = "\n```{." + $Q_ChunkLang(vID);
	}else{
		vPre = "\n```{" + $Q_ChunkLang(vID);
	};
	if($Q_CodeLineNumbers(vID).size > 0){
		vPre += " code-line-numbers = " + $Q_CodeLineNumbers(vID).format(", ");
	};
	if($QR_OutputLocation(vID)){
		vPre += " output-location = " + $QR_OutputLocation(vID);
	};
	vPre += "}\n";
	if($Q_ChunkEcho(vID)){
		vPre += vStr + "| echo: " + $Q_ChunkEcho(vID) + "\n";
	}else{
		vPre += vStr + "| echo: false\n";
	};
	if($Q_ChunkSuppressWarning(vID)){
		vPre += vStr + "| warning: " + "false" + "\n";
	};
	if($Q_ChunkAutoRun(vID)){
		vPre += vStr + "| autorun: " + $Q_ChunkAutoRun(vID) + "\n";
	};
	if($Q_ChunkFigLabel(vID)){
		vPre += vStr + "| label: fig-" + $Q_ChunkFigLabel(vID) + "\n";
	};
	if($Q_ChunkFigCaption(vID)){
		vPre += vStr + "| fig-cap: " + $Q_ChunkFigCaption(vID) + "\n";
	};
	if($Q_ChunkFigWidth(vID)){
		vPre += vStr + "| fig-width: " + $Q_ChunkFigWidth(vID) + "\n";
	};
	if($Q_ChunkFigHeight(vID)){
		vPre += vStr + "| fig-height: " + $Q_ChunkFigHeight(vID) + "\n";
	};
	if($Q_ChunkFigPos(vID)){
		vPre += vStr + "| fig-pos: " + $Q_ChunkFigPos(vID) + "\n";
	};
	if($Q_ChunkFigShow(vID)){
		vPre += vStr + "| fig-show: " + $Q_ChunkFigShow(vID) + "\n";
	};
	if($Q_ChunkFIgOutWidth(vID)){
		vPre += vStr + "| out-width: " + $Q_ChunkFIgOutWidth(vID) + "\n";
	};
	vReturn += vPre;
	vReturn += vTemp + "\n";
	vReturn += "```\n";
	return vReturn;
};
// /Hints/Library/Create New Project;


function fCreateBookProject(){
	//var:string vProjectName=$ProjectContainer("TBXConfig");
	var:string vTempPath;
	var:string vTempName;
	var:string vLabelList = [Section;Figure;Table;Equation];

	if($Prototype($ID) == "pBookFolder" & $ChildCount($ID) == 0){
		vLabelList.each(x){
			vTempName = x + " Label List";
			vTempPath = $Path($ID) + " / " + vTempName;
			create($Path($ID), vTempName + "#pLabelListContainer");
			$TypeOfList(vTempPath) = x;
			$ProjectContainer(vTempPath) = $Path($ID);
			//$Edict(vTempPath)="$ProjectContainer=collect(ancestors,$Path)[-1];\nfMake"+ x +"List($ProjectContainer,$Path);";
		};
		create($Path($ID), "_quarto#pYML");
		create($Path($ID), "index#pIndexQmd");
		$HTMLExportFileName($Path($ID)) = fDeleteCharacters($Name($ID));
	}else{
		if($ChildCount($ID) > 0){
			($Name($ID) + " already has child Notes").show();
		}else{
			"Please select a pBookFolder Note".show();
		};
	};
};


function fCreateManuscriptProject(){
	var:string vTempPath;
	var:string vTempName;
	var:string vLabelList = [Section;Figure;Table;Equation];

	if($Prototype($ID) == "pManuscriptFolder" & $ChildCount($ID) == 0){
		vLabelList.each(x){
			vTempName = x + " Label List";
			vTempPath = $Path($ID) + " / " + vTempName;
			create($Path($ID), vTempName + "#pLabelListContainer");
			$TypeOfList(vTempPath) = x;
			$ProjectContainer(vTempPath) = $Path($ID);
			//$Edict(vTempPath)="fMake"+ x +"List($ProjectContainer,$Path);\n$ProjectContainer=collect(ancestors,$Path)[-1];";
		};
		create($Path($ID), "_quarto_manuscript#pYMLmanuscript");
		create($Path($ID), "main#pFrontmatterManuscript");
		create($Path($ID) + " / main", "SectionTitle#pSubnoteManuscript");
		create($Path($ID), "Authors#pAuthorsContainer");
		create($Path($ID) + " / Authors", "Author#pAuthor");
		$Q_Title($Path($ID) + " / main") = $Name($ID);
		$HTMLExportFileName($Path($ID)) = fDeleteCharacters($Name($ID));
	}else{
		if($ChildCount($ID) > 0){
			($Name($ID) + " already has child Notes").show();
		}else{
			"Please select a pManuscriptFolder Note".show();
		};
	};
};


