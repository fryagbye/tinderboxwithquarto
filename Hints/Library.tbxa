function fMakeGraphList(){
	var:string vName;
	var:string vName2;
	var:string vGraphLabelListPath = $GraphListContainer("TBXConfig");
	var:string vProjectLabelListPath;
	var:string vProjectPath;
	var:string vTest;
	var:dictionary vDict;
	var:list vList;

	if($Container == " / "){
		vProjectPath = $Path;
	}else{
		vProjectPath = collect(ancestors, $Path)[-1];
	};
	vProjectLabelListPath = vProjectPath + $FigLabelListContainer("TBXConfig");
	if($IsLabelGenerateON(vGraphLabelListPath)&($Prototype(vGraphLabelListPath) == "pLabelListContainer"|$Prototype($Prototype(vGraphLabelListPath)) == "pLabelListContainer")){
		$Text(vGraphLabelListPath) = "";
		vList = collect_if(all, ($Prototype == "pMFContainer"|$Prototype == "pGContainer")&!$IsPrototype&!$IsAlias&($Container != vGraphLabelListPath), $ID);
		vList.each(aGraph){
			var:string vFigRef;

			if($Q_ChunkFigLabel(aGraph)){
				vFigRef = "➡️fig-" + $Q_ChunkFigLabel(aGraph) + "";
			};
			if(!$Q_ChunkFigCaption(aGraph)){
				$Q_ChunkFigCaption(aGraph) = $Name(aGraph);
			};
			$Name(aGraph) = fDeleteCharacters($Name(aGraph));
			if($Prototype(aGraph) == "pMFContainer"){
				vName = " < mermaid:" + $Name(aGraph) + vFigRef + " > ";
				vName2 = "\ < mermaid:" + $Name(aGraph) + vFigRef + "\ > ";
			}else{
				vName = " < dot:" + $Name(aGraph) + vFigRef + " > ";
				vName2 = "\ < dot:" + $Name(aGraph) + vFigRef + "\ > ";
			};
			vTest = $ID(vName);
			if(!vTest & vFigName != "@fig-"){
				if($Text(aGraph).wordCount > 0){
					var:string vPrototype;
					var:string vPath;

					if($Prototype(aGraph) == "pMFContainer"){
						vPrototype = "#pMFGraphList";
					}else{
						vPrototype = "#pGGraphList";
					};
					vPath = vGraphLabelListPath + " / " + vName2;
					create(vPath + vPrototype);
					$Text(vPath) = $Text(aGraph);
					createLink($Path(vPath), $Path(aGraph), "dummy");
					$ToDummyLinkPath(vPath) = $Path(aGraph);
					$Text(vGraphLabelListPath += vName + ":" + $ToDummyLinkPath(vPath) + "\n");
					$Name(vPath) = vName;
				};
			};
			//Create Figure Label;
			var:string vFigName;
			var:string vLabelPath;
			var:list vAttributes = $DisplayedAttributes($Prototype(aGraph));
			var:string vTemp;

			vFigName = "@fig-" + $Q_ChunkFigLabel($Path(aGraph));
			vLabelPath = vProjectPath + vGraphLabelListPath + " / " + vFigName;
			vTest = $ID(vLabelPath);
			if(!vTest & vFigName != "@fig-"){
				LogRec("MakeGraphList", " < < mark > > create vLabelPath = " + vLabelPath + " vFigName = " + vFigName + " vGraphLabelListPath = " + vGraphLabelListPath);
				create(vLabelPath, vFigName + "#pReferenceList");
				$ToDummyLinkPath(vLabelPath) = $Path(aGraph);
				$OutlineBackgroundColor(vLabelPath) = "light violet";
				$Text(vLabelPath) = $Text(aGraph);
				createLink(vGraphLabelListPath + " / " + vFigName, vLabelPath, "dummy");
			};
			vAttributes.each(x){
				vTemp = "$" + x + "(" + vLabelPath + ") = $" + x + "(" + $Path(aGraph) + ");";
				action(vTemp);
			};
		};
	};
};


function fClearGraphList(){
	var:string vPath1 = $GraphListContainer("TBXConfig");
	var:list vDellist;

	vDellist = collect(children(vPath1), $Path);
	if(vDellist.count > 0){
		delete(vDellist);
		$Text(vPath1) = "";
	};
};
