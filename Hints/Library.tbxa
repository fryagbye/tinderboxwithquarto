// /Hints/Library/Quarto Commands;


function fBookAction(vQCommand:string, vQuartoOptions:string){
	var:string vSelected = $ID;
	var:string vOutputFolder;
	var:string vVenv;
	var:string vCheck = false;
	var:string vRoot = collect(ancestors, $Path)[-1];
	var:string vConf = "TBXConfig";
	var:boolean debug = true;
	var:string vAgentName = "Export Agent";
	var:string vProject = "";

	// プロジェクトノートの特定
	if ($Prototype == "pBookFolder") {
		vProject = $Path;
	} else {
		if ($Prototype(vRoot) == "pBookFolder") {
			vProject = vRoot;
			vCheck = true;
		} else {
			if ($IsAgent(vRoot) & $Name(vRoot) == vAgentName) {
				vProject = $CurrentBookProject(vAgentName);
				vCheck = true;
			};
		};
	};

	// プロジェクト情報の設定
	if (vProject) {
		vVenv = $VenvActivateCommand(vProject);
		vOutputFolder = $HTMLExportFileName(vProject);
		if (!vOutputFolder) { vOutputFolder = $Name(vProject); };
	} else {
		vVenv = $VenvActivateCommand;
		vOutputFolder = $HTMLExportFileName;
		if (!vOutputFolder) { vOutputFolder = $Name; };
	};

	if($Prototype == "pBookFolder" | vCheck){
		fActivateAppName($TerminalApp(vConf));
		if(debug){LogRec("Quarto", " < < mark > > " + vQCommand + ": vCheck = " + vCheck + " vOutputFolder = " + vOutputFolder + " vOption = " + vQuartoOptions + " vVenv = " + vVenv);};
		if($TerminalApp(vConf) == "Wezterm"){
			fQuartoCommnadInWezterm(vQCommand, vOutputFolder, vQuartoOptions, vVenv);
		};
		if($TerminalApp(vConf) == "Terminal"){
			fQuartoCommnadInTerminal(vQCommand, vOutputFolder, vQuartoOptions, vVenv);
		};
		if($TerminalApp(vConf) == "Ghostty"){
			fQuartoCommnadInGhostty(vQCommand, vOutputFolder, vQuartoOptions, vVenv);
		};
		select($Path(vSelected));
	}else{
		("Please select the pBookFolder note or any of its descendant notes.").show;
	};
};


function fManuscriptPreview(){
	var:string vOption;
	var:string vOutputFolder;
	var:string vVenv;
	var:string vCheck;
	var:string vSelected = $ID;
	var:string vRoot = collect(ancestors, $Path)[-1];
	var:string vConf = "TBXConfig";
	var:boolean debug = true;

	if($HasVenvEnv){
		vVenv = $VenvActivateCommand;
	}else{
		vVenv = "";
	};
	vOption = "--to html";
	if($Prototype != "pManuscriptFolder"){
		if($Prototype(vRoot) == "pManuscriptFolder"){
			if($HasVenvEnv(vRoot)){
				vVenv = $VenvActivateCommand(vRoot);
			}else{
				vVenv = "";
			};
			if($HTMLExportFileName(vRoot)){
				vOutputFolder = $HTMLExportFileName(vRoot);
			}else{
				vOutputFolder = $Name(vRoot);
			};
			vCheck = true;
		};
	}else{
		if($HTMLExportFileName){
			vOutputFolder = $HTMLExportFileName;
		}else{
			vOutputFolder = $Name;
		};
	};
	if(debug){LogRec("Quarto", " < < mark > > Preview: vCheck = " + vCheck + " vOutputFolder = " + vOutputFolder + " vOption = " + vOption + " vVenv = " + vVenv);};
	if($Prototype == "pManuscriptFolder"|vCheck){
		fActivateAppName($TerminalApp(vConf));
		if($TerminalApp(vConf) == "Wezterm"){
			fQuartoCommnadInWezterm("preview", vOutputFolder, vOption, vVenv);
		};
		if($TerminalApp(vConf) == "Terminal"){
			fQuartoCommnadInTerminal("preview", vOutputFolder, vOption, vVenv);
		};
		select($Path(vSelected));
	}else{
		if(debug){LogRec("Quarto", " < < mark > > Render: vCheck = " + vCheck + " vOutputFolder = " + vOutputFolder + " vOption = " + vOption + " vVenv = " + vVenv);};
		("Please select the pManuscriptFolder note or any of its descendant notes.").show;
	};
};


function fRevealjsPreview(){
	var:string vSelected = $ID;
	var:string vOption;
	var:string vOutputFolder;
	var:string vVenv;
	var:string vCheck;
	var:string vConf = "TBXConfig";
	var:string vRoot = collect(ancestors, $Path)[-1];
	var:boolean debug = true;

	if($HasVenvEnv){
		vVenv = $VenvActivateCommand;
	}else{
		vVenv = "";
	};
	if($Q_HasQuartoLiveChunk(vRoot)){
		vOption = "--to live-revealjs";
	}else{
		vOption = "--to revealjs";
	};
	if($Prototype != "pRevealjsFolder"){
		var:string vRoot = collect(ancestors, $Path)[-1];

		if($Prototype(vRoot) == "pRevealjsFolder"){
			if($HasVenvEnv(vRoot)){
				vVenv = $VenvActivateCommand(vRoot);
			}else{
				vVenv = "";
			};
			if($HTMLExportFileName(vRoot)){
				vOutputFolder = $HTMLExportFileName(vRoot);
			}else{
				vOutputFolder = $Name(vRoot);
			};
			if($Q_HasQuartoLiveChunk(vRoot)){
				vOption = "--to live-revealjs";
			}else{
				vOption = "--to revealjs";
			};
			vCheck = true;
		};
	}else{
		if($HTMLExportFileName){
			vOutputFolder = $HTMLExportFileName;
		}else{
			vOutputFolder = $Name;
		};
	};
	if($Prototype == "pRevealjsFolder"|vCheck){
		if($TerminalApp(vConf) == "Wezterm"){
			fQuartoCommnadInWezterm("preview", vOutputFolder, vOption, vVenv);
		};
		if($TerminalApp(vConf) == "Terminal"){
			fQuartoCommnadInTerminal("preview", vOutputFolder, vOption, vVenv);
		};
		select($Path(vSelected));
	}else{
		("Please select the pRevealjsFolder note or any of its descendant notes.").show;
	};
};


function fQuartoCommnadInTerminal(vQCommand:string, vProjectPath:string, vQuartoOptions:string, vVenvCommand){
	var:string vVenv;
	var:string vCommand;
	var:string vReturn;
	var:string vConf = "TBXConfig";
	var:boolean debug = true;

	if(vVenvCommand){
		vCommand = " / usr / bin / osascript -e '" + 'tell application "Terminal" to do script "cd ' + $ExportFolder("TBXConfig") + ';' + vVenvCommand + ' && sleep 0.5; ' + $Quarto_Path("TBXConfig") + " " + vQCommand + " " + vProjectPath + " " + vQuartoOptions + '"' + "'";
	}else{
		vCommand = " / usr / bin / osascript -e '" + 'tell application "Terminal" to do script "cd ' + $ExportFolder("TBXConfig") + '; sleep 0.5; ' + $Quarto_Path("TBXConfig") + " " + vQCommand + " " + vProjectPath + " " + vQuartoOptions + '"' + "'";
	};
	if(debug){LogRec("Quarto", " < < mark > > Terminal vCommand = " + vCommand);};
	vReturn = runCommand(vCommand);
	fActivateAppName("Terminal");
};


function fActivateAppName(vApp:string){
	var:string vCommand = " / usr / bin / osascript -e '" + 'tell application "' + vApp + '" to activate' + "'";

	runCommand(vCommand);
};


function fActivateAppID(vID:string){
	var:string vCommand = " / usr / bin / osascript -e '" + 'tell application id"' + vID + '" to activate' + "'";

	runCommand(vCommand);
};


function fQuartoCommnadInWezterm(vQuartoCommand:string, vProjectPath:string, vQuartoOptions:string, vVenvCommand){
	var:string vCommand = " / opt / homebrew / bin / wezterm cli spawn --cwd " + $ExportFolder("TBXConfig") + " -- zsh -c '";
	var:string vReturn;
	var:string vPre;
	var:boolean debug = true;

	if(vVenvCommand){
		vPre = "cd " + $ExportFolder("TBXConfig") + "&&export PATH = /usr / local / bin:/opt / homebrew / bin:" + $RScriptLibraryPath("TBXConfig") + ":$PATH&&" + vVenvCommand + "&&";
	}else{
		vPre = "cd " + $ExportFolder("TBXConfig") + "&&export PATH = /usr / local / bin:/opt / homebrew / bin:" + $RScriptLibraryPath("TBXConfig") + ":$PATH&&";
	};
	vCommand += vPre + $Quarto_Path("TBXConfig") + " " + vQuartoCommand + " " + vProjectPath + " " + vQuartoOptions + ";exec zsh;'";
	if(debug){LogRec("Quarto", " < < mark > > Wezterm: vCommand = " + vCommand);};
	vReturn = runCommand(vCommand);
	if(debug){LogRec("Quarto", " < < mark > > Wezterm: vReturn = " + vReturn);};
	fActivateAppName("Wezterm");
};


function fQuartoCommnadInKitty(vQuartoCommand:string, vSubProjectPath:string, vQuartoOptions:string, vVenvCommand){
	var:string vCommand = " / opt / homebrew / bin / kitty --single-instance --instance-group tbx -d " + $ExportFolder("TBXConfig") + " zsh -c '";
	var:string vReturn;
	var:string vPre;

	if(vVenvCommand){
		vPre = "cd " + $ExportFolder("TBXConfig") + "&&export PATH = /usr / local / bin:/opt / homebrew / bin:" + $RScriptLibraryPath("TBXConfig") + ":$PATH&&" + vVenvCommand + "&&";
	}else{
		vPre = "cd " + $ExportFolder("TBXConfig") + "&&export PATH = /usr / local / bin:/opt / homebrew / bin:" + $RScriptLibraryPath("TBXConfig") + ":$PATH&&";
	};
	vCommand += vPre + $Quarto_Path("TBXConfig") + " " + vQuartoCommand + " " + vSubProjectPath + " " + vQuartoOptions + ";exec zsh&;'"; //$Text(/Log) += vCommand + "\n";
	("This Stamp will remain running until you exit Kitty.app.").show;
	vReturn = runCommand(vCommand);
	fActivateAppName("Kitty");
};


function fQuartoCommnadInGhostty(vQuartoCommand:string, vSubProjectPath:string, vQuartoOptions:string, vVenvCommand){
	var:string vCommand;
	var:string vReturn;
	var:string vPre;
	var:boolean debug = true;	
	var:string vQ = '"';

	if(vVenvCommand){
		vPre = "cd " + $ExportFolder("TBXConfig") + " && export PATH = /usr / local / bin:/opt / homebrew / bin:" + $RScriptLibraryPath("TBXConfig") + ":$PATH && " + vVenvCommand + " && ";
	}else{
		vPre = "cd " + $ExportFolder("TBXConfig") + " && export PATH = /usr / local / bin:/opt / homebrew / bin:" + $RScriptLibraryPath("TBXConfig") + ":$PATH && ";
	};
	var:string vFullTerminalCommand = vPre + $Quarto_Path("TBXConfig") + " " + vQuartoCommand + " " + vSubProjectPath + " " + vQuartoOptions;

	// Use AppleScript to activate Ghostty, handle window/tab creation based on running state;
	vCommand = "/usr/bin/osascript -e 'set isRunning to application " + vQ + "Ghostty" + vQ + " is running' ";
	vCommand += "-e 'tell application " + vQ + "Ghostty" + vQ + "' ";
	vCommand += "-e 'activate' ";
	vCommand += "-e 'if not isRunning then' ";
	vCommand += "-e 'delay 0.5' "; // Wait for Ghostty to initialize window;
	vCommand += "-e 'set tObj to tab 1 of front window' ";
	vCommand += "-e 'else' ";
	vCommand += "-e 'if (count of windows) is 0 then' ";
	vCommand += "-e 'set win to new window' ";
	vCommand += "-e 'set tObj to tab 1 of win' ";
	vCommand += "-e 'else' ";
	vCommand += "-e 'set win to front window' ";
	vCommand += "-e 'set tObj to new tab in win' ";
	vCommand += "-e 'end if' ";
	vCommand += "-e 'end if' ";
	vCommand += "-e 'delay 0.1' ";
	vCommand += "-e 'input text " + vQ + vFullTerminalCommand + vQ + " & return to focused terminal of tObj' ";
	vCommand += "-e 'end tell'";
	if(debug){LogRec("Quarto", " < < mark > > Ghostty vCommand = " + vCommand);};
	vReturn = runCommand(vCommand);
};



// /Hints/Library/_quarto.yml;


function fagentqmd(){
	var:string vName($AgentNameForQmdFiles("TBXConfig"));
	var:string vQuote = '"';
	var:string vProjectPath = collect(ancestors, $Path)[-1];
	var:boolean debug = false;

	if(debug){LogRec("Quarto", " < < mark > > fagentqmd: vName = " + vName + " vProjectPath = " + vProjectPath);};
	$QmdList = collect_if(descendants(vProjectPath), ($Prototype == "pNote"|$Prototype($Prototype) == "pNote")&$IsAppendix == false, $ID);
	$AppendixList = collect_if(descendants(vProjectPath), ($Prototype == "pNote"|$Prototype($Prototype) == "pNote")&$IsAppendix == true, $ID);
};


function fqmdlist(){
	var:string vName($AgentNameForQmdFiles("TBXConfig"));
	var:string vNameTOC = $TableOfContaintsNote("TBXConfig");
	var:string vProjectPath = collect(ancestors, $Path)[-1];

	$Text = " chapters:\n";
	$QmdList.each(x){
		x = x.replace('"', '');
		if($Is_Part_qmd(x)){
			if($Text(x).wordCount == 0){
				$Text += ' - part: "' + $Name(x) + '"\n chapters:\n';
			}else{
				$Text += " - part: " + $HTMLExportFileName(x) + $HTMLExportExtension(x) + "\n chapters:\n";
			};
		}else{
			if($Part_file(x)){
				$Text += " - " + $HTMLExportFileName(x) + $HTMLExportExtension(x) + "\n";
			}else{
				$Text += " - " + $HTMLExportFileName(x) + $HTMLExportExtension(x) + "\n";
			};
		};
	};
	if($AppendixList.count > 0){
		$Text += " appendices:\n";
		$AppendixList.each(x){
			x = x.replace('"', '');
			$Text += " - " + $HTMLExportFileName(x) + $HTMLExportExtension(x) + "\n";
		};
	};
};


function fChangeTemplateQuartoYML(){
	var:string vName = "_quarto";
	var:string vProjectPath = collect(ancestors, $Path)[-1];
	var:string vYmlPath = $Path(vProjectPath) + " / " + vName;

	if($ID(vYmlPath)&$Prototype(vYmlPath) == "pYML"){
		if($HTMLExportTemplate(vYmlPath) == " / Templates / tYML_bookhtml"){
			$HTMLExportTemplate(vYmlPath) = " / Templates / tYML_bookpdf";
			$Q_OutputType(vYmlPath) = "pdf";
		}else{
			$HTMLExportTemplate(vYmlPath) = " / Templates / tYML_bookhtml";
			$Q_OutputType(vYmlPath) = "html";
		};
		fChangeQuartoYMLDisplayedAttributes(vYmlPath);
		$DisplayExpression(vYmlPath) = '$Name + " ( " + $HTMLExportTemplate + " )"';
		$MyString = $Name($HTMLExportTemplate);
		$OutlineBackgroundColor = $OutlineBackgroundColor($Name($HTMLExportTemplate));
		(vYmlPath + " template is set with " + $HTMLExportTemplate(vYmlPath)).show();
	}else{
		(" Please select _quarto.yml or inside of project folder").show();
	};
};
// /Hints/Library/Table of Contains;


function fMakeTOC(){
	var:string vTOC($TableOfContaintsNote("TBXConfig"));
	var:string vPath = $ProjectContainer("TBXConfig");
	var:string vNewNote = vTOC + "#pTOCQmd";
	var:string vMessage = "Move the TOC note where you want to place it." + vPath;

	if(!$ToggleTOC){
		vMessage += "\nPlease set $ToggleTOC ON in TBXConfig note";
	};
	//select(vPath);
	create(vPath, vNewNote);
	$Text($TableOfContaintsNote("TBXConfig")) = $Text("Index List");
	vMessage.show();
};


function fMakeIndexList(vProjectPath:string){
	var:string vNote1 = vProjectPath + $SecLabelListContainer("TBXConfig");
	var:string vNote2 = vProjectPath + $IndexListContainer("TBXConfig");
	var:string vNote3 = vProjectPath + " / " + $TableOfContaintsNote("TBXConfig");
	var:boolean vInJapanese = $IsInJapaneseTOC("TBXConfig");
	var:number vLevel = $MakeIndexLevel("TBXConfig");
	var:string vTest;
	var:string vSectionName;
	var:string vName;

	$Text(vNote2) = "";
	$Text(vNote1).eachLine(aline){
		vName = aline.substr(2);
		if($ChildCount("agent unnumbered") == 0){
			vSectionName = $Name($MyDictionary(vNote1)[vName]);
		}else{
			vSectionName =;
		};
		if(aline.beginsWith("1:")){
			if(vInJapanese & $ChildCount("agent unnumbered") == 0){
				$Text(vNote2) += "第[-" + vName + "]章 " + vSectionName + "\n \n";
			}else{
				$Text(vNote2) += "[" + vName + "] " + vSectionName + "\n \n";
			};
		};
		if(vLevel >= 2){
			if(aline.beginsWith("2:")){
				aline = aline.substr(2);
				if(vInJapanese & $ChildCount("agent unnumbered") == 0){
					$Text(vNote2) += "- [-" + vName + "] " + vSectionName + "\n \n";
				}else{
					$Text(vNote2) += "- [" + vName + "] " + vSectionName + "\n \n";
				}
			};
		};
		if(vLevel >= 3){
			if(aline.beginsWith("3:")){
				aline = aline.substr(2);
				if(vInJapanese & $ChildCount("agent unnumbered") == 0){
					$Text(vNote2) += "- [-" + vName + "] " + vSectionName + "\n \n";
				}else{
					$Text(vNote2) += "- [" + vName + "] " + vSectionName + "\n \n";
				}
			};
		};
	};
	vTest = $IDString(vNote3);
	if(vTest){
		$Text(vNote3) = $Text(vNote2);
	};
};
// /Hints/Library/pNote;


function fSetExportMode(aPath:string){
	if($Prototype($Prototype(aPath)) == "pNote"|$Prototype(aPath) == "pNote"){
		$HTMLExportExtension(aPath) = ".qmd";
		$HTMLExportTemplate(aPath) = " / Templates / tNote";
	};
	if($Prototype($Prototype(aPath)) == "pSubnote"|$Prototype(aPath) == "pSubnote"){
		$HTMLExportExtension(aPath) = ".txt";
		$HTMLExportTemplate(aPath) = " / Templates / tSubnote";
	};
	$HTMLMarkdown(aPath) = true;
	$HTMLMarkupText(aPath) = false;
}


function fSetPreviewMode(aPath:string){
	$HTMLPreviewCommand(aPath) = " / opt / homebrew / bin / pandoc -f markdown --quiet --citeproc --bibliography = " + $Q_BibliographyFile("TBXConfig")
	+ " --resource-path = " + $ImagePathForPandoc("TBXConfig") + " --css = " + $PandocCSSPath("TBXConfig") + " -t html";
	$HTMLExportExtension(aPath) = ".html";
	if($Prototype($Prototype(aPath)) == "pNote"|$Prototype(aPath) == "pNote"){
		$HTMLExportTemplate(aPath) = " / Templates / tNote_Preview";
	};
	if($Prototype($Prototype(aPath)) == "pSubnote"|$Prototype(aPath) == "pSubnote"){
		$HTMLExportTemplate(aPath) = " / Templates / tSubnote_Preview";
	};
	$HTMLMarkdown(aPath) = true;
	$HTMLMarkupText(aPath) = false;
}


function fSetHTMLExportFileName(){
	if(!($IsNamesLocked)){
		if($IsIndexqmd){
			$HTMLExportFileName = "index";
		}else{
			$HTMLExportFileName = fDeleteCharacters($Name);
		};
		if(($SectionLabel == "untitled"|$HTMLExportFileName == "untitled"|!$SectionLabel|!$HTMLExportFileName)&!$IsPrototype){
			$HTMLExportFileName = fDeleteCharacters($Name);
			$SectionLabel = $HTMLExportFileName;
		};
		if(($SectionLabel != $HTMLExportFileName)&!$IsPrototype){
			$SectionLabel = $HTMLExportFileName;
		};
		if(($SectionLabel == $HTMLExportFileName)&$SectionLabel != "untitled"&!$IsPrototype){
			$IsNamesLocked = true;
		};
	};
	if($IsUnnumbered){
		$HasSectionLabel = false;
	};
};


function fSetIsPartQmd(){
	var:number vBaseOutlineDepth = 2;

	if(($OutlineDepth == vBaseOutlineDepth)&(collect_if(children, $Prototype == "pNote"|$Prototype($Prototype) == "pNote", $Name).count > 0)){
		$Is_Part_qmd = true;
	}else{
		$Is_Part_qmd = false;
	};
	if($OutlineDepth == vBaseOutlineDepth + 1){
		$Is_Part_qmd = false;
	};
};


function fCollectIncludeNotes(){
	if($Is_Part_qmd){
		$IncludeNotes = collect_if(children, $Prototype == "pNote"|$Prototype($Prototype) == "pNote", $ID);
	}else{
		$IncludeNotes = collect_if(children, $Prototype == "pSubnote"|$Prototype($Prototype) == "pSubnote", $ID);
	};
};


function fSetPartFileAttribute(){
	var:number vBaseOutlineDepth = 2;

	if(($OutlineDepth == vBaseOutlineDepth + 1)&($Is_Part_qmd(parent))){
		$Part_file = $HTMLExportFileName(parent) + $HTMLExportExtension(parent);
	}else{
		$Part_file =;
	};
	fCollectIncludeNotes();
};


function fSetOutlineDepthBaseForpNote(){
	var:number vOutlineDepthControle = 1;

	if($Part_file){
		$OutlineDepthBase = $OutlineDepth - 1 - vOutlineDepthControle;
	}else{
		$OutlineDepthBase = $OutlineDepth - vOutlineDepthControle;
	};
};
//For pNote;


function fSetAttributeForpNote(){
	fSetHTMLExportFileName();
	// Is a part-qmd or not.
	fSetIsPartQmd();
	//Set attribute for Nested qmd file ( Under the Part file );
	fSetPartFileAttribute();
	//Adjust OutlineDepthBase;
	fSetOutlineDepthBaseForpNote();
};
// /Hints/Library/pSubNote;


function fSetOutlineDepthBaseForpSubnote(){
	$OutlineDepthBase = $OutlineDepthBase(parent) + 1;
};
// For pSubnote;


function fSetAttributeForpSubnote(){
	fSetHTMLExportFileName();
	fSetOutlineDepthBaseForpSubnote();
	fCollectIncludeNotes();
};


function fSetPreviewForpSubnote(vID:string){
	if($Prototype(vID) == "pSubnote"|$Prototype($Prototype(vID)) == "pSubnote"){
		if($HTMLExportExtension == ".txt"){
			$HTMLPreviewCommand(vID) = " / opt / homebrew / bin / pandoc -f markdown --quiet --citeproc --bibliography = " + $Q_BibliographyFile("TBXConfig")
			+ " --resource-path = " + $ImagePathForPandoc("TBXConfig") + " --css = " + $PandocCSSPath("TBXConfig") + " -t html";
			$HTMLExportTemplate(vID) = " / Templates / tSubnote_all_Preview";
			$HTMLExportExtension(vID) = ".html";
			$HTMLMarkdown(vID) = false;
			$HTMLMarkupText(vID) = false;
		}else{
			$HTMLPreviewCommand(vAgentExport) = "CommonMark";
			$HTMLExportTemplate(vID) = " / Templates / tSubnote";
			$HTMLExportExtension(vID) = ".txt";
			$HTMLMarkdown(vID) = true;
			$HTMLMarkupText(vID) = false;
		};
	};
};


function fSetPreviewForpSubnoteFromPath(vPath:string){
	var:list vList = collect_if(descendants(vPath), $Prototype == "pSubnote"|$Prototype($Prototype) == "pSubnote", $ID);

	vList.each(aL){
		fSetPreviewForpSubnote(aL);
		update(aL);
	};
};
// /Hints/Library/Make Section Label List;


function fMakeSectionList(vContainer:string, vPath:string){
	var:string vName;
	var:string vTest;
	var:number vCount(0);
	var:set vCheck;
	var:dictionary vDict =;
	var:string vTemp;

	if($IsLabelGenerateON(vPath)&($Prototype(vPath) == "pLabelListContainer"|$Prototype($Prototype(vPath)) == "pLabelListContainer")){
		$Text(vPath) =;
		$MyList(vPath) =;
		$ListKey(vPath) =;
		$ListValue(vPath) =;
		$OutlineDepthBaseDictionary(vPath) =;
		$MyDictionary(vPath) =;
		$MyList(vPath) = collect_if(descendants(vContainer), $HasSectionLabel&$SectionLabel&!$IsAlias&$Prototype(parent) != "pLabelListContainer", $Path);
		$MyList(vPath).each(L){
			L = L.replace('"', "");
			if(!(vCheck.contains($Path(L)))){
				vCheck += $Path(L);
				vDict += dictionary($SectionLabel(L) + ":" + L + ";");
				//$MyString(vPath)=vDict;
				$ListKey(vPath) += $SectionLabel(L);
				$ListValue(vPath) += L;
				if($SectionLabel(L) != ""){
					$MyDictionary(vPath) += dictionary("@sec-" + $SectionLabel(L) + ":" + L + ";");
					if($Is_Part_qmd(L)){
						$OutlineDepthBaseDictionary(vPath) += dictionary("@sec-" + $SectionLabel(L) + ":" + 0 + ";");
					}else{
						$OutlineDepthBaseDictionary(vPath) += dictionary("@sec-" + $SectionLabel(L) + ":" + $OutlineDepthBase(L) + ";");
					};
				};
			};
		};
		vCount = 0;
		$ListKey(vPath).each(S){
			vName = "@sec-" + S;
			vTest = $IDString(vName);
			if(vTest == ""){
				create(vPath, vName + "#pReferenceList");
				$OutlineBackgroundColor(vName) = "blue";
			};
			$Text(vName) = exportedString($ListValue(vPath)[vCount], "tNote");
			//参照元のアウトラインの階層を記録
			$OutlineDepthBase(vName) = $OutlineDepthBaseDictionary(vPath)[vName];
			$Text(vPath) += $OutlineDepthBase(vName) + ":" + vName + "\n";
			vCount += 1;
		};
		vCount = 0;
		$ListKey(vPath).each(K){
			K = "@sec-" + K;
			$ToDummyLinkPath(K) += $ListValue(vPath)[vCount];
			createLink(K, $ListValue(vPath)[vCount], "dummy");
			vCount += 1;
		};
	};
};
// /Hints/Library/Make Figure Label List;


function fMakeFigureList(vContainer:string, vPath:string){
	var:string vName;
	var:string vTest;
	var:number vCount(0);
	var:string vLabel;
	var:string vTemp;
	var:list vList;

	LogRec("MakeFigureList", " < < mark > > vContainer = " + vContainer + " vPath = " + vPath);
	if($IsLabelGenerateON(vPath)&($Prototype(vPath) == "pLabelListContainer"|$Prototype($Prototype(vPath)) == "pLabelListContainer")){
		$Text(vPath) =;
		$MyList(vPath) =;
		$ListKey(vPath) =;
		$ListValue(vPath) =;
		$MyDictionary(vPath) =;
		//Notes contains chunk "fig-" label with style "#| label: fig- ";
		vList = collect_if(descendants(vContainer), $Text.contains("(#\| label: fig-[\w\d-] * ) + ?")&!$IsAlias&$Prototype(parent) != "pLabelListContainer", $Path);
		// Add Figures From pChunk, pRChunk, pPChunk;
		vList.each(L){
			L = L.replace('"', "");
			$Text(L).eachLine(aLine:aLine.contains("(#\| label: fig-[\w\d-] * ) + ?")){
				vTemp = $1;
				vTemp = vTemp.replace("#\| label: ", "@");
				$MyList(vPath) += vTemp;
				$ListKey(vPath) += vTemp;
				$ListValue(vPath) += L;
				$MyDictionary(vPath) = $MyDictionary(vPath).add("{" + $ListKey(vPath) + ":" + $ListValue(vPath) + "}");
			};
		};
		//Notes contains chunk "fig-" label with style "#fig-";
		vList = collect_if(descendants(vContainer), $Text.contains("(#fig-[\w\d-] * ) + ?")&!$IsAlias&$Prototype(parent) != "pLabelListContainer", $Path);
		vList.each(L){
			L = L.replace('"', "");
			$Text(L).eachLine(aLine:aLine.contains(". * (#fig-[\w\d-] * ) + ?. * ")){
				vTemp = $1;
				vTemp = vTemp.replace("#fig-", "@fig-");
				$MyList(vPath) += vTemp;
				$ListKey(vPath) += vTemp;
				$ListValue(vPath) += L;
				$MyDictionary(vPath) = $MyDictionary(vPath).add("{" + $ListKey(vPath) + ":" + $ListValue(vPath) + "}");
			};
		};
		//Notes contains chunk "fig-" label with style "%%| label: fig-" for Mermaid Flowchart;
		vList = collect_if(descendants(vContainer), $Text.contains("(%%\| label: fig-[\w\d-] * ) + ?")&!$IsAlias&$Prototype(parent) != "pLabelListContainer", $Path);
		LogRec("MakeFigureList", " < < mark > > vList = " + vList + " vContainer = " + vContainer + " $Path = " + $Path);
		vList.each(L){
			L = L.replace('"', "");
			$Text(L).eachLine(aLine:aLine.contains("(%%\| label: fig-[\w\d-] * ) + ?")){
				vTemp = $1;
				vTemp = vTemp.replace("%%\| label: ", "@");
				$MyList(vPath) += vTemp;
				$ListKey(vPath) += vTemp;
				$ListValue(vPath) += L;
				$MyDictionary(vPath) = $MyDictionary(vPath).add("{" + $ListKey(vPath) + ":" + $ListValue(vPath) + "}");
			};
		};
		//Notes contains chunk "fig-" label with style "//| label: fig-" for Graphviz;
		vList = collect_if(descendants(vContainer), $Text.contains("(\/\/\| label: fig-[\w\d-] * ) + ?")&!$IsAlias&$Prototype(parent) != "pLabelListContainer", $Path);
		vList.each(L){
			L = L.replace('"', "");
			$Text(L).eachLine(aLine:aLine.contains("(\/\/\| label: fig-[\w\d-] * ) + ?")){
				vTemp = $1;
				vTemp = vTemp.replace("\/\/\| label: ", "@");
				$MyList(vPath) += vTemp;
				$ListKey(vPath) += vTemp;
				$ListValue(vPath) += L;
				$MyDictionary(vPath) = $MyDictionary(vPath).add("{" + $ListKey(vPath) + ":" + $ListValue(vPath) + "}");
			};
		};
		$MySet(vPath) = $MyList(vPath);
		$MySet(vPath).each(S){
			vName = S;
			vLabel = S.replace("@", "");
			vTest = $IDString(vName);
			if(vTest == ""&vName != "@fig-"){
				LogRec("MakeFigureList", " < < mark > > create vName = " + vName + " vLabel = " + vLabel + " vTest = " + vTest);
				create(vPath, vName + "#pReferenceList");
				$OutlineBackgroundColor(vName) = "green";
				//  $Text(vName) = fFigureChunk($ListValue(vPath)[vCount], vLabel);
			};
			if(vName != "@fig-"){
				$Text(vPath) += vName + "\n";
			};
		};
		vCount = 0;
		$ListKey(vPath).each(K){
			vName = K;
			$ToDummyLinkPath(vName) = $ListValue(vPath)[vCount];
			$Text(vName) = fFigureChunk($ListValue(vPath)[vCount], vName.replace("@", ""));
			createLink(K, $ListValue(vPath)[vCount], "dummy");
			vCount += 1;
		};
	};
};


function fFigureChunk(vName:string, vLabel:string){
	var:string vReg1;
	var:string vReg2;
	var:string vReg3;
	var:string vReg4;
	var:string vTemp;

	vReg1 = "(```[^`] + #\| label: " + vLabel + "[^`] + ```)";
	vReg2 = "(:::[\s\S] * ?\{#" + vLabel + "\}[\s\S] * ?:::)";
	vReg3 = "(:::\s * \{#" + vLabel + "[\s\S] * ?\}[\s\S] * ?:::)";
	vReg4 = "(!\[. * ?\]\(. * ?\)\{#" + vLabel + ". * ?\})";
	if($Text(vName).contains(vReg1)){
		vTemp = $1;
	};
	if($Text(vName).contains(vReg2)){
		vTemp = $1;
	};
	if($Text(vName).contains(vReg3)){
		vTemp = $1;
	};
	if($Text(vName).contains(vReg4)){
		vTemp = $1;
	};
	return vTemp;
};
// /Hints/Library/Make Table Label List;


function fMakeTableList(vContainer:string, vPath){
	var:string vName;
	var:string vTest;
	var:number vCount(0);
	var:string vLabel;
	var:string vTemp;
	var:list vList;

	if($IsLabelGenerateON(vPath)&($Prototype(vPath) == "pLabelListContainer"|$Prototype($Prototype(vPath)) == "pLabelListContainer")){
		$Text(vPath) =;
		$MyList(vPath) =;
		$ListKey(vPath) =;
		$ListValue(vPath) =;
		$MyDictionary(vPath) =;
		//Notes contains chunk "tbl-" label;
		vList = collect_if(descendants(vContainer), $Text.contains("(#tbl-[\w\d-] * ) + ?")&!$IsAlias&$Prototype(parent) != "pLabelListContainer", $ID);
		vList.each(L){
			//L=L.replace('"',"");
			$Text(L).eachLine(aLine:aLine.contains("(#tbl-[\w\d-] * ) + ?")){
				vTemp = $1;
				vTemp = vTemp.replace("#tbl-", "@tbl-");
				$MyList(vPath) += vTemp;
				$ListKey(vPath) += vTemp;
				$ListValue(vPath) += $Path(L);
				$MyDictionary(vPath) = $MyDictionary(vPath).add("{" + $ListKey(vPath) + ":" + $ListValue(vPath) + "}");
			};
		};
		$MyList(vPath).each(S){
			vName = S;
			vLabel = S.replace("@", "");
			vTemp = vPath + " / " + S;
			vTest = $IDString(vTemp);
			if(vTest == ""&vName != "@tbl-"){
				create(vPath, vName + "#pReferenceList");
				$OutlineBackgroundColor(vName) = "purple";
			};
			//		$Text(vName) = fTableChunk($ListValue(vPath)[vCount], vLabel);
			if(vName != "@tbl-"){
				$Text(vPath) += vName + "\n";
			};
			vCount += 1;
		};
		vCount = 0;
		$ListKey(vPath).each(K){
			vName = vPath + " / " + K;
			$ToDummyLinkPath(vName) = $ListValue(vPath)[vCount];
			$Text(vName) = fTableChunk($ListValue(vPath)[vCount], K.replace("@", ""));
			createLink(K, $ListValue(vPath)[vCount], "dummy");
			vCount += 1;
		};
	};
};


function fTableChunk(vName:string, vLabel:string){
	var:string vReg;
	var:string vTemp;

	//vReg = ":\s*(.*?)\s*\{#("+ vLabel +")\s*?\}\s*\n(?:\s*\|.*\n)+\n";
	vReg = ":\s * (. * ?)\s * \{#(" + vLabel + ")\s * ?\}\s * \n(?:\s * \|. * \n) + ";
	//vReg = "```([\s\S]*?\{#("+ vLabel + ")\}[\s\S]*?)```";
	if($Text(vName).contains(vReg)){
		return $0;
	};
};
// /Hints/Library/Make Equation Label List;


function fMakeEquationList(vContainer:string, vPath){
	var:string vName;
	var:string vTest;
	var:number vCount(0);
	var:string vLabel;
	var:string vTemp;
	var:list vList;

	if($IsLabelGenerateON(vPath)&($Prototype(vPath) == "pLabelListContainer"|$Prototype($Prototype(vPath)) == "pLabelListContainer")){
		$Text(vPath) =;
		$MyList(vPath) =;
		$ListKey(vPath) =;
		$ListValue(vPath) =;
		$MyDictionary(vPath) =;
		//Notes contains chunk "eq-" label;
		vList = collect_if(descendants(vContainer), $Text.contains("(eq-[\w\d-] * ) + ?")&!$IsAlias&$Prototype(parent) != "pLabelListContainer", $Path);
		vList.each(L){
			L = L.replace('"', "");
			$Text(L).eachLine(aLine:aLine.contains("(#eq-[\w\d-] * ) + ?")){
				vTemp = $1;
				vTemp = vTemp.replace("#eq-", "@eq-");
				$MyList(vPath) += vTemp;
				$ListKey(vPath) += vTemp;
				$ListValue(vPath) += L;
				$MyDictionary(vPath) = $MyDictionary(vPath).add("{" + $ListKey(vPath) + ":" + $ListValue(vPath) + "}");
			};
		};
		$MyList(vPath).each(S){
			vName = S;
			vLabel = S.replace("@", "");
			vTest = $IDString(vName);
			if(vTest == ""&vName != "@eq-"){
				create(vPath, vName + "#pReferenceList");
				$OutlineBackgroundColor(vName) = "purple";
				$Text(vName) = fEquationChunk($ListValue(vPath)[vCount], vLabel);
			};
			if(vName != "@eq-"){
				$Text(vPath) += vName + "\n";
			};
			vCount += 1;
		};
		vCount = 0;
		$ListKey(vPath).each(K){
			vName = K;
			$ToDummyLinkPath(vName) = $ListValue(vPath)[vCount];
			$Text(vName) = fEquationChunk($ListValue(vPath)[vCount], vName.replace("@", ""));
			createLink(K, $ListValue(vPath)[vCount], "dummy");
			vCount += 1;
		};
	};
};


function fEquationChunk(vName:string, vLabel:string){
	var:string vReg;
	var:string vTemp;

	vReg = "(\$\$([\s\S] * ?)\$\$)\s * \{#(" + vLabel + ")\}";
	if($Text(vName).contains(vReg)){
		return $1;
	};
};
// /Hints/Library/Make Chunk and Graph List
//******************* Make Chunk List ***************************************


function fMakeFigLabelListFrompChunk(){
	var:string vName;
	var:string vPath = $FigLabelListContainer("TBXConfig");
	var:list vList = collect(children(vPath), $ID);
	var:list vReturn;

	vList.each(a){
		vReturn = vReturn + $Q_ChunkFigLabel($ToDummyLinkPath(a));
	};
	return vList;
};


function fMakeChunkList(){
	var:string vName;
	var:string vName2;
	var:string vChunkLabelListPath = $ChunkListContainer("TBXConfig");
	var:string vProjectLabelListPath;
	var:string vProjectPath;
	var:string vTest;
	var:dictionary vDict;
	var:list vList;
	var:string vID;

	if($Container($Path) == " / "){
		vProjectPath = $Path;
	}else{
		vProjectPath = collect(ancestors, $Path)[-1];
	};
	vProjectLabelListPath = vProjectPath + $ChunkListContainer("TBXConfig");
	if($IsLabelGenerateON(vChunkLabelListPath)&($Prototype(vChunkLabelListPath) == "pLabelListContainer"|$Prototype($Prototype(vChunkLabelListPath)) == "pLabelListContainer")){
		$Text(vChunkLabelListPath) = "";
		vList = collect_if(all, ($Prototype == "pChunk"|$Prototype == "pRChunk"|$Prototype == "pPChunk")&!$IsPrototype&!$IsAlias&($Container != vChunkLabelListPath), $ID);
		vList = vList.sort($Q_ChunkLang);
		vList.each(aChunk){
			var:string vFigRef;

			if($Q_ChunkFigLabel(aChunk)){
				vFigRef = "➡️fig-" + $Q_ChunkFigLabel(aChunk) + "";
			};
			$Name(aChunk) = fDeleteCharacters($Name(aChunk));
			vName = " < " + $Q_ChunkLang(aChunk) + ":" + $Name(aChunk) + vFigRef + " > ";
			vName2 = "\ < " + $Q_ChunkLang(aChunk) + ":" + $Name(aChunk) + vFigRef + "\ > ";
			vTest = $ID(vName);
			if(!vTest){
				if($Text(aChunk).wordCount > 0){
					var:string vPrototype;
					var:string vPath;

					if($Q_ChunkLang(aChunk) == "r"|$Q_ChunkLang(aChunk) == "webr"){
						vPrototype = "#pRChunkList";
					}else{
						vPrototype = "#pChunkList";
					};
					vPath = vChunkLabelListPath + " / " + vName2;
					LogRec("MakeChunkList", " < < mark > > vPath = " + vPath + vPrototype);
					create(vPath + vPrototype);
					$Text(vPath) = $Text(aChunk);
					createLink($Path(vPath), $Path(aChunk), "dummy");
					$ToDummyLinkPath(vPath) = $Path(aChunk);
					$Text(vChunkLabelListPath) += vName + ":" + $ToDummyLinkPath(vPath) + "\n";
					$Name(vPath) = vName;
				};
			};
			//Create Figure Label;
			var:string vFigName;
			var:string vLabelPath;
			var:list vAttributes = $DisplayedAttributes($Prototype(aChunk));
			var:string vTemp;

			vFigName = "@fig-" + $Q_ChunkFigLabel($Path(aChunk));
			LogRec("MakeChunkList", " < < mark > > vProjectPath = " + vProjectPath + " vChunkLabelListPath = " + vChunkLabelListPath + " vFigName = " + vFigName);
			vLabelPath = vProjectPath + vChunkLabelListPath + " / " + vFigName;
			vTest = $ID(vLabelPath);
			if(!vTest & vFigName != "@fig-"){
				create(vLabelPath, vFigName + "#pReferenceList");
				$ToDummyLinkPath(vLabelPath) = $Path(aChunk);
				$OutlineBackgroundColor(vLabelPath) = "light violet";
				$Text(vLabelPath) = $Text(aChunk);
				createLink(vChunkLabelListPath + " / " + vFigName, vLabelPath, "dummy");
			};
			vAttributes.each(x){
				vTemp = "$" + x + "(" + vChunkLabelListPath + " / " + vFigName + ") = $" + x + "(" + $Path(aChunk) + ");";
				action(vTemp);
			};
		};
	};
};


function fClearChunkList(){
	var:string vPath1 = $ChunkListContainer("TBXConfig");
	var:list vDellist;

	vDellist = collect(children(vPath1), $Path);
	if(vDellist.count > 0){
		delete(vDellist);
		$Text(vPath1) = "";
	};
};


function fCheckDuplicateChunkName(){
	var:string vPath1 = $ChunkListContainer("TBXConfig");
	var:list vList = collect_if(children(vPath1), $Prototype == "pChunkList"&$Name == $Name(this)&$Path != $Path(this));

	if(vList.count = > 2){
		$Color = "red";
	}else{
		$Color = $Color($Prototype);
	};
};
