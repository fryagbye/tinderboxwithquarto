	//	$MyList(vNote) = collect_if(descendants($Container.contains($CurrentBookProject($AgentNameForQmdFiles("TBXConfig")))), $Text.contains("(@sec-[\w\d-]*)+?"),$ID);
	$MyList(vNote) = collect_if(descendants(vContainer), $Text.contains("(@sec-[\w\d-] * ) + ?"), $ID);
	$MyList(vNote).each(L){
		$Text(L).eachLine(aLine){
			vTest = aLine.contains("(@sec-[\w\d-] * ) + ?");
